// wasifu.swa — tafsiri ya src/core/profile.c (na .h) kwenda Swa.
// Wasifu wa mchezaji na usimamizi wa maeneo ya kuhifadhi (save slots)
// kwa kila wasifu.
//
// Kiambishi: wasifu_ — angalia ../../KANUNI-MAJINA.md.
//
// TOFAUTI KUBWA kutoka kwa chanzo cha C: chanzo kilitumia SDL3 moja
// kwa moja (SDL_CreateDirectory, SDL_IOFromFile, SDL_EnumerateDirectory)
// kwa sababu Swa haina maktaba ya juu ya faili/saraka bado. Badala ya
// kuruka uwezo huu (kama ilivyofanyika kwa map_view.c/flag_system.c
// zilizohitaji uwakilishi wa picha), NIMEANDIKA MOJA KWA MOJA
// kupitia syscalls ghafi za Linux x86-64 (wito_wa_mfumo, kutoka
// kumbukumbu.swa, ile ile inayotumika na faili.swa kwa open/read/
// write/close/unlink):
//   - mkdir(njia, ruhusa) ni syscall 83 — imejaribiwa moja kwa moja,
//     inaunda saraka halisi kwenye faili mfumo, inarudisha -17
//     (-EEXIST) ikiwa saraka ipo tayari, kama C.
//   - Uorodheshaji wa saraka (kuchukua nafasi ya SDL_EnumerateDirectory)
//     umetekelezwa kwa getdents64 (syscall 217): fungua saraka kwa
//     open(njia, O_DIRECTORY=65536), kisha piga getdents64 mara kwa
//     mara kwenye bafa ya 4096 hadi irudishe 0. Muundo wa rekodi
//     (linux_dirent64): d_ino (N64, 8 baiti) + d_off (N64, 8 baiti)
//     + d_reclen (N16, 2 baiti, kwenye nafasi 16) + d_type (N8,
//     nafasi 18) + d_name (mfuatano wenye NUL, kuanzia nafasi 19).
//     MUHIMU: N8 kwenye Swa INA ALAMA (signed) — thamani 128-255
//     zinarudi HASI zikipanuliwa kuwa N32 (imethibitishwa kwa
//     jaribio dogo). Kusoma d_reclen (baiti mbili) bila
//     kuzingatia hili kunatoa matokeo yasiyo sahihi kwa saraka
//     zenye majina marefu. Suluhisho: `v & 255` (bitwise AND,
//     inatumika sahihi bila kujali alama) kabla ya kuunganisha
//     baiti ya chini na ya juu (`lo + hi*256`).
//
// Muundo wa faili ya profile.dat: MSTARI MMOJA KWA KILA FIELD (si
// unakili wa muundo mzima kama baiti ghafi kama C, kwa sababu
// WasifuMchezaji ina vielekezi vya N8* -- kunakili muundo wenye
// vielekezi moja kwa moja kwenye faili hakungefanya kazi baada ya
// mchakato kuanzishwa upya, tofauti na C ambayo ilitumia safu za
// herufi zisizobadilika ndani ya muundo wenyewe): jina, kitambulisho,
// aliyeundwa, alicheza_mwisho, njia_ya_picha -- kila moja mstari
// wake, ikisomwa kwa faili_soma_mstari (tayari ipo kwenye faili.swa).

husisha { msingi/msingi_civ.swa }
husisha { msingi/maktaba/faili.swa }
husisha { msingi/maktaba/mfuatano.swa }

N32 WASIFU_JINA_UPEO = 32;
N32 WASIFU_ID_UPEO = 32;
N32 WASIFU_NJIA_UPEO = 64;
N32 WASIFU_RUHUSA_SARAKA = 493;   // 0755
N32 WASIFU_O_DIRECTORY = 65536;  // O_DIRECTORY, bendera ya open(2)
N32 WASIFU_URUFU_WA_MSTARI = 300;

muundo WasifuMchezaji {
    N8* jina;
    N8* kitambulisho;    // id
    N64 aliyeundwa;       // created_at
    N64 alicheza_mwisho;  // last_played
    N8* njia_ya_picha;    // avatar_path
};

// WasifuOrodha: safu inayokua ya mfuatano (majina ya wasifu au
// majina ya slots) -- N64* ya vielekezi vya N8*, angalia
// lugha-swa/swa#185 (TYPE** ingehesabu hatua isiyo sahihi).
muundo WasifuOrodha {
    N64* majina;
    N32 idadi;
    N32 uwezo;
};

N32 wasifu_baiti_bila_alama(N8 b) {
    N32 v = b;
    rudisha v & 255;
}

N32 wasifu_saraka_unda(N8* njia) {
    rudisha wito_wa_mfumo(83, njia, WASIFU_RUHUSA_SARAKA, 0, 0, 0);
}

W0 wasifu_hakikisha_saraka_kuu() {
    wasifu_saraka_unda("saves");
    wasifu_saraka_unda("saves/profiles");
}

N8* wasifu_njia_ya_saraka(N8* id) {
    N8* tmp = tenga(WASIFU_URUFU_WA_MSTARI);
    unganisha_mfuatano(tmp, "saves/profiles", "/");
    N8* matokeo = tenga(WASIFU_URUFU_WA_MSTARI);
    unganisha_mfuatano(matokeo, tmp, id);
    achilia tmp;
    rudisha matokeo;
}

N8* wasifu_njia_ya_slots(N8* id) {
    N8* dir = wasifu_njia_ya_saraka(id);
    N8* tmp = tenga(WASIFU_URUFU_WA_MSTARI);
    unganisha_mfuatano(tmp, dir, "/");
    N8* matokeo = tenga(WASIFU_URUFU_WA_MSTARI);
    unganisha_mfuatano(matokeo, tmp, "slots");
    achilia dir;
    achilia tmp;
    rudisha matokeo;
}

N8* wasifu_njia_ya_meta(N8* id) {
    N8* dir = wasifu_njia_ya_saraka(id);
    N8* tmp = tenga(WASIFU_URUFU_WA_MSTARI);
    unganisha_mfuatano(tmp, dir, "/");
    N8* matokeo = tenga(WASIFU_URUFU_WA_MSTARI);
    unganisha_mfuatano(matokeo, tmp, "profile.dat");
    achilia dir;
    achilia tmp;
    rudisha matokeo;
}

W0 wasifu_hakikisha_saraka_za_wasifu(N8* id) {
    N8* dir = wasifu_njia_ya_saraka(id);
    wasifu_saraka_unda(dir);
    N8* slots = wasifu_njia_ya_slots(id);
    wasifu_saraka_unda(slots);
    achilia dir;
    achilia slots;
}

WasifuMchezaji* wasifu_unda(N8* jina) {
    WasifuMchezaji* p = tenga(ukubwa(WasifuMchezaji));

    N64 ujina = urefu_wa_mfuatano(jina);
    N8* jina_buf = tenga(ujina + 1);
    nakili_mfuatano(jina_buf, jina);
    p->jina = jina_buf;

    N64 muda = civ_muda_sasa();
    N8* muda_str = tenga(32);
    nambari_kwa_mfuatano_n64(muda, muda_str);

    N8* id_tmp = tenga(WASIFU_URUFU_WA_MSTARI);
    unganisha_mfuatano(id_tmp, jina, "_");
    N8* id_buf = tenga(WASIFU_URUFU_WA_MSTARI);
    unganisha_mfuatano(id_buf, id_tmp, muda_str);
    achilia id_tmp;
    achilia muda_str;

    // safisha: badilisha ' ' '/' '\' ':' '.' kuwa '_' (sawa na chanzo
    // cha C).
    N64 i = 0;
    wakati (id_buf[i] != 0) {
        N8 c = id_buf[i];
        kama (c == 32 || c == 47 || c == 92 || c == 58 || c == 46) {
            id_buf[i] = 95;
        }
        i = i + 1;
    }
    p->kitambulisho = id_buf;

    p->aliyeundwa = muda;
    p->alicheza_mwisho = muda;

    N8* njia_tupu = tenga(1);
    njia_tupu[0] = 0;
    p->njia_ya_picha = njia_tupu;

    rudisha p;
}

W0 wasifu_uharibu(WasifuMchezaji* p) {
    achilia p;
}

W0 wasifu_ondoa_mstari_mpya(N8* s, N32 urefu) {
    kama (urefu > 0 && s[urefu - 1] == 10) {
        s[urefu - 1] = 0;
    }
}

N32 wasifu_hifadhi(WasifuMchezaji* p) {
    kama (p == 0) { rudisha 0; }

    wasifu_hakikisha_saraka_kuu();
    wasifu_hakikisha_saraka_za_wasifu(p->kitambulisho);

    N8* njia = wasifu_njia_ya_meta(p->kitambulisho);
    N8* f = faili_fungua(njia, "w");
    achilia njia;
    kama (f == 0) { rudisha 0; }

    N8* mstari = tenga(WASIFU_URUFU_WA_MSTARI);
    N8* nambari = tenga(32);
    N64 u;

    unganisha_mfuatano(mstari, p->jina, "\n");
    u = urefu_wa_mfuatano(mstari);
    faili_andika(mstari, 1, u, f);

    unganisha_mfuatano(mstari, p->kitambulisho, "\n");
    u = urefu_wa_mfuatano(mstari);
    faili_andika(mstari, 1, u, f);

    nambari_kwa_mfuatano_n64(p->aliyeundwa, nambari);
    unganisha_mfuatano(mstari, nambari, "\n");
    u = urefu_wa_mfuatano(mstari);
    faili_andika(mstari, 1, u, f);

    nambari_kwa_mfuatano_n64(p->alicheza_mwisho, nambari);
    unganisha_mfuatano(mstari, nambari, "\n");
    u = urefu_wa_mfuatano(mstari);
    faili_andika(mstari, 1, u, f);

    unganisha_mfuatano(mstari, p->njia_ya_picha, "\n");
    u = urefu_wa_mfuatano(mstari);
    faili_andika(mstari, 1, u, f);

    faili_funga(f);
    achilia mstari;
    achilia nambari;
    rudisha 1;
}

WasifuMchezaji* wasifu_pakia(N8* id) {
    N8* njia = wasifu_njia_ya_meta(id);
    N8* f = faili_fungua(njia, "r");
    achilia njia;
    kama (f == 0) { rudisha 0; }

    WasifuMchezaji* p = tenga(ukubwa(WasifuMchezaji));
    N8* buf = tenga(WASIFU_URUFU_WA_MSTARI);
    N32 n;

    n = faili_soma_mstari(f, buf, WASIFU_URUFU_WA_MSTARI);
    kama (n < 0) { faili_funga(f); achilia p; achilia buf; rudisha 0; }
    wasifu_ondoa_mstari_mpya(buf, n);
    N8* jina_buf = tenga(urefu_wa_mfuatano(buf) + 1);
    nakili_mfuatano(jina_buf, buf);
    p->jina = jina_buf;

    n = faili_soma_mstari(f, buf, WASIFU_URUFU_WA_MSTARI);
    kama (n < 0) { faili_funga(f); achilia p; achilia buf; rudisha 0; }
    wasifu_ondoa_mstari_mpya(buf, n);
    N8* id_buf = tenga(urefu_wa_mfuatano(buf) + 1);
    nakili_mfuatano(id_buf, buf);
    p->kitambulisho = id_buf;

    n = faili_soma_mstari(f, buf, WASIFU_URUFU_WA_MSTARI);
    kama (n < 0) { faili_funga(f); achilia p; achilia buf; rudisha 0; }
    wasifu_ondoa_mstari_mpya(buf, n);
    p->aliyeundwa = mfuatano_hadi_n64(buf);

    n = faili_soma_mstari(f, buf, WASIFU_URUFU_WA_MSTARI);
    kama (n < 0) { faili_funga(f); achilia p; achilia buf; rudisha 0; }
    wasifu_ondoa_mstari_mpya(buf, n);
    p->alicheza_mwisho = mfuatano_hadi_n64(buf);

    n = faili_soma_mstari(f, buf, WASIFU_URUFU_WA_MSTARI);
    kama (n < 0) { faili_funga(f); achilia p; achilia buf; rudisha 0; }
    wasifu_ondoa_mstari_mpya(buf, n);
    N8* picha_buf = tenga(urefu_wa_mfuatano(buf) + 1);
    nakili_mfuatano(picha_buf, buf);
    p->njia_ya_picha = picha_buf;

    faili_funga(f);
    achilia buf;
    rudisha p;
}

N8* wasifu_njia_ya_kuhifadhi(N8* id, N8* jina_la_kipande) {
    wasifu_hakikisha_saraka_kuu();
    wasifu_hakikisha_saraka_za_wasifu(id);

    N8* slots = wasifu_njia_ya_slots(id);
    N8* tmp1 = tenga(WASIFU_URUFU_WA_MSTARI);
    unganisha_mfuatano(tmp1, slots, "/");
    N8* tmp2 = tenga(WASIFU_URUFU_WA_MSTARI);
    unganisha_mfuatano(tmp2, tmp1, jina_la_kipande);
    N8* matokeo = tenga(WASIFU_URUFU_WA_MSTARI);
    unganisha_mfuatano(matokeo, tmp2, ".civ");

    achilia slots;
    achilia tmp1;
    achilia tmp2;
    rudisha matokeo;
}

N8* wasifu_orodha_pata(WasifuOrodha* orodha, N32 idx) {
    rudisha orodha->majina[idx];
}

WasifuOrodha* wasifu_orodhesha_saraka(N8* njia_ya_saraka) {
    WasifuOrodha* orodha = tenga(ukubwa(WasifuOrodha));
    orodha->uwezo = 16;
    orodha->idadi = 0;
    orodha->majina = tenga(ukubwa(N64) * orodha->uwezo);

    N32 fd = wito_wa_mfumo(2, njia_ya_saraka, WASIFU_O_DIRECTORY, 0, 0, 0);
    kama (fd < 0) { rudisha orodha; }

    N8* buf = tenga(4096);
    N32 kuendelea = 1;
    wakati (kuendelea != 0) {
        N64 n = wito_wa_mfumo(217, fd, buf, 4096, 0, 0);
        kama (n <= 0) {
            kuendelea = 0;
        } sivyo {
            N64 nafasi = 0;
            wakati (nafasi < n) {
                N32 reclen_lo = wasifu_baiti_bila_alama(buf[nafasi + 16]);
                N32 reclen_hi = wasifu_baiti_bila_alama(buf[nafasi + 17]);
                N32 reclen = reclen_lo + reclen_hi * 256;

                N8* jina_kipengele = buf + nafasi + 19;
                N32 ni_nukta = linganisha_mfuatano(jina_kipengele, ".");
                N32 ni_nukta_mbili = linganisha_mfuatano(jina_kipengele, "..");
                kama (ni_nukta != 0 && ni_nukta_mbili != 0) {
                    kama (orodha->idadi >= orodha->uwezo) {
                        orodha->uwezo = orodha->uwezo * 2;
                        orodha->majina = badili(orodha->majina, ukubwa(N64) * orodha->uwezo);
                    }
                    N64 ujina = urefu_wa_mfuatano(jina_kipengele);
                    N8* nakala = tenga(ujina + 1);
                    nakili_mfuatano(nakala, jina_kipengele);
                    orodha->majina[orodha->idadi] = nakala;
                    orodha->idadi = orodha->idadi + 1;
                }

                nafasi = nafasi + reclen;
            }
        }
    }

    wito_wa_mfumo(3, fd, 0, 0, 0, 0);
    achilia buf;
    rudisha orodha;
}

WasifuOrodha* wasifu_orodhesha_wasifu() {
    wasifu_hakikisha_saraka_kuu();
    rudisha wasifu_orodhesha_saraka("saves/profiles");
}

WasifuOrodha* wasifu_orodhesha_vipande(N8* id) {
    wasifu_hakikisha_saraka_kuu();
    wasifu_hakikisha_saraka_za_wasifu(id);

    N8* slots = wasifu_njia_ya_slots(id);
    WasifuOrodha* ghafi = wasifu_orodhesha_saraka(slots);
    achilia slots;

    N32 i = 0;
    wakati (i < ghafi->idadi) {
        N8* jina = wasifu_orodha_pata(ghafi, i);
        N32 ina_civ = isha_kwa_mfuatano(jina, ".civ");
        kama (ina_civ != 0) {
            N64 u = urefu_wa_mfuatano(jina);
            jina[u - 4] = 0;
        }
        i = i + 1;
    }
    rudisha ghafi;
}

W0 wasifu_orodha_huru(WasifuOrodha* orodha) {
    N32 i = 0;
    wakati (i < orodha->idadi) {
        N8* jina = wasifu_orodha_pata(orodha, i);
        achilia jina;
        i = i + 1;
    }
    achilia orodha->majina;
    achilia orodha;
}
