    r->skrini_6 = JUKUMU_SKRINI_HAKUNA; r->skrini_7 = JUKUMU_SKRINI_HAKUNA;
    r->skrini_8 = JUKUMU_SKRINI_HAKUNA; r->skrini_9 = JUKUMU_SKRINI_HAKUNA;
    r->skrini_10 = JUKUMU_SKRINI_HAKUNA; r->skrini_11 = JUKUMU_SKRINI_HAKUNA;
    r->idadi_ya_skrini = 6;
    r->cheo_cha_bosi = "Mkuu wa Serikali";
    r->idara = "Wizara ya Ulinzi";
    r->ngazi_ya_uongozi = 2;
