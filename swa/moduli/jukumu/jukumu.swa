    JukumuAinisho* r = tenga(ukubwa(JukumuAinisho));
    r->jina = "Mbunge";
    r->wigo = "Utungaji wa sheria na usimamizi";
    r->matendo_yanayoruhusiwa = JUKUMU_TAZAMA_DASHIBODI | JUKUMU_PITISHA_SHERIA
        | JUKUMU_PIGA_KURA | JUKUMU_PENDEKEZA_SERA | JUKUMU_TANDAO
        | JUKUMU_JIUZULU | JUKUMU_TAZAMA_HABARI | JUKUMU_TAZAMA_UTAWALA
        | JUKUMU_TAZAMA_BAJETI | JUKUMU_ONDOA_MADARAKANI;
    r->skrini_0 = JUKUMU_SKRINI_DASHIBODI; r->skrini_1 = JUKUMU_SKRINI_SERA;
    r->skrini_2 = JUKUMU_SKRINI_UTAWALA; r->skrini_3 = JUKUMU_SKRINI_SIASA;
    r->skrini_4 = JUKUMU_SKRINI_BAJETI; r->skrini_5 = JUKUMU_SKRINI_HABARI;
    r->skrini_6 = JUKUMU_SKRINI_HAKUNA; r->skrini_7 = JUKUMU_SKRINI_HAKUNA;
    r->skrini_8 = JUKUMU_SKRINI_HAKUNA; r->skrini_9 = JUKUMU_SKRINI_HAKUNA;
