// jukumu.swa — tafsiri ya src/core/role.c (na .h) kwenda Swa. Kila
// raia ana jukumu; jukumu linaeleza vitendo vinavyoruhusiwa,
// skrini za dashibodi, na uhusiano wa bosi/mfanyakazi.
//
// Kiambishi: jukumu_ — angalia ../../KANUNI-MAJINA.md.
// permitted_actions (uint64_t bitmask, C) imekuwa N32 -- kitendo cha
// mwisho kinachotumika ni bit 26 (CIV_ACT_VIEW_DIPLOMACY), ndani ya
// mipaka ya N32 (bits 0-31), hivyo hakuna hasara. Uendeshaji wa
// bitwise (| na &) umejaribiwa moja kwa moja na kuthibitishwa
// kufanya kazi sahihi kwenye Swa. nav_screens[12] (safu ya ndani ya
// int, field ya muundo) imegawanywa kuwa vigezo 12 vyenye majina
// (skrini_0..skrini_11) -- safu za ndani za muundo hazichanganuliwi
// kabisa. Majukumu 6 yaliyoainishwa awali (private_citizen,
// cabinet_economics, cabinet_defense, diplomat, legislator,
// head_of_state) yamekuwa kazi 6 tofauti zinazounda na kurudisha
// muundo mpya kwenye rundo kila zikiitwa (badala ya const globals za
// C) -- hakuna hifadhi ya "singleton" ya kudumu, urahisi kuliko
// usahihi wa utendaji, mtindo uliothibitishwa kikao hiki.

husisha { msingi/msingi_civ.swa }

N32 JUKUMU_TAZAMA_DASHIBODI    = 1;
N32 JUKUMU_FANYA_BIASHARA      = 2;
N32 JUKUMU_TANDAO              = 4;
N32 JUKUMU_JIUNGE_CHAMA        = 8;
N32 JUKUMU_OMBA_NAFASI         = 16;
N32 JUKUMU_ANZISHA_BIASHARA    = 32;
N32 JUKUMU_PINGA                = 64;
N32 JUKUMU_PIGA_KURA           = 128;
N32 JUKUMU_JIUZULU              = 256;
N32 JUKUMU_TAZAMA_BAJETI       = 512;
N32 JUKUMU_GAWA_BAJETI         = 1024;
N32 JUKUMU_PENDEKEZA_SERA      = 2048;
N32 JUKUMU_AJIRI_WAFANYAKAZI   = 4096;
N32 JUKUMU_FUKUZA_WAFANYAKAZI  = 8192;
N32 JUKUMU_PELEKA_JESHI        = 16384;
N32 JUKUMU_JADILIANA_MKATABA   = 32768;
N32 JUKUMU_TANGAZA_VITA        = 65536;
N32 JUKUMU_PITISHA_SHERIA      = 131072;
N32 JUKUMU_TOA_HUKUMU          = 262144;
N32 JUKUMU_TEUA_AFISA          = 524288;
N32 JUKUMU_ONDOA_MADARAKANI    = 1048576;
N32 JUKUMU_TAZAMA_UJASUSI      = 2097152;
N32 JUKUMU_TAZAMA_HABARI       = 4194304;
N32 JUKUMU_TAZAMA_UCHUMI       = 8388608;
N32 JUKUMU_TAZAMA_JESHI        = 16777216;
N32 JUKUMU_TAZAMA_UTAWALA      = 33554432;
N32 JUKUMU_TAZAMA_DIPLOMASIA   = 67108864;

N32 JUKUMU_SKRINI_DASHIBODI     = 0;
N32 JUKUMU_SKRINI_KAZI          = 1;
N32 JUKUMU_SKRINI_FEDHA         = 2;
N32 JUKUMU_SKRINI_MAKAZI        = 3;
N32 JUKUMU_SKRINI_ELIMU         = 4;
N32 JUKUMU_SKRINI_TANDAO        = 5;
N32 JUKUMU_SKRINI_SIASA         = 6;
N32 JUKUMU_SKRINI_AFYA          = 7;
N32 JUKUMU_SKRINI_BAJETI        = 8;
N32 JUKUMU_SKRINI_SERA          = 9;
N32 JUKUMU_SKRINI_RIPOTI        = 10;
N32 JUKUMU_SKRINI_WAFANYAKAZI   = 11;
N32 JUKUMU_SKRINI_MAJESHI       = 12;
N32 JUKUMU_SKRINI_UPELEKAJI     = 13;
N32 JUKUMU_SKRINI_UJASUSI       = 14;
N32 JUKUMU_SKRINI_HABARI        = 15;
N32 JUKUMU_SKRINI_UCHUMI        = 16;
N32 JUKUMU_SKRINI_UTAWALA       = 17;
N32 JUKUMU_SKRINI_KATIBA        = 18;
N32 JUKUMU_SKRINI_RAMANI        = 19;
N32 JUKUMU_SKRINI_DIPLOMASIA    = 20;
N32 JUKUMU_SKRINI_JESHI         = 21;
N32 JUKUMU_SKRINI_HAKUNA        = -1;

muundo JukumuAinisho {
    N8* jina;
    N8* wigo;
    N32 matendo_yanayoruhusiwa;
    N32 skrini_0; N32 skrini_1; N32 skrini_2; N32 skrini_3;
    N32 skrini_4; N32 skrini_5; N32 skrini_6; N32 skrini_7;
    N32 skrini_8; N32 skrini_9; N32 skrini_10; N32 skrini_11;
    N32 idadi_ya_skrini;
    N8* cheo_cha_bosi;
    N8* idara;
    N32 ngazi_ya_uongozi;
};

muundo JukumuLaMchezaji {
    N8* jina_la_jukumu;
    N8* taifa_id;
    N8* jina_la_bosi;
    N8* jina_la_chama;
    D64 imani_ya_bosi;
    D64 uwiano_na_chama;
    D64 kibali_cha_umma;
    N32 matendo_yanayoruhusiwa;
    N32 skrini_0; N32 skrini_1; N32 skrini_2; N32 skrini_3;
    N32 skrini_4; N32 skrini_5; N32 skrini_6; N32 skrini_7;
    N32 skrini_8; N32 skrini_9; N32 skrini_10; N32 skrini_11;
    N32 idadi_ya_skrini;
    N32 ni_jukumu_la_serikali;
};

N8* jukumu_lebo_ya_skrini(N32 skrini) {
    kama (skrini == JUKUMU_SKRINI_DASHIBODI) { rudisha "Dashibodi"; }
    kama (skrini == JUKUMU_SKRINI_KAZI) { rudisha "Kazi"; }
    kama (skrini == JUKUMU_SKRINI_FEDHA) { rudisha "Fedha"; }
    kama (skrini == JUKUMU_SKRINI_MAKAZI) { rudisha "Makazi"; }
    kama (skrini == JUKUMU_SKRINI_ELIMU) { rudisha "Elimu"; }
    kama (skrini == JUKUMU_SKRINI_TANDAO) { rudisha "Tandao"; }
    kama (skrini == JUKUMU_SKRINI_SIASA) { rudisha "Siasa"; }
    kama (skrini == JUKUMU_SKRINI_AFYA) { rudisha "Afya"; }
    kama (skrini == JUKUMU_SKRINI_BAJETI) { rudisha "Bajeti"; }
    kama (skrini == JUKUMU_SKRINI_SERA) { rudisha "Sera"; }
    kama (skrini == JUKUMU_SKRINI_RIPOTI) { rudisha "Ripoti"; }
    kama (skrini == JUKUMU_SKRINI_WAFANYAKAZI) { rudisha "Wafanyakazi"; }
    kama (skrini == JUKUMU_SKRINI_MAJESHI) { rudisha "Majeshi"; }
    kama (skrini == JUKUMU_SKRINI_UPELEKAJI) { rudisha "Upelekaji"; }
    kama (skrini == JUKUMU_SKRINI_UJASUSI) { rudisha "Ujasusi"; }
    kama (skrini == JUKUMU_SKRINI_HABARI) { rudisha "Habari"; }
    kama (skrini == JUKUMU_SKRINI_UCHUMI) { rudisha "Uchumi"; }
    kama (skrini == JUKUMU_SKRINI_UTAWALA) { rudisha "Utawala"; }
    kama (skrini == JUKUMU_SKRINI_KATIBA) { rudisha "Katiba"; }
    kama (skrini == JUKUMU_SKRINI_RAMANI) { rudisha "Ramani"; }
    kama (skrini == JUKUMU_SKRINI_DIPLOMASIA) { rudisha "Diplomasia"; }
    kama (skrini == JUKUMU_SKRINI_JESHI) { rudisha "Jeshi"; }
    rudisha "Haijulikani";
}

JukumuAinisho* jukumu_raia_binafsi() {
    JukumuAinisho* r = tenga(ukubwa(JukumuAinisho));
    r->jina = "Raia wa Kawaida";
    r->wigo = "Mambo binafsi, kazi, na jamii ya karibu";
    r->matendo_yanayoruhusiwa = JUKUMU_TAZAMA_DASHIBODI | JUKUMU_FANYA_BIASHARA
        | JUKUMU_TANDAO | JUKUMU_JIUNGE_CHAMA | JUKUMU_OMBA_NAFASI
        | JUKUMU_ANZISHA_BIASHARA | JUKUMU_PINGA | JUKUMU_PIGA_KURA
        | JUKUMU_JIUZULU | JUKUMU_TAZAMA_HABARI | JUKUMU_TAZAMA_UCHUMI;
    r->skrini_0 = JUKUMU_SKRINI_DASHIBODI; r->skrini_1 = JUKUMU_SKRINI_RAMANI;
    r->skrini_2 = JUKUMU_SKRINI_KAZI; r->skrini_3 = JUKUMU_SKRINI_FEDHA;
    r->skrini_4 = JUKUMU_SKRINI_MAKAZI; r->skrini_5 = JUKUMU_SKRINI_ELIMU;
    r->skrini_6 = JUKUMU_SKRINI_TANDAO; r->skrini_7 = JUKUMU_SKRINI_SIASA;
    r->skrini_8 = JUKUMU_SKRINI_AFYA; r->skrini_9 = JUKUMU_SKRINI_KATIBA;
    r->skrini_10 = JUKUMU_SKRINI_HABARI; r->skrini_11 = JUKUMU_SKRINI_UCHUMI;
    r->idadi_ya_skrini = 12;
    r->cheo_cha_bosi = "";
    r->idara = "Jamii ya Kiraia";
    r->ngazi_ya_uongozi = 99;
    rudisha r;
}

JukumuAinisho* jukumu_waziri_uchumi() {
    JukumuAinisho* r = tenga(ukubwa(JukumuAinisho));
    r->jina = "Katibu wa Baraza la Mawaziri wa Uchumi";
    r->wigo = "Sera ya uchumi wa taifa, bajeti, biashara, na udhibiti wa sekta";
    r->matendo_yanayoruhusiwa = JUKUMU_TAZAMA_DASHIBODI | JUKUMU_TAZAMA_BAJETI
        | JUKUMU_GAWA_BAJETI | JUKUMU_PENDEKEZA_SERA | JUKUMU_AJIRI_WAFANYAKAZI
        | JUKUMU_FUKUZA_WAFANYAKAZI | JUKUMU_TANDAO | JUKUMU_JIUZULU
        | JUKUMU_TAZAMA_HABARI | JUKUMU_TAZAMA_UCHUMI | JUKUMU_TAZAMA_UTAWALA;
    r->skrini_0 = JUKUMU_SKRINI_DASHIBODI; r->skrini_1 = JUKUMU_SKRINI_BAJETI;
    r->skrini_2 = JUKUMU_SKRINI_SERA; r->skrini_3 = JUKUMU_SKRINI_WAFANYAKAZI;
    r->skrini_4 = JUKUMU_SKRINI_RIPOTI; r->skrini_5 = JUKUMU_SKRINI_HABARI;
    r->skrini_6 = JUKUMU_SKRINI_HAKUNA; r->skrini_7 = JUKUMU_SKRINI_HAKUNA;
    r->skrini_8 = JUKUMU_SKRINI_HAKUNA; r->skrini_9 = JUKUMU_SKRINI_HAKUNA;
    r->skrini_10 = JUKUMU_SKRINI_HAKUNA; r->skrini_11 = JUKUMU_SKRINI_HAKUNA;
    r->idadi_ya_skrini = 6;
    r->cheo_cha_bosi = "Mkuu wa Serikali";
    r->idara = "Wizara ya Uchumi";
    r->ngazi_ya_uongozi = 2;
    rudisha r;
}

