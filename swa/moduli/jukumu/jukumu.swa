JukumuAinisho* jukumu_mkuu_wa_nchi() {
    JukumuAinisho* r = tenga(ukubwa(JukumuAinisho));
    r->jina = "Mkuu wa Nchi";
    r->wigo = "Mamlaka kuu ya utendaji";
    r->matendo_yanayoruhusiwa = JUKUMU_TAZAMA_DASHIBODI | JUKUMU_GAWA_BAJETI
        | JUKUMU_PENDEKEZA_SERA | JUKUMU_AJIRI_WAFANYAKAZI | JUKUMU_FUKUZA_WAFANYAKAZI
        | JUKUMU_PELEKA_JESHI | JUKUMU_JADILIANA_MKATABA | JUKUMU_TANGAZA_VITA
        | JUKUMU_PITISHA_SHERIA | JUKUMU_TEUA_AFISA | JUKUMU_ONDOA_MADARAKANI
        | JUKUMU_JIUZULU | JUKUMU_TAZAMA_UJASUSI | JUKUMU_TAZAMA_HABARI
        | JUKUMU_TAZAMA_UCHUMI | JUKUMU_TAZAMA_JESHI | JUKUMU_TAZAMA_UTAWALA
        | JUKUMU_TANDAO;
    r->skrini_0 = JUKUMU_SKRINI_DASHIBODI; r->skrini_1 = JUKUMU_SKRINI_UCHUMI;
    r->skrini_2 = JUKUMU_SKRINI_JESHI; r->skrini_3 = JUKUMU_SKRINI_DIPLOMASIA;
    r->skrini_4 = JUKUMU_SKRINI_UTAWALA; r->skrini_5 = JUKUMU_SKRINI_UJASUSI;
    r->skrini_6 = JUKUMU_SKRINI_WAFANYAKAZI; r->skrini_7 = JUKUMU_SKRINI_HABARI;
    r->skrini_8 = JUKUMU_SKRINI_HAKUNA; r->skrini_9 = JUKUMU_SKRINI_HAKUNA;
    r->skrini_10 = JUKUMU_SKRINI_HAKUNA; r->skrini_11 = JUKUMU_SKRINI_HAKUNA;
    r->idadi_ya_skrini = 8;
    r->cheo_cha_bosi = "";
    r->idara = "Ofisi ya Utendaji";
    r->ngazi_ya_uongozi = 0;
    rudisha r;
}

W0 jukumu_anzisha(JukumuLaMchezaji* r) {
    r->jina_la_jukumu = "";
    r->taifa_id = "";
    r->jina_la_bosi = "";
    r->jina_la_chama = "";
    r->imani_ya_bosi = 0.0;
    r->uwiano_na_chama = 0.0;
    r->kibali_cha_umma = 0.0;
    r->matendo_yanayoruhusiwa = 0;
    r->skrini_0 = JUKUMU_SKRINI_HAKUNA; r->skrini_1 = JUKUMU_SKRINI_HAKUNA;
    r->skrini_2 = JUKUMU_SKRINI_HAKUNA; r->skrini_3 = JUKUMU_SKRINI_HAKUNA;
    r->skrini_4 = JUKUMU_SKRINI_HAKUNA; r->skrini_5 = JUKUMU_SKRINI_HAKUNA;
    r->skrini_6 = JUKUMU_SKRINI_HAKUNA; r->skrini_7 = JUKUMU_SKRINI_HAKUNA;
    r->skrini_8 = JUKUMU_SKRINI_HAKUNA; r->skrini_9 = JUKUMU_SKRINI_HAKUNA;
    r->skrini_10 = JUKUMU_SKRINI_HAKUNA; r->skrini_11 = JUKUMU_SKRINI_HAKUNA;
    r->idadi_ya_skrini = 0;
    r->ni_jukumu_la_serikali = 0;
}

W0 jukumu_weka(JukumuLaMchezaji* r, JukumuAinisho* ainisho, N8* taifa_id) {
    kama (r == 0 || ainisho == 0) { rudisha; }
    r->jina_la_jukumu = ainisho->jina;
    r->taifa_id = taifa_id;
    r->matendo_yanayoruhusiwa = ainisho->matendo_yanayoruhusiwa;
    r->idadi_ya_skrini = ainisho->idadi_ya_skrini;
    r->skrini_0 = ainisho->skrini_0; r->skrini_1 = ainisho->skrini_1;
    r->skrini_2 = ainisho->skrini_2; r->skrini_3 = ainisho->skrini_3;
    r->skrini_4 = ainisho->skrini_4; r->skrini_5 = ainisho->skrini_5;
    r->skrini_6 = ainisho->skrini_6; r->skrini_7 = ainisho->skrini_7;
    r->skrini_8 = ainisho->skrini_8; r->skrini_9 = ainisho->skrini_9;
    r->skrini_10 = ainisho->skrini_10; r->skrini_11 = ainisho->skrini_11;
    N32 ngazi = ainisho->ngazi_ya_uongozi;
    kama (ngazi < 10) { r->ni_jukumu_la_serikali = 1; } sivyo { r->ni_jukumu_la_serikali = 0; }
    r->imani_ya_bosi = 0.5;
    r->uwiano_na_chama = 0.5;
    r->kibali_cha_umma = 0.5;
}

W0 jukumu_weka_bosi(JukumuLaMchezaji* r, N8* jina, D64 imani_ya_awali) {
    kama (r == 0) { rudisha; }
    r->jina_la_bosi = jina;
    r->imani_ya_bosi = imani_ya_awali;
}

N32 jukumu_linaweza(JukumuLaMchezaji* r, N32 kitendo) {
    kama (r == 0) { rudisha 0; }
    N32 matokeo = r->matendo_yanayoruhusiwa & kitendo;
    kama (matokeo != 0) { rudisha 1; }
    rudisha 0;
}
