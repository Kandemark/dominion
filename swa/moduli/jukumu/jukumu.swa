    JukumuAinisho* r = tenga(ukubwa(JukumuAinisho));
    r->jina = "Balozi";
    r->wigo = "Uhusiano wa kigeni na majadiliano ya mikataba";
    r->matendo_yanayoruhusiwa = JUKUMU_TAZAMA_DASHIBODI | JUKUMU_JADILIANA_MKATABA
        | JUKUMU_TANDAO | JUKUMU_JIUZULU | JUKUMU_TAZAMA_HABARI
        | JUKUMU_TAZAMA_DIPLOMASIA | JUKUMU_PENDEKEZA_SERA;
    r->skrini_0 = JUKUMU_SKRINI_DASHIBODI; r->skrini_1 = JUKUMU_SKRINI_DIPLOMASIA;
    r->skrini_2 = JUKUMU_SKRINI_RIPOTI; r->skrini_3 = JUKUMU_SKRINI_TANDAO;
    r->skrini_4 = JUKUMU_SKRINI_HABARI; r->skrini_5 = JUKUMU_SKRINI_HAKUNA;
    r->skrini_6 = JUKUMU_SKRINI_HAKUNA; r->skrini_7 = JUKUMU_SKRINI_HAKUNA;
    r->skrini_8 = JUKUMU_SKRINI_HAKUNA; r->skrini_9 = JUKUMU_SKRINI_HAKUNA;
    r->skrini_10 = JUKUMU_SKRINI_HAKUNA; r->skrini_11 = JUKUMU_SKRINI_HAKUNA;
