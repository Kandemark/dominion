// msingi.swa (ndani ya moduli/akili/) — tafsiri ya src/core/ai/base_ai.c
// (na .h) kwenda Swa. Wakala wa msingi wa akili bandia — utu, kufikiri,
// na maamuzi.
//
// Kiambishi: akili_msingi_ (angalia ../../KANUNI-MAJINA.md — ai/ ina
// viambishi vidogo kadhaa: akili_msingi_, akili_mfumo_, akili_mbinu_,
// akili_mkakati_, kuepuka mgongano wa majina kati ya faili nne).
// timestamp/creation_time/last_think (time_t) HAVIKULETWA -- si
// muhimu kwa mantiki ya uigaji.

husisha { msingi/msingi_civ.swa }
husisha { msingi/maktaba/mfuatano.swa }

muundo AkiliUtu {
    d64 ukali;
    d64 upanuzi;
    d64 diplomasia;
    d64 lengo_la_utafiti;
    d64 lengo_la_uchumi;
};

muundo AkiliUamuzi {
    n8* aina_ya_kitendo;
    n8* lengo;
    d64 kipaumbele;
    d64 uhakika;
};

muundo AkiliMsingi {
    n8* kitambulisho;
    n8* jina;
    AkiliUtu utu;
    n64* maamuzi;
    n32 idadi_ya_maamuzi;
    n32 uwezo_wa_maamuzi;
    d64 akili_kiwango;
    d64 uwezo_wa_kubadilika;
};

AkiliMsingi* akili_msingi_unda(n8* kitambulisho, n8* jina) {
    kama (kitambulisho == 0 || jina == 0) { rudisha 0; }

    AkiliMsingi* ai = tenga(ukubwa(AkiliMsingi));
    ai->kitambulisho = kitambulisho;
    ai->jina = jina;

    ai->utu.ukali = 0.5;
    ai->utu.upanuzi = 0.5;
    ai->utu.diplomasia = 0.5;
    ai->utu.lengo_la_utafiti = 0.5;
    ai->utu.lengo_la_uchumi = 0.5;

    ai->akili_kiwango = 0.5;
    ai->uwezo_wa_kubadilika = 0.5;
    ai->uwezo_wa_maamuzi = 32;
    ai->idadi_ya_maamuzi = 0;
    ai->maamuzi = tenga(ukubwa(n64) * ai->uwezo_wa_maamuzi);

    rudisha ai;
}

w0 akili_msingi_uharibu(AkiliMsingi* ai) {
    achilia ai->maamuzi;
    achilia ai;
}

AkiliUamuzi* akili_msingi_pata_uamuzi(AkiliMsingi* ai, n32 idx) {
    rudisha ai->maamuzi[idx];
}

CivMatokeo akili_msingi_fikiri(AkiliMsingi* ai, d64 muda) {
    CivMatokeo r;
    r.hitilafu = CIV_SAWA;
    r.ujumbe = 0;

    kama (ai == 0) {
        r.hitilafu = CIV_HITILAFU_KIELEKEZI_TUPU;
        rudisha r;
    }

    ai->idadi_ya_maamuzi = 0;
    rudisha r;
}

CivMatokeo akili_msingi_amua(AkiliMsingi* ai, n8* aina_ya_kitendo, n8* lengo, d64 kipaumbele) {
    CivMatokeo r;
    r.hitilafu = CIV_SAWA;
    r.ujumbe = 0;

    kama (ai == 0 || aina_ya_kitendo == 0) {
        r.hitilafu = CIV_HITILAFU_KIELEKEZI_TUPU;
        rudisha r;
    }

    d64 kipaumbele_kilichofinywa = finya_d64(kipaumbele, 0.0, 1.0);

    kama (ai->idadi_ya_maamuzi >= ai->uwezo_wa_maamuzi) {
        ai->uwezo_wa_maamuzi = ai->uwezo_wa_maamuzi * 2;
        ai->maamuzi = badili(ai->maamuzi, ukubwa(n64) * ai->uwezo_wa_maamuzi);
    }

    AkiliUamuzi* uamuzi = tenga(ukubwa(AkiliUamuzi));
    uamuzi->aina_ya_kitendo = aina_ya_kitendo;
    uamuzi->lengo = lengo;
    uamuzi->kipaumbele = kipaumbele_kilichofinywa;
    uamuzi->uhakika = ai->akili_kiwango;

    ai->maamuzi[ai->idadi_ya_maamuzi] = uamuzi;
    ai->idadi_ya_maamuzi = ai->idadi_ya_maamuzi + 1;

    rudisha r;
}

AkiliUamuzi* akili_msingi_uamuzi_bora(AkiliMsingi* ai) {
    kama (ai == 0 || ai->idadi_ya_maamuzi == 0) { rudisha 0; }

    AkiliUamuzi* bora = akili_msingi_pata_uamuzi(ai, 0);
    n32 i = 1;
    wakati (i < ai->idadi_ya_maamuzi) {
        AkiliUamuzi* huyu = akili_msingi_pata_uamuzi(ai, i);
        kama (huyu->kipaumbele > bora->kipaumbele) { bora = huyu; }
        i = i + 1;
    }

    rudisha bora;
}

w0 akili_msingi_weka_utu(AkiliMsingi* ai, AkiliUtu* utu) {
    kama (ai == 0 || utu == 0) { rudisha; }
    ai->utu.ukali = utu->ukali;
    ai->utu.upanuzi = utu->upanuzi;
    ai->utu.diplomasia = utu->diplomasia;
    ai->utu.lengo_la_utafiti = utu->lengo_la_utafiti;
    ai->utu.lengo_la_uchumi = utu->lengo_la_uchumi;
}
