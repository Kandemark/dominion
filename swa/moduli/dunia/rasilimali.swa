// rasilimali.swa — tafsiri ya src/core/world/resource_map.c (na .h)
// kwenda Swa. Uwepo wa rasilimali kwa kila kipande cha ramani —
// aina 20 za madini, nishati, na malighafi.
//
// Kiambishi: dunia_rasilimali_ — angalia ../../KANUNI-MAJINA.md.
//
// Tofauti za kimakusudi kutoka kwa chanzo cha C:
//   - civ_resource_map_load() SASA IMELETWA kama
//     dunia_rasilimali_pakia (angalia chini), ikitumia
//     msingi/maktaba/bin_soma.swa. dunia_rasilimali_ongeza_amana()
//     bado inapatikana kwa kuongeza amana moja moja kwa mkono.
//   - deposits[CIV_RESOURCE_COUNT] (safu ya vielekezi 20, kila
//     kimoja kikielekeza safu ya ndani inayokua ya amana) imekuwa
//     SAFU MOJA TU BAPA (flat) ya amana zote, kila moja ikiwa na
//     nyanja ya "aina" -- rahisi zaidi kuliko safu 20 tofauti
//     zinazokua, na ina tabia ileile ya utafutaji (linear scan
//     iliyochujwa kwa aina+eneo, sawa na C asili). Safu bapa
//     inatumia mtindo wa n64* wa vielekezi (#185, angalia dini.swa).
//   - deposit_count[CIV_RESOURCE_COUNT] halihitajiki tena (safu bapa
//     ina "idadi" moja tu ya jumla).
//   - civ_resource_type_name() imekuwa mnyororo wa kama/sivyo
//     unaorudisha herufi, si safu ya vielekezi vya mfuatano (safu ya
//     n8* kama field ya muundo ingekuwa na hatari ileile ya #185/
//     #186 -- kazi ya moja kwa moja inaepuka kabisa).

husisha { msingi/msingi_civ.swa }
husisha { msingi/maktaba/faili.swa }
husisha { msingi/maktaba/bin_soma.swa }

n32 DUNIA_RASILIMALI_MAFUTA = 0;
n32 DUNIA_RASILIMALI_GESI_ASILIA = 1;
n32 DUNIA_RASILIMALI_MAKAA = 2;
n32 DUNIA_RASILIMALI_CHUMA = 3;
n32 DUNIA_RASILIMALI_SHABA = 4;
n32 DUNIA_RASILIMALI_BAUXITE = 5;
n32 DUNIA_RASILIMALI_DHAHABU = 6;
n32 DUNIA_RASILIMALI_FEDHA = 7;
n32 DUNIA_RASILIMALI_URANIUM = 8;
n32 DUNIA_RASILIMALI_ALMASI = 9;
n32 DUNIA_RASILIMALI_PHOSPHATI = 10;
n32 DUNIA_RASILIMALI_ARDHI_ADIMU = 11;
n32 DUNIA_RASILIMALI_LITHIUM = 12;
n32 DUNIA_RASILIMALI_COBALT = 13;
n32 DUNIA_RASILIMALI_BATI = 14;
n32 DUNIA_RASILIMALI_ZINC = 15;
n32 DUNIA_RASILIMALI_RISASI = 16;
n32 DUNIA_RASILIMALI_NIKELI = 17;
n32 DUNIA_RASILIMALI_CHROMITE = 18;
n32 DUNIA_RASILIMALI_MANGANESE = 19;
n32 DUNIA_RASILIMALI_IDADI_YA_AINA = 20;

muundo DuniaRasilimaliAmana {
    n32 x;
    n32 y;
    n32 aina;
    n32 kiasi;
    n32 ubora;
};

muundo DuniaRasilimaliRamani {
    n64* amana;
    n32 idadi;
    n32 uwezo;
    n32 upana;
    n32 urefu;
};

DuniaRasilimaliAmana* dunia_rasilimali_pata_amana(DuniaRasilimaliRamani* rm, n32 faharisi) {
    rudisha rm->amana[faharisi];
}

DuniaRasilimaliRamani* dunia_rasilimali_ramani_unda(n32 upana, n32 urefu) {
    DuniaRasilimaliRamani* rm = tenga(ukubwa(DuniaRasilimaliRamani));
    rm->upana = upana;
    rm->urefu = urefu;
    rm->idadi = 0;
    rm->uwezo = 64;
    rm->amana = tenga(ukubwa(n64) * rm->uwezo);
    rudisha rm;
}

w0 dunia_rasilimali_ramani_uharibu(DuniaRasilimaliRamani* rm) {
    achilia rm->amana;
    achilia rm;
}

w0 dunia_rasilimali_ongeza_amana(DuniaRasilimaliRamani* rm, n32 x, n32 y, n32 aina,
                                   n32 kiasi, n32 ubora) {
    kama (rm->idadi >= rm->uwezo) {
        rm->uwezo = rm->uwezo * 2;
        rm->amana = badili(rm->amana, ukubwa(n64) * rm->uwezo);
    }
    DuniaRasilimaliAmana* a = tenga(ukubwa(DuniaRasilimaliAmana));
    a->x = x;
    a->y = y;
    a->aina = aina;
    a->kiasi = kiasi;
    a->ubora = ubora;
    rm->amana[rm->idadi] = a;
    rm->idadi = rm->idadi + 1;
}

DuniaRasilimaliAmana* dunia_rasilimali_tafuta_kipande(DuniaRasilimaliRamani* rm, n32 x, n32 y, n32 aina) {
    kama (rm == 0 || x < 0 || y < 0 || x >= rm->upana || y >= rm->urefu) { rudisha 0; }
    n32 i = 0;
    wakati (i < rm->idadi) {
        DuniaRasilimaliAmana* a = dunia_rasilimali_pata_amana(rm, i);
        kama (a->x == x && a->y == y && a->aina == aina) { rudisha a; }
        i = i + 1;
    }
    rudisha 0;
}

n32 dunia_rasilimali_ina_aina(DuniaRasilimaliRamani* rm, n32 x, n32 y, n32 aina) {
    kama (dunia_rasilimali_tafuta_kipande(rm, x, y, aina) != 0) { rudisha 1; }
    rudisha 0;
}

n32 dunia_rasilimali_pata_kiasi(DuniaRasilimaliRamani* rm, n32 x, n32 y, n32 aina) {
    DuniaRasilimaliAmana* a = dunia_rasilimali_tafuta_kipande(rm, x, y, aina);
    kama (a == 0) { rudisha 0; }
    rudisha a->kiasi;
}

n32 dunia_rasilimali_pata_ubora(DuniaRasilimaliRamani* rm, n32 x, n32 y, n32 aina) {
    DuniaRasilimaliAmana* a = dunia_rasilimali_tafuta_kipande(rm, x, y, aina);
    kama (a == 0) { rudisha 0; }
    rudisha a->ubora;
}

n32 dunia_rasilimali_jumla_kwenye_kipande(DuniaRasilimaliRamani* rm, n32 x, n32 y) {
    kama (rm == 0) { rudisha 0; }
    n32 jumla = 0;
    n32 i = 0;
    wakati (i < rm->idadi) {
        DuniaRasilimaliAmana* a = dunia_rasilimali_pata_amana(rm, i);
        kama (a->x == x && a->y == y) { jumla = jumla + a->kiasi; }
        i = i + 1;
    }
    rudisha jumla;
}

n32 dunia_rasilimali_idadi_ya_aina_kwenye_kipande(DuniaRasilimaliRamani* rm, n32 x, n32 y) {
    kama (rm == 0) { rudisha 0; }
    n32 aina = 0;
    n32 idadi = 0;
    wakati (aina < DUNIA_RASILIMALI_IDADI_YA_AINA) {
        kama (dunia_rasilimali_ina_aina(rm, x, y, aina) != 0) { idadi = idadi + 1; }
        aina = aina + 1;
    }
    rudisha idadi;
}

n8* dunia_rasilimali_jina_la_aina(n32 aina) {
    kama (aina == DUNIA_RASILIMALI_MAFUTA) { rudisha "Mafuta"; }
    kama (aina == DUNIA_RASILIMALI_GESI_ASILIA) { rudisha "Gesi Asilia"; }
    kama (aina == DUNIA_RASILIMALI_MAKAA) { rudisha "Makaa"; }
    kama (aina == DUNIA_RASILIMALI_CHUMA) { rudisha "Chuma"; }
    kama (aina == DUNIA_RASILIMALI_SHABA) { rudisha "Shaba"; }
    kama (aina == DUNIA_RASILIMALI_BAUXITE) { rudisha "Bauxite"; }
    kama (aina == DUNIA_RASILIMALI_DHAHABU) { rudisha "Dhahabu"; }
    kama (aina == DUNIA_RASILIMALI_FEDHA) { rudisha "Fedha"; }
    kama (aina == DUNIA_RASILIMALI_URANIUM) { rudisha "Uranium"; }
    kama (aina == DUNIA_RASILIMALI_ALMASI) { rudisha "Almasi"; }
    kama (aina == DUNIA_RASILIMALI_PHOSPHATI) { rudisha "Phosphati"; }
    kama (aina == DUNIA_RASILIMALI_ARDHI_ADIMU) { rudisha "Ardhi Adimu"; }
    kama (aina == DUNIA_RASILIMALI_LITHIUM) { rudisha "Lithium"; }
    kama (aina == DUNIA_RASILIMALI_COBALT) { rudisha "Cobalt"; }
    kama (aina == DUNIA_RASILIMALI_BATI) { rudisha "Bati"; }
    kama (aina == DUNIA_RASILIMALI_ZINC) { rudisha "Zinc"; }
    kama (aina == DUNIA_RASILIMALI_RISASI) { rudisha "Risasi"; }
    kama (aina == DUNIA_RASILIMALI_NIKELI) { rudisha "Nikeli"; }
    kama (aina == DUNIA_RASILIMALI_CHROMITE) { rudisha "Chromite"; }
    kama (aina == DUNIA_RASILIMALI_MANGANESE) { rudisha "Manganese"; }
    rudisha "Haijulikani";
}

// RESOURCE_MAGIC ("RSOR" endian ndogo) = 0x52534F52
n32 DUNIA_RASILIMALI_MAGIC = 1381191506;

// dunia_rasilimali_pakia: soma data/resources.bin halisi. Muundo wa
// faili (endian ndogo): magic(u32) version(u32) upana(u32) urefu(u32)
// idadi_ya_aina(u32) kisha kwa kila aina: idadi(u16), kisha kwa kila
// amana: x(u16) y(u16) kiasi(u16) ubora(u8).
CivMatokeo dunia_rasilimali_pakia(DuniaRasilimaliRamani* rm, n8* njia) {
    CivMatokeo r;
    r.hitilafu = CIV_SAWA;
    r.ujumbe = 0;

    // Bafa dogo kimakusudi -- angalia lugha-swa/swa#190 (tenga() ina
    // kikomo cha JUMLA cha baiti milioni 1 kwa maisha yote ya
    // programu, si kwa mgao mmoja).
    n32 uwezo_bafa = 65536;
    n8* buf = tenga(uwezo_bafa);
    n64 urefu64 = faili_soma_yote(njia, buf, uwezo_bafa);
    kama (urefu64 < 20) {
        r.hitilafu = CIV_HITILAFU_HAIJAPATIKANA;
        r.ujumbe = "faili halifunguki au ni fupi mno";
        rudisha r;
    }

    n32 magic = civ_bin_u32le(buf, 0);
    kama (magic != DUNIA_RASILIMALI_MAGIC) {
        r.hitilafu = CIV_HITILAFU_HOJA_MBAYA;
        r.ujumbe = "magic si sahihi";
        rudisha r;
    }
    n32 idadi_ya_aina = civ_bin_u32le(buf, 16);
    kama (idadi_ya_aina > DUNIA_RASILIMALI_IDADI_YA_AINA) {
        r.hitilafu = CIV_HITILAFU_HOJA_MBAYA;
        r.ujumbe = "aina nyingi mno za rasilimali";
        rudisha r;
    }

    n32 off = 20;
    n32 t = 0;
    wakati (t < idadi_ya_aina) {
        n32 idadi = civ_bin_u16le(buf, off);
        off = off + 2;

        n32 i = 0;
        wakati (i < idadi) {
            n32 x = civ_bin_u16le(buf, off);
            off = off + 2;
            n32 y = civ_bin_u16le(buf, off);
            off = off + 2;
            n32 kiasi = civ_bin_u16le(buf, off);
            off = off + 2;
            n32 ubora = civ_bin_u8(buf, off);
            off = off + 1;

            dunia_rasilimali_ongeza_amana(rm, x, y, t, kiasi, ubora);
            i = i + 1;
        }
        t = t + 1;
    }

    achilia buf;
    r.ujumbe = "rasilimali zimepakiwa";
    rudisha r;
}
