// benki.swa — tafsiri ya src/core/economy/banking.c (na .h) kwenda
// Swa. Benki kuu — mahitaji ya akiba, mikopo, viwango vya riba, na
// mikopo.
//
// Kiambishi: benki_ — angalia ../../KANUNI-MAJINA.md.
// loans[] (safu inayokua ya C) imekuwa BENKI_MKOPO_IDADI=32 vigezo
// vyenye majina + kazi ya kupata. id (jina la mkopo, lililoundwa kwa
// snprintf "LOAN_%d") limekuwa nambari ya kiwakilishi (N32) badala ya
// mfuatano, kwa kuwa hakuna umbizo la mfuatano+nambari (snprintf)
// linalopatikana kwa urahisi. pow() (kwa malipo ya kila mwezi
// yaliyorekebishwa) imetekelezwa kama kazi ya ndani ya kipeo cha
// nambari kamili (hakuna D64 pow, angalia lugha-swa/swa#183).

husisha { msingi/msingi_civ.swa }

N32 BENKI_HATARI_CHINI = 0;
N32 BENKI_HATARI_WASTANI = 1;
N32 BENKI_HATARI_JUU = 2;
N32 BENKI_HATARI_MBAYA = 3;
N32 BENKI_MKOPO_IDADI = 32;

muundo BenkiMkopo {
    N32 nambari_ya_mkopo;
    N8* mkopaji;
    D64 kiasi_asili;
    D64 kilichobaki;
    D64 kiwango_cha_riba;
    D64 malipo_ya_mwezi;
    N32 miezi_ya_muda;
    N32 miezi_iliyobaki;
    N32 hatari;
    N32 inafanya_vizuri;
};

muundo BenkiMfumo {
    BenkiMkopo m_0; BenkiMkopo m_1; BenkiMkopo m_2; BenkiMkopo m_3;
    BenkiMkopo m_4; BenkiMkopo m_5; BenkiMkopo m_6; BenkiMkopo m_7;
    BenkiMkopo m_8; BenkiMkopo m_9; BenkiMkopo m_10; BenkiMkopo m_11;
    BenkiMkopo m_12; BenkiMkopo m_13; BenkiMkopo m_14; BenkiMkopo m_15;
    BenkiMkopo m_16; BenkiMkopo m_17; BenkiMkopo m_18; BenkiMkopo m_19;
    BenkiMkopo m_20; BenkiMkopo m_21; BenkiMkopo m_22; BenkiMkopo m_23;
    BenkiMkopo m_24; BenkiMkopo m_25; BenkiMkopo m_26; BenkiMkopo m_27;
    BenkiMkopo m_28; BenkiMkopo m_29; BenkiMkopo m_30; BenkiMkopo m_31;

    D64 uwiano_wa_akiba;
    D64 kiwango_cha_msingi_cha_riba;
    D64 ugavi_wa_fedha;
    D64 akiba_zilizohifadhiwa;
    D64 ujazo_wa_mikopo;
    D64 kiwango_cha_kutolipa;
    N32 idadi_ya_mikopo;
    D64 kizidishi_cha_mkopo;
};

BenkiMkopo* benki_pata_mkopo(BenkiMfumo* b, N32 idx) {
    kama (idx == 0) { rudisha &b->m_0; }
    kama (idx == 1) { rudisha &b->m_1; }
    kama (idx == 2) { rudisha &b->m_2; }
    kama (idx == 3) { rudisha &b->m_3; }
    kama (idx == 4) { rudisha &b->m_4; }
    kama (idx == 5) { rudisha &b->m_5; }
    kama (idx == 6) { rudisha &b->m_6; }
    kama (idx == 7) { rudisha &b->m_7; }
    kama (idx == 8) { rudisha &b->m_8; }
    kama (idx == 9) { rudisha &b->m_9; }
    kama (idx == 10) { rudisha &b->m_10; }
    kama (idx == 11) { rudisha &b->m_11; }
    kama (idx == 12) { rudisha &b->m_12; }
    kama (idx == 13) { rudisha &b->m_13; }
    kama (idx == 14) { rudisha &b->m_14; }
    kama (idx == 15) { rudisha &b->m_15; }
    kama (idx == 16) { rudisha &b->m_16; }
    kama (idx == 17) { rudisha &b->m_17; }
    kama (idx == 18) { rudisha &b->m_18; }
    kama (idx == 19) { rudisha &b->m_19; }
    kama (idx == 20) { rudisha &b->m_20; }
    kama (idx == 21) { rudisha &b->m_21; }
    kama (idx == 22) { rudisha &b->m_22; }
    kama (idx == 23) { rudisha &b->m_23; }
    kama (idx == 24) { rudisha &b->m_24; }
    kama (idx == 25) { rudisha &b->m_25; }
    kama (idx == 26) { rudisha &b->m_26; }
    kama (idx == 27) { rudisha &b->m_27; }
    kama (idx == 28) { rudisha &b->m_28; }
    kama (idx == 29) { rudisha &b->m_29; }
    kama (idx == 30) { rudisha &b->m_30; }
    rudisha &b->m_31;
}

D64 benki_kipeo_d64(D64 msingi, N32 kipeo) {
    D64 matokeo = 1.0;
    N32 i = 0;
    wakati (i < kipeo) {
        matokeo = matokeo * msingi;
        i = i + 1;
    }
    rudisha matokeo;
}

D64 benki_malipo_ya_awali(N32 hatari) {
    kama (hatari == BENKI_HATARI_CHINI) { rudisha 0.005; }
    kama (hatari == BENKI_HATARI_WASTANI) { rudisha 0.02; }
    kama (hatari == BENKI_HATARI_JUU) { rudisha 0.06; }
    rudisha 0.15;
}

D64 benki_kiwango_cha_mkopo(BenkiMfumo* b, N32 hatari) {
    rudisha b->kiwango_cha_msingi_cha_riba + benki_malipo_ya_awali(hatari);
}

D64 benki_kiwango_cha_akiba(BenkiMfumo* b) {
    rudisha b->kiwango_cha_msingi_cha_riba * 0.6;
}

D64 benki_kizidishi_cha_fedha(BenkiMfumo* b) {
    rudisha b->kizidishi_cha_mkopo;
}

BenkiMfumo* benki_unda() {
    BenkiMfumo* b = tenga(ukubwa(BenkiMfumo));
    b->uwiano_wa_akiba = 0.10;
    b->kiwango_cha_msingi_cha_riba = 0.04;
    b->ugavi_wa_fedha = 1000000.0;
    b->akiba_zilizohifadhiwa = b->ugavi_wa_fedha * b->uwiano_wa_akiba;
    b->kizidishi_cha_mkopo = 1.0 / (b->uwiano_wa_akiba + 0.001);
    b->ujazo_wa_mikopo = 0.0;
    b->kiwango_cha_kutolipa = 0.0;
    b->idadi_ya_mikopo = 0;
    rudisha b;
}

W0 benki_uharibu(BenkiMfumo* b) {
    achilia b;
}

W0 benki_lipa_mikopo(BenkiMfumo* b, D64 muda) {
    N32 i = 0;
    wakati (i < b->idadi_ya_mikopo) {
        BenkiMkopo* mkopo = benki_pata_mkopo(b, i);
        kama (mkopo->inafanya_vizuri != 0 && mkopo->kilichobaki > 0.0) {
            D64 nafasi_ya_kutolipa = 0.0;
            kama (mkopo->hatari == BENKI_HATARI_CHINI) { nafasi_ya_kutolipa = 0.002; }
            sivyo { kama (mkopo->hatari == BENKI_HATARI_WASTANI) { nafasi_ya_kutolipa = 0.01; }
            sivyo { kama (mkopo->hatari == BENKI_HATARI_JUU) { nafasi_ya_kutolipa = 0.03; }
            sivyo { nafasi_ya_kutolipa = 0.08; } } }
            nafasi_ya_kutolipa = nafasi_ya_kutolipa + b->kiwango_cha_kutolipa * 0.1;

            N32 kura = civ_nasibu_chini_ya(1000);
            D64 kura_d = kura;
            D64 uwezekano = kura_d / 1000.0;
            kama (uwezekano < nafasi_ya_kutolipa) {
                mkopo->inafanya_vizuri = 0;
                b->ujazo_wa_mikopo = b->ujazo_wa_mikopo - mkopo->kilichobaki;
            } sivyo {
                mkopo->kilichobaki = mkopo->kilichobaki - mkopo->malipo_ya_mwezi;
                mkopo->miezi_iliyobaki = mkopo->miezi_iliyobaki - 1;
                b->ujazo_wa_mikopo = b->ujazo_wa_mikopo - mkopo->malipo_ya_mwezi;
                kama (mkopo->kilichobaki <= 0.0 || mkopo->miezi_iliyobaki <= 0) {
                    mkopo->kilichobaki = 0.0;
                    mkopo->miezi_iliyobaki = 0;
                }
            }
        }
        i = i + 1;
    }
}

W0 benki_sasisha(BenkiMfumo* b, D64 muda, D64 kiwango_cha_mfumuko, D64 ukuaji_wa_pato,
                   D64 kiwango_cha_ukosefu_wa_kazi, D64 uwiano_wa_matumizi_ya_serikali) {
    D64 kiwango_lengwa = 0.04;

    kama (kiwango_cha_mfumuko > 0.06) {
        kiwango_lengwa = kiwango_lengwa + (kiwango_cha_mfumuko - 0.03) * 0.8;
    } sivyo { kama (kiwango_cha_mfumuko > 0.03) {
        kiwango_lengwa = kiwango_lengwa + (kiwango_cha_mfumuko - 0.03) * 0.4;
    } }

    kama (ukuaji_wa_pato < 0.0 && kiwango_cha_ukosefu_wa_kazi > 0.07) {
        kiwango_lengwa = kiwango_lengwa - 0.02;
    } sivyo { kama (ukuaji_wa_pato < 0.02) {
        kiwango_lengwa = kiwango_lengwa - 0.005;
    } }

    kiwango_lengwa = kiwango_lengwa + uwiano_wa_matumizi_ya_serikali * 0.01;

    b->kiwango_cha_msingi_cha_riba = b->kiwango_cha_msingi_cha_riba
        + (kiwango_lengwa - b->kiwango_cha_msingi_cha_riba) * 0.1;
    kama (b->kiwango_cha_msingi_cha_riba < 0.001) { b->kiwango_cha_msingi_cha_riba = 0.001; }
    kama (b->kiwango_cha_msingi_cha_riba > 0.35) { b->kiwango_cha_msingi_cha_riba = 0.35; }

    kama (kiwango_cha_mfumuko > 0.05) { b->uwiano_wa_akiba = b->uwiano_wa_akiba + 0.002; }
    sivyo { kama (kiwango_cha_mfumuko < 0.01) { b->uwiano_wa_akiba = b->uwiano_wa_akiba - 0.001; } }
    kama (b->uwiano_wa_akiba < 0.01) { b->uwiano_wa_akiba = 0.01; }
    kama (b->uwiano_wa_akiba > 0.25) { b->uwiano_wa_akiba = 0.25; }

    b->kizidishi_cha_mkopo = 1.0 / (b->uwiano_wa_akiba + 0.001);

    b->ugavi_wa_fedha = b->ugavi_wa_fedha
        * (1.0 + ukuaji_wa_pato * 0.5 - (b->kiwango_cha_msingi_cha_riba - 0.02) * 0.1);

    b->kiwango_cha_kutolipa = kiwango_cha_ukosefu_wa_kazi * 0.6;
    kama (b->kiwango_cha_kutolipa > 1.0) { b->kiwango_cha_kutolipa = 1.0; }

    benki_lipa_mikopo(b, muda);
}

BenkiMkopo* benki_toa_mkopo(BenkiMfumo* b, N8* mkopaji, D64 kiasi, N32 miezi_ya_muda) {
    kama (mkopaji == 0 || kiasi <= 0.0 || miezi_ya_muda <= 0) { rudisha 0; }
    kama (b->idadi_ya_mikopo >= BENKI_MKOPO_IDADI) { rudisha 0; }

    BenkiMkopo* mkopo = benki_pata_mkopo(b, b->idadi_ya_mikopo);
    mkopo->nambari_ya_mkopo = b->idadi_ya_mikopo;
    mkopo->mkopaji = mkopaji;
    mkopo->kiasi_asili = kiasi;
    mkopo->kilichobaki = kiasi;
    mkopo->miezi_ya_muda = miezi_ya_muda;
    mkopo->miezi_iliyobaki = miezi_ya_muda;
    mkopo->inafanya_vizuri = 1;

    D64 kizingiti_juu = b->ugavi_wa_fedha * 0.001;
    D64 kizingiti_wastani = b->ugavi_wa_fedha * 0.0001;
    kama (kiasi > kizingiti_juu) { mkopo->hatari = BENKI_HATARI_JUU; }
    sivyo { kama (kiasi > kizingiti_wastani) { mkopo->hatari = BENKI_HATARI_WASTANI; }
    sivyo { mkopo->hatari = BENKI_HATARI_CHINI; } }

    mkopo->kiwango_cha_riba = benki_kiwango_cha_mkopo(b, mkopo->hatari);

    N32 miezi_d = miezi_ya_muda;
    D64 miezi_dd = miezi_d;
    kama (mkopo->kiwango_cha_riba > 0.0) {
        D64 kiwango_cha_mwezi = mkopo->kiwango_cha_riba / 12.0;
        D64 msingi = 1.0 + kiwango_cha_mwezi;
        D64 juu = benki_kipeo_d64(msingi, miezi_ya_muda);
        D64 dhehebu = 1.0 - (1.0 / juu);
        kama (dhehebu > 0.0) {
            mkopo->malipo_ya_mwezi = kiasi * kiwango_cha_mwezi / dhehebu;
        } sivyo {
            mkopo->malipo_ya_mwezi = kiasi / miezi_dd;
        }
    } sivyo {
        mkopo->malipo_ya_mwezi = kiasi / miezi_dd;
    }

    b->ujazo_wa_mikopo = b->ujazo_wa_mikopo + kiasi;
    b->idadi_ya_mikopo = b->idadi_ya_mikopo + 1;
    rudisha mkopo;
}

D64 benki_mkopo_unaopatikana(BenkiMfumo* b) {
    D64 mkopo_wa_juu = b->akiba_zilizohifadhiwa * b->kizidishi_cha_mkopo;
    D64 unaopatikana = mkopo_wa_juu - b->ujazo_wa_mikopo;
    kama (unaopatikana > 0.0) { rudisha unaopatikana; }
    rudisha 0.0;
}
