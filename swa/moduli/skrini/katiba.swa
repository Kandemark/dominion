husisha { moduli/skrini/mkutano.swa }
husisha { moduli/siasa/hati.swa }

// katiba.swa (skrini) -- katiba ya taifa kama hati inayosomeka, mihimili ya
// dola (utendaji, bunge, mahakama, majeshi, mikoa) na meza ya marekebisho.
//
// Hati huchorwa kama ukurasa: kichwa kwa serif, kila ibara na kichwa chake na
// aya zake; gurudumu husogeza hati. Marekebisho hufuata utaratibu wa katiba:
// amri, theluthi mbili za bunge (na kura ya maoni kwenye jamhuri), mkutano wa
// chama, kura ya maoni, au baraza la machifu.

n64 KB_PUNGUZA = 100;
n64 KB_ONGEZA = 101;
n64 KB_PENDEKEZA = 102;

n64 skrini_katiba_tembea = 0;   // pikseli zilizosogezwa juu
n64* skrini_katiba_pendekezo = 0;
n8 skrini_katiba_ujumbe[240];

// Aya inayofungwa kwa maneno, ikichorwa tu ndani ya [juu, chini).
n64 skrini_katiba_aya(n8* s, Fonti* f, n64 px, n64 x, n64 y, n64 w, n64 juu, n64 chini) {
    n8 mstari[512];
    n64 n = 0;
    n64 i = 0;
    n64 mwisho_wa_neno = 0;
    n64 chanzo_cha_neno = 0;
    n64 kimo = px + 9;
    wakati (s[i] != 0) {
        n64 c = s[i];
        mstari[n] = c;
        n = n + 1;
        mstari[n] = 0;
        i = i + 1;
        kama (c == 32) { mwisho_wa_neno = n; chanzo_cha_neno = i; }
        kama (n >= 500 || maandishi_upana(f, mstari, px) > w) {
            kama (mwisho_wa_neno > 0) { n = mwisho_wa_neno; i = chanzo_cha_neno; }
            mstari[n] = 0;
            kama (y >= juu && y + kimo <= chini) { maandishi_chora(sura_t, f, mstari, x, y, px); }
            y = y + kimo;
            n = 0;
            mstari[0] = 0;
            mwisho_wa_neno = 0;
        }
    }
    kama (n > 0) {
        kama (y >= juu && y + kimo <= chini) { maandishi_chora(sura_t, f, mstari, x, y, px); }
        y = y + kimo;
    }
    rudisha y;
}

w0 skrini_katiba_hati(Dola* d, n8* taifa, n64 x, n64 y, n64 w, n64 h) {
    // karatasi: paneli angavu kidogo yenye ukingo
    turubai_brashi(sura_t, SURA_PANELI_JUU, 255);
    turubai_mviringo(sura_t, x, y, w, h, 8);
    turubai_brashi(sura_t, 16777215, 30);
    turubai_mpaka(sura_t, x, y, w, h, 8);
    n64 kando = 56;
    n64 xs = x + kando;
    n64 ws = w - 2 * kando;
    n64 juu = y + 12;
    n64 chini = y + h - 12;
    n64 yy = y + 40 - skrini_katiba_tembea;
    n8 kichwa[160];
    n8 kubwa[160];
    mfuatano_umbiza(kichwa, 160, ui("The Constitution of %s"), taifa, 0, 0, 0, 0, 0);
    skrini_herufi_kubwa(kubwa, 160, kichwa);
    n64 wk = maandishi_upana(sura_nene, kubwa, 22);
    kama (yy >= juu && yy + 30 <= chini) {
        turubai_brashi(sura_t, SURA_MAANDISHI, 255);
        maandishi_chora(sura_t, sura_nene, kubwa, x + (w - wk) / 2, yy, 22);
    }
    yy = yy + 36;
    n8 m[160];
    mfuatano_umbiza(m, 160, "%s  ·  %s", ui(dola_aina_jina(d->aina)), utaratibu_jina(hati_utaratibu(d)), 0, 0, 0, 0);
    n64 wm = maandishi_upana(sura_serif, m, 14);
    kama (yy >= juu && yy + 20 <= chini) {
        turubai_brashi(sura_t, SURA_HAFIFU, 255);
        maandishi_chora(sura_t, sura_serif, m, x + (w - wm) / 2, yy, 14);
    }
    yy = yy + 30;
    kama (yy >= juu && yy <= chini) {
        turubai_brashi(sura_t, SURA_LAFUDHI, 255);
        turubai_jaza(sura_t, x + w / 2 - 40, yy, 80, 2);
    }
    yy = yy + 24;
    n64 i = 0;
    wakati (i < hati_ibara_idadi) {
        Ibara* b = hati_ibara_pata(i);
        turubai_brashi(sura_t, SURA_LAFUDHI, 255);
        kama (yy >= juu && yy + 24 <= chini) { maandishi_chora(sura_t, sura_nene, b->kichwa, xs, yy, 15); }
        yy = yy + 26;
        turubai_brashi(sura_t, SURA_MAANDISHI, 255);
        kama (i == 0) { yy = skrini_katiba_aya(b->maandishi, sura_serif, 15, xs, yy, ws, juu, chini); }
        sivyo { yy = skrini_katiba_aya(b->maandishi, sura_kawaida, 14, xs, yy, ws, juu, chini); }
        yy = yy + 18;
        i = i + 1;
    }
    // urefu wa hati: zuia kusogeza kupita mwisho
    n64 urefu = yy + skrini_katiba_tembea - y;
    kama (skrini_katiba_tembea > urefu - h + 40) { skrini_katiba_tembea = urefu - h + 40; }
    kama (skrini_katiba_tembea < 0) { skrini_katiba_tembea = 0; }
    kama (urefu > h) {
        // kiashiria cha kusogeza
        n64 kh = (h * h) / urefu;
        n64 ky = y + (skrini_katiba_tembea * h) / urefu;
        turubai_brashi(sura_t, 16777215, 40);
        turubai_mviringo(sura_t, x + w - 8, ky + 4, 4, kh - 8, 2);
    }
}

// Mhimili mmoja wa dola: kisanduku chenye jina, idadi ya vyeo na mkuu wake.
w0 skrini_katiba_mhimili(n8* jina, n8* mkuu, n64 idadi, n64 rangi, n64 x, n64 y, n64 w) {
    turubai_brashi(sura_t, SURA_PANELI_JUU, 255);
    turubai_mviringo(sura_t, x, y, w, 64, 8);
    turubai_brashi(sura_t, rangi, 255);
    turubai_mviringo(sura_t, x, y + 8, 3, 48, 1);
    sura_rangi(SURA_MAANDISHI);
    turubai_kata(sura_t, x, y, w - 6, 64);
    sura_lebo_kati(jina, x + 12, y + 8, 12);
    sura_rangi(SURA_HAFIFU);
    sura_lebo(mkuu, x + 12, y + 26, 11);
    n8 m[32];
    sura_namba(m, idadi);
    sura_rangi(rangi);
    sura_lebo_nene(m, x + 12, y + 42, 13);
    turubai_kata_yote(sura_t);
}

n64 skrini_katiba_idadi_ya_tawi(Wahusika* w, n64 tawi) {
    n64 n = 0;
    n64 i = 0;
    wakati (i < w->idadi) {
        MhusikaWaDola* m = wahusika_pata(w, i);
        kama (m->tawi == tawi) { n = n + 1; }
        i = i + 1;
    }
    rudisha n;
}

// Mihimili ya dola na nani anamdhibiti nani.
w0 skrini_katiba_mihimili(Dola* d, Wahusika* w, n64 x, n64 y, n64 wk, n64 h) {
    sura_paneli(x, y, wk, h, ui("ARMS OF GOVERNMENT"));
    n64 bw = (wk - 32 - 2 * 12) / 3;
    n64 y1 = y + 40;
    n8 m[96];
    MhusikaWaDola* mkuu = wahusika_pata(w, 0);
    skrini_katiba_mhimili(ui("Executive"), mkuu->cheo, skrini_katiba_idadi_ya_tawi(w, TAWI_UTENDAJI), SURA_LAFUDHI, x + 16, y1, bw);
    n64 viti = 0;
    n64 b = 0;
    wakati (b < d->mabaraza) { viti = viti + d->baraza_viti[b]; b = b + 1; }
    mfuatano_umbiza(m, 96, ui("%d chamber(s)"), d->mabaraza, 0, 0, 0, 0, 0);
    skrini_katiba_mhimili(ui("Legislature"), m, viti, SURA_BAHARI, x + 16 + bw + 12, y1, bw);
    mfuatano_umbiza(m, 96, ui("High Court, %d justices"), NGUVU_BENCHI, 0, 0, 0, 0, 0);
    skrini_katiba_mhimili(ui("Judiciary"), m, skrini_katiba_idadi_ya_tawi(w, TAWI_MAHAKAMA) + NGUVU_BENCHI, 11032472, x + 16 + 2 * (bw + 12), y1, bw);
    n64 y2 = y1 + 64 + 36;
    skrini_katiba_mhimili(ui("Armed forces"), ui("Commander-in-Chief: head of state"), skrini_katiba_idadi_ya_tawi(w, TAWI_JESHI), SURA_HASI, x + 16 + bw / 2, y2, bw);
    skrini_katiba_mhimili(ui("Provinces"), ui("Governors and chiefs"), skrini_katiba_idadi_ya_tawi(w, TAWI_MIKOA), SURA_CHANYA, x + 16 + bw / 2 + bw + 12, y2, bw);
    // mistari ya udhibiti kati ya mihimili
    turubai_brashi(sura_t, 16777215, 50);
    turubai_jaza(sura_t, x + 16 + bw, y1 + 32, 12, 2);
    turubai_jaza(sura_t, x + 16 + 2 * bw + 12, y1 + 32, 12, 2);
    turubai_jaza(sura_t, x + 16 + bw, y1 + 64, 2, 36);
    turubai_jaza(sura_t, x + 16 + bw + 12 + bw / 2, y1 + 64, 2, 36);
    // maandishi ya udhibiti
    n64 yy = y2 + 80;
    n8* kwanza = ui("The executive answers to the head of state alone.");
    kama (d->aina == DOLA_JAMHURI_YA_BUNGE || d->aina == DOLA_UFALME_WA_KATIBA || d->aina == DOLA_JAMHURI_NUSU_RAIS) { kwanza = ui("The government must keep the confidence of the legislature."); }
    n8* pili = ui("The head of state cannot block the laws.");
    kama (hati_vifungu[KIFUNGU_TURUFU]) { pili = ui("The head of state may veto; two thirds override."); }
    n8* tatu = ui("The judiciary is appointed by the head of state.");
    kama (d->mabaraza > 0 && hati_ni_jamhuri(d)) { tatu = ui("Judges are confirmed by the upper chamber."); }
    sura_rangi(SURA_HAFIFU);
    sura_lebo(kwanza, x + 16, yy, 12);
    sura_lebo(pili, x + 16, yy + 20, 12);
    sura_lebo(tatu, x + 16, yy + 40, 12);
}

// Meza ya marekebisho: kila kifungu, thamani ya sasa, pendekezo na kitufe.
w0 skrini_katiba_marekebisho(Dola* d, Wahusika* w, n64 x, n64 y, n64 wk, n64 h) {
    sura_paneli(x, y, wk, h, ui("AMEND THE CONSTITUTION"));
    n8 m[160];
    mfuatano_umbiza(m, 160, "%s  ·  %s %d", utaratibu_jina(hati_utaratibu(d)), ui("capital"), GHARAMA_MAREKEBISHO, 0, 0, 0);
    sura_rangi(SURA_LAFUDHI);
    sura_lebo_kati(m, x + 16, y + 34, 12);
    n64 yy = y + 60;
    n8 a[48];
    n8 b[48];
    n64 k = 0;
    wakati (k < KIFUNGU_IDADI && yy + 30 < y + h) {
        n64 sasa = hati_vifungu[k];
        n64 pendekezo = skrini_katiba_pendekezo[k];
        sura_safu(x + 8, yy - 4, wk - 16, 30, k, pendekezo != sasa);
        sura_rangi(SURA_MAANDISHI);
        sura_lebo(kifungu_jina(k), x + 16, yy + 2, 12);
        sura_rangi(SURA_HAFIFU);
        turubai_kata(sura_t, x + (wk * 38) / 100, yy - 4, (wk * 22) / 100, 30);
        sura_lebo(kifungu_thamani_jina(k, sasa, a), x + (wk * 38) / 100, yy + 2, 12);
        turubai_kata_yote(sura_t);
        n64 xp = x + (wk * 61) / 100;
        serikali_kitufe("<", xp, yy - 1, 0, pendekezo > kifungu_chini(k), KB_PUNGUZA, k);
        sura_rangi(SURA_MAANDISHI);
        kama (pendekezo != sasa) { sura_rangi(SURA_LAFUDHI); }
        turubai_kata(sura_t, xp + 28, yy - 4, (wk * 20) / 100, 30);
        sura_lebo(kifungu_thamani_jina(k, pendekezo, b), xp + 32, yy + 2, 12);
        turubai_kata_yote(sura_t);
        serikali_kitufe(">", xp + 32 + (wk * 20) / 100, yy - 1, 0, pendekezo < kifungu_juu(k), KB_ONGEZA, k);
        kama (pendekezo != sasa) { serikali_kitufe(ui("Propose"), x + wk - 86, yy - 1, 1, nguvu_mtaji >= GHARAMA_MAREKEBISHO, KB_PENDEKEZA, k); }
        yy = yy + 32;
        k = k + 1;
    }
    kama (skrini_katiba_ujumbe[0] != 0) {
        sura_rangi(SURA_LAFUDHI);
        turubai_kata(sura_t, x, yy, wk - 8, 24);
        sura_lebo(skrini_katiba_ujumbe, x + 16, yy + 4, 12);
        turubai_kata_yote(sura_t);
    }
}

// Marekebisho yanayosubiri kura na yaliyopitishwa.
w0 skrini_katiba_historia(Dola* d, n64 zamu, n64 x, n64 y, n64 wk, n64 h) {
    sura_paneli(x, y, wk, h, ui("AMENDMENTS"));
    n64 yy = y + 38;
    n8 m[160];
    n8 a[48];
    n64 i = nguvu_hoja_idadi - 1;
    wakati (i >= 0 && yy + 22 < y + h) {
        Hoja* hj = nguvu_hoja_pata(i);
        kama (hj->aina == HOJA_MAREKEBISHO) {
            n8* hali_yake = ui("vote pending");
            kama (hj->hatua == HOJA_IMEPITA) { hali_yake = ui("carried"); }
            kama (hj->hatua == HOJA_IMESHINDWA) { hali_yake = ui("defeated"); }
            mfuatano_umbiza(m, 160, "%s: %s  ·  %s", kifungu_jina(hj->kifungu), kifungu_thamani_jina(hj->kifungu, hj->thamani, a), hali_yake, 0, 0, 0);
            sura_rangi(SURA_MAANDISHI);
            sura_lebo(m, x + 16, yy, 12);
            kama (hj->hatua == HOJA_INASUBIRI) {
                mfuatano_umbiza(m, 160, "%d%%", nguvu_uwezekano(hj, d), 0, 0, 0, 0, 0);
                sura_rangi(SURA_LAFUDHI);
                sura_lebo_kulia(m, x + wk - 16, yy, 12);
            }
            yy = yy + 22;
        }
        i = i - 1;
    }
    i = hati_historia_idadi - 1;
    wakati (i >= 0 && yy + 22 < y + h) {
        n8 tarehe[64];
        tarehe_maandishi(tarehe_siku_ya_zamu(hati_historia[i * 3 + 2]), tarehe, 64);
        mfuatano_umbiza(m, 160, "%s: %s", kifungu_jina(hati_historia[i * 3]), kifungu_thamani_jina(hati_historia[i * 3], hati_historia[i * 3 + 1], a), 0, 0, 0, 0);
        sura_rangi(SURA_CHANYA);
        sura_lebo(m, x + 16, yy, 12);
        sura_rangi(SURA_HAFIFU);
        sura_lebo_kulia(tarehe, x + wk - 16, yy, 11);
        yy = yy + 22;
        i = i - 1;
    }
    kama (yy == y + 38) {
        sura_rangi(SURA_HAFIFU);
        sura_lebo(ui("The constitution has not been amended."), x + 16, yy, 12);
    }
}

w0 skrini_katiba_chora(Mchezo* g, Turubai* t, n64 taifa) {
    sura_anzisha(t);
    bofya_anza();
    turubai_brashi(t, SURA_USULI, 255);
    turubai_jaza(t, 0, 0, t->upana, t->kimo);
    skrini_upau_wa_juu(g, t);
    skrini_urambazaji(t, 14);
    TaifaNchi* tn = dunia_taifa_mfumo_pata_kwa_faharisi(mchezo_pata_taifa(g), taifa);
    Dola* d = skrini_siasa_dola(g, taifa);
    Wahusika* w = skrini_mkutano_watu(g, taifa);
    kama (tn == 0 || d == 0 || w == 0) { rudisha; }
    nguvu_hakikisha(d, taifa);
    n64 kabla = hati_taifa;
    hati_anzisha(d, taifa);
    kama (skrini_katiba_pendekezo == 0) { skrini_katiba_pendekezo = tenga(8 * KIFUNGU_IDADI); kabla = 0 - 9; }
    kama (kabla != taifa) {
        n64 k = 0;
        wakati (k < KIFUNGU_IDADI) { skrini_katiba_pendekezo[k] = hati_vifungu[k]; k = k + 1; }
        skrini_katiba_ujumbe[0] = 0;
        skrini_katiba_tembea = 0;
    }
    hati_jenga(d, tn->jina, w);
    n64 x = SKRINI_UPANA_WA_PEMBENI + 25;
    n64 y = SKRINI_UPAU_WA_JUU + 10;
    n64 wote = t->upana - x - 24;
    skrini_kichwa_fm(g, t, ui("Constitution"), ui("The supreme law of the state, how power is divided, and how it may be changed."), x, y);
    y = y + 70;
    n64 pengo = 12;
    n64 h = t->kimo - y - 16;
    n64 wl = (wote * 56) / 100;
    n64 xr = x + wl + pengo;
    n64 wr = wote - wl - pengo;
    skrini_katiba_hati(d, tn->jina, x, y, wl, h);
    n64 h1 = 300;
    n64 h2 = 60 + KIFUNGU_IDADI * 32 + 34;
    skrini_katiba_mihimili(d, w, xr, y, wr, h1);
    skrini_katiba_marekebisho(d, w, xr, y + h1 + pengo, wr, h2);
    skrini_katiba_historia(d, g->zamu_ya_sasa, xr, y + h1 + h2 + 2 * pengo, wr, h - h1 - h2 - 2 * pengo);
}

n32 skrini_katiba_bofya(Mchezo* g, n64 taifa, n64 px, n64 py) {
    n64 hoja = 0;
    n64 k = bofya_tafuta(px, py, &hoja);
    kama (k == 0) { rudisha 0; }
    kama (k == KB_PUNGUZA && skrini_katiba_pendekezo[hoja] > kifungu_chini(hoja)) { skrini_katiba_pendekezo[hoja] = skrini_katiba_pendekezo[hoja] - 1; }
    kama (k == KB_ONGEZA && skrini_katiba_pendekezo[hoja] < kifungu_juu(hoja)) { skrini_katiba_pendekezo[hoja] = skrini_katiba_pendekezo[hoja] + 1; }
    kama (k == KB_PENDEKEZA) {
        Dola* d = skrini_siasa_dola(g, taifa);
        Wahusika* w = skrini_mkutano_watu(g, taifa);
        n64 r = hati_pendekeza(d, w, mkutano_ofisi, hoja, skrini_katiba_pendekezo[hoja], g->zamu_ya_sasa);
        kama (r == HATI_IMEPITISHWA) { nakili_mfuatano(skrini_katiba_ujumbe, ui("The amendment is in force.")); }
        kama (r == HATI_KWA_BUNGE) { nakili_mfuatano(skrini_katiba_ujumbe, ui("The amendment is tabled; the chamber votes in two weeks and needs two thirds.")); }
        kama (r == HATI_IMEKATALIWA) { nakili_mfuatano(skrini_katiba_ujumbe, ui("The amendment was rejected.")); }
        kama (r == HATI_HAKUNA_MAMLAKA) { nakili_mfuatano(skrini_katiba_ujumbe, ui("Only the head of state can amend by decree.")); }
        kama (r == HATI_HAKUNA_MTAJI) { nakili_mfuatano(skrini_katiba_ujumbe, ui("Not enough political capital.")); }
        kama (r == HATI_IMEPITISHWA || r == HATI_IMEKATALIWA) { skrini_katiba_pendekezo[hoja] = hati_vifungu[hoja]; }
    }
    rudisha 1;
}

w0 skrini_katiba_tembeza(n64 pikseli) {
    skrini_katiba_tembea = skrini_katiba_tembea + pikseli;
    kama (skrini_katiba_tembea < 0) { skrini_katiba_tembea = 0; }
}
