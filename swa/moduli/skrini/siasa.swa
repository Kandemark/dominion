husisha { moduli/skrini/muhtasari.swa }

// Skrini ya siasa: hali ya taifa na uwiano wa vikundi halisi vya kisiasa.
w0 skrini_siasa_chora(Mchezo* g, Turubai* t, n64 taifa) {
    sura_anzisha(t);
    turubai_brashi(t, SURA_USULI, 255);
    turubai_jaza(t, 0, 0, t->upana, t->kimo);
    skrini_upau_wa_juu(g, t);
    skrini_urambazaji(t, 2);

    TaifaMfumo* tm = mchezo_pata_taifa(g);
    TaifaNchi* tn = dunia_taifa_mfumo_pata_kwa_faharisi(tm, taifa);
    SiasaMfumo* si = mchezo_pata_siasa(g);
    SiasaKikundiMfumo* vik = mchezo_pata_kikundi(g);
    kama (tn == 0) { rudisha; }

    n64 x = SKRINI_UPANA_WA_PEMBENI + 25;
    n64 y = SKRINI_UPAU_WA_JUU + 25;
    n64 w = t->upana - x - 24;
    turubai_brashi(t, tn->rangi, 255);
    turubai_mviringo(t, x, y + 6, 24, 16, 4);
    sura_kichwa_ukurasa(tn->jina, ui("WORLD POLITICS · NATIONAL DATA NOT YET LINKED"), x + 36, y - 5);
    y = y + 66;

    n8 value[48];
    n64 gap = 16;
    n64 card_w = (w - 3 * gap) / 4;
    n64 legitimacy = 0;
    n64 stability = 0;
    kama (si != 0) {
        legitimacy = si->uhalali * 1000.0;
        stability = si->utulivu * 1000.0;
    }
    sura_asilimia(value, legitimacy, 0);
    sura_kadi(x, y, card_w, ui("LEGITIMACY (WORLD)"), value, 0);
    sura_asilimia(value, stability, 0);
    sura_kadi(x + card_w + gap, y, card_w, ui("STABILITY (WORLD)"), value, 0);
    n8 count_text[24];
    n64 faction_count = 0;
    kama (vik != 0) { faction_count = vik->idadi; }
    sura_namba(count_text, faction_count);
    sura_kadi(x + 2 * (card_w + gap), y, card_w, ui("POLITICAL FACTIONS"), count_text, 0);
    sura_namba(count_text, g->zamu_ya_sasa);
    sura_kadi(x + 3 * (card_w + gap), y, card_w, ui("CURRENT TURN"), count_text, 0);
    y = y + 108;

    n64 left_w = (w - gap) * 3 / 5;
    n64 right_x = x + left_w + gap;
    n64 right_w = w - left_w - gap;
    n64 panel_h = t->kimo - y - 24;
    sura_paneli(x, y, left_w, panel_h, ui("FACTION REPRESENTATION"));
    sura_paneli(right_x, y, right_w, panel_h, ui("STATE OF GOVERNMENT"));
    kama (vik == 0 || vik->idadi == 0) {
        sura_hali_tupu(ui("No factions formed"), ui("The political system is waiting for its first factions."), 0,
                       x + 12, y + 56, left_w - 24, panel_h - 72);
    } sivyo {
        n64 row = 0;
        n64 row_limit = (panel_h - 60) / 48;
        kama (row_limit > 12) { row_limit = 12; }
        wakati (row < vik->idadi && row < row_limit) {
            SiasaKikundi* k = &vik->vikundi[row];
            n64 ry = y + 48 + row * 48;
            n64 support = k->uungwaji_mkono * 1000.0;
            sura_safu(x + 12, ry, left_w - 24, 44, row, 0);
            sura_rangi(SURA_MAANDISHI);
            sura_lebo(k->jina, x + 26, ry + 4, 13);
            sura_rangi(SURA_HAFIFU);
            n8 percent[24];
            sura_asilimia(percent, support, 0);
            sura_lebo_kulia(percent, x + left_w - 20, ry + 4, 12);
            sura_mita(ui("Support"), 0, x + 26, ry + 24, left_w - 62, support, SURA_LAFUDHI);
            row = row + 1;
        }
    }
    n8 percent2[24];
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("Government legitimacy"), right_x + 18, y + 58, 12);
    sura_asilimia(percent2, legitimacy, 0);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_kulia(percent2, right_x + right_w - 18, y + 58, 12);
    sura_mita(0, 0, right_x + 18, y + 82, right_w - 36, legitimacy, SURA_BAHARI);
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("Political stability"), right_x + 18, y + 118, 12);
    sura_asilimia(percent2, stability, 0);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_kulia(percent2, right_x + right_w - 18, y + 118, 12);
    sura_mita(0, 0, right_x + 18, y + 142, right_w - 36, stability, SURA_CHANYA);
    sura_kigawanyaji(right_x + 18, y + 174, right_w - 36, SURA_MPAKA, 255);
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("Indicators are simulation state; policy and votes are not yet linked."), right_x + 18, y + 190, 11);
}
