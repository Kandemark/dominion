husisha { moduli/dunia/historia_ya_mipaka.swa }
husisha { moduli/skrini/muhtasari.swa }
husisha { moduli/onyesho/dunia_halisi.swa }

// ramani.swa -- skrini ya ramani: atlasi ya dunia ya mchezo ndani ya fremu
// ya mchezo (upau wa juu, urambazaji), taifa lililochaguliwa likiangaziwa,
// kipimo cha umbali, na paneli ya taarifa ya taifa hilo kulia.
//
// Ramani huchorwa moja kwa moja kwenye bafa ya skrini kupitia turubai ya
// pili iliyofungwa juu ya sehemu yake (turubai_funga yenye hatua ile ile),
// hivyo hakuna nakala ya pikseli.

n64 SKRINI_RAMANI_PANELI = 0;        // upana wa droo ya taifa: 0 imefungwa, 360 wazi
n64 SKRINI_RAMANI_KM_KWA_KIZIO = 625;    // kizio 1 = 360/64 shahada ~ km 625

n64 skrini_ramani_vidhibiti_x(Turubai* t) {
    rudisha t->upana - SKRINI_RAMANI_PANELI - 98;
}

n64 skrini_ramani_vidhibiti_y() {
    rudisha SKRINI_UPAU_WA_JUU + 16;
}

w0 skrini_ramani_vidhibiti_chora(Turubai* t) {
    n64 x = skrini_ramani_vidhibiti_x(t);
    n64 y = skrini_ramani_vidhibiti_y();
    sura_kadi_kuelea(x, y, 84, 42, 220, 0);
    sura_kitufe_ikoni(x + 25, y + 21, 15, SURA_ICON_MINUS, SURA_HALI_KAWAIDA, 255);
    sura_kitufe_ikoni(x + 59, y + 21, 15, SURA_ICON_PLUS, SURA_HALI_KAWAIDA, 255);
}

Fonti* skrini_serifu = 0;
Turubai* skrini_ramani_eneo = 0;

// Akiba ya fremu kamili ya mwisho ya ramani (eneo la ramani pekee), kwa
// hakikisho la haraka wakati ramani inaburutwa.
n8* skrini_akiba = 0;
n64 skrini_akiba_ukubwa = 0;
n64 skrini_akiba_w = 0;
n64 skrini_akiba_h = 0;
n64 skrini_akiba_x = 0;         // kitovu cha dunia cha fremu iliyohifadhiwa
n64 skrini_akiba_y = 0;
n64 skrini_akiba_kipimo = 0;

// Nafasi (1 = kubwa zaidi) ya taifa kwa pato ghafi.
n64 skrini_nafasi_ya_taifa(TaifaMfumo* tm, n64 taifa) {
    TaifaNchi* t = dunia_taifa_mfumo_pata_kwa_faharisi(tm, taifa);
    n64 p = skrini_pato_la_taifa(t);
    n64 nafasi = 1;
    n64 i = 0;
    wakati (i < tm->idadi) {
        TaifaNchi* o = dunia_taifa_mfumo_pata_kwa_faharisi(tm, i);
        kama (skrini_pato_la_taifa(o) > p) { nafasi = nafasi + 1; }
        i = i + 1;
    }
    rudisha nafasi;
}

// Kipimo cha umbali: urefu wa duara (100, 200, 500, ...) km unaotoshea
// kwenye pikseli ~120, na upau wake.
w0 skrini_kipimo_cha_umbali(Turubai* t, n64 x, n64 y, n64 kipimo) {
    skrini_kipimo_cha_mita(t, x, y, (kipimo * SKRINI_RAMANI_KM_KWA_KIZIO * 1000) / 1024);
}

// Kipimo cha umbali kwa mita kwa kila pikseli ya skrini (dunia yoyote).
w0 skrini_kipimo_cha_mita(Turubai* t, n64 x, n64 y, n64 mita) {
    kama (mita < 1) { mita = 1; }
    // km kwa pikseli 120
    n64 km = (120 * mita) / 1000;
    n64 duara = 10;
    wakati (duara * 10 <= km) { duara = duara * 10; }
    n64 hatua = duara;
    kama (duara * 5 <= km) { hatua = duara * 5; } sivyo { kama (duara * 2 <= km) { hatua = duara * 2; } }
    n64 px = (hatua * 1000) / mita;
    turubai_brashi(t, 16777215, 200);
    turubai_mviringo(t, x - 8, y - 8, px + 96, 30, 6);
    turubai_brashi(t, ATLASI_RANGI_MAANDISHI, 255);
    turubai_jaza(t, x, y + 8, px, 2);
    turubai_jaza(t, x, y + 3, 2, 7);
    turubai_jaza(t, x + px - 2, y + 3, 2, 7);
    n8 chombo[32];
    n8 namba[24];
    sura_namba(namba, hatua);
    mfuatano_umbiza(chombo, 32, "%s km", namba, 0, 0, 0, 0, 0);
    maandishi_chora(t, sura_kati, chombo, x + px + 8, y - 1, 12);
}

// Safu ya taarifa: lebo kushoto, thamani kulia.
w0 skrini_safu_ya_taarifa(n8* lebo, n8* thamani, n64 x, n64 y, n64 w) {
    sura_rangi(SURA_HAFIFU);
    sura_lebo(lebo, x, y, 13);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_kulia(thamani, x + w, y, 13);
}

w0 skrini_ramani_paneli(Mchezo* g, Turubai* t, n64 taifa) {
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    Miji* mj = mchezo_pata_miji(g);
    TaifaNchi* tn = dunia_taifa_mfumo_pata_kwa_faharisi(tm, taifa);
    kama (SKRINI_RAMANI_PANELI == 0) { rudisha; }       // droo imefungwa
    n64 x = t->upana - SKRINI_RAMANI_PANELI;
    n64 y = SKRINI_UPAU_WA_JUU + 1;
    turubai_brashi(t, SURA_PANELI, 255);
    turubai_jaza(t, x, y, SKRINI_RAMANI_PANELI, t->kimo - y);
    turubai_brashi(t, SURA_MPAKA, 255);
    turubai_jaza(t, x, y, 1, t->kimo - y);
    kama (tn == 0) { rudisha; }
    n64 px = x + 24;
    n64 pw = SKRINI_RAMANI_PANELI - 48;
    n64 py = y + 24;

    turubai_brashi(t, tn->rangi, 255);
    turubai_mviringo(t, px, py + 4, 28, 20, 4);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_nene(tn->jina, px + 40, py, 22);
    py = py + 40;
    n8 chombo[64];
    n8 namba[32];
    sura_rangi(SURA_HAFIFU);
    mfuatano_umbiza(chombo, 64, ui("Capital: %s"), mj->jina[taifa], 0, 0, 0, 0, 0);
    sura_lebo(chombo, px, py, 13);
    py = py + 36;

    sura_namba_fupi(namba, tn->idadi_ya_watu);
    skrini_safu_ya_taarifa(ui("Population"), namba, px, py, pw);
    py = py + 26;
    sura_namba_fupi(namba, skrini_pato_la_taifa(tn));
    skrini_safu_ya_taarifa(ui("row|GDP"), namba, px, py, pw);
    py = py + 26;
    n8 nafasi[32];
    sura_namba(namba, skrini_nafasi_ya_taifa(tm, taifa));
    n8 jumla[16];
    sura_namba(jumla, tm->idadi);
    mfuatano_umbiza(nafasi, 32, "%s / %s", namba, jumla, 0, 0, 0, 0);
    skrini_safu_ya_taarifa(ui("GDP rank"), nafasi, px, py, pw);
    py = py + 26;
    // kipande 1 = shahada 1 x 1 ~ km 111 x 111 (bila kurekebisha latitudo)
    n64 eneo_km2 = tn->uchumi.vipande_vya_ardhi * 12321;
    sura_namba(namba, eneo_km2);
    mfuatano_umbiza(chombo, 64, "%s km2", namba, 0, 0, 0, 0, 0);
    skrini_safu_ya_taarifa(ui("Area"), chombo, px, py, pw);
    py = py + 26;
    sura_namba(namba, tn->idadi_ya_mgawanyo);
    skrini_safu_ya_taarifa(ui("Regions"), namba, px, py, pw);
    py = py + 26;
    n64 lugha = mj->lugha_ya_taifa[taifa];
    mfuatano_umbiza(chombo, 64, "%s (%s)", lugha_jina(lugha), lugha_familia_jina(lugha_familia(lugha)), 0, 0, 0, 0);
    skrini_safu_ya_taarifa(ui("Language"), chombo, px, py, pw);
    py = py + 40;

    sura_kichwa_cha_safuwima(ui("INDICATORS"), px, py, 0);
    py = py + 24;
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("Technology"), px, py, 13);
    sura_pau(px + 110, py + 5, pw - 110, 8, (tn->kielezo_cha_teknolojia * 1000) / 500, SURA_BAHARI);
    py = py + 24;
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("Economy"), px, py, 13);
    sura_pau(px + 110, py + 5, pw - 110, 8, (tn->kielezo_cha_uchumi * 1000) / 500, SURA_CHANYA);
    py = py + 24;
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("Military"), px, py, 13);
    sura_pau(px + 110, py + 5, pw - 110, 8, (tn->kielezo_cha_kijeshi * 1000) / 500, SURA_HASI);
    py = py + 24;
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("Culture"), px, py, 13);
    sura_pau(px + 110, py + 5, pw - 110, 8, (tn->kielezo_cha_utamaduni * 1000) / 500, SURA_LAFUDHI);
    py = py + 40;

    sura_kichwa_cha_safuwima(ui("LARGEST CITIES"), px, py, 0);
    py = py + 24;
    n64 daraja = 3;
    n64 imeonyeshwa = 0;
    wakati (daraja >= 1) {
        n64 i = 0;
        wakati (i < mj->idadi && imeonyeshwa < 8) {
            kama (mj->taifa[i] == taifa && mj->daraja[i] == daraja) {
                turubai_brashi(t, SURA_MAANDISHI, 255);
                turubai_duara256(t, (px + 5) * 256, (py + 9) * 256, 300 + daraja * 120);
                sura_rangi(SURA_MAANDISHI);
                kama (daraja >= 2) { sura_lebo_kati(mj->jina[i], px + 20, py, 13); }
                sivyo { sura_lebo(mj->jina[i], px + 20, py, 13); }
                sura_rangi(SURA_HAFIFU);
                kama (daraja == 3) { sura_lebo_kulia(ui("capital"), px + pw, py, 12); }
                sivyo { kama (mj->bandari[i]) { sura_lebo_kulia(ui("port"), px + pw, py, 12); } }
                py = py + 22;
                imeonyeshwa = imeonyeshwa + 1;
            }
            i = i + 1;
        }
        daraja = daraja - 1;
    }
}

// ---- dunia iliyokubaliwa (rasilimali/dunia.bin) ----
DuniaHalisi* skrini_dunia = 0;
n64 skrini_dunia_imejaribiwa = 0;
n64* skrini_dunia_eneo = 0;          // pikseli za dunia kwa kila taifa

DuniaHalisi* skrini_dunia_pata() {
    kama (skrini_dunia_imejaribiwa == 0) {
        skrini_dunia_imejaribiwa = 1;
        skrini_dunia = dunia_halisi_ya_mchezo;           // dunia ile ile ya uigaji
        kama (skrini_dunia == 0) { skrini_dunia = dunia_halisi_pakia("rasilimali/dunia.bin"); }
        kama (skrini_dunia != 0) {
            DuniaHalisi* d = skrini_dunia;
            skrini_dunia_eneo = tenga(8 * d->mataifa);
            weka_sifuri(skrini_dunia_eneo, 8 * d->mataifa);
            n64 n = d->upana * d->kimo;
            n64 g = 0;
            wakati (g < n) {
                n64 m = dh_u16(d->wamiliki, 2 * g);
                kama (m < d->mataifa) { skrini_dunia_eneo[m] = skrini_dunia_eneo[m] + 1; }
                g = g + 1;
            }
        }
    }
    rudisha skrini_dunia;
}

// Idadi ya mikoa ya taifa (kitambulisho tofauti cha mkoa kwenye ardhi yake).
n64 skrini_dunia_mikoa_ya(DuniaHalisi* d, n64 taifa) {
    kata_hakikisha(d);
    n8* ipo = tenga(65536);
    weka_sifuri(ipo, 65536);
    n64 n = 0;
    n64 k = 0;
    wakati (k < kata_idadi) {
        n64 r = kata_mkoa[k] & 65535;
        kama (kata_taifa[k] == taifa && ipo[r] == 0) { ipo[r] = 1; n = n + 1; }
        k = k + 1;
    }
    achilia ipo;
    rudisha n;
}

w0 skrini_dunia_paneli(Turubai* t, DuniaHalisi* d, n64 taifa) {
    kama (SKRINI_RAMANI_PANELI == 0) { rudisha; }       // droo imefungwa
    n64 x = t->upana - SKRINI_RAMANI_PANELI;
    n64 y = SKRINI_UPAU_WA_JUU + 1;
    turubai_brashi(t, SURA_PANELI, 255);
    turubai_jaza(t, x, y, SKRINI_RAMANI_PANELI, t->kimo - y);
    turubai_brashi(t, SURA_MPAKA, 255);
    turubai_jaza(t, x, y, 1, t->kimo - y);
    kama (taifa < 0 || taifa >= d->mataifa) {
        sura_rangi(SURA_HAFIFU);
        sura_lebo(ui("Click a nation on the map"), x + 24, y + 24, 13);
        rudisha;
    }
    n8* p = d->data;
    n64 px = x + 24;
    n64 pw = SKRINI_RAMANI_PANELI - 48;
    n64 py = y + 24;
    turubai_brashi(t, d->rangi[taifa], 255);
    turubai_mviringo(t, px, py + 4, 28, 20, 4);
    // jina la Kiingereza (kamili) na jina la asili
    n64 o = d->jina[taifa];
    n64 o_asili = o + 1 + dh_u8(p, o);
    n64 o_eng = o_asili + 1 + dh_u8(p, o_asili);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_nene(dh_jina(p, d->jina[taifa]), px + 40, py, 22);
    py = py + 34;
    sura_rangi(SURA_HAFIFU);
    sura_lebo(dh_jina(p, o_eng), px, py, 13);
    py = py + 20;
    sura_lebo(dh_jina(p, o_asili), px, py, 13);
    py = py + 20;
    n8 chombo[96];
    n8 namba[32];
    mfuatano_umbiza(chombo, 96, ui("Capital: %s"), dh_jina(p, d->mji_jina[taifa]), 0, 0, 0, 0, 0);
    sura_lebo(chombo, px, py, 13);
    py = py + 20;
    // historia: uhuru wake, na mataifa yajayo yaliyo ndani yake mwaka huu
    n8 historia[160];
    historia_maelezo(d, taifa, historia, 160);
    kama (historia[0] != 0) { sura_lebo(historia, px, py, 12); py = py + 18; }
    n64 watoto = historia_watoto_wa(taifa);
    kama (watoto > 0) {
        mfuatano_umbiza(historia, 160, ui("Rules the lands of %d later nations"), watoto, 0, 0, 0, 0, 0);
        sura_lebo(historia, px, py, 12);
        py = py + 18;
    }
    py = py + 14;
    // takwimu kutoka makazi yake
    n64 watu = 0;
    n64 idadi[4];
    idadi[0] = 0; idadi[1] = 0; idadi[2] = 0; idadi[3] = 0;
    n64 bandari = 0;
    n64 i = 0;
    wakati (i < d->idadi_makazi) {
        n64 q = d->makazi[i];
        kama (dh_u16(p, q + 10) == taifa) {
            watu = watu + dh_u32(p, q + 4);
            n64 ng = dh_u8(p, q + 8);
            kama (ng < 4) { idadi[ng] = idadi[ng] + 1; }
            kama ((dh_u8(p, q + 9) & 2) != 0) { bandari = bandari + 1; }
        }
        i = i + 1;
    }
    sura_namba_fupi(namba, watu);
    skrini_safu_ya_taarifa(ui("Population"), namba, px, py, pw);
    py = py + 26;
    // pikseli 1 ya dunia ~ km 9.77 x 9.77 (wastani bila latitudo)
    sura_namba(namba, skrini_dunia_eneo[taifa] * 95);
    mfuatano_umbiza(chombo, 96, "%s km2", namba, 0, 0, 0, 0, 0);
    skrini_safu_ya_taarifa(ui("Area"), chombo, px, py, pw);
    py = py + 26;
    sura_namba(namba, idadi[0] + idadi[1]);
    skrini_safu_ya_taarifa(ui("Cities"), namba, px, py, pw);
    py = py + 26;
    sura_namba(namba, idadi[2]);
    skrini_safu_ya_taarifa(ui("Towns"), namba, px, py, pw);
    py = py + 26;
    sura_namba(namba, idadi[3]);
    skrini_safu_ya_taarifa(ui("Villages"), namba, px, py, pw);
    py = py + 26;
    sura_namba(namba, bandari);
    skrini_safu_ya_taarifa(ui("Ports"), namba, px, py, pw);
    py = py + 26;
    // ngazi za utawala: mikoa (regions) na kata (provinces)
    sura_namba(namba, skrini_dunia_mikoa_ya(d, taifa));
    skrini_safu_ya_taarifa(ui("Regions"), namba, px, py, pw);
    py = py + 26;
    sura_namba(namba, kata_za_taifa(d, taifa));
    skrini_safu_ya_taarifa(ui("Provinces"), namba, px, py, pw);
    py = py + 40;
    sura_kichwa_cha_safuwima(ui("LARGEST CITIES"), px, py, 0);
    py = py + 24;
    // miji 8 mikubwa zaidi: chagua mara 8 kubwa zaidi kuliko iliyotangulia
    n64 moja = 1;                 // halisi 1 ni n32: (1 << 40) ingekuwa 256 (swa#399)
    n64 juu_ya = moja << 40;
    n64 k = 0;
    wakati (k < 8) {
        n64 bora = 0 - 1;
        n64 bora_w = 0;
        i = 0;
        wakati (i < d->idadi_makazi) {
            n64 q = d->makazi[i];
            kama (dh_u16(p, q + 10) == taifa) {
                n64 w = dh_u32(p, q + 4);
                kama (w < juu_ya && w > bora_w) { bora_w = w; bora = i; }
            }
            i = i + 1;
        }
        kama (bora < 0) { acha; }
        n64 q = d->makazi[bora];
        turubai_brashi(t, SURA_MAANDISHI, 255);
        turubai_duara256(t, (px + 5) * 256, (py + 9) * 256, 300 + (3 - dh_u8(p, q + 8)) * 100);
        sura_rangi(SURA_MAANDISHI);
        sura_lebo(dh_jina(p, q + 12), px + 20, py, 13);
        sura_namba_fupi(namba, bora_w);
        sura_rangi(SURA_HAFIFU);
        sura_lebo_kulia(namba, px + pw, py, 12);
        py = py + 22;
        juu_ya = bora_w;
        k = k + 1;
    }
}

// Angazia taifa lililochaguliwa: ukingo wa ndani mweupe kidogo juu ya pikseli zake.
w0 skrini_dunia_angazia(Turubai* e, n64 taifa) {
    kama (dh_wamiliki_skrini == 0 || taifa < 0) { rudisha; }
    n64 w = e->upana;
    n64 h = e->kimo;
    n64 j = 1;
    wakati (j < h - 1) {
        n64 i = 1;
        wakati (i < w - 1) {
            n64 k = j * w + i;
            kama (dh_wamiliki_skrini[k] == taifa) {
                kama (dh_wamiliki_skrini[k - 1] != taifa || dh_wamiliki_skrini[k + 1] != taifa
                    || dh_wamiliki_skrini[k - w] != taifa || dh_wamiliki_skrini[k + w] != taifa) {
                    n64 o = j * e->hatua + i * 4;
                    weka_u32(e->pikseli, o, 16766976);          // 0xFFD800 ukingo wa uteuzi
                }
            }
            i = i + 1;
        }
        j = j + 1;
    }
}

// Ramani ya dunia iliyokubaliwa. Vipimo: kitovu kwa pikseli za dunia * 256,
// kipimo = pikseli za dunia * 256 kwa pikseli moja ya skrini.
w0 skrini_dunia_chora(Mchezo* g, Turubai* t, DuniaHalisi* d, n64 kitovu_x, n64 kitovu_y, n64 kipimo, n64 taifa) {
    sura_anzisha(t);
    kama (skrini_serifu == 0) { skrini_serifu = maandishi_pakia("rasilimali/fonti/NotoSerif-Italic.ttf"); }
    kama (skrini_ramani_eneo == 0) { skrini_ramani_eneo = tenga(ukubwa(Turubai)); }
    turubai_brashi(t, SURA_USULI, 255);
    turubai_jaza(t, 0, 0, t->upana, t->kimo);
    skrini_upau_wa_juu(g, t);
    skrini_urambazaji(t, 7);
    n64 x = SKRINI_UPANA_WA_PEMBENI + 1;
    n64 y = SKRINI_UPAU_WA_JUU + 1;
    n64 w = t->upana - x - SKRINI_RAMANI_PANELI;
    n64 h = t->kimo - y;
    Turubai* e = skrini_ramani_eneo;
    turubai_funga(e, t->pikseli + y * t->hatua + x * 4, t->hatua, w, h);
    n64 x0 = kitovu_x - (w / 2) * kipimo;
    n64 y0 = kitovu_y - (h / 2) * kipimo;
    dunia_halisi_chora_msingi(d, e, x0, y0, kipimo);
    skrini_dunia_angazia(e, taifa);
    dunia_halisi_chora_vekta(d, e, x0, y0, kipimo);
    dunia_halisi_chora_majina(d, e, x0, y0, kipimo, sura_nene, sura_kawaida, skrini_serifu);
    dunia_halisi_chora_mito_majina(d, e, x0, y0, kipimo, skrini_serifu);
    skrini_kipimo_cha_mita(e, 24, h - 40, (9770 * kipimo) / 256);
    kama (skrini_akiba_ukubwa < w * h * 4) {
        kama (skrini_akiba != 0) { achilia skrini_akiba; }
        skrini_akiba_ukubwa = w * h * 4;
        skrini_akiba = tenga(skrini_akiba_ukubwa);
    }
    n64 j = 0;
    wakati (j < h) {
        nakili(skrini_akiba + j * w * 4, e->pikseli + j * e->hatua, w * 4);
        j = j + 1;
    }
    skrini_akiba_w = w;
    skrini_akiba_h = h;
    skrini_akiba_x = kitovu_x;
    skrini_akiba_y = kitovu_y;
    skrini_akiba_kipimo = kipimo;
    skrini_ramani_vidhibiti_chora(t);
    skrini_dunia_paneli(t, d, taifa);
}

// Chora skrini ya ramani. (kitovu_x, kitovu_y) ni nukta ya dunia ya
// atlasi katikati ya ramani; kipimo ni vizio vya dunia kwa pikseli.
w0 skrini_ramani_chora(Mchezo* g, Turubai* t, n64 kitovu_x, n64 kitovu_y, n64 kipimo, n64 taifa) {
    sura_anzisha(t);
    kama (skrini_serifu == 0) { skrini_serifu = maandishi_pakia("rasilimali/fonti/NotoSerif-Italic.ttf"); }
    kama (skrini_ramani_eneo == 0) { skrini_ramani_eneo = tenga(ukubwa(Turubai)); }
    turubai_brashi(t, SURA_USULI, 255);
    turubai_jaza(t, 0, 0, t->upana, t->kimo);
    skrini_upau_wa_juu(g, t);
    skrini_urambazaji(t, 7);

    Atlasi* a = mchezo_pata_atlasi(g);
    Miji* mj = mchezo_pata_miji(g);
    n64 x = SKRINI_UPANA_WA_PEMBENI + 1;
    n64 y = SKRINI_UPAU_WA_JUU + 1;
    n64 w = t->upana - x - SKRINI_RAMANI_PANELI;
    n64 h = t->kimo - y;
    Turubai* e = skrini_ramani_eneo;
    turubai_funga(e, t->pikseli + y * t->hatua + x * 4, t->hatua, w, h);
    n64 x0 = kitovu_x - (w / 2) * kipimo;
    n64 y0 = kitovu_y - (h / 2) * kipimo;
    atlasi_chora_msingi(a, e, x0, y0, kipimo);
    atlasi_angazia(a, e, taifa, 40);
    atlasi_chora_juu(a, mj, e, x0, y0, kipimo, sura_nene, sura_kati, sura_kawaida, skrini_serifu);
    skrini_kipimo_cha_umbali(e, 24, h - 40, kipimo);

    // hifadhi eneo la ramani kwa hakikisho la kuburuta
    kama (skrini_akiba_ukubwa < w * h * 4) {
        kama (skrini_akiba != 0) { achilia skrini_akiba; }
        skrini_akiba_ukubwa = w * h * 4;
        skrini_akiba = tenga(skrini_akiba_ukubwa);
    }
    n64 j = 0;
    wakati (j < h) {
        nakili(skrini_akiba + j * w * 4, e->pikseli + j * e->hatua, w * 4);
        j = j + 1;
    }
    skrini_akiba_w = w;
    skrini_akiba_h = h;
    skrini_akiba_x = kitovu_x;
    skrini_akiba_y = kitovu_y;
    skrini_akiba_kipimo = kipimo;

    skrini_ramani_vidhibiti_chora(t);
    skrini_ramani_paneli(g, t, taifa);
}

// Hakikisho la haraka: fremu ya mwisho iliyohifadhiwa, imesogezwa kwa
// tofauti ya kitovu (pikseli nzima), na bahari kwenye sehemu mpya
// iliyofunuliwa. Hurudisha 0 ikiwa akiba haifai (ukubwa au kipimo
// kimebadilika) -- mwitaji achore kikamilifu.
n32 skrini_ramani_hakikisho(Mchezo* g, Turubai* t, n64 kitovu_x, n64 kitovu_y, n64 kipimo, n64 taifa) {
    n64 x = SKRINI_UPANA_WA_PEMBENI + 1;
    n64 y = SKRINI_UPAU_WA_JUU + 1;
    n64 w = t->upana - x - SKRINI_RAMANI_PANELI;
    n64 h = t->kimo - y;
    kama (skrini_akiba == 0 || kipimo != skrini_akiba_kipimo || w != skrini_akiba_w || h != skrini_akiba_h) { rudisha 0; }
    sura_anzisha(t);
    turubai_brashi(t, SURA_USULI, 255);
    turubai_jaza(t, 0, 0, t->upana, t->kimo);
    skrini_upau_wa_juu(g, t);
    skrini_urambazaji(t, 7);
    // pikseli (i,j) ya sasa = pikseli (i+dx, j+dy) ya akiba
    n64 dx = (kitovu_x - skrini_akiba_x) / kipimo;
    n64 dy = (kitovu_y - skrini_akiba_y) / kipimo;
    turubai_brashi(t, ATLASI_RANGI_BAHARI, 255);
    turubai_jaza(t, x, y, w, h);
    n64 i0 = 0;
    kama (dx < 0) { i0 = 0 - dx; }
    n64 i1 = w;
    kama (dx > 0) { i1 = w - dx; }
    n64 j = 0;
    wakati (j < h) {
        n64 js = j + dy;
        kama (js >= 0 && js < h && i1 > i0) {
            nakili(t->pikseli + (y + j) * t->hatua + (x + i0) * 4, skrini_akiba + js * w * 4 + (i0 + dx) * 4, (i1 - i0) * 4);
        }
        j = j + 1;
    }
    skrini_ramani_vidhibiti_chora(t);
    kama (skrini_dunia != 0) { skrini_dunia_paneli(t, skrini_dunia, taifa); }
    sivyo { skrini_ramani_paneli(g, t, taifa); }
    rudisha 1;
}
