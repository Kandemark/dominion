husisha { moduli/skrini/jeshi.swa }

// jaribio_jeshi.swa -- chora skrini ya jeshi la taifa la mchezaji kutoka mchezo halisi
// baada ya zamu kadhaa, na uandike fremu ghafi (BGRA) kwenye njia iliyopewa.
//   jaribio_jeshi <njia> [zamu]

n32 anza(n32 idadi_ya_hoja, n8** hoja_za_mstari) {
    Mchezo* g = mchezo_unda();
    MchezoUsanidi usanidi;
    mchezo_usanidi_chaguomsingi(&usanidi);
    CivMatokeo r = mchezo_anzisha(g, &usanidi);
    kama (r.hitilafu != CIV_SAWA) { andika("SHINDWA: mchezo_anzisha\n", 0, 0, 0, 0, 0, 0); rudisha 1; }
    vk_anzisha(g);
    n64 zamu = 40;
    kama (idadi_ya_hoja > 2) { zamu = mfuatano_hadi_n64(hoja_za_mstari[2]); }
    n64 i = 0;
    wakati (i < zamu) {
        mchezo_sasisha(g);
        mchezo_maliza_zamu(g);
        vk_zamu(g, g->zamu_ya_sasa);
        i = i + 1;
    }
    vk_weka_uhamasishaji(mchezo_pata_taifa(g)->faharisi_ya_taifa_la_mchezaji, VK_SEHEMU);
    Turubai* t = turubai_unda(1600, 900);
    skrini_jeshi_chora(g, t, mchezo_pata_taifa(g)->faharisi_ya_taifa_la_mchezaji);
    kama (idadi_ya_hoja > 1) {
        n64 fd = mfumo_fungua(hoja_za_mstari[1], 577, 420);
        mfumo_andika(fd, t->pikseli, t->hatua * t->kimo);
        mfumo_funga(fd);
    }
    // wigo: dunia = mataifa yote, mkoa = taifa na majirani wa nchi kavu,
    // wenzake = taifa na wenye pato la nafasi 15 juu au chini yake
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    n64 mimi = tm->faharisi_ya_taifa_la_mchezaji;
    n64 makosa = 0;
    skrini_wigo = WIGO_DUNIA;
    jopo_weka_kituo(g, mimi);
    kama (jopo_kundi_idadi != tm->idadi) { andika("SHINDWA: wigo wa dunia %d\n", jopo_kundi_idadi, 0, 0, 0, 0, 0); makosa = makosa + 1; }
    skrini_wigo = WIGO_MKOA;
    jopo_weka_kituo(g, mimi);
    n64 majirani = 1;
    i = 0;
    wakati (i < tm->idadi) { kama (i != mimi && dunia_atlasi_mpaka(mimi, i) > 0) { majirani = majirani + 1; } i = i + 1; }
    kama (jopo_kundi_idadi != majirani || jopo_inafaa(mimi) == 0) { andika("SHINDWA: wigo wa mkoa %d / %d\n", jopo_kundi_idadi, majirani, 0, 0, 0, 0); makosa = makosa + 1; }
    kama (kipimo_nafasi(g, mimi, KIPIMO_JESHI) > majirani) { andika("SHINDWA: nafasi ndani ya mkoa\n", 0, 0, 0, 0, 0, 0); makosa = makosa + 1; }
    skrini_wigo = WIGO_TAIFA;
    jopo_weka_kituo(g, mimi);
    kama (jopo_kundi_idadi < 16 || jopo_kundi_idadi > 31 || jopo_inafaa(mimi) == 0) { andika("SHINDWA: wigo wa wenzake %d\n", jopo_kundi_idadi, 0, 0, 0, 0, 0); makosa = makosa + 1; }
    kama (makosa > 0) { rudisha 1; }
    andika("zamu %d, mataifa %d, mkoa %d\n", g->zamu_ya_sasa, tm->idadi, majirani, 0, 0, 0);
    rudisha 0;
}
