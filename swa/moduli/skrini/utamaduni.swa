husisha { moduli/skrini/jopo.swa }

// Skrini ya utamaduni: identities, imani na mawazo; inaonyesha tupu wazi
// kwa sababu mifumo hii huanza bila rekodi kwenye mchezo mpya.
w0 skrini_utamaduni_chora(Mchezo* g, Turubai* t, n64 taifa) {
    sura_anzisha(t);
    bofya_anza();
    turubai_brashi(t, SURA_USULI, 255);
    turubai_jaza(t, 0, 0, t->upana, t->kimo);
    skrini_upau_wa_juu(g, t);
    skrini_urambazaji(t, 5);
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    TaifaNchi* tn = dunia_taifa_mfumo_pata_kwa_faharisi(tm, taifa);
    UtamaduniKitambulishoMfumo* cultures = mchezo_pata_utamaduni_kitambulisho(g);
    UtamaduniDiniMfumo* faiths = mchezo_pata_utamaduni_dini(g);
    UtamaduniItikadiMfumo* ideologies = mchezo_pata_utamaduni_itikadi(g);
    UtamaduniKuenea* diffusion = mchezo_pata_utamaduni_kuenea(g);
    kama (tn == 0) { rudisha; }
    n64 x = SKRINI_UPANA_WA_PEMBENI + 25;
    n64 y = SKRINI_UPAU_WA_JUU + 25;
    n64 w = t->upana - x - 24;
    skrini_kichwa_fm(g, t, ui("Culture"), ui("Identity, faith and ideas across the world."), x, y - 15);
    jopo_weka_kituo(g, taifa);
    jopo_wigo_chora(t->upana - 24, y - 1);
    y = y + 66;
    n64 gap = 16;
    n64 cw = (w - 3 * gap) / 4;
    n8 value[40];
    n64 culture_count = 0;
    n64 faith_count = 0;
    n64 ideology_count = 0;
    n64 diffusion_count = 0;
    kama (cultures != 0) { culture_count = cultures->idadi; }
    kama (faiths != 0) { faith_count = faiths->idadi; }
    kama (ideologies != 0) { ideology_count = ideologies->idadi; }
    kama (diffusion != 0) { diffusion_count = diffusion->idadi_ya_matukio; }
    sura_namba(value, culture_count);
    sura_kadi(x, y, cw, ui("IDENTITIES"), value, 0);
    sura_namba(value, faith_count);
    sura_kadi(x + cw + gap, y, cw, ui("FAITHS"), value, 0);
    sura_namba(value, ideology_count);
    sura_kadi(x + 2 * (cw + gap), y, cw, ui("SCHOOLS OF THOUGHT"), value, 0);
    sura_namba(value, diffusion_count);
    sura_kadi(x + 3 * (cw + gap), y, cw, ui("DIFFUSION EVENTS"), value, 0);
    y = y + 108;
    // utamaduni kati ya mataifa, kisha majirani na aina za utawala
    jopo_safu_ya_dunia(g, taifa, KIPIMO_UTAMADUNI, KIPIMO_TEKNOLOJIA, x, y, w, 300);
    y = y + 300 + 12;
    n64 w4 = (w - 3 * 12) / 4;
    n64 h_chini = t->kimo - y - 24;
    jopo_majirani(g, taifa, KIPIMO_UTAMADUNI, ui("NEIGHBOURS  ·  CULTURE"), x, y, w4, h_chini);
    jopo_kwa_utawala(g, taifa, KIPIMO_UTAMADUNI, ui("CULTURE BY FORM OF GOVERNMENT"), x + w4 + 12, y, w4, h_chini);
    x = x + 2 * (w4 + 12);
    w = w - 2 * (w4 + 12);
    gap = 12;
    n64 left_w = (w - gap) / 2;
    n64 right_x = x + left_w + gap;
    n64 right_w = w - left_w - gap;
    n64 panel_h = t->kimo - y - 24;
    sura_paneli(x, y, left_w, panel_h, ui("SOCIAL IDENTITY"));
    sura_paneli(right_x, y, right_w, panel_h, ui("FAITHS AND SCHOOLS OF THOUGHT"));
    kama (cultures == 0 || culture_count == 0) {
        sura_hali_tupu(ui("No identities recorded"), ui("Cultural systems are ready; their data has not been generated yet."), 0,
                       x + 12, y + 52, left_w - 24, panel_h - 64);
    } sivyo {
        n64 i = 0;
        wakati (i < culture_count && i < 5) {
            UtamaduniKitambulisho* c = utamaduni_kitambulisho_mfumo_pata(cultures, i);
            n64 ry = y + 50 + i * 56;
            sura_safu(x + 12, ry, left_w - 24, 50, i, 0);
            sura_rangi(SURA_MAANDISHI);
            sura_lebo(c->jina, x + 26, ry + 4, 13);
            n8 cohesion[24];
            sura_asilimia(cohesion, c->mshikamano * 1000.0, 0);
            sura_mita(ui("Cohesion"), cohesion, x + 26, ry + 24, left_w - 54, c->mshikamano * 1000.0, SURA_BAHARI);
            i = i + 1;
        }
    }
    kama ((faiths == 0 || faith_count == 0) && (ideologies == 0 || ideology_count == 0)) {
        sura_hali_tupu(ui("No faiths or ideologies yet"), ui("Faiths, values and outlooks appear once they emerge."), 0,
                       right_x + 12, y + 52, right_w - 24, panel_h - 64);
    } sivyo {
        n64 row = 0;
        wakati (faiths != 0 && row < faith_count && row < 4) {
            UtamaduniDini* d = utamaduni_dini_mfumo_pata(faiths, row);
            n64 ry = y + 50 + row * 46;
            sura_safu(right_x + 12, ry, right_w - 24, 40, row, 0);
            sura_rangi(SURA_MAANDISHI);
            sura_lebo(d->jina, right_x + 26, ry + 5, 12);
            sura_rangi(SURA_HAFIFU);
            sura_lebo(ui("Trust"), right_x + right_w - 85, ry + 5, 10);
            row = row + 1;
        }
        n64 base = y + 50 + row * 46;
        n64 i = 0;
        wakati (ideologies != 0 && i < ideology_count && i < 3 && base + (i + 1) * 44 < y + panel_h) {
            UtamaduniItikadi* idea = utamaduni_itikadi_mfumo_pata(ideologies, i);
            sura_safu(right_x + 12, base + i * 44, right_w - 24, 40, i, 0);
            sura_rangi(SURA_MAANDISHI);
            sura_lebo(idea->jina, right_x + 26, base + i * 44 + 5, 12);
            n8 cohesion[24];
            sura_asilimia(cohesion, idea->mshikamano * 1000.0, 0);
            sura_rangi(SURA_HAFIFU);
            sura_lebo(cohesion, right_x + right_w - 84, base + i * 44 + 5, 11);
            i = i + 1;
        }
    }
}
