husisha { moduli/skrini/jopo.swa }

// Skrini ya jeshi: muhtasari na orodha ya vikosi vilivyo kwenye mfumo.
w0 skrini_jeshi_chora(Mchezo* g, Turubai* t, n64 taifa) {
    sura_anzisha(t);
    bofya_anza();
    turubai_brashi(t, SURA_USULI, 255);
    turubai_jaza(t, 0, 0, t->upana, t->kimo);
    skrini_upau_wa_juu(g, t);
    skrini_urambazaji(t, 3);
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    TaifaNchi* tn = dunia_taifa_mfumo_pata_kwa_faharisi(tm, taifa);
    JeshiVitengoMfumo* army = mchezo_pata_jeshi_vitengo(g);
    kama (tn == 0) { rudisha; }
    n64 x = SKRINI_UPANA_WA_PEMBENI + 25;
    n64 y = SKRINI_UPAU_WA_JUU + 25;
    n64 w = t->upana - x - 24;
    skrini_kichwa_fm(g, t, ui("Military"), ui("Strength among the nations, commanders, neighbours and forces."), x, y - 15);
    y = y + 66;
    n64 total_units = 0;
    n64 total_strength = 0;
    n64 morale_sum = 0;
    kama (army != 0) {
        total_units = army->idadi;
        n64 i = 0;
        wakati (i < army->idadi) {
            JeshiKitengo* u = jeshi_vitengo_pata(army, i);
            total_strength = total_strength + u->nguvu_ya_sasa;
            morale_sum = morale_sum + u->morali * 1000.0;
            i = i + 1;
        }
    }
    n8 value[40];
    n64 gap = 16;
    n64 cw = (w - 3 * gap) / 4;
    sura_namba(value, total_units);
    sura_kadi(x, y, cw, ui("WORLD UNITS"), value, 0);
    sura_namba_fupi(value, total_strength);
    sura_kadi(x + cw + gap, y, cw, ui("FORCE STRENGTH"), value, 0);
    n64 morale = 0;
    kama (total_units > 0) { morale = morale_sum / total_units; }
    sura_asilimia(value, morale, 0);
    sura_kadi(x + 2 * (cw + gap), y, cw, ui("AVERAGE MORALE"), value, 0);
    sura_namba(value, tn->kielezo_cha_kijeshi);
    sura_kadi(x + 3 * (cw + gap), y, cw, ui("MILITARY INDEX"), value, 0);
    y = y + 108;
    // nguvu kati ya mataifa: nafasi, mgawanyo, jeshi dhidi ya pato
    n64 pengo = 12;
    jopo_safu_ya_dunia(g, taifa, KIPIMO_JESHI, KIPIMO_PATO, x, y, w, 300);
    y = y + 300 + pengo;
    n64 h_chini = t->kimo - y - 24;
    n64 w4 = (w - 3 * pengo) / 4;
    jopo_vyeo(g, taifa, TAWI_JESHI, ui("HIGH COMMAND"), x, y, w4, h_chini);
    jopo_majirani(g, taifa, KIPIMO_JESHI, ui("NEIGHBOURS  ·  MILITARY"), x + (w4 + pengo), y, w4, h_chini);
    jopo_kwa_utawala(g, taifa, KIPIMO_JESHI, ui("MILITARY BY FORM OF GOVERNMENT"), x + 2 * (w4 + pengo), y, w4, h_chini);
    x = x + 3 * (w4 + pengo);
    w = w - 3 * (w4 + pengo);
    n64 panel_h = h_chini;
    sura_paneli(x, y, w, panel_h, ui("ORDER OF BATTLE"));
    kama (army == 0 || army->idadi == 0) {
        sura_hali_tupu(ui("No military units"), ui("Forces appear here once the simulation raises them."), 0,
                       x + 16, y + 55, w - 32, panel_h - 70);
    } sivyo {
        n64 row = 0;
        wakati (row < army->idadi && row < 10) {
            JeshiKitengo* u = jeshi_vitengo_pata(army, row);
            n64 ry = y + 48 + row * 48;
            sura_safu(x + 12, ry, w - 24, 44, row, 0);
            sura_rangi(SURA_MAANDISHI);
            sura_lebo(u->jina, x + 28, ry + 4, 13);
            n8 stat[40];
            sura_namba_fupi(stat, u->nguvu_ya_sasa);
            sura_rangi(SURA_HAFIFU);
            sura_lebo(stat, x + 330, ry + 5, 11);
            n64 morale_pct = u->morali * 1000.0;
            sura_mita(ui("Morale"), 0, x + 460, ry + 15, w - 510, morale_pct, SURA_CHANYA);
            row = row + 1;
        }
    }
}
