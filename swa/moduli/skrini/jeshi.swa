husisha { moduli/skrini/muhtasari.swa }

// Skrini ya jeshi: muhtasari na orodha ya vikosi vilivyo kwenye mfumo.
w0 skrini_jeshi_chora(Mchezo* g, Turubai* t, n64 taifa) {
    sura_anzisha(t);
    turubai_brashi(t, SURA_USULI, 255);
    turubai_jaza(t, 0, 0, t->upana, t->kimo);
    skrini_upau_wa_juu(g, t);
    skrini_urambazaji(t, 3);
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    TaifaNchi* tn = dunia_taifa_mfumo_pata_kwa_faharisi(tm, taifa);
    JeshiVitengoMfumo* army = mchezo_pata_jeshi_vitengo(g);
    kama (tn == 0) { rudisha; }
    n64 x = SKRINI_UPANA_WA_PEMBENI + 25;
    n64 y = SKRINI_UPAU_WA_JUU + 25;
    n64 w = t->upana - x - 24;
    turubai_brashi(t, tn->rangi, 255);
    turubai_mviringo(t, x, y + 6, 24, 16, 4);
    sura_kichwa_ukurasa(tn->jina, "VIKOSI VYA DUNIA · VITENGO BADO HAVIHUSISHWI NA TAIFA", x + 36, y - 5);
    y = y + 66;
    n64 total_units = 0;
    n64 total_strength = 0;
    n64 morale_sum = 0;
    kama (army != 0) {
        total_units = army->idadi;
        n64 i = 0;
        wakati (i < army->idadi) {
            JeshiKitengo* u = jeshi_vitengo_pata(army, i);
            total_strength = total_strength + u->nguvu_ya_sasa;
            morale_sum = morale_sum + u->morali * 1000.0;
            i = i + 1;
        }
    }
    n8 value[40];
    n64 gap = 16;
    n64 cw = (w - 3 * gap) / 4;
    sura_namba(value, total_units);
    sura_kadi(x, y, cw, "VITENGO VYA DUNIA", value, 0);
    sura_namba_fupi(value, total_strength);
    sura_kadi(x + cw + gap, y, cw, "NGUVU YA VIKOSI", value, 0);
    n64 morale = 0;
    kama (total_units > 0) { morale = morale_sum / total_units; }
    sura_asilimia(value, morale, 0);
    sura_kadi(x + 2 * (cw + gap), y, cw, "MORALE WASTANI", value, 0);
    sura_namba(value, tn->kielezo_cha_kijeshi);
    sura_kadi(x + 3 * (cw + gap), y, cw, "KIASHIRIA CHA JESHI", value, 0);
    y = y + 108;
    n64 panel_h = t->kimo - y - 24;
    sura_paneli(x, y, w, panel_h, "ORODHA YA VIKOSI");
    kama (army == 0 || army->idadi == 0) {
        sura_hali_tupu("Hakuna vitengo vya kijeshi", "Vikosi vitaonekana hapa baada ya kuundwa na simulizi.", 0,
                       x + 16, y + 55, w - 32, panel_h - 70);
    } sivyo {
        n64 row = 0;
        wakati (row < army->idadi && row < 10) {
            JeshiKitengo* u = jeshi_vitengo_pata(army, row);
            n64 ry = y + 48 + row * 48;
            sura_safu(x + 12, ry, w - 24, 44, row, 0);
            sura_rangi(SURA_MAANDISHI);
            sura_lebo(u->jina, x + 28, ry + 4, 13);
            n8 stat[40];
            sura_namba_fupi(stat, u->nguvu_ya_sasa);
            sura_rangi(SURA_HAFIFU);
            sura_lebo(stat, x + 330, ry + 5, 11);
            n64 morale_pct = u->morali * 1000.0;
            sura_mita("Morale", 0, x + 460, ry + 15, w - 510, morale_pct, SURA_CHANYA);
            row = row + 1;
        }
    }
}
