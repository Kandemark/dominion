husisha { moduli/skrini/jopo.swa }
husisha { moduli/jeshi/vikosi.swa }
husisha { moduli/skrini/terminali.swa }
husisha { moduli/soko/masoko.swa }
husisha { moduli/skrini/nyuso.swa }

// jeshi.swa -- kituo cha ulinzi (DEFN): ukurasa wa Military kama kituo.
//   1 FORCES   maelezo ya ulinzi, uhamasishaji, historia ya kielezo, jedwali
//              la matawi (vikosi, askari, vifaa, ari, uzoefu, vyombo, nguvu),
//              vikosi vikubwa, mizani ya nguvu na mataifa ya karibu, na
//              amri kuu
//   2 OOB      mpangilio kamili wa vita: kila kikosi, mji wake, nguvu, vifaa,
//              ari, uzoefu, vyombo, utayari, wiki ya kuundwa na alama
//   3 BALANCE  mataifa ya wigo: askari, kielezo na mabadiliko, uhamasishaji,
//              utayari, vita, hasara, uwiano dhidi yetu na umbali

// vitendo vya kubofya
n64 JS_UHAMASISHAJI = 120;      // hoja: kiwango
n64 JS_UKURASA = 121;           // hoja: -1 au +1
n64 jeshi_ukurasa = 0;
n64 JS_TABO = 122;
n64 js_tabo = 0;

n64 vk_jumla_ya(n64 t) {
    kama (vk_mataifa == 0 || t < 0 || t >= vk_mataifa) { rudisha 0; }
    rudisha vk_jumla[t];
}

n8* js_mji(Kikosi* k) {
    kama (vk_miji == 0 || vk_miji_idadi == 0 || k->nyumbani < 0 || k->nyumbani >= vk_miji_idadi[k->taifa]) { rudisha "-"; }
    rudisha vk_miji[k->taifa * VK_MIJI + k->nyumbani];
}

// Mstari wa amri na vichupo.
w0 js_amri(Mchezo* g, n64 taifa, n64 x, n64 y, n64 w) {
    n8 m[160];
    n8* kazi = "FORCES";
    kama (js_tabo == 1) { kazi = "OOB"; }
    kama (js_tabo == 2) { kazi = "BAL"; }
    n8* wigo = "NATION";
    kama (skrini_wigo == WIGO_MKOA) { wigo = "REGION"; }
    kama (skrini_wigo == WIGO_DUNIA) { wigo = "WORLD"; }
    mfuatano_umbiza(m, 160, "%s <DEFN> %s %s <GO>", soko_sarafu_ya(taifa)->msimbo, kazi, wigo, 0, 0, 0);
    n64 bx = kt_amri(m, x, y, w);
    bx = bx + kt_kitufe(ui("1 FORCES"), bx, y + 5, js_tabo == 0, JS_TABO, 0) + 4;
    bx = bx + kt_kitufe(ui("2 ORDER OF BATTLE"), bx, y + 5, js_tabo == 1, JS_TABO, 1) + 4;
    kt_kitufe(ui("3 BALANCE"), bx, y + 5, js_tabo == 2, JS_TABO, 2);
    kt_wigo(x + w, y, JOPO_WIGO);
}

// Mstari unaopita: hali yetu, kisha kielezo cha mataifa ya karibu.
w0 js_mstari(Mchezo* g, n64 taifa, n64 x, n64 y, n64 w) {
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    n64 xx = kt_mstari_anza(x, y, w);
    n8 m[32];
    sura_namba_fupi(m, vk_jumla_ya(taifa));
    xx = kt_kipande(xx, y, ui("PERS"), m, 0, 0);
    sura_namba(m, hs_pata(taifa, HS_JESHI, 0));
    xx = kt_kipande(xx, y, ui("MIL"), m, hs_badiliko(taifa, HS_JESHI, 1), 1);
    mfuatano_umbiza(m, 32, "%d%%", vk_utayari_wa_taifa(taifa), 0, 0, 0, 0, 0);
    xx = kt_kipande(xx, y, ui("READY"), m, 0, 0);
    xx = kt_kipande(xx, y, ui("POSTURE"), vk_jina_fupi_la_uhamasishaji(vk_uhamasishaji[taifa]), 0, 0);
    xx = xx + 12;
    n64 i = 0;
    wakati (i < tm->idadi && xx < x + w) {
        kama (i != taifa && (dunia_atlasi_mpaka(taifa, i) > 0 || jopo_umbali(taifa, i) <= 3000)) {
            sura_namba(m, hs_pata(i, HS_JESHI, 0));
            xx = kt_kipande(xx, y, soko_sarafu_ya(i)->msimbo, m, hs_badiliko(i, HS_JESHI, 4), 1);
        }
        i = i + 1;
    }
    kt_mstari_maliza();
}



// Ufunguo wa safuwima ya mpangilio wa vita kwa kikosi.
//   0 jina  1 mji  2 askari  3 ujazo  4 vifaa  5 ari  6 utayari  7 uzoefu
//   8 vyombo  9 wiki ya kuundwa  10 alama
n64 js_ufunguo_oob(Kikosi* kk, n64 mwaka, n64 safu) {
    kama (safu == 0) { n8 jina[96]; vk_jina(kk, mwaka, jina, 96); rudisha kt_ufunguo_wa_jina(jina); }
    kama (safu == 1) { rudisha kt_ufunguo_wa_jina(js_mji(kk)); }
    kama (safu == 3) { kama (kk->juu <= 0) { rudisha 0; } rudisha (kk->watu * 1000) / kk->juu; }
    kama (safu == 4) { rudisha kk->vifaa; }
    kama (safu == 5) { rudisha kk->morali; }
    kama (safu == 6) { rudisha vk_utayari(kk); }
    kama (safu == 7) { rudisha kk->uzoefu; }
    kama (safu == 8) { rudisha vk_vyombo(kk, mwaka); }
    kama (safu == 9) { rudisha kk->zamu; }
    kama (safu == 10) { rudisha vk_alama_ya(kk, mwaka); }
    rudisha kk->watu;
}

// Mpangilio wa vita: jedwali la vikosi (kamili kwenye kichupo cha OOB).
w0 js_oob(Mchezo* g, n64 taifa, n64 mwaka, n64 x, n64 y, n64 w, n64 h, n32 pana) {
    n64* orodha = tenga(8 * VK_JUU_KWA_TAIFA);
    n64 n = vk_vya_taifa(taifa, orodha, VK_JUU_KWA_TAIFA);
    // mpangilio wa safuwima iliyobofywa (asili: mpangilio wa vikosi)
    n64 safu_ya_panga = kt_panga_safu_ya(KT_JEDWALI_OOB);
    kama (pana && safu_ya_panga >= 0) {
        n64* funguo = tenga(8 * VK_JUU_KWA_TAIFA);
        n64 q = 0;
        wakati (q < n) { funguo[q] = js_ufunguo_oob(vk_pata(orodha[q]), mwaka, safu_ya_panga); q = q + 1; }
        kt_panga_kwa_funguo(orodha, funguo, n, kt_panga_juu[KT_JEDWALI_OOB]);
        achilia funguo;
    }
    n8 k[96];
    mfuatano_umbiza(k, 96, ui("ORDER OF BATTLE  %d FORMATIONS"), n, 0, 0, 0, 0, 0);
    kt_paneli(x, y, w, h, k);
    n64 x_jina = x + 12;
    n64 x_mji = x + (w * 34) / 100;
    n64 c1 = x + (w * 48) / 100;
    kama (pana == 0) { x_mji = x + w; c1 = x + (w * 50) / 100; }
    n64 safuwima = 5;
    kama (pana) { safuwima = 9; }
    n64 hatua = (w - (c1 - x) - 12) / safuwima;
    n64 yh = y + 30;
    kama (pana) {
        kt_kichwa_p(ui("FORMATION"), x_jina, yh, 0, KT_JEDWALI_OOB, 0);
        kt_kichwa_p(ui("HOME"), x_mji, yh, 0, KT_JEDWALI_OOB, 1);
        kt_kichwa_p(ui("MEN"), c1 + hatua, yh, 1, KT_JEDWALI_OOB, 2);
        kt_kichwa_p(ui("STR"), c1 + 2 * hatua, yh, 1, KT_JEDWALI_OOB, 3);
        kt_kichwa_p(ui("EQUIP"), c1 + 3 * hatua, yh, 1, KT_JEDWALI_OOB, 4);
        kt_kichwa_p(ui("MORALE"), c1 + 4 * hatua, yh, 1, KT_JEDWALI_OOB, 5);
        kt_kichwa_p(ui("READY"), c1 + 5 * hatua, yh, 1, KT_JEDWALI_OOB, 6);
    } sivyo {
        kt_kichwa(ui("FORMATION"), x_jina, yh);
        kt_kichwa_kulia(ui("MEN"), c1 + hatua, yh);
        kt_kichwa_kulia(ui("STR"), c1 + 2 * hatua, yh);
        kt_kichwa_kulia(ui("EQUIP"), c1 + 3 * hatua, yh);
        kt_kichwa_kulia(ui("MORALE"), c1 + 4 * hatua, yh);
        kt_kichwa_kulia(ui("READY"), c1 + 5 * hatua, yh);
    }
    kama (pana) {
        kt_kichwa_p(ui("EXP"), c1 + 6 * hatua, yh, 1, KT_JEDWALI_OOB, 7);
        kt_kichwa_p(ui("VEH"), c1 + 7 * hatua, yh, 1, KT_JEDWALI_OOB, 8);
        kt_kichwa_p(ui("RAISED"), c1 + 8 * hatua, yh, 1, KT_JEDWALI_OOB, 9);
        kt_kichwa_p(ui("SCORE"), c1 + 9 * hatua, yh, 1, KT_JEDWALI_OOB, 10);
    }
    n64 safu_h = 18;
    n64 kwa_ukurasa = (h - 76) / safu_h;
    kama (kwa_ukurasa < 1) { kwa_ukurasa = 1; }
    n64 kurasa = (n + kwa_ukurasa - 1) / kwa_ukurasa;
    kama (kurasa < 1) { kurasa = 1; }
    kama (jeshi_ukurasa >= kurasa) { jeshi_ukurasa = kurasa - 1; }
    kama (jeshi_ukurasa < 0) { jeshi_ukurasa = 0; }
    n8 jina[96];
    n8 m[32];
    n64 r = 0;
    wakati (r < kwa_ukurasa && jeshi_ukurasa * kwa_ukurasa + r < n) {
        Kikosi* kk = vk_pata(orodha[jeshi_ukurasa * kwa_ukurasa + r]);
        n64 ry = yh + 16 + r * safu_h;
        kt_safu(x + 2, ry - 2, w - 4, safu_h, r, 0);
        vk_jina(kk, mwaka, jina, 96);
        turubai_kata(sura_t, x_jina, ry - 2, x_mji - x_jina - 8, safu_h);
        kama (pana == 0) { turubai_kata(sura_t, x_jina, ry - 2, c1 - x_jina - 8, safu_h); }
        kt_maandishi(jina, x_jina, ry, 11, SURA_MAANDISHI);
        turubai_kata_yote(sura_t);
        kama (pana) {
            turubai_kata(sura_t, x_mji, ry - 2, c1 - x_mji - 8, safu_h);
            kt_maandishi(js_mji(kk), x_mji, ry, 11, SURA_HAFIFU);
            turubai_kata_yote(sura_t);
        }
        sura_namba_fupi(m, kk->watu);
        kt_maandishi_kulia(m, c1 + hatua, ry, 11, SURA_MAANDISHI);
        n64 ujazo = 0;
        kama (kk->juu > 0) { ujazo = (kk->watu * 100) / kk->juu; }
        mfuatano_umbiza(m, 32, "%d%%", ujazo, 0, 0, 0, 0, 0);
        kt_maandishi_kulia(m, c1 + 2 * hatua, ry, 11, SURA_MAANDISHI);
        mfuatano_umbiza(m, 32, "%d%%", kk->vifaa / 10, 0, 0, 0, 0, 0);
        kt_maandishi_kulia(m, c1 + 3 * hatua, ry, 11, SURA_MAANDISHI);
        mfuatano_umbiza(m, 32, "%d%%", kk->morali / 10, 0, 0, 0, 0, 0);
        kt_maandishi_kulia(m, c1 + 4 * hatua, ry, 11, SURA_MAANDISHI);
        n64 tayari = vk_utayari(kk);
        mfuatano_umbiza(m, 32, "%d%%", tayari, 0, 0, 0, 0, 0);
        n64 rangi = SURA_MAANDISHI;
        kama (tayari >= 70) { rangi = SURA_CHANYA; }
        kama (tayari < 45) { rangi = SURA_HASI; }
        kt_maandishi_kulia(m, c1 + 5 * hatua, ry, 11, rangi);
        kama (pana) {
            sura_namba(m, kk->uzoefu / 10);
            kt_maandishi_kulia(m, c1 + 6 * hatua, ry, 11, SURA_HAFIFU);
            n64 vy = vk_vyombo(kk, mwaka);
            sura_namba(m, vy);
            kama (vy == 0) { nakili_mfuatano(m, "-"); }
            kt_maandishi_kulia(m, c1 + 7 * hatua, ry, 11, SURA_HAFIFU);
            mfuatano_umbiza(m, 32, "W%d", kk->zamu, 0, 0, 0, 0, 0);
            kt_maandishi_kulia(m, c1 + 8 * hatua, ry, 11, SURA_HAFIFU);
            sura_namba_fupi(m, vk_alama_ya(kk, mwaka));
            kt_maandishi_kulia(m, c1 + 9 * hatua, ry, 11, SURA_BAHARI);
        }
        r = r + 1;
    }
    mfuatano_umbiza(m, 32, ui("PAGE %d/%d"), jeshi_ukurasa + 1, kurasa, 0, 0, 0, 0);
    kt_maandishi(m, x + 12, y + h - 20, 10, SURA_HAFIFU);
    kama (jeshi_ukurasa > 0) { kt_kitufe("<PREV", x + w - 124, y + h - 24, 0, JS_UKURASA, 0 - 1); }
    kama (jeshi_ukurasa + 1 < kurasa) { kt_kitufe("NEXT>", x + w - 62, y + h - 24, 0, JS_UKURASA, 1); }
    achilia orodha;
}

// Ufunguo wa safuwima ya mizani kwa taifa t.
//   0 jina  1 kielezo  2 4W  3 askari  4 uwiano  5 uhamasishaji  6 1W  7 26W
//   8 utayari  9 vikosi  10 hasara  11 vitani  12 umbali
n64 js_ufunguo_mizani(Mchezo* g, n64 taifa, n64 t, n64 safu) {
    kama (safu == 0) { rudisha kt_ufunguo_wa_jina(dunia_taifa_mfumo_pata_kwa_faharisi(mchezo_pata_taifa(g), t)->jina); }
    kama (safu == 2) { rudisha hs_badiliko(t, HS_JESHI, 4); }
    kama (safu == 3 || safu == 4) { rudisha vk_jumla_ya(t); }
    kama (safu == 5) { rudisha vk_uhamasishaji[t]; }
    kama (safu == 6) { rudisha hs_badiliko(t, HS_JESHI, 1); }
    kama (safu == 7) { rudisha hs_badiliko(t, HS_JESHI, 26); }
    kama (safu == 8) { rudisha vk_utayari_wa_taifa(t); }
    kama (safu == 9) { rudisha vk_kt_mwanzo[t + 1] - vk_kt_mwanzo[t]; }
    kama (safu == 10) { rudisha vk_hasara[t]; }
    kama (safu == 11) { rudisha vk_vita_adui[t] >= 0; }
    kama (safu == 12) { rudisha jopo_umbali(taifa, t); }
    rudisha hs_pata(t, HS_JESHI, 0);
}

// Mizani ya nguvu: mataifa ya wigo (au ya karibu kwenye FORCES), yamepangwa
// kwa kielezo cha kijeshi, na uwiano wa askari wao kwa wetu.
w0 js_mizani(Mchezo* g, n64 taifa, n64 x, n64 y, n64 w, n64 h, n32 pana) {
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    n8 k[96];
    kama (pana) { mfuatano_umbiza(k, 96, ui("BALANCE OF FORCES  %s"), jopo_jina_la_wigo(), 0, 0, 0, 0, 0); }
    sivyo { nakili_mfuatano(k, ui("BALANCE OF FORCES  NEAREST NATIONS")); }
    kt_paneli(x, y, w, h, k);
    n64* orodha = tenga(8 * tm->idadi + 8);
    n64* karibu = tenga(8 * tm->idadi + 8);
    weka_sifuri(karibu, 8 * tm->idadi + 8);
    kama (pana == 0) {
        // mataifa ya karibu zaidi hadi jopo lijae (taifa hili likiwemo)
        n64 nafasi = (h - 50) / 18;
        karibu[taifa] = 1;
        n64 chaguliwa = 1;
        wakati (chaguliwa < nafasi && chaguliwa < tm->idadi) {
            n64 bora = 0 - 1;
            n64 j = 0;
            wakati (j < tm->idadi) {
                kama (karibu[j] == 0 && (bora < 0 || jopo_umbali(taifa, j) < jopo_umbali(taifa, bora))) { bora = j; }
                j = j + 1;
            }
            karibu[bora] = 1;
            chaguliwa = chaguliwa + 1;
        }
    }
    n64 n = 0;
    n64 i = 0;
    wakati (i < tm->idadi) {
        n32 ndani = jopo_inafaa(i);
        kama (pana == 0) { ndani = karibu[i] != 0; }
        kama (ndani) { orodha[n] = i; n = n + 1; }
        i = i + 1;
    }
    // mpangilio: kwa kielezo (kubwa kwanza), au safuwima iliyobofywa (pana)
    kt_panga_chaguo(KT_JEDWALI_MIZANI, 1, 0);
    n64 safu_ya_panga = 1;
    n32 ndogo_kwanza = 0;
    kama (pana) { safu_ya_panga = kt_panga_safu_ya(KT_JEDWALI_MIZANI); ndogo_kwanza = kt_panga_juu[KT_JEDWALI_MIZANI]; }
    n64* funguo = tenga(8 * tm->idadi + 8);
    i = 0;
    wakati (i < n) { funguo[i] = js_ufunguo_mizani(g, taifa, orodha[i], safu_ya_panga); i = i + 1; }
    kt_panga_kwa_funguo(orodha, funguo, n, ndogo_kwanza);
    achilia funguo;
    n64 c_jina = x + 52;
    n64 c1 = x + (w * 28) / 100;
    n64 safuwima = 5;
    kama (pana) { c1 = x + (w * 24) / 100; safuwima = 12; }
    n64 hatua = (w - (c1 - x) - 12) / safuwima;
    n64 yh = y + 30;
    kt_kichwa("CCY", x + 12, yh);
    kt_kichwa_p(ui("NATION"), c_jina, yh, 0, KT_JEDWALI_MIZANI, 0);
    kt_kichwa_p(ui("MIL"), c1 + hatua, yh, 1, KT_JEDWALI_MIZANI, 1);
    kt_kichwa_p("4W", c1 + 2 * hatua, yh, 1, KT_JEDWALI_MIZANI, 2);
    kt_kichwa_p(ui("MEN"), c1 + 3 * hatua, yh, 1, KT_JEDWALI_MIZANI, 3);
    kt_kichwa_p(ui("RATIO"), c1 + 4 * hatua, yh, 1, KT_JEDWALI_MIZANI, 4);
    kt_kichwa_p(ui("POSTURE"), c1 + 5 * hatua, yh, 1, KT_JEDWALI_MIZANI, 5);
    kama (pana) {
        kt_kichwa_p("1W", c1 + 6 * hatua, yh, 1, KT_JEDWALI_MIZANI, 6);
        kt_kichwa_p("26W", c1 + 7 * hatua, yh, 1, KT_JEDWALI_MIZANI, 7);
        kt_kichwa_p(ui("READY"), c1 + 8 * hatua, yh, 1, KT_JEDWALI_MIZANI, 8);
        kt_kichwa_p(ui("FMN"), c1 + 9 * hatua, yh, 1, KT_JEDWALI_MIZANI, 9);
        kt_kichwa_p(ui("LOSSES"), c1 + 10 * hatua, yh, 1, KT_JEDWALI_MIZANI, 10);
        kt_kichwa_p(ui("AT WAR"), c1 + 11 * hatua, yh, 1, KT_JEDWALI_MIZANI, 11);
        kt_kichwa_p("KM", c1 + 12 * hatua, yh, 1, KT_JEDWALI_MIZANI, 12);
    }
    n64 wetu = vk_jumla_ya(taifa);
    kama (wetu <= 0) { wetu = 1; }
    n8 m[48];
    n64 safu_h = 18;
    n64 kwa_ukurasa = (h - 50) / safu_h;
    n64 mwanzo = 0;
    kama (pana) {
        kwa_ukurasa = (h - 76) / safu_h;
        kama (jeshi_ukurasa * kwa_ukurasa >= n) { jeshi_ukurasa = 0; }
        mwanzo = jeshi_ukurasa * kwa_ukurasa;
    }
    n64 r = 0;
    wakati (r < kwa_ukurasa && mwanzo + r < n) {
        n64 t = orodha[mwanzo + r];
        n64 ry = yh + 16 + r * safu_h;
        kt_safu(x + 2, ry - 2, w - 4, safu_h, r, t == taifa);
        bofya_ongeza(x + 2, ry - 2, w - 4, safu_h, JOPO_FUNGUA, t);
        kt_maandishi(soko_sarafu_ya(t)->msimbo, x + 12, ry, 11, SURA_BAHARI);
        turubai_kata(sura_t, c_jina, ry - 2, c1 + hatua - 34 - c_jina, safu_h);
        kt_maandishi(dunia_taifa_mfumo_pata_kwa_faharisi(tm, t)->jina, c_jina, ry, 11, SURA_MAANDISHI);
        turubai_kata_yote(sura_t);
        sura_namba(m, hs_pata(t, HS_JESHI, 0));
        kt_maandishi_kulia(m, c1 + hatua, ry, 11, SURA_MAANDISHI);
        kama (hs_zilizopo() > 4) { n64 b4 = hs_badiliko(t, HS_JESHI, 4); kt_badiliko(m, b4); kt_maandishi_kulia(m, c1 + 2 * hatua, ry, 11, kt_rangi_ya_badiliko(b4)); }
        sivyo { kt_maandishi_kulia("-", c1 + 2 * hatua, ry, 11, SURA_HAFIFU); }
        sura_namba_fupi(m, vk_jumla_ya(t));
        kt_maandishi_kulia(m, c1 + 3 * hatua, ry, 11, SURA_MAANDISHI);
        n64 uw = (vk_jumla_ya(t) * 100) / wetu;
        mfuatano_umbiza(m, 48, "%d.%d%dx", uw / 100, (uw / 10) % 10, uw % 10, 0, 0, 0);
        kt_maandishi_kulia(m, c1 + 4 * hatua, ry, 11, SURA_HAFIFU);
        n64 u = vk_uhamasishaji[t];
        kama (u > 0) { kt_maandishi_kulia(vk_jina_fupi_la_uhamasishaji(u), c1 + 5 * hatua, ry, 11, SURA_HASI); }
        sivyo { kt_maandishi_kulia(vk_jina_fupi_la_uhamasishaji(u), c1 + 5 * hatua, ry, 11, SURA_HAFIFU); }
        kama (pana) {
            kama (hs_zilizopo() > 1) { n64 b1 = hs_badiliko(t, HS_JESHI, 1); kt_badiliko(m, b1); kt_maandishi_kulia(m, c1 + 6 * hatua, ry, 11, kt_rangi_ya_badiliko(b1)); }
            kama (hs_zilizopo() > 26) { n64 b26 = hs_badiliko(t, HS_JESHI, 26); kt_badiliko(m, b26); kt_maandishi_kulia(m, c1 + 7 * hatua, ry, 11, kt_rangi_ya_badiliko(b26)); }
            sivyo { kt_maandishi_kulia("-", c1 + 7 * hatua, ry, 11, SURA_HAFIFU); }
            mfuatano_umbiza(m, 48, "%d%%", vk_utayari_wa_taifa(t), 0, 0, 0, 0, 0);
            kt_maandishi_kulia(m, c1 + 8 * hatua, ry, 11, SURA_MAANDISHI);
            sura_namba(m, vk_kt_mwanzo[t + 1] - vk_kt_mwanzo[t]);
            kt_maandishi_kulia(m, c1 + 9 * hatua, ry, 11, SURA_HAFIFU);
            sura_namba_fupi(m, vk_hasara[t]);
            kt_maandishi_kulia(m, c1 + 10 * hatua, ry, 11, SURA_HAFIFU);
            kama (vk_vita_adui[t] >= 0) { kt_maandishi_kulia(soko_sarafu_ya(vk_vita_adui[t])->msimbo, c1 + 11 * hatua, ry, 11, SURA_HASI); }
            sivyo { kt_maandishi_kulia("-", c1 + 11 * hatua, ry, 11, SURA_HAFIFU); }
            kama (t != taifa) { sura_namba(m, jopo_umbali(taifa, t)); kt_maandishi_kulia(m, c1 + 12 * hatua, ry, 11, SURA_HAFIFU); }
        }
        r = r + 1;
    }
    achilia karibu;
    kama (pana) {
        n64 kurasa = (n + kwa_ukurasa - 1) / kwa_ukurasa;
        kama (kurasa < 1) { kurasa = 1; }
        mfuatano_umbiza(m, 48, ui("%d NATIONS  PAGE %d/%d"), n, jeshi_ukurasa + 1, kurasa, 0, 0, 0);
        kt_maandishi(m, x + 12, y + h - 20, 10, SURA_HAFIFU);
        kama (jeshi_ukurasa > 0) { kt_kitufe("<PREV", x + w - 124, y + h - 24, 0, JS_UKURASA, 0 - 1); }
        kama (jeshi_ukurasa + 1 < kurasa) { kt_kitufe("NEXT>", x + w - 62, y + h - 24, 0, JS_UKURASA, 1); }
    }
    achilia orodha;
}




// ======================================================================
// FORCES (kichupo cha kwanza): ukurasa wa picha badala ya majedwali.
//   juu      vigae vitano: askari (dhidi ya kikomo), utayari (pete), kielezo
//            (nafasi duniani na mwelekeo), nguvu kubwa jirani, uhamasishaji
//   kati     mpangilio wa vita kama kadi (picha ya aina, mji, askari, pete ya
//            utayari, vipau vya ujazo/vifaa/ari), muundo kwa matawi, na
//            amri kuu yenye nyuso na kipimo cha msimamo
//   chini    mizani ya nguvu (vipau vya mataifa ya karibu) na kielezo kwa wiki
// Picha za aina zinasema kikosi ni nini: kofia ya chuma (miguu), kiatu cha
// farasi (farasi), mzinga, kifaru, meli, ndege, nyota (vikosi maalum).
// ======================================================================

n64 js_rangi_ya_aina(n64 a) {
    kama (a == VK_MIGUU) { rudisha 7972863; }        // buluu
    kama (a == VK_FARASI) { rudisha 13148711; }       // dhahabu
    kama (a == VK_MIZINGA) { rudisha 14721112; }      // machungwa
    kama (a == VK_DERAYA) { rudisha 10135985; }       // kijivu-chuma
    kama (a == VK_MANOWARI) { rudisha 5999087; }      // bahari
    kama (a == VK_ANGA) { rudisha 5688562; }          // anga
    rudisha 11832027;                                 // zambarau
}

// Picha ya aina katikati ya (cx, cy), takriban 28x22, juu ya usuli `usuli`.
w0 js_ishara(n64 a, n64 cx, n64 cy, n64 rangi, n64 usuli) {
    turubai_brashi(sura_t, rangi, 255);
    kama (a == VK_MIGUU) {
        // kofia ya chuma: kuba na ukingo
        turubai_duara(sura_t, cx, cy + 3, 10);
        turubai_brashi(sura_t, usuli, 255);
        turubai_jaza(sura_t, cx - 11, cy + 4, 23, 11);
        turubai_brashi(sura_t, rangi, 255);
        turubai_mviringo(sura_t, cx - 13, cy + 3, 27, 4, 2);
        turubai_jaza(sura_t, cx - 6, cy + 7, 2, 4);
        rudisha;
    }
    kama (a == VK_FARASI) {
        // kiatu cha farasi: pete iliyo wazi chini, na misumari
        turubai_duara(sura_t, cx, cy, 10);
        turubai_brashi(sura_t, usuli, 255);
        turubai_duara(sura_t, cx, cy, 6);
        turubai_jaza(sura_t, cx - 5, cy + 1, 11, 11);
        turubai_brashi(sura_t, rangi, 255);
        turubai_jaza(sura_t, cx - 10, cy + 6, 5, 3);
        turubai_jaza(sura_t, cx + 6, cy + 6, 5, 3);
        turubai_brashi(sura_t, usuli, 255);
        turubai_jaza(sura_t, cx - 8, cy - 2, 2, 2);
        turubai_jaza(sura_t, cx + 7, cy - 2, 2, 2);
        turubai_jaza(sura_t, cx - 1, cy - 9, 2, 2);
        rudisha;
    }
    kama (a == VK_MIZINGA) {
        // mzinga: bomba lililoinuka na gurudumu
        turubai_mstari(sura_t, cx - 6, cy + 3, cx + 11, cy - 7, 1280);
        turubai_duara(sura_t, cx - 4, cy + 5, 7);
        turubai_brashi(sura_t, usuli, 255);
        turubai_duara(sura_t, cx - 4, cy + 5, 4);
        turubai_brashi(sura_t, rangi, 255);
        turubai_duara(sura_t, cx - 4, cy + 5, 2);
        turubai_mstari(sura_t, cx - 12, cy + 11, cx - 4, cy + 5, 512);
        rudisha;
    }
    kama (a == VK_DERAYA) {
        // kifaru: mnyororo, mwili, mnara na bomba
        turubai_mviringo(sura_t, cx - 13, cy + 3, 26, 8, 4);
        turubai_brashi(sura_t, usuli, 255);
        turubai_mviringo(sura_t, cx - 11, cy + 5, 22, 4, 2);
        turubai_brashi(sura_t, rangi, 255);
        turubai_jaza(sura_t, cx - 10, cy - 1, 20, 4);
        turubai_mviringo(sura_t, cx - 6, cy - 6, 11, 6, 2);
        turubai_mstari(sura_t, cx + 4, cy - 4, cx + 14, cy - 5, 512);
        rudisha;
    }
    kama (a == VK_MANOWARI) {
        // meli: tako la meli, mlingoti, tanga
        n64 r = 0;
        wakati (r < 6) { turubai_jaza(sura_t, cx - 13 + r, cy + 4 + r, 26 - 2 * r, 1); r = r + 1; }
        turubai_jaza(sura_t, cx - 1, cy - 11, 2, 15);
        r = 0;
        wakati (r < 12) { turubai_jaza(sura_t, cx + 2, cy - 10 + r, 1 + (r * 8) / 12, 1); r = r + 1; }
        r = 0;
        wakati (r < 9) { turubai_jaza(sura_t, cx - 2 - (r * 6) / 9, cy - 7 + r, (r * 6) / 9, 1); r = r + 1; }
        rudisha;
    }
    kama (a == VK_ANGA) {
        // ndege: mwili, mabawa, mkia
        turubai_mstari(sura_t, cx - 12, cy, cx + 12, cy, 768);
        turubai_mstari(sura_t, cx + 2, cy, cx - 4, cy - 10, 768);
        turubai_mstari(sura_t, cx + 2, cy, cx - 4, cy + 10, 768);
        turubai_mstari(sura_t, cx - 10, cy, cx - 13, cy - 5, 512);
        turubai_mstari(sura_t, cx - 10, cy, cx - 13, cy + 5, 512);
        rudisha;
    }
    // vikosi maalum: nyota
    turubai_mstari(sura_t, cx, cy - 10, cx + 6, cy + 9, 512);
    turubai_mstari(sura_t, cx + 6, cy + 9, cx - 10, cy - 3, 512);
    turubai_mstari(sura_t, cx - 10, cy - 3, cx + 10, cy - 3, 512);
    turubai_mstari(sura_t, cx + 10, cy - 3, cx - 6, cy + 9, 512);
    turubai_mstari(sura_t, cx - 6, cy + 9, cx, cy - 10, 512);
}

// Pete: sehemu (kwa elfu) ya mzunguko kuanzia juu kwa mwelekeo wa saa.
w0 js_pete(n64 cx, n64 cy, n64 r, n64 unene, n64 elfu, n64 rangi) {
    n64 r2 = r * r;
    n64 ri = r - unene;
    n64 ri2 = ri * ri;
    n64 kikomo = (elfu * 4096) / 1000;
    n64 dy = 0 - r;
    wakati (dy <= r) {
        n64 dx = 0 - r;
        wakati (dx <= r) {
            n64 d2 = dx * dx + dy * dy;
            kama (d2 <= r2 && d2 >= ri2) {
                n64 ax = dx;
                kama (ax < 0) { ax = 0 - ax; }
                n64 ay = dy;
                kama (ay < 0) { ay = 0 - ay; }
                n64 pp = 0;
                kama (ax + ay > 0) {
                    kama (dx >= 0 && dy < 0) { pp = (ax * 1024) / (ax + ay); }
                    sivyo kama (dx >= 0) { pp = 1024 + (ay * 1024) / (ax + ay); }
                    sivyo kama (dy >= 0) { pp = 2048 + (ax * 1024) / (ax + ay); }
                    sivyo { pp = 3072 + (ay * 1024) / (ax + ay); }
                }
                kama (pp < kikomo) { turubai_brashi(sura_t, rangi, 255); } sivyo { turubai_brashi(sura_t, 16777215, 24); }
                turubai_jaza(sura_t, cx + dx, cy + dy, 1, 1);
            }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
}

// Kigae: lebo, thamani kubwa, maelezo.
w0 js_kigae(n64 x, n64 y, n64 w, n64 h, n8* lebo, n8* thamani, n8* maelezo) {
    turubai_brashi(sura_t, SURA_PANELI, 255);
    turubai_mviringo(sura_t, x, y, w, h, 8);
    turubai_brashi(sura_t, 16777215, 16);
    turubai_mpaka(sura_t, x, y, w, h, 8);
    sura_rangi(SURA_HAFIFU);
    sura_lebo_kati(lebo, x + 16, y + 12, 11);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_nene(thamani, x + 16, y + 30, 26);
    sura_rangi(SURA_HAFIFU);
    turubai_kata(sura_t, x + 16, y + h - 26, w - 24, 18);
    sura_lebo(maelezo, x + 16, y + h - 24, 11);
    turubai_kata_yote(sura_t);
}

// Nafasi ya taifa duniani kwa kielezo cha kijeshi (1 = kubwa zaidi).
n64 js_nafasi_ya_kielezo(TaifaMfumo* tm, n64 taifa) {
    n64 v = dunia_taifa_mfumo_pata_kwa_faharisi(tm, taifa)->kielezo_cha_kijeshi;
    n64 n = 1;
    n64 i = 0;
    wakati (i < tm->idadi) { kama (dunia_taifa_mfumo_pata_kwa_faharisi(tm, i)->kielezo_cha_kijeshi > v) { n = n + 1; } i = i + 1; }
    rudisha n;
}

// Mataifa `n` ya karibu zaidi (taifa hili likiwemo), yamepangwa kwa kielezo.
n64 js_majirani(TaifaMfumo* tm, n64 taifa, n64* nje, n64 n) {
    n32* imo = tenga(4 * tm->idadi + 4);
    n64 i = 0;
    wakati (i < tm->idadi) { imo[i] = 0; i = i + 1; }
    imo[taifa] = 1;
    nje[0] = taifa;
    n64 k = 1;
    wakati (k < n && k < tm->idadi) {
        n64 bora = 0 - 1;
        i = 0;
        wakati (i < tm->idadi) { kama (imo[i] == 0 && (bora < 0 || jopo_umbali(taifa, i) < jopo_umbali(taifa, bora))) { bora = i; } i = i + 1; }
        imo[bora] = 1;
        nje[k] = bora;
        k = k + 1;
    }
    achilia imo;
    // panga kwa kielezo, kubwa kwanza
    i = 1;
    wakati (i < k) {
        n64 j = i;
        wakati (j > 0 && dunia_taifa_mfumo_pata_kwa_faharisi(tm, nje[j - 1])->kielezo_cha_kijeshi < dunia_taifa_mfumo_pata_kwa_faharisi(tm, nje[j])->kielezo_cha_kijeshi) {
            n64 t = nje[j]; nje[j] = nje[j - 1]; nje[j - 1] = t;
            j = j - 1;
        }
        i = i + 1;
    }
    rudisha k;
}

// Vigae vitano vya juu.
w0 js_vigae(Mchezo* g, n64 taifa, n64 x, n64 y, n64 w) {
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    TaifaNchi* tn = dunia_taifa_mfumo_pata_kwa_faharisi(tm, taifa);
    n64 p = 10;
    n64 kw = (w - 4 * p) / 5;
    n64 h = 96;
    n8 a[48];
    n8 b[48];
    n8 m[160];
    // askari dhidi ya kikomo
    n64 askari = vk_jumla_ya(taifa);
    n64 kikomo = vk_watu_lengo[taifa];
    n32 ni_katiba = taifa == vk_taifa_la_katiba && vk_kikomo_cha_katiba != 0;
    kama (ni_katiba) {
        kikomo = 0;
        n64 q = 0;
        wakati (q < VK_AINA) { kikomo = kikomo + vk_kikomo_cha_katiba[q] * 1000; q = q + 1; }
    }
    sura_namba(a, askari);
    sura_namba(b, kikomo);
    kama (ni_katiba) { mfuatano_umbiza(m, 160, ui("of %s allowed in peacetime"), b, 0, 0, 0, 0, 0); }
    sivyo { mfuatano_umbiza(m, 160, ui("target strength %s"), b, 0, 0, 0, 0, 0); }
    js_kigae(x, y, kw, h, ui("PERSONNEL"), a, m);
    kama (kikomo > 0) {
        n64 bx = x + 26 + maandishi_upana(sura_nene, a, 26);
        n64 bw = x + kw - 16 - bx;
        kama (bw > 30) {
            n64 jaza = (askari * bw) / kikomo;
            kama (jaza > bw) { jaza = bw; }
            turubai_brashi(sura_t, 16777215, 22);
            turubai_mviringo(sura_t, bx, y + 46, bw, 6, 3);
            turubai_brashi(sura_t, SURA_LAFUDHI, 255);
            turubai_mviringo(sura_t, bx, y + 46, jaza, 6, 3);
        }
    }
    // utayari
    n64 ut = vk_utayari_wa_taifa(taifa);
    mfuatano_umbiza(a, 48, "%d%%", ut, 0, 0, 0, 0, 0);
    mfuatano_umbiza(m, 160, ui("average of %d formations"), vk_kt_mwanzo[taifa + 1] - vk_kt_mwanzo[taifa], 0, 0, 0, 0, 0);
    n64 x1 = x + kw + p;
    js_kigae(x1, y, kw, h, ui("READINESS"), a, m);
    js_pete(x1 + kw - 44, y + 46, 26, 7, ut * 10, SURA_LAFUDHI);
    // kielezo
    n64 x2 = x1 + kw + p;
    sura_namba(a, tn->kielezo_cha_kijeshi);
    kt_badiliko(b, hs_badiliko(taifa, HS_JESHI, hs_zilizopo()));
    mfuatano_umbiza(m, 160, ui("%d of %d  ·  %s in %d weeks"), js_nafasi_ya_kielezo(tm, taifa), tm->idadi, b, hs_zilizopo(), 0, 0);
    js_kigae(x2, y, kw, h, ui("MILITARY INDEX"), a, m);
    n64 th[104];
    n64 nh = hs_mfululizo(taifa, HS_JESHI, 52, th);
    kama (nh >= 2) { sura_sparkline(th, nh, x2 + kw - 112, y + 26, 96, 30, SURA_BAHARI, 40); }
    // nguvu kubwa jirani
    n64 x3 = x2 + kw + p;
    n64 jirani[8];
    n64 nj = js_majirani(tm, taifa, jirani, 8);
    n64 kubwa = jirani[0];
    kama (kubwa == taifa && nj > 1) { kubwa = jirani[1]; }
    TaifaNchi* tk = dunia_taifa_mfumo_pata_kwa_faharisi(tm, kubwa);
    n64 wetu = tn->kielezo_cha_kijeshi;
    kama (wetu < 1) { wetu = 1; }
    n64 uw = (tk->kielezo_cha_kijeshi * 100) / wetu;
    n8* hali_ya_vita = ui("at peace");
    kama (vk_vita_adui[taifa] == kubwa) { hali_ya_vita = ui("at war with us"); }
    mfuatano_umbiza(m, 160, ui("index %d  ·  %d.%dx ours  ·  %s"), tk->kielezo_cha_kijeshi, uw / 100, (uw / 10) % 10, hali_ya_vita, 0, 0);
    js_kigae(x3, y, kw, h, ui("STRONGEST NEIGHBOUR"), tk->jina, m);
    bofya_ongeza(x3, y, kw, h, JOPO_FUNGUA, kubwa);
    // uhamasishaji
    n64 x4 = x3 + kw + p;
    js_kigae(x4, y, w - (x4 - x), h, ui("MOBILISATION"), vk_jina_la_uhamasishaji(vk_uhamasishaji[taifa]), "");
    n32 mimi = taifa == tm->faharisi_ya_taifa_la_mchezaji;
    n64 bx = x4 + 16;
    n64 q = 0;
    wakati (q < 4) {
        n8* lebo = ui("PEACE");
        kama (q == 1) { lebo = ui("ALERT"); }
        kama (q == 2) { lebo = ui("PARTIAL"); }
        kama (q == 3) { lebo = ui("FULL"); }
        n32 hai = vk_uhamasishaji[taifa] == q;
        n64 lw = maandishi_upana(sura_nene, lebo, 10) + 16;
        kama (hai) { turubai_brashi(sura_t, SURA_LAFUDHI, 255); } sivyo { turubai_brashi(sura_t, SURA_PANELI_JUU, 255); }
        turubai_mviringo(sura_t, bx, y + h - 30, lw, 20, 4);
        kama (hai) { sura_rangi(CHATI_GIZA); } sivyo { sura_rangi(SURA_MAANDISHI); }
        sura_lebo_nene(lebo, bx + 8, y + h - 27, 10);
        kama (mimi && (vk_vita_adui[taifa] < 0 || q >= VK_SEHEMU)) { bofya_ongeza(bx, y + h - 30, lw, 20, JS_UHAMASISHAJI, q); }
        bx = bx + lw + 4;
        q = q + 1;
    }
}

// Kipau kidogo chenye lebo chini yake.
w0 js_kipau(n64 x, n64 y, n64 w, n64 elfu, n64 rangi, n8* lebo) {
    turubai_brashi(sura_t, 16777215, 18);
    turubai_mviringo(sura_t, x, y, w, 4, 2);
    n64 jaza = (elfu * w) / 1000;
    kama (jaza > w) { jaza = w; }
    turubai_brashi(sura_t, rangi, 255);
    turubai_mviringo(sura_t, x, y, jaza, 4, 2);
    sura_rangi(SURA_HAFIFU);
    sura_lebo(lebo, x, y + 6, 9);
}

// Nakili `s` kwenye `nje` ikikatwa kwa "…" ili isizidi upana `w` (fonti nene/kati).
w0 js_fupisha(n8* s, n8* nje, n64 uwezo, n64 w, n64 px) {
    nakili_mfuatano(nje, s);
    kama (maandishi_upana(sura_kati, nje, px) <= w) { rudisha; }
    n64 n = urefu_wa_mfuatano(nje);
    wakati (n > 1) {
        n = n - 1;
        // usikate katikati ya herufi ya UTF-8
        wakati (n > 1 && (nje[n] & 192) == 128) { n = n - 1; }
        nje[n] = 0;
        n8 jaribu[200];
        mfuatano_umbiza(jaribu, 200, "%s…", nje, 0, 0, 0, 0, 0);
        kama (maandishi_upana(sura_kati, jaribu, px) <= w) { nakili_mfuatano(nje, jaribu); rudisha; }
    }
}

// Kadi ya kikosi kimoja.
w0 js_kadi(Kikosi* kk, n64 mwaka, n64 x, n64 y, n64 w, n64 h) {
    turubai_brashi(sura_t, SURA_PANELI_JUU, 255);
    turubai_mviringo(sura_t, x, y, w, h, 6);
    n64 rangi = js_rangi_ya_aina(kk->aina);
    js_ishara(kk->aina, x + 24, y + 22, rangi, SURA_PANELI_JUU);
    n8 jina[96];
    vk_jina(kk, mwaka, jina, 96);
    n8 fupi[200];
    js_fupisha(jina, fupi, 200, w - 86, 12);
    turubai_kata(sura_t, x + 44, y + 4, w - 80, 40);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_kati(fupi, x + 44, y + 8, 12);
    sura_rangi(SURA_HAFIFU);
    sura_lebo(js_mji(kk), x + 44, y + 25, 10);
    turubai_kata_yote(sura_t);
    n64 ut = vk_utayari(kk);
    js_pete(x + w - 20, y + 20, 11, 3, ut * 10, SURA_LAFUDHI);
    n8 m[48];
    sura_namba(m, kk->watu);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_nene(m, x + 12, y + 42, 14);
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("men"), x + 18 + maandishi_upana(sura_nene, m, 14), y + 46, 10);
    n64 sw = (w - 24 - 16) / 3;
    n64 ujazo = 0;
    kama (kk->juu > 0) { ujazo = (kk->watu * 1000) / kk->juu; }
    n8 l1[24];
    n8 l2[24];
    n8 l3[24];
    mfuatano_umbiza(l1, 24, ui("STR %d%%"), ujazo / 10, 0, 0, 0, 0, 0);
    mfuatano_umbiza(l2, 24, ui("EQP %d%%"), kk->vifaa / 10, 0, 0, 0, 0, 0);
    mfuatano_umbiza(l3, 24, ui("MOR %d%%"), kk->morali / 10, 0, 0, 0, 0, 0);
    js_kipau(x + 12, y + h - 20, sw, ujazo, rangi, l1);
    js_kipau(x + 12 + sw + 8, y + h - 20, sw, kk->vifaa, rangi, l2);
    js_kipau(x + 12 + 2 * (sw + 8), y + h - 20, sw, kk->morali, rangi, l3);
    // maelezo kamili kielekezi kikiwa juu
    n8 e[200];
    n8 w1[24];
    n8 w2[24];
    sura_namba(w1, kk->watu);
    sura_namba(w2, kk->juu);
    mfuatano_umbiza(e, 200, ui("%s of %s men  ·  ready %d%%  ·  experience %d%%  ·  raised week %d"), w1, w2, ut, kk->uzoefu / 10, kk->zamu, 0);
    elea_ongeza(x, y, w, h, jina, e);
}

// Mpangilio wa vita kama kadi.
w0 js_kadi_za_vikosi(Mchezo* g, n64 taifa, n64 mwaka, n64 x, n64 y, n64 w, n64 h) {
    n64* orodha = tenga(8 * VK_JUU_KWA_TAIFA);
    n64 n = vk_vya_taifa(taifa, orodha, VK_JUU_KWA_TAIFA);
    n8 k[96];
    mfuatano_umbiza(k, 96, ui("ORDER OF BATTLE  ·  %d FORMATIONS"), n, 0, 0, 0, 0, 0);
    sura_paneli(x, y, w, h, k);
    n64 safuwima = 4;
    kama (w < 760) { safuwima = 3; }
    n64 pg = 8;
    n64 cw = (w - 32 - (safuwima - 1) * pg) / safuwima;
    n64 ch = 84;
    n64 safu = (h - 48 - 24) / (ch + 6);
    kama (safu < 1) { safu = 1; }
    n64 kwa_ukurasa = safu * safuwima;
    n64 kurasa = (n + kwa_ukurasa - 1) / kwa_ukurasa;
    kama (kurasa < 1) { kurasa = 1; }
    kama (jeshi_ukurasa >= kurasa) { jeshi_ukurasa = kurasa - 1; }
    n64 i = jeshi_ukurasa * kwa_ukurasa;
    n64 j = 0;
    wakati (i < n && j < kwa_ukurasa) {
        n64 cx = x + 16 + (j % safuwima) * (cw + pg);
        n64 cy = y + 42 + (j / safuwima) * (ch + 6);
        js_kadi(vk_pata(orodha[i]), mwaka, cx, cy, cw, ch);
        i = i + 1;
        j = j + 1;
    }
    sura_rangi(SURA_HAFIFU);
    kama (kurasa > 1) {
        mfuatano_umbiza(k, 96, ui("page %d of %d"), jeshi_ukurasa + 1, kurasa, 0, 0, 0, 0);
        sura_lebo(k, x + 16, y + h - 22, 11);
        n64 bx = x + w - 80;
        kama (jeshi_ukurasa > 0) { kt_kitufe("<", bx, y + h - 28, 0, JS_UKURASA, 0 - 1); }
        kama (jeshi_ukurasa + 1 < kurasa) { kt_kitufe(">", bx + 36, y + h - 28, 0, JS_UKURASA, 1); }
    }
    sura_lebo_kulia(ui("Point at a formation for its full record; tab 2 lists every figure."), x + w - 16, y + 12, 11);
    achilia orodha;
}

// Muundo: kipau kimoja kilichogawanywa kwa matawi, na safu ya kila tawi.
w0 js_muundo(n64 taifa, n64 x, n64 y, n64 w, n64 h) {
    sura_paneli(x, y, w, h, ui("COMPOSITION  ·  MEN BY BRANCH"));
    n64 jumla = vk_jumla_ya(taifa);
    kama (jumla <= 0) { rudisha; }
    n64 vifaa[7];
    n64 ari[7];
    n64 idadi[7];
    n64 a = 0;
    wakati (a < VK_AINA) { vifaa[a] = 0; ari[a] = 0; idadi[a] = 0; a = a + 1; }
    n64 j = vk_kt_mwanzo[taifa];
    wakati (j < vk_kt_mwanzo[taifa + 1]) {
        Kikosi* kk = vk_pata(vk_kt[j]);
        vifaa[kk->aina] = vifaa[kk->aina] + kk->vifaa;
        ari[kk->aina] = ari[kk->aina] + kk->morali;
        idadi[kk->aina] = idadi[kk->aina] + 1;
        j = j + 1;
    }
    n64 bx = x + 16;
    n64 bw = w - 32;
    a = 0;
    wakati (a < VK_AINA) {
        n64 watu = vk_aina_watu[taifa * VK_AINA + a];
        kama (watu > 0) {
            n64 sw = (watu * bw) / jumla;
            turubai_brashi(sura_t, js_rangi_ya_aina(a), 255);
            turubai_jaza(sura_t, bx, y + 42, sw - 2, 16);
            n8 e[64];
            sura_namba(e, watu);
            elea_ongeza(bx, y + 42, sw, 16, vk_jina_fupi_la_aina(a), e);
            bx = bx + sw;
        }
        a = a + 1;
    }
    n64 ry = y + 70;
    n8 m[64];
    a = 0;
    wakati (a < VK_AINA && ry + 16 < y + h) {
        n64 watu = vk_aina_watu[taifa * VK_AINA + a];
        kama (watu > 0) {
            turubai_brashi(sura_t, js_rangi_ya_aina(a), 255);
            turubai_jaza(sura_t, x + 16, ry + 3, 8, 8);
            sura_rangi(SURA_MAANDISHI);
            sura_lebo(vk_jina_fupi_la_aina(a), x + 30, ry, 11);
            sura_namba(m, watu);
            sura_lebo_kulia(m, x + 30 + (w * 34) / 100, ry, 11);
            sura_rangi(SURA_HAFIFU);
            sura_asilimia(m, (watu * 10000) / jumla, 0);
            sura_lebo_kulia(m, x + 30 + (w * 50) / 100, ry, 11);
            kama (idadi[a] > 0) {
                mfuatano_umbiza(m, 64, ui("equipment %d%%  ·  morale %d%%"), vifaa[a] / idadi[a] / 10, ari[a] / idadi[a] / 10, 0, 0, 0, 0);
                sura_lebo(m, x + 40 + (w * 52) / 100, ry, 10);
            }
            ry = ry + 17;
        }
        a = a + 1;
    }
}

// Amri kuu: nyuso, cheo na tabia, na kipimo cha msimamo (-100..100).
w0 js_amri_kuu_nyuso(Mchezo* g, n64 taifa, n64 x, n64 y, n64 w, n64 h) {
    sura_paneli(x, y, w, h, ui("HIGH COMMAND"));
    Dola* d = skrini_siasa_dola(g, taifa);
    TaifaNchi* tn = dunia_taifa_mfumo_pata_kwa_faharisi(mchezo_pata_taifa(g), taifa);
    kama (d == 0 || tn == 0) { rudisha; }
    Wahusika* wh = wahusika_wa_taifa(taifa, d, tn->idadi_ya_watu);
    n64 mwaka = ny_mwaka_wa_zamu(g->zamu_ya_sasa);
    n64 ry = y + 40;
    n8 m[160];
    n64 i = 0;
    wakati (i < wh->idadi && ry + 34 < y + h) {
        MhusikaWaDola* mh = wahusika_pata(wh, i);
        kama (mh->tawi == TAWI_JESHI) {
            ny_chora_mhusika(sura_t, mh, d, taifa, mwaka, x + 30, ry + 15, 15);
            turubai_kata(sura_t, x + 52, ry, w - 52 - 150, 34);
            sura_rangi(SURA_MAANDISHI);
            sura_lebo_kati(mh->jina, x + 52, ry, 12);
            sura_rangi(SURA_HAFIFU);
            mfuatano_umbiza(m, 160, "%s  ·  %s, %s", mh->cheo, tabia_jina(mh->tabia_1), tabia_jina(mh->tabia_2), 0, 0, 0);
            sura_lebo(m, x + 52, ry + 17, 10);
            turubai_kata_yote(sura_t);
            // kipimo: katikati ni sifuri
            n64 mx = x + w - 136;
            n64 mw = 100;
            turubai_brashi(sura_t, 16777215, 20);
            turubai_mviringo(sura_t, mx, ry + 13, mw, 4, 2);
            turubai_brashi(sura_t, SURA_HAFIFU, 255);
            turubai_jaza(sura_t, mx + mw / 2, ry + 9, 1, 12);
            n64 mwisho = mx + mw / 2 + (mh->msimamo * (mw / 2)) / 100;
            n64 a0 = mx + mw / 2;
            n64 a1 = mwisho;
            kama (a1 < a0) { n64 t = a0; a0 = a1; a1 = t; }
            turubai_brashi(sura_t, SURA_LAFUDHI, 255);
            turubai_jaza(sura_t, a0, ry + 13, a1 - a0 + 1, 4);
            kt_badiliko(m, mh->msimamo);
            sura_rangi(SURA_MAANDISHI);
            sura_lebo(m, mx + mw + 6, ry + 7, 11);
            ry = ry + 38;
        }
        i = i + 1;
    }
}

// Mizani ya nguvu: vipau vya mataifa ya karibu kwa kielezo.
w0 js_mizani_vipau(Mchezo* g, n64 taifa, n64 x, n64 y, n64 w, n64 h) {
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    sura_paneli(x, y, w, h, ui("BALANCE OF POWER  ·  NEAREST NATIONS BY MILITARY INDEX"));
    n64 safu = (h - 50) / 22;
    kama (safu > 12) { safu = 12; }
    kama (safu < 2) { safu = 2; }
    n64 orodha[12];
    n64 n = js_majirani(tm, taifa, orodha, safu);
    n64 juu = 1;
    n64 i = 0;
    wakati (i < n) { n64 v = dunia_taifa_mfumo_pata_kwa_faharisi(tm, orodha[i])->kielezo_cha_kijeshi; kama (v > juu) { juu = v; } i = i + 1; }
    n64 wetu = dunia_taifa_mfumo_pata_kwa_faharisi(tm, taifa)->kielezo_cha_kijeshi;
    kama (wetu < 1) { wetu = 1; }
    n64 bh = (h - 50) / n;
    kama (bh > 26) { bh = 26; }
    n64 L = x + 130;
    n64 bw = w - 130 - 120;
    n8 m[64];
    i = 0;
    wakati (i < n) {
        TaifaNchi* t = dunia_taifa_mfumo_pata_kwa_faharisi(tm, orodha[i]);
        n64 ry = y + 42 + i * bh;
        n32 mimi = orodha[i] == taifa;
        kama (mimi) { sura_rangi(SURA_LAFUDHI); } sivyo { sura_rangi(SURA_MAANDISHI); }
        turubai_kata(sura_t, x + 16, ry, 110, bh);
        sura_lebo(t->jina, x + 16, ry + (bh - 14) / 2, 11);
        turubai_kata_yote(sura_t);
        n64 v = t->kielezo_cha_kijeshi;
        n64 len = (v * bw) / juu;
        kama (len < 2) { len = 2; }
        kama (mimi) { turubai_brashi(sura_t, SURA_LAFUDHI, 255); } sivyo { turubai_brashi(sura_t, t->rangi, 190); }
        turubai_mviringo(sura_t, L, ry + 3, len, bh - 7, 3);
        n64 uw = (v * 100) / wetu;
        mfuatano_umbiza(m, 64, "%d   %d.%d%dx", v, uw / 100, (uw / 10) % 10, uw % 10, 0, 0);
        kama (mimi) { sura_rangi(SURA_MAANDISHI); } sivyo { sura_rangi(SURA_HAFIFU); }
        sura_lebo(m, L + len + 8, ry + (bh - 14) / 2, 11);
        kama (vk_vita_adui[taifa] == orodha[i]) { sura_rangi(SURA_HASI); sura_lebo(ui("at war"), L + len + 90, ry + (bh - 14) / 2, 11); }
        bofya_ongeza(x + 8, ry, w - 16, bh, JOPO_FUNGUA, orodha[i]);
        i = i + 1;
    }
}

// Ukurasa wa FORCES.
w0 js_forces_chora(Mchezo* g, n64 taifa, n64 mwaka, n64 x, n64 y, n64 w, n64 h) {
    n64 p = 10;
    js_vigae(g, taifa, x, y, w);
    n64 y2 = y + 96 + p;
    n64 baki = h - 96 - p;
    // kadi: safu nne zikitosha (vikosi 16 bila kurasa), kisha mizani chini
    n64 h2 = 48 + 4 * 90 + 28;
    kama (h2 > baki - 200) { h2 = (baki * 62) / 100; }
    n64 h3 = baki - h2 - p;
    n64 wl = (w * 62) / 100;
    js_kadi_za_vikosi(g, taifa, mwaka, x, y2, wl, h2);
    n64 xr = x + wl + p;
    n64 wr = w - wl - p;
    n64 h_mu = 70 + 17 * 4 + 10;
    js_muundo(taifa, xr, y2, wr, h_mu);
    js_amri_kuu_nyuso(g, taifa, xr, y2 + h_mu + p, wr, h2 - h_mu - p);
    kama (h3 > 120) {
        n64 y3 = y2 + h2 + p;
        js_mizani_vipau(g, taifa, x, y3, wl, h3);
        n8 k[64];
        mfuatano_umbiza(k, 64, ui("MILITARY INDEX  ·  %d WEEKS"), hs_zilizopo(), 0, 0, 0, 0, 0);
        sura_paneli(xr, y3, wr, h3, k);
        kt_chati_ya_historia(taifa, HS_JESHI, xr + 16, y3 + 40, wr - 32, h3 - 54, SURA_BAHARI);
    }
}

// Bofya kwenye kituo cha ulinzi; hurudisha 1 ikiwa kitendo kilifanyika.
n32 skrini_jeshi_bofya(Mchezo* g, n64 taifa, n64 px, n64 py) {
    n64 hoja = 0;
    n64 k = bofya_tafuta(px, py, &hoja);
    kama (k == JS_UHAMASISHAJI) { vk_weka_uhamasishaji(taifa, hoja); rudisha 1; }
    kama (k == JS_UKURASA) { jeshi_ukurasa = jeshi_ukurasa + hoja; kama (jeshi_ukurasa < 0) { jeshi_ukurasa = 0; } rudisha 1; }
    kama (k == JS_TABO) { js_tabo = hoja; jeshi_ukurasa = 0; rudisha 1; }
    kama (k == KT_PANGA_SAFU) { kt_panga_bofya(hoja); jeshi_ukurasa = 0; rudisha 1; }
    rudisha 0;
}

w0 skrini_jeshi_chora(Mchezo* g, Turubai* t, n64 taifa) {
    sura_anzisha(t);
    bofya_anza();
    turubai_brashi(t, SURA_USULI, 255);
    turubai_jaza(t, 0, 0, t->upana, t->kimo);
    skrini_upau_wa_juu(g, t);
    skrini_urambazaji(t, 3);
    kama (vk_mataifa == 0 || soko_sarafu_ya(taifa) == 0) { rudisha; }
    jopo_weka_kituo(g, taifa);
    n64 mwaka = vk_mwaka(g->zamu_ya_sasa);
    n64 x = SKRINI_UPANA_WA_PEMBENI + 8;
    n64 y = SKRINI_UPAU_WA_JUU + 6;
    n64 w = t->upana - x - 8;
    js_amri(g, taifa, x, y, w);
    y = y + 32;
    kama (js_tabo == 0) {
        js_forces_chora(g, taifa, mwaka, x + 2, y + 4, w - 4, t->kimo - y - 14);
        rudisha;
    }
    js_mstari(g, taifa, x, y, w);
    y = y + 28;
    n64 h = t->kimo - y - 8;
    kama (js_tabo == 1) { js_oob(g, taifa, mwaka, x, y, w, h, 1); rudisha; }
    js_mizani(g, taifa, x, y, w, h, 1);
}
