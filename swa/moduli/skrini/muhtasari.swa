husisha { moduli/onyesho/sura.swa }
husisha { moduli/onyesho/vipengele.swa }
husisha { moduli/mchezo.swa }
husisha { moduli/injini/tarehe.swa }

// muhtasari.swa -- skrini ya muhtasari wa dunia: upau wa juu, urambazaji,
// kadi nne za takwimu, jedwali la mataifa (limepangwa kwa pato ghafi),
// historia ya pato ghafi, na viashiria vya taifa la mchezaji.
//
// Kila namba inasomwa kutoka Mchezo -- hakuna thamani ya mfano. Pato ghafi
// ni uchumi.pato_ghafi ya uigaji (watu x tija), ile ile ya historia ya GDP.

n64 SKRINI_UPAU_WA_JUU = 64;
n64 SKRINI_UPANA_WA_PEMBENI = 200;

// Pato ghafi la taifa kwa vizio kamili (uchumi.pato_ghafi ni milioni).
n64 skrini_pato_la_taifa(TaifaNchi* t) {
    d64 jumla = t->uchumi.pato_ghafi * 1000000.0;
    n64 v = jumla;
    rudisha v;
}

// Skrini inapochorwa ndani ya dirisha linaloelea, fremu ya mchezo (upau wa
// juu na urambazaji) haichorwi: dirisha lina kichwa chake.
n64 skrini_bila_fremu = 0;

// ---------- fremu ya mchezo: upau wa juu na urambazaji wa pembeni ----------
//
// Mtindo wa FM: upau wa juu wenye nembo ya taifa, jina na muktadha wake,
// sanduku la tarehe na kitufe cha njano cha "Continue" (zamu inayofuata);
// pembeni kushoto, urambazaji kwa vikundi (PORTAL, STATE, NATION) wenye
// ikoni na lebo, kipengele hai kikiwa na mstari wa njano.

// Maandishi meusi juu ya rangi angavu (kitufe cha Continue, beji).
n64 CHATI_GIZA_YA_JUU = 659488;          // 0x0A1020

n64 SKRINI_NAV_IDADI = 15;
n64 skrini_nav_beji_kikasha = 0;        // ujumbe usiosomwa (huwekwa na programu)
n64 SKRINI_NAV_SAFU = 36;
n64 SKRINI_NAV_KICHWA = 30;

// Skrini ya kipengele i cha urambazaji (kwa mpangilio wa kuonyeshwa).
n64 skrini_nav_skrini(n64 i) {
    kama (i == 0) { rudisha 7; }        // Ramani
    kama (i == 1) { rudisha 13; }       // Wasifu wa mchezaji
    kama (i == 2) { rudisha 0; }        // Muhtasari wa taifa (dashibodi)
    kama (i == 3) { rudisha 11; }       // Kikasha
    kama (i == 4) { rudisha 12; }       // Kalenda
    kama (i == 5) { rudisha 10; }       // Dunia: mataifa yote
    kama (i == 6) { rudisha 2; }        // Siasa
    kama (i == 7) { rudisha 9; }        // Serikali
    kama (i == 8) { rudisha 14; }       // Katiba
    kama (i == 9) { rudisha 3; }        // Jeshi
    kama (i == 10) { rudisha 4; }       // Diplomasia
    kama (i == 11) { rudisha 1; }       // Uchumi
    kama (i == 12) { rudisha 5; }       // Utamaduni
    kama (i == 13) { rudisha 6; }       // Teknolojia
    rudisha 8;                          // Mipangilio
}

n8* skrini_nav_jina(n64 i) {
    kama (i == 0) { rudisha ui("Map"); }
    kama (i == 1) { rudisha ui("Profile"); }
    kama (i == 2) { rudisha ui("Overview"); }
    kama (i == 3) { rudisha ui("Inbox"); }
    kama (i == 4) { rudisha ui("Calendar"); }
    kama (i == 5) { rudisha ui("World"); }
    kama (i == 6) { rudisha ui("Politics"); }
    kama (i == 7) { rudisha ui("Government"); }
    kama (i == 8) { rudisha ui("Constitution"); }
    kama (i == 9) { rudisha ui("Military"); }
    kama (i == 10) { rudisha ui("Diplomacy"); }
    kama (i == 11) { rudisha ui("Economy"); }
    kama (i == 12) { rudisha ui("Culture"); }
    kama (i == 13) { rudisha ui("Technology"); }
    rudisha ui("Settings");
}

// Kichwa cha kikundi kinachoanzia kabla ya kipengele i, au 0.
n8* skrini_nav_kikundi(n64 i) {
    kama (i == 0) { rudisha ui("Portal"); }
    kama (i == 6) { rudisha ui("State"); }
    kama (i == 11) { rudisha ui("Nation"); }
    rudisha 0;
}

// y ya juu ya kipengele i. Mipangilio hukaa chini kabisa.
n64 skrini_nav_y(n64 i, n64 kimo) {
    kama (i == SKRINI_NAV_IDADI - 1) { rudisha kimo - 18 - SKRINI_NAV_SAFU; }
    n64 y = SKRINI_UPAU_WA_JUU + 10;
    n64 k = 0;
    wakati (k <= i) {
        kama (skrini_nav_kikundi(k) != 0) { y = y + SKRINI_NAV_KICHWA; }
        kama (k < i) { y = y + SKRINI_NAV_SAFU; }
        k = k + 1;
    }
    rudisha y;
}

// Kipengele kilicho chini ya (px, py), au -1.
n64 skrini_nav_chini_ya(n64 px, n64 py, n64 kimo) {
    kama (px >= SKRINI_UPANA_WA_PEMBENI || py < SKRINI_UPAU_WA_JUU) { rudisha 0 - 1; }
    n64 i = 0;
    wakati (i < SKRINI_NAV_IDADI) {
        n64 y = skrini_nav_y(i, kimo);
        kama (py >= y && py < y + SKRINI_NAV_SAFU) { rudisha i; }
        i = i + 1;
    }
    rudisha 0 - 1;
}

// Ikoni ya mstari ya skrini `skrini` katikati ya (cx, cy); `chini` ni rangi
// ya usuli (kwa kutoboa maumbo yaliyojazwa).
w0 skrini_nav_ikoni(Turubai* t, n64 skrini, n64 cx, n64 cy, n64 rangi, n64 chini) {
    n64 m = 2 * 256;
    turubai_brashi(t, rangi, 255);
    kama (skrini == 7) {                                // ramani iliyokunjwa
        turubai_mpaka(t, cx - 9, cy - 7, 18, 14, 2);
        turubai_mstari(t, cx - 3, cy - 7, cx - 3, cy + 7, m);
        turubai_mstari(t, cx + 3, cy - 7, cx + 3, cy + 7, m);
        rudisha;
    }
    kama (skrini == 14) {                               // hati: ukurasa wenye mistari
        turubai_mpaka(t, cx - 7, cy - 9, 14, 18, 2);
        turubai_jaza(t, cx - 4, cy - 5, 8, 2);
        turubai_jaza(t, cx - 4, cy - 1, 8, 2);
        turubai_jaza(t, cx - 4, cy + 3, 5, 2);
        rudisha;
    }
    kama (skrini == 13) {                               // mtu: kichwa na mabega
        turubai_duara(t, cx, cy - 4, 4);
        turubai_mviringo(t, cx - 8, cy + 2, 16, 7, 3);
        rudisha;
    }
    kama (skrini == 0) {                                // nyumba
        turubai_mstari(t, cx - 9, cy - 1, cx, cy - 9, m);
        turubai_mstari(t, cx, cy - 9, cx + 9, cy - 1, m);
        turubai_jaza(t, cx - 6, cy - 1, 12, 9);
        turubai_brashi(t, chini, 255);
        turubai_jaza(t, cx - 2, cy + 3, 4, 5);
        rudisha;
    }
    kama (skrini == 2) {                                // jengo la nguzo
        turubai_mstari(t, cx - 9, cy - 4, cx, cy - 9, m);
        turubai_mstari(t, cx, cy - 9, cx + 9, cy - 4, m);
        turubai_jaza(t, cx - 7, cy - 3, 3, 9);
        turubai_jaza(t, cx - 1, cy - 3, 3, 9);
        turubai_jaza(t, cx + 5, cy - 3, 3, 9);
        turubai_jaza(t, cx - 9, cy + 7, 18, 2);
        rudisha;
    }
    kama (skrini == 9) {                                // watu wawili
        turubai_duara(t, cx - 4, cy - 4, 3);
        turubai_duara(t, cx + 5, cy - 3, 3);
        turubai_mviringo(t, cx - 9, cy + 1, 10, 8, 4);
        turubai_mviringo(t, cx + 1, cy + 2, 9, 7, 4);
        rudisha;
    }
    kama (skrini == 3) {                                // ngao
        turubai_jaza(t, cx - 7, cy - 8, 14, 9);
        n64 j = 0;
        wakati (j < 8) {
            turubai_jaza(t, cx - 7 + j, cy + 1 + j, 14 - 2 * j, 1);
            j = j + 1;
        }
        turubai_brashi(t, chini, 255);
        turubai_jaza(t, cx - 1, cy - 5, 2, 9);
        rudisha;
    }
    kama (skrini == 4) {                                // dunia
        turubai_duara(t, cx, cy, 9);
        turubai_brashi(t, chini, 255);
        turubai_duara(t, cx, cy, 7);
        turubai_brashi(t, rangi, 255);
        turubai_mstari(t, cx - 8, cy, cx + 8, cy, m);
        turubai_mstari(t, cx, cy - 8, cx, cy + 8, m);
        rudisha;
    }
    kama (skrini == 11) {                               // bahasha
        turubai_mpaka(t, cx - 9, cy - 6, 18, 13, 2);
        turubai_mstari(t, cx - 8, cy - 5, cx, cy + 1, m);
        turubai_mstari(t, cx, cy + 1, cx + 8, cy - 5, m);
        rudisha;
    }
    kama (skrini == 12) {                               // kalenda
        turubai_mpaka(t, cx - 9, cy - 7, 18, 16, 2);
        turubai_jaza(t, cx - 9, cy - 7, 18, 4);
        turubai_jaza(t, cx - 5, cy - 10, 2, 4);
        turubai_jaza(t, cx + 3, cy - 10, 2, 4);
        turubai_jaza(t, cx - 5, cy + 1, 3, 3);
        turubai_jaza(t, cx + 1, cy + 1, 3, 3);
        rudisha;
    }
    kama (skrini == 10) {                               // orodha ya nafasi
        turubai_jaza(t, cx - 9, cy - 7, 3, 3);
        turubai_jaza(t, cx - 4, cy - 7, 13, 3);
        turubai_jaza(t, cx - 9, cy - 1, 3, 3);
        turubai_jaza(t, cx - 4, cy - 1, 10, 3);
        turubai_jaza(t, cx - 9, cy + 5, 3, 3);
        turubai_jaza(t, cx - 4, cy + 5, 7, 3);
        rudisha;
    }
    kama (skrini == 1) {                                // pau za chati
        turubai_jaza(t, cx - 8, cy + 1, 4, 7);
        turubai_jaza(t, cx - 2, cy - 4, 4, 12);
        turubai_jaza(t, cx + 4, cy - 8, 4, 16);
        rudisha;
    }
    kama (skrini == 5) {                                // kitabu kilichofunguliwa
        turubai_mpaka(t, cx - 9, cy - 7, 9, 14, 1);
        turubai_mpaka(t, cx, cy - 7, 9, 14, 1);
        rudisha;
    }
    kama (skrini == 6) {                                // chipu
        turubai_mpaka(t, cx - 6, cy - 6, 12, 12, 2);
        turubai_jaza(t, cx - 2, cy - 2, 4, 4);
        turubai_jaza(t, cx - 9, cy - 3, 3, 2);
        turubai_jaza(t, cx - 9, cy + 1, 3, 2);
        turubai_jaza(t, cx + 6, cy - 3, 3, 2);
        turubai_jaza(t, cx + 6, cy + 1, 3, 2);
        rudisha;
    }
    // mipangilio: gia
    turubai_duara(t, cx, cy, 8);
    turubai_brashi(t, chini, 255);
    turubai_duara(t, cx, cy, 5);
    turubai_brashi(t, rangi, 255);
    turubai_duara(t, cx, cy, 2);
}

// Kitufe cha "Continue" (zamu inayofuata) kwenye upau wa juu.
n64 skrini_endelea_x(n64 upana) { rudisha upana - 212; }
n64 SKRINI_ENDELEA_UPANA = 196;

// Sanduku la mtu anayeshikwa na mchezaji (hujazwa na programu) hukaa kabla
// ya sanduku la tarehe.
n64 skrini_tarehe_x(n64 upana) { rudisha skrini_endelea_x(upana) - 168; }
n64 skrini_mtu_x(n64 upana) { rudisha skrini_tarehe_x(upana) - 300; }

// Nafasi ya taifa kwa pato ghafi (1 = kubwa zaidi).
n64 skrini_nafasi_ya_pato(TaifaMfumo* tm, TaifaNchi* tn) {
    n64 p = skrini_pato_la_taifa(tn);
    n64 nafasi = 1;
    n64 i = 0;
    wakati (i < tm->idadi) {
        TaifaNchi* x = dunia_taifa_mfumo_pata_kwa_faharisi(tm, i);
        kama (x != 0 && skrini_pato_la_taifa(x) > p) { nafasi = nafasi + 1; }
        i = i + 1;
    }
    rudisha nafasi;
}

// Upau wa juu: mishale, nembo ya taifa, jina na muktadha, tarehe, Continue.
w0 skrini_upau_wa_juu(Mchezo* g, Turubai* t) {
    kama (skrini_bila_fremu) { rudisha; }
    turubai_brashi(t, SURA_PANELI, 255);
    turubai_jaza(t, 0, 0, t->upana, SKRINI_UPAU_WA_JUU);
    turubai_brashi(t, 0, 90);
    turubai_jaza(t, 0, SKRINI_UPAU_WA_JUU - 1, t->upana, 1);
    // mishale ya nyuma/mbele na jina la mchezo juu ya urambazaji
    sura_ikoni(48, 32, 12, SURA_ICON_ARROW_LEFT, SURA_HAFIFU, 200);
    sura_ikoni(84, 32, 12, SURA_ICON_ARROW_RIGHT, SURA_MAANDISHI, 230);
    sura_rangi(SURA_LAFUDHI);
    sura_lebo_nene("DOMINION", 112, 21, 13);

    TaifaMfumo* tm = mchezo_pata_taifa(g);
    TaifaNchi* mchezaji = dunia_taifa_mfumo_pata_kwa_faharisi(tm, tm->faharisi_ya_taifa_la_mchezaji);
    n64 x_mtu = skrini_mtu_x(t->upana);
    kama (mchezaji != 0) {
        // nembo: bendera ya rangi ya taifa yenye ukingo
        n64 xb = SKRINI_UPANA_WA_PEMBENI + 22;
        turubai_brashi(t, mchezaji->rangi, 255);
        turubai_mviringo(t, xb, 18, 34, 26, 4);
        turubai_brashi(t, 16777215, 60);
        turubai_mpaka(t, xb, 18, 34, 26, 4);
        sura_rangi(SURA_MAANDISHI);
        sura_lebo_nene(mchezaji->jina, xb + 50, 14, 24);
        n64 xm = xb + 50 + maandishi_upana(sura_nene, mchezaji->jina, 24) + 18;
        n8 chombo[160];
        n8 a1[16];
        n8 a2[16];
        n8 a3[24];
        sura_namba(a1, skrini_nafasi_ya_pato(tm, mchezaji));
        sura_namba(a2, tm->idadi);
        sura_namba_fupi(a3, mchezaji->idadi_ya_watu);
        mfuatano_umbiza(chombo, 160, ui("%s of %s by GDP  ·  %s people"), a1, a2, a3, 0, 0, 0);
        turubai_kata(t, 0, 0, x_mtu - 16, SKRINI_UPAU_WA_JUU);
        sura_rangi(SURA_MAANDISHI);
        sura_lebo(chombo, xm, 24, 14);
        turubai_kata_yote(t);
    }
    // tarehe na zamu
    n64 xt = skrini_tarehe_x(t->upana);
    turubai_brashi(t, SURA_USULI, 255);
    turubai_mviringo(t, xt, 10, 156, 44, 4);
    turubai_brashi(t, 16777215, 30);
    turubai_mpaka(t, xt, 10, 156, 44, 4);
    n8 tarehe[48];
    tarehe_maandishi_mafupi(tarehe_siku_ya_zamu(g->zamu_ya_sasa), tarehe, 48);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_nene(tarehe, xt + 12, 14, 14);
    n8 zamu[32];
    n8 namba[16];
    sura_namba(namba, g->zamu_ya_sasa);
    mfuatano_umbiza(zamu, 32, ui("Turn %s  ·  one week"), namba, 0, 0, 0, 0, 0);
    sura_rangi(SURA_HAFIFU);
    sura_lebo(zamu, xt + 12, 34, 11);
    // Continue: njano, hupeleka zamu inayofuata
    // Continue: sehemu kuu husonga kwa kipindi kilichochaguliwa; mshale wa
    // kulia hufungua orodha ya vipindi
    n64 xe = skrini_endelea_x(t->upana);
    turubai_brashi(t, SURA_LAFUDHI, 255);
    turubai_mviringo(t, xe, 10, SKRINI_ENDELEA_UPANA, 44, 4);
    turubai_brashi(t, CHATI_GIZA_YA_JUU, 255);
    maandishi_chora(t, sura_nene, ui("Continue"), xe + 16, 14, 15);
    maandishi_chora(t, sura_kawaida, skrini_kipindi_jina(skrini_kipindi), xe + 16, 33, 11);
    turubai_brashi(t, CHATI_GIZA_YA_JUU, 60);
    turubai_jaza(t, xe + SKRINI_ENDELEA_UPANA - SKRINI_ENDELEA_MSHALE, 16, 1, 32);
    sura_ikoni(xe + SKRINI_ENDELEA_UPANA - SKRINI_ENDELEA_MSHALE / 2, 32, 11, SURA_ICON_ARROW_DOWN, CHATI_GIZA_YA_JUU, 255);
}

// ---------- vipindi vya kusonga ----------
//
// Zamu ya uigaji ni wiki moja. Mchezaji huchagua kipindi cha kusonga kwa
// kila Continue: wiki moja, mwezi mmoja (hadi mwezi ubadilike), miezi
// mitatu, au hadi tukio kubwa linalofuata (ombi, tahadhari au mkutano
// kwenye shajara; si zaidi ya miezi sita).

n64 KIPINDI_WIKI = 0;
n64 KIPINDI_MWEZI = 1;
n64 KIPINDI_MIEZI_MITATU = 2;
n64 KIPINDI_TUKIO = 3;
n64 KIPINDI_IDADI = 4;
n64 SKRINI_ENDELEA_MSHALE = 40;         // upana wa mshale wa orodha ya vipindi

n64 skrini_kipindi = 0;                 // kipindi kilichochaguliwa
n64 skrini_kipindi_wazi = 0;            // orodha ya vipindi imefunguliwa

n8* skrini_kipindi_jina(n64 k) {
    kama (k == KIPINDI_MWEZI) { rudisha ui("One month"); }
    kama (k == KIPINDI_MIEZI_MITATU) { rudisha ui("Three months"); }
    kama (k == KIPINDI_TUKIO) { rudisha ui("Until the next event"); }
    rudisha ui("One week");
}

// Orodha ya vipindi chini ya kitufe cha Continue.
n64 SKRINI_KIPINDI_SAFU = 40;

n64 skrini_kipindi_y(n64 k) { rudisha 62 + k * SKRINI_KIPINDI_SAFU; }

w0 skrini_kipindi_chora(Turubai* t) {
    kama (skrini_kipindi_wazi == 0) { rudisha; }
    n64 x = skrini_endelea_x(t->upana);
    n64 w = SKRINI_ENDELEA_UPANA;
    n64 h = KIPINDI_IDADI * SKRINI_KIPINDI_SAFU + 8;
    turubai_brashi(t, 0, 90);
    turubai_mviringo(t, x + 2, 60, w, h, 8);
    turubai_brashi(t, SURA_PANELI_JUU, 255);
    turubai_mviringo(t, x, 56, w, h, 8);
    turubai_brashi(t, 16777215, 24);
    turubai_mpaka(t, x, 56, w, h, 8);
    n64 k = 0;
    wakati (k < KIPINDI_IDADI) {
        n64 y = skrini_kipindi_y(k);
        kama (k == skrini_kipindi) {
            turubai_brashi(t, SURA_LAFUDHI, 30);
            turubai_mviringo(t, x + 4, y, w - 8, SKRINI_KIPINDI_SAFU - 4, 6);
            sura_rangi(SURA_LAFUDHI);
        } sivyo { sura_rangi(SURA_MAANDISHI); }
        sura_lebo_kati(skrini_kipindi_jina(k), x + 16, y + 9, 13);
        k = k + 1;
    }
}

// Kipindi kilicho chini ya (px, py) kwenye orodha, au -1.
n64 skrini_kipindi_chini_ya(n64 upana, n64 px, n64 py) {
    kama (skrini_kipindi_wazi == 0) { rudisha 0 - 1; }
    n64 x = skrini_endelea_x(upana);
    kama (px < x || px >= x + SKRINI_ENDELEA_UPANA) { rudisha 0 - 1; }
    n64 k = 0;
    wakati (k < KIPINDI_IDADI) {
        n64 y = skrini_kipindi_y(k);
        kama (py >= y && py < y + SKRINI_KIPINDI_SAFU) { rudisha k; }
        k = k + 1;
    }
    rudisha 0 - 1;
}

// Herufi kubwa za ASCII (majina ya ndani ya dunia ni ya Kilatini).
w0 skrini_herufi_kubwa(n8* nje, n64 uwezo, n8* s) {
    n64 i = 0;
    wakati (s[i] != 0 && i < uwezo - 1) {
        n64 c = s[i] & 255;
        kama (c >= 97 && c <= 122) { c = c - 32; }
        nje[i] = c;
        i = i + 1;
    }
    nje[i] = 0;
}

// Kichwa cha ukurasa kwa mtindo wa FM: muktadha mdogo juu ("CHEQING ·
// 1900"), jina la ukurasa kwa herufi kubwa nzito, na maelezo chini yake.
// Hutumia kimo cha takriban 58.
w0 skrini_kichwa_fm(Mchezo* g, Turubai* t, n8* kichwa, n8* maelezo, n64 x, n64 y) {
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    TaifaNchi* mchezaji = dunia_taifa_mfumo_pata_kwa_faharisi(tm, tm->faharisi_ya_taifa_la_mchezaji);
    n64 mwaka = 0;
    n64 mwezi = 0;
    n64 siku = 0;
    tarehe_ya_siku(tarehe_siku_ya_zamu(g->zamu_ya_sasa), &mwaka, &mwezi, &siku);
    n8 jina[64];
    jina[0] = 0;
    kama (mchezaji != 0) { skrini_herufi_kubwa(jina, 64, mchezaji->jina); }
    n8 muktadha[96];
    mfuatano_umbiza(muktadha, 96, "%s  ·  %d", jina, mwaka, 0, 0, 0, 0);
    sura_rangi(SURA_LAFUDHI);
    sura_lebo_nene(muktadha, x, y, 11);
    n8 kubwa[64];
    skrini_herufi_kubwa(kubwa, 64, kichwa);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_nene(kubwa, x, y + 14, 26);
    kama (maelezo != 0) {
        sura_rangi(SURA_HAFIFU);
        sura_lebo(maelezo, x, y + 47, 12);
    }
}

// Urambazaji wa pembeni. `hai` ni skrini inayoonyeshwa (SKRINI_*).
w0 skrini_urambazaji(Turubai* t, n64 hai) {
    kama (skrini_bila_fremu) { rudisha; }
    turubai_brashi(t, SURA_USULI, 255);
    turubai_jaza(t, 0, SKRINI_UPAU_WA_JUU, SKRINI_UPANA_WA_PEMBENI, t->kimo - SKRINI_UPAU_WA_JUU);
    turubai_brashi(t, 0, 110);
    turubai_jaza(t, SKRINI_UPANA_WA_PEMBENI - 1, SKRINI_UPAU_WA_JUU, 1, t->kimo - SKRINI_UPAU_WA_JUU);
    n64 i = 0;
    wakati (i < SKRINI_NAV_IDADI) {
        n64 y = skrini_nav_y(i, t->kimo);
        n8* kikundi = skrini_nav_kikundi(i);
        kama (kikundi != 0) {
            kama (i > 0) {
                turubai_brashi(t, 16777215, 18);
                turubai_jaza(t, 12, y - SKRINI_NAV_KICHWA + 4, SKRINI_UPANA_WA_PEMBENI - 24, 1);
            }
            sura_rangi(SURA_HAFIFU);
            sura_lebo(kikundi, 16, y - SKRINI_NAV_KICHWA + 11, 11);
        }
        n64 skrini = skrini_nav_skrini(i);
        n64 rangi = SURA_MAANDISHI;
        n64 chini = SURA_USULI;
        kama (skrini == hai) {
            chini = SURA_PANELI_JUU;
            turubai_brashi(t, chini, 255);
            turubai_jaza(t, 0, y, SKRINI_UPANA_WA_PEMBENI - 1, SKRINI_NAV_SAFU);
            turubai_brashi(t, SURA_LAFUDHI, 255);
            turubai_jaza(t, 0, y, 3, SKRINI_NAV_SAFU);
            rangi = SURA_LAFUDHI;
        }
        skrini_nav_ikoni(t, skrini, 32, y + SKRINI_NAV_SAFU / 2, rangi, chini);
        turubai_brashi(t, rangi, 255);
        maandishi_chora(t, sura_kati, skrini_nav_jina(i), 54, y + 9, 14);
        kama (skrini == 11 && skrini_nav_beji_kikasha > 0) {
            n8 beji[8];
            kama (skrini_nav_beji_kikasha > 9) { beji[0] = 57; beji[1] = 43; beji[2] = 0; }
            sivyo { beji[0] = 48 + skrini_nav_beji_kikasha; beji[1] = 0; }
            n64 wb = maandishi_upana(sura_nene, beji, 11) + 12;
            kama (wb < 22) { wb = 22; }
            turubai_brashi(t, SURA_LAFUDHI, 255);
            turubai_mviringo(t, SKRINI_UPANA_WA_PEMBENI - 34 - wb, y + 7, wb, 22, 11);
            turubai_brashi(t, CHATI_GIZA_YA_JUU, 255);
            maandishi_chora(t, sura_nene, beji, SKRINI_UPANA_WA_PEMBENI - 34 - wb + (wb - maandishi_upana(sura_nene, beji, 11)) / 2, y + 10, 11);
        }
        i = i + 1;
    }
}

n64 SKRINI_KIMO_CHA_SAFU = 38;

w0 skrini_historia_ya_pato(Mchezo* g, n64 x, n64 y, n64 w, n64 chart_h) {
    sura_paneli(x, y, w, chart_h, ui("WORLD GDP -- HISTORY"));
    TakwimuHistoria* h = mchezo_pata_gdp_historia(g);
    kama (h == 0 || h->idadi < 2) {
        sura_rangi(SURA_HAFIFU);
        sura_lebo(ui("History appears after two turns."), x + 16, y + chart_h / 2 - 8, 14);
        rudisha;
    }
    n64 n = h->idadi;
    kama (n > 240) { n = 240; }
    n64* thamani = tenga(8 * n);
    n64 mwanzo = h->idadi - n;
    n64 i = 0;
    wakati (i < n) {
        d64 s = h->sampuli[mwanzo + i];
        n64 v = s * 1000000.0;          // sampuli ni milioni
        thamani[i] = v;
        i = i + 1;
    }
    sura_chati_mstari(x + 16, y + 48, w - 32, chart_h - 72, thamani, n);
    achilia thamani;
}
