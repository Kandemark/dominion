husisha { moduli/skrini/ramani.swa }

// jaribio_ramani.swa -- chora skrini ya ramani kutoka mchezo halisi,
// ikiwa imekaa juu ya mji mkuu wa taifa la mchezaji, na uandike fremu
// ghafi (BGRA).   jaribio_ramani <njia> [kipimo] [taifa]

n32 anza(n32 idadi_ya_hoja, n8** hoja_za_mstari) {
    Mchezo* g = mchezo_unda();
    MchezoUsanidi usanidi;
    mchezo_usanidi_chaguomsingi(&usanidi);
    CivMatokeo r = mchezo_anzisha(g, &usanidi);
    kama (r.hitilafu != CIV_SAWA) { andika("SHINDWA: mchezo_anzisha\n", 0, 0, 0, 0, 0, 0); rudisha 1; }
    n64 kipimo = 12;
    kama (idadi_ya_hoja > 2) { kipimo = mfuatano_hadi_n64(hoja_za_mstari[2]); }
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    n64 taifa = tm->faharisi_ya_taifa_la_mchezaji;
    kama (idadi_ya_hoja > 3) { taifa = mfuatano_hadi_n64(hoja_za_mstari[3]); }
    Atlasi* a = mchezo_pata_atlasi(g);
    Turubai* t = turubai_unda(1600, 900);
    skrini_ramani_chora(g, t, a->mji_x[taifa], a->mji_y[taifa], kipimo, taifa);
    kama (idadi_ya_hoja > 1) {
        n64 fd = mfumo_fungua(hoja_za_mstari[1], 577, 420);
        mfumo_andika(fd, t->pikseli, t->hatua * t->kimo);
        mfumo_funga(fd);
    }
    rudisha 0;
}
