husisha { moduli/skrini/muhtasari.swa }
husisha { moduli/akili/mshauri.swa }

// mipangilio.swa -- skrini ya mipangilio: lugha ya kiolesura na mshauri wa AI.
//
// Lugha huhifadhiwa kwenye saves/mipangilio (baiti moja: tarakimu ya lugha)
// na husomwa mchezo unapowaka, kabla ya skrini ya kwanza.
//
// Mshauri wa AI: mchezaji huchagua kuzima, modeli ya ndani ya mashine hii,
// au seva maalum yenye ufunguo. Anwani, modeli na ufunguo huandikwa kwenye
// saves/akili (angalia moduli/akili/mshauri.swa); skrini huonyesha hali na
// hujaribu muunganisho.

n64 SKRINI_MIPANGILIO_SAFU = 56;        // kimo cha safu moja ya lugha

n64 skrini_mipangilio_x() { rudisha SKRINI_UPANA_WA_PEMBENI + 25; }
n64 skrini_mipangilio_y() { rudisha SKRINI_UPAU_WA_JUU + 25 + 66 + 40; }
n64 skrini_mipangilio_w(n64 upana) {
    n64 w = upana - skrini_mipangilio_x() - 24;
    kama (w > 560) { w = 560; }
    rudisha w;
}

n64 mipangilio_soma_lugha() {
    n64 fd = mfumo_fungua("saves/mipangilio", 0, 0);
    kama (fd < 0) { rudisha 0; }
    n8 b[4];
    n64 n = mfumo_soma(fd, b, 1);
    mfumo_funga(fd);
    kama (n < 1) { rudisha 0; }
    n64 l = (b[0] & 255) - 48;
    kama (l < 0 || l >= MANENO_LUGHA_IDADI) { rudisha 0; }
    rudisha l;
}

w0 mipangilio_hifadhi_lugha(n64 l) {
    mfumo_unda_saraka("saves", 493);
    n64 fd = mfumo_fungua("saves/mipangilio", 577, 420);
    kama (fd < 0) { rudisha; }
    n8 b[4];
    b[0] = 48 + l;
    mfumo_andika(fd, b, 1);
    mfumo_funga(fd);
}

// Tumia lugha kwenye kiolesura na kwenye ujumbe wa uigaji.
w0 mipangilio_tumia_lugha(Mchezo* g, n64 l) {
    maneno_weka_lugha(l);
    kama (g != 0) { mchezo_weka_lugha(g, maneno_lugha_msimbo(maneno_lugha)); }
}

// Lugha iliyobofywa kwenye (px, py), au -1.
n64 skrini_mipangilio_bofya(n64 upana, n64 px, n64 py) {
    n64 x = skrini_mipangilio_x();
    n64 y = skrini_mipangilio_y();
    n64 w = skrini_mipangilio_w(upana);
    kama (px < x || px >= x + w || py < y) { rudisha 0 - 1; }
    n64 safu = (py - y) / SKRINI_MIPANGILIO_SAFU;
    kama (safu >= MANENO_LUGHA_IDADI) { rudisha 0 - 1; }
    rudisha safu;
}

n8* skrini_mipangilio_maelezo(n64 l) {
    kama (l == MANENO_KISWAHILI) { rudisha ui("Swahili"); }
    kama (l == MANENO_KIFARANSA) { rudisha ui("French"); }
    rudisha ui("English");
}

// ---------- mshauri wa AI ----------

AkiliUsanidi* mipangilio_akili = 0;
n64 mipangilio_akili_hali = 0;          // 0 haijajaribiwa, 1 imeunganishwa, 2 haifikiki, 3 modeli haipo
n64 MIPANGILIO_MODELI_SAFU = 24;        // kimo cha safu ya modeli kwenye orodha

AkiliUsanidi* mipangilio_akili_pata() {
    kama (mipangilio_akili == 0) { mipangilio_akili = akili_soma_usanidi("saves/akili"); }
    rudisha mipangilio_akili;
}

n64 skrini_mipangilio_akili_y() {
    rudisha skrini_mipangilio_y() + SKRINI_MIPANGILIO_SAFU * MANENO_LUGHA_IDADI + 76;
}

n8* skrini_mipangilio_mtoa_jina(n64 m) {
    kama (m == AKILI_WA_NDANI) { rudisha ui("Local model on this computer"); }
    kama (m == AKILI_MAALUM) { rudisha ui("Custom server with API key"); }
    rudisha ui("Off");
}

n8* skrini_mipangilio_mtoa_maelezo(n64 m) {
    kama (m == AKILI_WA_NDANI) { rudisha ui("Ollama at 127.0.0.1:11434. Nothing leaves this machine."); }
    kama (m == AKILI_MAALUM) { rudisha ui("Any chat-completions server. Uses the address, model and key in saves/akili."); }
    rudisha ui("No adviser. The game makes no network connections."); 
}

// Kitendo cha bofya kwenye sehemu ya mshauri: 0..2 = mtoa, 10 = jaribu
// muunganisho, 100 + i = tumia modeli i ya seva, -1 = hakuna.
n64 skrini_mipangilio_bofya_akili(n64 upana, n64 px, n64 py) {
    n64 x = skrini_mipangilio_x();
    n64 y = skrini_mipangilio_akili_y();
    n64 w = skrini_mipangilio_w(upana);
    kama (px < x || px >= x + w || py < y) { rudisha 0 - 1; }
    n64 safu = (py - y) / SKRINI_MIPANGILIO_SAFU;
    kama (safu < AKILI_WATOA) { rudisha safu; }
    n64 y_kitufe = y + SKRINI_MIPANGILIO_SAFU * AKILI_WATOA + 92;
    kama (py >= y_kitufe && py < y_kitufe + 32 && px < x + 180) { rudisha 10; }
    n64 y_orodha = y_kitufe + 90;
    kama (akili_modeli_idadi > 0 && py >= y_orodha) {
        n64 i = (py - y_orodha) / MIPANGILIO_MODELI_SAFU;
        kama (i < akili_modeli_idadi) { rudisha 100 + i; }
    }
    rudisha 0 - 1;
}

// Tekeleza kitendo cha bofya_akili.
w0 mipangilio_akili_tekeleza(n64 kitendo) {
    AkiliUsanidi* u = mipangilio_akili_pata();
    kama (kitendo >= 0 && kitendo < AKILI_WATOA) {
        kama (u->mtoa != kitendo) {
            u->mtoa = kitendo;
            // mtoa wa ndani hurudi kwenye anwani ya Ollama ya chaguo-msingi
            kama (kitendo == AKILI_WA_NDANI) { nakili_mfuatano(u->anwani, "127.0.0.1"); u->bandari = 11434; }
            akili_hifadhi_usanidi(u, "saves/akili");
            mipangilio_akili_hali = 0;
        }
    }
    kama (kitendo == 10) {
        mipangilio_akili_hali = 2;
        kama (akili_jaribu(u)) {
            mipangilio_akili_hali = 1;
            kama (akili_modeli_idadi > 0 && akili_modeli_ipo(u) == 0) { mipangilio_akili_hali = 3; }
        }
    }
    kama (kitendo >= 100 && kitendo - 100 < akili_modeli_idadi) {
        nakili_mfuatano(u->modeli, akili_modeli[kitendo - 100]);
        akili_hifadhi_usanidi(u, "saves/akili");
        mipangilio_akili_hali = 1;
    }
}

w0 skrini_mipangilio_akili_chora(Turubai* t, n64 x, n64 w) {
    AkiliUsanidi* u = mipangilio_akili_pata();
    // jaribio la kwanza hufanyika ukurasa unapofunguliwa, ili orodha ya modeli ionekane
    kama (mipangilio_akili_hali == 0 && u->mtoa != AKILI_HAKUNA) { mipangilio_akili_tekeleza(10); }
    n64 y = skrini_mipangilio_akili_y();
    sura_rangi(SURA_HAFIFU);
    sura_lebo_kati(ui("AI ADVISER"), x + 4, y - 26, 12);
    sura_paneli(x, y, w, SKRINI_MIPANGILIO_SAFU * AKILI_WATOA, 0);
    n64 m = 0;
    wakati (m < AKILI_WATOA) {
        n64 sy = y + m * SKRINI_MIPANGILIO_SAFU;
        n64 hai = 0;
        kama (m == u->mtoa) { hai = 1; }
        kama (hai) {
            turubai_brashi(t, SURA_LAFUDHI, 22);
            turubai_mviringo(t, x + 4, sy + 4, w - 8, SKRINI_MIPANGILIO_SAFU - 8, 6);
        }
        kama (m > 0) {
            turubai_brashi(t, 16777215, 10);
            turubai_jaza(t, x + 52, sy, w - 68, 1);
        }
        sura_radio(x + 28, sy + SKRINI_MIPANGILIO_SAFU / 2, hai, SURA_LAFUDHI, 255);
        sura_rangi(SURA_MAANDISHI);
        sura_lebo_kati(skrini_mipangilio_mtoa_jina(m), x + 52, sy + 9, 15);
        sura_rangi(SURA_HAFIFU);
        sura_lebo(skrini_mipangilio_mtoa_maelezo(m), x + 52, sy + 31, 11);
        m = m + 1;
    }
    // undani wa muunganisho
    n64 dy = y + SKRINI_MIPANGILIO_SAFU * AKILI_WATOA + 14;
    n8 chombo[160];
    mfuatano_umbiza(chombo, 160, "%s:%d", u->anwani, u->bandari, 0, 0, 0, 0);
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("Server"), x + 4, dy, 12);
    sura_lebo(ui("Model"), x + 4, dy + 22, 12);
    sura_lebo(ui("API key"), x + 4, dy + 44, 12);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo(chombo, x + 110, dy, 12);
    sura_lebo(u->modeli, x + 110, dy + 22, 12);
    kama (u->ufunguo[0] != 0) { sura_lebo(ui("Set (hidden)"), x + 110, dy + 44, 12); }
    sivyo { sura_rangi(SURA_HAFIFU); sura_lebo(ui("Not set"), x + 110, dy + 44, 12); }
    // kitufe cha kujaribu na hali
    n64 by = dy + 78;
    turubai_brashi(t, SURA_PANELI_JUU, 255);
    turubai_mviringo(t, x, by, 176, 32, 7);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_kati(ui("Test connection"), x + 16, by + 7, 13);
    kama (mipangilio_akili_hali == 1) { sura_rangi(SURA_CHANYA); sura_lebo_kati(ui("Connected"), x + 196, by + 7, 13); }
    kama (mipangilio_akili_hali == 2) { sura_rangi(SURA_HASI); sura_lebo_kati(ui("Not reachable"), x + 196, by + 7, 13); }
    kama (mipangilio_akili_hali == 3) {
        n8 ujumbe[200];
        mfuatano_umbiza(ujumbe, 200, ui("Connected, but the model %s is not installed"), u->modeli, 0, 0, 0, 0, 0);
        sura_rangi(SURA_HASI);
        sura_lebo_kati(ujumbe, x + 196, by + 7, 13);
    }
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("To change the server or key, edit the file saves/akili and reopen Settings."), x + 4, by + 46, 11);
    // modeli za seva: bofya moja kuitumia
    kama (akili_modeli_idadi > 0) {
        n64 oy = by + 90;
        sura_rangi(SURA_HAFIFU);
        sura_lebo_kati(ui("MODELS ON THE SERVER  ·  CLICK ONE TO USE IT"), x + 4, oy - 20, 11);
        n64 i = 0;
        wakati (i < akili_modeli_idadi) {
            n64 ry = oy + i * MIPANGILIO_MODELI_SAFU;
            n32 hii = linganisha_mfuatano(akili_modeli[i], u->modeli) == 0;
            kama (hii) { turubai_brashi(t, SURA_LAFUDHI, 30); turubai_mviringo(t, x, ry, w, MIPANGILIO_MODELI_SAFU - 2, 5); }
            sura_radio(x + 14, ry + MIPANGILIO_MODELI_SAFU / 2 - 1, hii, SURA_LAFUDHI, 255);
            sura_rangi(SURA_MAANDISHI);
            sura_lebo(akili_modeli[i], x + 32, ry + 4, 12);
            i = i + 1;
        }
    }
}

w0 skrini_mipangilio_chora(Mchezo* g, Turubai* t) {
    sura_anzisha(t);
    turubai_brashi(t, SURA_USULI, 255);
    turubai_jaza(t, 0, 0, t->upana, t->kimo);
    skrini_upau_wa_juu(g, t);
    skrini_urambazaji(t, 8);

    n64 x = skrini_mipangilio_x();
    n64 w = skrini_mipangilio_w(t->upana);
    skrini_kichwa_fm(g, t, ui("Settings"), ui("Language and adviser"), x, SKRINI_UPAU_WA_JUU + 17);

    n64 y = skrini_mipangilio_y();
    sura_rangi(SURA_HAFIFU);
    sura_lebo_kati(ui("LANGUAGE"), x + 4, y - 26, 12);
    sura_paneli(x, y, w, SKRINI_MIPANGILIO_SAFU * MANENO_LUGHA_IDADI, 0);
    n64 l = 0;
    wakati (l < MANENO_LUGHA_IDADI) {
        n64 sy = y + l * SKRINI_MIPANGILIO_SAFU;
        n64 hai = 0;
        kama (l == maneno_lugha) { hai = 1; }
        kama (hai) {
            turubai_brashi(t, SURA_LAFUDHI, 22);
            turubai_mviringo(t, x + 4, sy + 4, w - 8, SKRINI_MIPANGILIO_SAFU - 8, 6);
        }
        kama (l > 0) {
            turubai_brashi(t, 16777215, 10);
            turubai_jaza(t, x + 52, sy, w - 68, 1);
        }
        sura_radio(x + 28, sy + SKRINI_MIPANGILIO_SAFU / 2, hai, SURA_LAFUDHI, 255);
        // jina la lugha kwa lugha ya kiolesura; huachwa likiwa sawa na jina lenyewe
        n8* maelezo = skrini_mipangilio_maelezo(l);
        n64 juu = sy + 9;
        kama (linganisha_mfuatano(maelezo, maneno_lugha_jina(l)) == 0) { juu = sy + 18; }
        sivyo { sura_rangi(SURA_HAFIFU); sura_lebo(maelezo, x + 52, sy + 31, 12); }
        sura_rangi(SURA_MAANDISHI);
        sura_lebo_kati(maneno_lugha_jina(l), x + 52, juu, 16);
        l = l + 1;
    }
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("Names of nations, cities and rivers stay in their own languages."), x + 4,
              y + SKRINI_MIPANGILIO_SAFU * MANENO_LUGHA_IDADI + 14, 12);
    skrini_mipangilio_akili_chora(t, x, w);
}
