husisha { moduli/skrini/jopo.swa }
husisha { moduli/soko/masoko.swa }
husisha { moduli/onyesho/elea.swa }
husisha { moduli/onyesho/sankey.swa }

// Thamani za chati ya historia ya pato kielekezi kikiwa juu yake (sura_chati_mstari
// huacha pikseli 78 za lebo kushoto).
w0 uchumi_elea_ya_historia(n64* th, n64 n, n64 x, n64 y, n64 w, n64 h) {
    kama (n < 2) { rudisha; }
    n64 hatua = w / (n - 1);
    kama (hatua < 1) { hatua = 1; }
    n8 k[48];
    n8 v[32];
    n64 j = 0;
    wakati (j < n) {
        n64 nyuma = n - 1 - j;
        kama (nyuma == 0) { nakili_mfuatano(k, ui("This week")); }
        sivyo kama (nyuma == 1) { nakili_mfuatano(k, ui("1 week ago")); }
        sivyo { mfuatano_umbiza(k, 48, ui("%d weeks ago"), nyuma, 0, 0, 0, 0, 0); }
        sura_namba_fupi(v, th[j]);
        elea_ongeza(x + (j * (w - 1)) / (n - 1) - hatua / 2, y, hatua, h, k, v);
        j = j + 1;
    }
}

n64 skrini_uchumi_dirisha_la_historia = 24;

n64 skrini_uchumi_muda_x(n64 x, n64 panel_w) {
    rudisha x + panel_w - 196;
}

// uchumi.swa -- skrini ya uchumi wa taifa moja: kadi nne (pato ghafi na
// mabadiliko yake kwa zamu 10, tija, ukosefu wa kazi, mapato ya kodi),
// historia ya pato ghafi la taifa, uzalishaji dhidi ya matumizi, na nafasi
// ya taifa kati ya mataifa yote kwa kila kipimo.
//
// Kila namba ni ya uigaji (TaifaNchi.uchumi, historia ya kila taifa ya
// Mchezo) -- hakuna thamani ya mfano.

// Nafasi (1 = juu) ya thamani ya taifa `taifa` kati ya mataifa yote, kwa
// kipimo `aina`: 0 pato ghafi, 1 tija, 2 watu, 3 ardhi.
n64 skrini_thamani_ya_kipimo(TaifaNchi* t, n64 aina) {
    kama (aina == 0) { rudisha skrini_pato_la_taifa(t); }
    kama (aina == 1) { n64 v = t->pato_kwa_kila_mtu; rudisha v; }
    kama (aina == 2) { rudisha t->idadi_ya_watu; }
    rudisha t->uchumi.vipande_vya_ardhi;
}

n64 skrini_nafasi_kwa_kipimo(TaifaMfumo* tm, n64 taifa, n64 aina) {
    TaifaNchi* t = dunia_taifa_mfumo_pata_kwa_faharisi(tm, taifa);
    n64 v = skrini_thamani_ya_kipimo(t, aina);
    n64 nafasi = 1;
    n64 i = 0;
    wakati (i < tm->idadi) {
        TaifaNchi* o = dunia_taifa_mfumo_pata_kwa_faharisi(tm, i);
        kama (skrini_thamani_ya_kipimo(o, aina) > v) { nafasi = nafasi + 1; }
        i = i + 1;
    }
    rudisha nafasi;
}

// Mabadiliko ya pato kwa elfu kumi (100 = 1%) kati ya sampuli ya mwisho na
// ile ya zamu `nyuma` kabla yake; 0 ikiwa historia haitoshi.
n64 skrini_mabadiliko(TakwimuHistoria* h, n64 nyuma) {
    kama (h == 0 || h->idadi < 2) { rudisha 0; }
    n64 a = h->idadi - 1 - nyuma;
    kama (a < 0) { a = 0; }
    d64 kale = h->sampuli[a];
    d64 sasa = h->sampuli[h->idadi - 1];
    kama (kale <= 0.0) { rudisha 0; }
    d64 m = ((sasa - kale) / kale) * 10000.0;
    n64 v = m;
    rudisha v;
}

// Safu ya uzalishaji dhidi ya matumizi: lebo, thamani, na pau inayoonyesha
// uwiano (asilimia 100 = katikati ya pau).
w0 skrini_safu_ya_uwiano(n8* lebo, d64 uzalishaji, d64 matumizi, n64 x, n64 y, n64 w) {
    sura_rangi(SURA_HAFIFU);
    sura_lebo(lebo, x, y, 13);
    n64 kwa_elfu = 500;
    kama (matumizi > 0.0) {
        d64 u = (uzalishaji / matumizi) * 500.0;
        kwa_elfu = u;
    }
    n64 rangi = SURA_CHANYA;
    kama (kwa_elfu < 500) { rangi = SURA_HASI; }
    sura_pau(x + 150, y + 5, w - 230, 8, kwa_elfu, rangi);
    // alama ya 100%
    turubai_brashi(sura_t, SURA_MAANDISHI, 160);
    turubai_jaza(sura_t, x + 150 + (w - 230) / 2, y + 1, 1, 16);
    n8 chombo[32];
    sura_asilimia(chombo, kwa_elfu * 20, 0);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_kulia(chombo, x + w, y, 13);
}

// Mtiririko wa pato la taifa (Sankey): sekta -> pato ghafi -> kodi na
// mapato ya watu na makampuni -> hazina (pamoja na mikopo) -> matumizi kwa
// kategoria nane za bajeti, na ziada. Thamani ni za taifa hili (mamilioni
// kuwa vitengo); mgawanyo wa matumizi na uwiano wa mikopo hufuata mfumo wa
// bajeti wa mchezo.
w0 skrini_uchumi_mtiririko(Mchezo* g, n64 taifa, n64 x, n64 y, n64 w, n64 h) {
    TaifaNchi* tn = dunia_taifa_mfumo_pata_kwa_faharisi(mchezo_pata_taifa(g), taifa);
    sura_paneli(x, y, w, h, ui("WHERE THE OUTPUT GOES"));
    kama (tn == 0) { rudisha; }
    d64 M = 1000000.0;
    d64 pato_d = tn->uchumi.pato_ghafi;
    d64 viwanda_d = tn->uchumi.uzalishaji_wa_viwanda;
    d64 malighafi_d = tn->uchumi.malighafi;
    d64 kodi_d = tn->uchumi.mapato_ya_kodi;
    kama (viwanda_d + malighafi_d > pato_d) { viwanda_d = pato_d * 0.6; malighafi_d = pato_d * 0.2; }
    kama (kodi_d > pato_d) { kodi_d = pato_d; }
    n64 pato = pato_d * M;
    n64 viwanda = viwanda_d * M;
    n64 malighafi = malighafi_d * M;
    n64 kodi = kodi_d * M;
    sankey_anza();
    n64 nv = sankey_nodi(ui("Industry"), 0, 5999087);
    n64 nm = sankey_nodi(ui("Raw materials"), 0, 13214247);
    n64 nh = sankey_nodi(ui("Services and other"), 0, 5223077);
    n64 np = sankey_nodi(ui("GDP"), 1, 9413567);
    n64 nk = sankey_nodi(ui("Taxes"), 2, 14721112);
    n64 nb = sankey_nodi(ui("Households and firms"), 2, 7109267);
    sankey_kiungo(nv, np, viwanda);
    sankey_kiungo(nm, np, malighafi);
    sankey_kiungo(nh, np, pato - viwanda - malighafi);
    sankey_kiungo(np, nk, kodi);
    sankey_kiungo(np, nb, pato - kodi);
    sankey_chora(x + 16, y + 44, w - 32, h - 60);
}

// Bajeti (Sankey): kodi na mikopo -> hazina -> kategoria nane, na ziada.
// Mgawanyo na uwiano wa mikopo hufuata mfumo wa bajeti wa mchezo.
w0 skrini_uchumi_bajeti(Mchezo* g, n64 taifa, n64 x, n64 y, n64 w, n64 h) {
    TaifaNchi* tn = dunia_taifa_mfumo_pata_kwa_faharisi(mchezo_pata_taifa(g), taifa);
    BajetiMfumo* bj = mchezo_pata_bajeti(g);
    sura_paneli(x, y, w, h, ui("THE BUDGET"));
    sura_rangi(SURA_HAFIFU);
    sura_lebo_kulia(ui("Full budget: tab 6"), x + w - 16, y + 12, 11);
    bofya_ongeza(x, y, w, 36, 70, 5);       // KT_TABO, KT_BAJETI
    kama (tn == 0 || bj == 0) { rudisha; }
    n64 kodi_n = tn->uchumi.mapato_ya_kodi * 1000000.0;
    n64 mkopo = 0;
    n64 ziada = 0;
    kama (bj->mapato_jumla > 0.0) {
        d64 uw = bj->nakisi / bj->mapato_jumla;
        d64 kiasi = kodi_n * uw;
        kama (uw < 0.0) { mkopo = 0.0 - kiasi; } sivyo { ziada = kiasi; }
    }
    n64 matumizi = kodi_n + mkopo - ziada;
    sankey_anza();
    n64 nk = sankey_nodi(ui("Taxes"), 0, 14721112);
    n64 nmk = 0 - 1;
    kama (mkopo > 0) { nmk = sankey_nodi(ui("Borrowing"), 0, 14247003); }
    n64 nz = sankey_nodi(ui("Treasury"), 1, 14721112);
    sankey_kiungo(nk, nz, kodi_n);
    kama (nmk >= 0) { sankey_kiungo(nmk, nz, mkopo); }
    n64 rangi[8];
    rangi[0] = 14247003; rangi[1] = 5999087; rangi[2] = 5223077; rangi[3] = 7327639;
    rangi[4] = 11832027; rangi[5] = 5688562; rangi[6] = 10135985; rangi[7] = 13204323;
    n64 thamani[8];
    n32 imetumika[8];
    n64 c = 0;
    wakati (c < 8) {
        d64 sh = bajeti_pata_mgao(bj, c);
        thamani[c] = sh * matumizi;
        imetumika[c] = 0;
        c = c + 1;
    }
    n64 r = 0;
    wakati (r < 8) {
        n64 bora = 0 - 1;
        c = 0;
        wakati (c < 8) { kama (imetumika[c] == 0 && (bora < 0 || thamani[c] > thamani[bora])) { bora = c; } c = c + 1; }
        imetumika[bora] = 1;
        kama (thamani[bora] > 0) {
            n64 nn = sankey_nodi(uchumi_jina_la_kategoria(bora), 2, rangi[bora]);
            sankey_kiungo(nz, nn, thamani[bora]);
        }
        r = r + 1;
    }
    kama (ziada > 0) { n64 nzd = sankey_nodi(ui("Surplus to reserves"), 2, 9413567); sankey_kiungo(nz, nzd, ziada); }
    sankey_chora(x + 16, y + 44, w - 32, h - 60);
}

n8* uchumi_jina_la_kategoria(n64 c) {
    kama (c == 0) { rudisha ui("Military"); }
    kama (c == 1) { rudisha ui("Infrastructure"); }
    kama (c == 2) { rudisha ui("Education"); }
    kama (c == 3) { rudisha ui("Health"); }
    kama (c == 4) { rudisha ui("Welfare"); }
    kama (c == 5) { rudisha ui("Research"); }
    kama (c == 6) { rudisha ui("Administration"); }
    rudisha ui("Debt service");
}

// Kitendo cha kubofya: urefu wa historia ya pato (hoja = zamu).
n64 UCHUMI_MUDA = 60;

// Uchumi mkuu (kichupo cha MACRO cha kituo): vigae, historia ya pato,
// uzalishaji dhidi ya matumizi, nafasi, bajeti na mataifa yote, kuanzia y0.
w0 skrini_uchumi_makro_chora(Mchezo* g, Turubai* t, n64 taifa, n64 y0) {
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    TaifaNchi* tn = dunia_taifa_mfumo_pata_kwa_faharisi(tm, taifa);
    kama (tn == 0) { rudisha; }
    TakwimuHistoria* h = mchezo_pata_historia_ya_taifa(g, taifa);

    n64 x = SKRINI_UPANA_WA_PEMBENI + 25;
    n64 y = y0;
    n64 w = t->upana - x - 24;
    n64 pengo = 16;

    // kadi nne
    n64 wk = (w - 3 * pengo) / 4;
    n8 chombo[48];
    // Microtrend kwenye KPI hutumia historia ileile inayoonyeshwa chini.
    n64* gdp_trend = 0;
    n64 gdp_trend_n = 0;
    kama (h != 0 && h->idadi > 1) {
        gdp_trend_n = h->idadi;
        kama (gdp_trend_n > 24) { gdp_trend_n = 24; }
        gdp_trend = tenga(8 * gdp_trend_n);
        n64 gi = 0;
        n64 gdp_start = h->idadi - gdp_trend_n;
        wakati (gi < gdp_trend_n) {
            d64 gs = h->sampuli[gdp_start + gi];
            gdp_trend[gi] = gs * 1000000.0;
            gi = gi + 1;
        }
    }
    n8 gdp_delta[24];
    n64 gdp_change = skrini_mabadiliko(h, 10);
    sura_asilimia(gdp_delta, gdp_change, 1);
    soko_fedha_maandishi(chombo, taifa, soko_kwa_sarafu(taifa, skrini_pato_la_taifa(tn)));
    sura_kadi_sparkline(ui("GDP"), chombo, gdp_delta, gdp_change, gdp_trend, gdp_trend_n, x, y, wk, 92);
    kama (gdp_trend != 0) { achilia gdp_trend; }
    n64 tija = tn->pato_kwa_kila_mtu;
    sura_namba(chombo, tija);
    sura_kadi(x + wk + pengo, y, wk, ui("GDP PER CAPITA"), chombo, 0);
    d64 ukosefu = tn->uchumi.ukosefu_wa_kazi * 10000.0;
    n64 ukosefu_n = ukosefu;
    sura_asilimia(chombo, ukosefu_n, 0);
    sura_kadi(x + 2 * (wk + pengo), y, wk, ui("UNEMPLOYMENT"), chombo, 0);
    d64 kodi = tn->uchumi.mapato_ya_kodi * 1000000.0;
    n64 kodi_n = kodi;
    sura_namba_fupi(chombo, kodi_n);
    sura_kadi(x + 3 * (wk + pengo), y, wk, ui("TAX REVENUE"), chombo, 0);
    y = y + 92 + pengo;

    // historia (kushoto) na uzalishaji (kulia)
    n64 w_kushoto = (w * 3) / 5;
    n64 w_kulia = w - w_kushoto - pengo;
    n64 kimo_cha_safu = 300;
    sura_paneli(x, y, w_kushoto, kimo_cha_safu, ui("GDP -- HISTORY"));
    n64 controls_x = skrini_uchumi_muda_x(x, w_kushoto);
    n64 controls_y = y + 8;
    sura_segmenti("12T", controls_x, controls_y, 44, skrini_uchumi_dirisha_la_historia == 12, 0);
    sura_segmenti("24T", controls_x + 46, controls_y, 44, skrini_uchumi_dirisha_la_historia == 24, 0);
    sura_segmenti("60T", controls_x + 92, controls_y, 44, skrini_uchumi_dirisha_la_historia == 60, 0);
    sura_segmenti("240T", controls_x + 138, controls_y, 50, skrini_uchumi_dirisha_la_historia >= 240, 0);
    bofya_ongeza(controls_x, controls_y, 44, 28, UCHUMI_MUDA, 12);
    bofya_ongeza(controls_x + 46, controls_y, 44, 28, UCHUMI_MUDA, 24);
    bofya_ongeza(controls_x + 92, controls_y, 44, 28, UCHUMI_MUDA, 60);
    bofya_ongeza(controls_x + 138, controls_y, 50, 28, UCHUMI_MUDA, 240);
    kama (h == 0 || h->idadi < 2) {
        sura_rangi(SURA_HAFIFU);
        sura_lebo(ui("History appears after two turns."), x + 16, y + 140, 14);
    } sivyo {
        n64 n = h->idadi;
        kama (n > skrini_uchumi_dirisha_la_historia) { n = skrini_uchumi_dirisha_la_historia; }
        n64* thamani = tenga(8 * n);
        n64 mwanzo = h->idadi - n;
        n64 i = 0;
        wakati (i < n) {
            d64 s = h->sampuli[mwanzo + i];
            n64 v = s * 1000000.0;
            thamani[i] = v;
            i = i + 1;
        }
        sura_chati_mstari(x + 16, y + 48, w_kushoto - 32, kimo_cha_safu - 72, thamani, n);
        uchumi_elea_ya_historia(thamani, n, x + 16 + 78, y + 48, w_kushoto - 32 - 78, kimo_cha_safu - 72);
        achilia thamani;
    }

    n64 xr = x + w_kushoto + pengo;
    sura_paneli(xr, y, w_kulia, kimo_cha_safu, ui("PRODUCTION VS CONSUMPTION"));
    n64 py = y + 52;
    skrini_safu_ya_uwiano(ui("Food"), tn->uchumi.uzalishaji_wa_chakula, tn->uchumi.matumizi_ya_chakula, xr + 16, py, w_kulia - 32);
    py = py + 34;
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("Labour force"), xr + 16, py, 13);
    d64 nk = tn->uchumi.nguvukazi;
    n64 nk_n = nk;
    sura_namba_fupi(chombo, nk_n);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_kulia(chombo, xr + w_kulia - 16, py, 13);
    py = py + 26;
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("Average wage"), xr + 16, py, 13);
    d64 msh = tn->uchumi.mshahara_wa_wastani;
    n64 msh_n = msh;
    sura_namba(chombo, msh_n);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_kulia(chombo, xr + w_kulia - 16, py, 13);
    py = py + 26;
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("Energy (GWh per year)"), xr + 16, py, 13);
    d64 nis = tn->uchumi.uzalishaji_wa_nishati;
    n64 nis_n = nis;
    sura_namba(chombo, nis_n);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_kulia(chombo, xr + w_kulia - 16, py, 13);
    py = py + 26;
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("Industrial output"), xr + 16, py, 13);
    d64 vw = tn->uchumi.uzalishaji_wa_viwanda * 1000000.0;
    n64 vw_n = vw;
    sura_namba_fupi(chombo, vw_n);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_kulia(chombo, xr + w_kulia - 16, py, 13);
    py = py + 26;
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("Raw materials"), xr + 16, py, 13);
    d64 mg = tn->uchumi.malighafi * 1000000.0;
    n64 mg_n = mg;
    sura_namba_fupi(chombo, mg_n);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_kulia(chombo, xr + w_kulia - 16, py, 13);
    py = py + 26;
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("Land (tiles)"), xr + 16, py, 13);
    sura_namba(chombo, tn->uchumi.vipande_vya_ardhi);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_kulia(chombo, xr + w_kulia - 16, py, 13);
    py = py + 26;
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("GDP growth"), xr + 16, py, 13);
    d64 ukuaji = tn->uchumi.ukuaji_wa_pato * 1000.0;
    n64 ukuaji_n = ukuaji;
    sura_asilimia(chombo, ukuaji_n, 1);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_kulia(chombo, xr + w_kulia - 16, py, 13);
    py = py + 26;
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("Inflation"), xr + 16, py, 13);
    d64 inflation = tn->uchumi.mfumuko * 1000.0;
    n64 inflation_n = inflation;
    sura_asilimia(chombo, inflation_n, 0);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_kulia(chombo, xr + w_kulia - 16, py, 13);
    y = y + kimo_cha_safu + pengo;

    // mtiririko wa pato (kushoto) na bajeti (kulia); nafasi duniani ziko
    // kwenye upau wa juu na safu ya chini (RANKING)
    n64 h_mt = t->kimo - y - 24;
    kama (h_mt > 420) { h_mt = 420; }
    kama (h_mt < 260) { h_mt = 260; }
    n64 w_mt = ((w - pengo) * 45) / 100;
    skrini_uchumi_mtiririko(g, taifa, x, y, w_mt, h_mt);
    skrini_uchumi_bajeti(g, taifa, x + w_mt + pengo, y, w - w_mt - pengo, h_mt);
    y = y + h_mt - 132 - pengo;

    // chini: uchumi kati ya mataifa yote
    n64 y_chini = y + 132 + pengo;
    n64 h_chini = t->kimo - y_chini - 24;
    kama (h_chini > 180) {
        n64 w4 = (w - 3 * pengo) / 4;
        jopo_nafasi(g, taifa, KIPIMO_KWA_MTU, ui("RANKING  ·  GDP PER CAPITA"), x, y_chini, w4, h_chini);
        jopo_mgawanyo(g, taifa, KIPIMO_UKUAJI, ui("DISTRIBUTION  ·  GROWTH, 1 YEAR"), x + w4 + pengo, y_chini, w4, h_chini);
        jopo_mtawanyiko(g, taifa, KIPIMO_WATU, KIPIMO_PATO, ui("NATIONS  ·  POPULATION / GDP"), x + 2 * (w4 + pengo), y_chini, w4, h_chini);
        jopo_majirani(g, taifa, KIPIMO_PATO, ui("NEARBY  ·  GDP"), x + 3 * (w4 + pengo), y_chini, w - 3 * (w4 + pengo), h_chini);
    }
}
