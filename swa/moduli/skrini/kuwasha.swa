husisha { moduli/skrini/muhtasari.swa }

// kuwasha.swa -- skrini za kuwaka kwa mchezo: nembo ya studio (Kajara),
// kisha skrini ya kupakia.
//
// Kupakia huonyeshwa kama bunge linalojaa: kila hatua ya maandalizi huketisha
// viti zaidi kutoka kushoto hadi kulia, na bunge kamili ndilo mchezo ulio
// tayari. Hatua zinaitwa kwa vitendo vya dola -- kuitisha bunge, kuchora
// mipaka, kuhesabu watu, kuapisha baraza.

n64 KUWASHA_USULI = 395279;          // 0x06080F -- karibu nyeusi, yenye buluu kidogo
n64 KUWASHA_VITI = 300;

// Nembo ya Kajara: duara jembamba lenye K ya mistari mitatu.
w0 kuwasha_nembo(Turubai* t, n64 cx, n64 cy, n64 r, n64 uwazi) {
    turubai_brashi(t, SURA_MAANDISHI, uwazi);
    turubai_mpaka(t, cx - r, cy - r, 2 * r, 2 * r, r);
    n64 k = (r * 9) / 20;
    n64 unene = 2 * 256 + 64;
    turubai_mstari(t, cx - k / 2 - 2, cy - k, cx - k / 2 - 2, cy + k, unene);
    turubai_brashi(t, SURA_LAFUDHI, uwazi);
    turubai_mstari(t, cx - k / 2 + 3, cy, cx + k / 2 + 3, cy - k, unene);
    turubai_mstari(t, cx - k / 2 + 3, cy, cx + k / 2 + 3, cy + k, unene);
}

// Skrini ya studio. uwazi 0..255 hufifisha kuingia na kutoka.
w0 skrini_kuwasha_studio(Turubai* t, n64 uwazi) {
    sura_anzisha(t);
    turubai_brashi(t, KUWASHA_USULI, 255);
    turubai_jaza(t, 0, 0, t->upana, t->kimo);
    n64 cx = t->upana / 2;
    n64 cy = t->kimo / 2;
    kuwasha_nembo(t, cx, cy - 78, 34, uwazi);
    turubai_brashi(t, SURA_MAANDISHI, uwazi);
    sura_maandishi_mapana(sura_kati, "KAJARA", cx + 11, cy - 14, 44, 22);
    turubai_brashi(t, SURA_LAFUDHI, (uwazi * 3) / 4);
    turubai_jaza(t, cx - 20, cy + 52, 40, 2);
    turubai_brashi(t, SURA_HAFIFU, uwazi);
    sura_maandishi_mapana(sura_kawaida, ui("GAME STUDIO"), cx + 3, cy + 68, 12, 7);
}

// Skrini ya kupakia. maendeleo 0..1000; hatua ni maelezo ya kazi ya sasa;
// tayari = 1 huonyesha mwaliko wa kuingia, ukipumua kwa `mpigo` (fremu).
w0 skrini_kuwasha_kupakia(Turubai* t, n64 maendeleo, n8* hatua, n64 tayari, n64 mpigo) {
    sura_anzisha(t);
    turubai_brashi(t, KUWASHA_USULI, 255);
    turubai_jaza(t, 0, 0, t->upana, t->kimo);
    n64 cx = t->upana / 2;
    n64 p = maendeleo;
    kama (p < 0) { p = 0; }
    kama (p > 1000) { p = 1000; }

    // jina la mchezo
    n64 juu = t->kimo / 9;
    turubai_brashi(t, SURA_MAANDISHI, 255);
    sura_maandishi_mapana(sura_nene, "DOMINION", cx + 12, juu, 60, 24);
    turubai_brashi(t, SURA_HAFIFU, 255);
    sura_maandishi_mapana(sura_kawaida, ui("A grand strategy of nations"), cx + 1, juu + 86, 14, 3);

    // bunge
    n64 r_nje = t->upana / 2 - 120;
    n64 r_kimo = (t->kimo * 40) / 100;
    kama (r_nje > r_kimo) { r_nje = r_kimo; }
    n64 safu = 8;
    n64 r0 = (r_nje * 40) / 100;
    n64 dr = (r_nje - r0) / (safu - 1);
    n64 cy = (t->kimo * 76) / 100;
    n64 viti[4];
    n64 rangi[4];
    n64 uwazi[4];
    n64 vimeketi = (KUWASHA_VITI * p) / 1000;
    n64 kushoto = KUWASHA_VITI / 4;
    n64 kati = KUWASHA_VITI / 2;
    viti[0] = vimeketi;
    kama (viti[0] > kushoto) { viti[0] = kushoto; }
    viti[1] = vimeketi - viti[0];
    kama (viti[1] > kati) { viti[1] = kati; }
    viti[2] = vimeketi - viti[0] - viti[1];
    viti[3] = KUWASHA_VITI - vimeketi;
    rangi[0] = SURA_BAHARI;
    rangi[1] = SURA_LAFUDHI;
    rangi[2] = SURA_HASI;
    rangi[3] = 16777215;
    uwazi[0] = 255;
    uwazi[1] = 255;
    uwazi[2] = 255;
    uwazi[3] = 22;
    sura_bunge(cx, cy, r0, dr, safu, (dr * 256 * 38) / 100, viti, rangi, uwazi, 4);
    // mimbari ya spika
    turubai_brashi(t, 16777215, 30);
    turubai_mviringo(t, cx - 30, cy - 12, 60, 12, 4);

    // hatua na maendeleo
    n64 chini = cy + 44;
    n64 upana_pau = 360;
    turubai_brashi(t, 16777215, 24);
    turubai_mviringo(t, cx - upana_pau / 2, chini, upana_pau, 2, 1);
    turubai_brashi(t, SURA_LAFUDHI, 255);
    n64 jazo = (upana_pau * p) / 1000;
    kama (jazo > 0) { turubai_mviringo(t, cx - upana_pau / 2, chini, jazo, 2, 1); }
    kama (tayari) {
        n64 awamu = mpigo % 120;
        kama (awamu > 60) { awamu = 120 - awamu; }
        turubai_brashi(t, SURA_MAANDISHI, 110 + (awamu * 145) / 60);
        sura_maandishi_mapana(sura_kati, ui("Press any key to take office"), cx, chini + 20, 14, 2);
    } sivyo {
        kama (hatua != 0) {
            turubai_brashi(t, SURA_HAFIFU, 255);
            sura_maandishi_mapana(sura_kawaida, hatua, cx, chini + 20, 13, 1);
        }
    }
    turubai_brashi(t, SURA_HAFIFU, 140);
    sura_maandishi_mapana(sura_kati, "KAJARA", cx + 3, t->kimo - 40, 11, 7);
}
