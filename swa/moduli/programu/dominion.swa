husisha { msingi/maktaba/mfuatano.swa }
husisha { moduli/skrini/ramani.swa }
husisha { moduli/skrini/kituo.swa }
husisha { moduli/skrini/diplomasia.swa }
husisha { moduli/skrini/siasa.swa }
husisha { moduli/skrini/jeshi.swa }
husisha { moduli/skrini/utamaduni.swa }
husisha { moduli/skrini/teknolojia.swa }
husisha { moduli/skrini/mipangilio.swa }
husisha { moduli/skrini/kuwasha.swa }
husisha { moduli/skrini/mkutano.swa }
husisha { moduli/skrini/dashibodi.swa }
husisha { moduli/skrini/kalenda.swa }
husisha { moduli/skrini/kikasha.swa }
husisha { moduli/skrini/dunia.swa }
husisha { moduli/skrini/wasifu.swa }
husisha { moduli/skrini/katiba.swa }
husisha { moduli/hifadhi/hifadhi.swa }
husisha { moduli/onyesho/wayland/dirisha.swa }

// dominion.swa -- programu ya mchezo: dirisha la Wayland, mchezo halisi,
// na skrini zinazojibu ingizo la kweli.
//
// Kurasa: Ramani ndiyo ukurasa mkuu. Kila kipengele cha urambazaji wa
// pembeni (Overview, Inbox, Calendar, World, Politics, Government, Military,
// Diplomacy, Economy, Culture, Technology, Settings) hufungua ukurasa wake
// kamili kwenye eneo la maudhui; Ramani hurudisha ramani. Ramani huchorwa
// mara moja kwa kila mwonekano na kuhifadhiwa, hivyo kadi za juu yake na
// kadi ya taifa chini ya kielekezi ni kunakili na kuchora juu tu.
//
//   pembeni     bofya kufungua ukurasa; Ramani hurudi kwenye ramani
//   Continue    (juu kulia) au Space: songa kwa kipindi kilichochaguliwa
//               (wiki, mwezi, miezi mitatu, au hadi tukio linalofuata);
//               mshale wa kitufe hufungua orodha ya vipindi
//   F11         skrini nzima / dirisha
//   ramani      buruta kusogeza; gurudumu kukuza karibu na kielekezi;
//               kielekezi juu ya taifa huonyesha kadi yake; kubofya
//               huibandika na kufungua droo ya taifa upande wa kulia
//   + / -       kukuza; mishale kusogeza ramani
//   Esc         ukurasa -> ramani; droo -> imefungwa; vinginevyo toka
//
//   dominion [--fremu N] [--dampo njia] [--dirisha S]...
//     --fremu N     toka baada ya fremu N (majaribio)
//     --dampo njia  andika fremu ya mwisho (BGRA) kwenye njia
//     --skrini S    anza kwenye ukurasa S (SKRINI_*)
//     --bandika     bandika kadi ya taifa la mchezaji na ufungue droo yake
//     --dirishani   anza kwenye dirisha badala ya skrini nzima (F11 hubadili)
//     --mwaka Y     mwaka wa kuanza mchezo (1700 hadi 2000; chaguo-msingi 1900)
//     --bila-dirisha W H   chora kwenye kumbukumbu kwa ukubwa W x H bila kufungua
//                   dirisha (pamoja na --fremu na --dampo kwa picha)

n64 KITUFE_KUSHOTO = 272;
n64 KEY_ESC = 1;
n64 KEY_SPACE = 57;
n64 KEY_MINUS = 12;
n64 KEY_EQUAL = 13;
n64 KEY_UP = 103;
n64 KEY_DOWN = 108;
n64 KEY_LEFT = 105;
n64 KEY_RIGHT = 106;
n64 KEY_F11 = 87;

n64 SKRINI_MUHTASARI = 0;
n64 SKRINI_UCHUMI = 1;
n64 SKRINI_SIASA = 2;
n64 SKRINI_JESHI = 3;
n64 SKRINI_DIPLOMASIA = 4;
n64 SKRINI_UTAMADUNI = 5;
n64 SKRINI_TEKNOLOJIA = 6;
n64 SKRINI_RAMANI = 7;
n64 SKRINI_MIPANGILIO = 8;
n64 SKRINI_MKUTANO = 9;
n64 SKRINI_DUNIA_YOTE = 10;
n64 SKRINI_KIKASHA = 11;
n64 SKRINI_KALENDA = 12;
n64 SKRINI_WASIFU = 13;
n64 SKRINI_KATIBA = 14;

// Skrini zote zisizo ramani: kila moja huchora taifa lililochaguliwa.
w0 chora_skrini_ya_taifa(Mchezo* g, Turubai* t, n64 skrini, n64 taifa) {
    kama (skrini == SKRINI_UCHUMI) { skrini_uchumi_chora(g, t, taifa); rudisha; }
    kama (skrini == SKRINI_SIASA) { skrini_siasa_chora(g, t, taifa); rudisha; }
    kama (skrini == SKRINI_JESHI) { skrini_jeshi_chora(g, t, taifa); rudisha; }
    kama (skrini == SKRINI_DIPLOMASIA) { skrini_diplomasia_chora(g, t, taifa); rudisha; }
    kama (skrini == SKRINI_UTAMADUNI) { skrini_utamaduni_chora(g, t, taifa); rudisha; }
    kama (skrini == SKRINI_TEKNOLOJIA) { skrini_teknolojia_chora(g, t, taifa); rudisha; }
    kama (skrini == SKRINI_MIPANGILIO) { skrini_mipangilio_chora(g, t); rudisha; }
    kama (skrini == SKRINI_MKUTANO) { skrini_mkutano_chora(g, t, taifa); rudisha; }
    kama (skrini == SKRINI_DUNIA_YOTE) { skrini_dunia_kituo_chora(g, t); rudisha; }
    kama (skrini == SKRINI_KIKASHA) { skrini_kikasha_chora(g, t, taifa); rudisha; }
    kama (skrini == SKRINI_KALENDA) { skrini_kalenda_chora(g, t, taifa); rudisha; }
    kama (skrini == SKRINI_WASIFU) { skrini_wasifu_chora(g, t, taifa); rudisha; }
    kama (skrini == SKRINI_KATIBA) { skrini_katiba_chora(g, t, taifa); rudisha; }
    skrini_dashibodi_chora(g, t, taifa);
}

// ---------- hali ya programu ----------

muundo Hali {
    n64 skrini;             // ukurasa unaoonyeshwa (SKRINI_*); SKRINI_RAMANI = ramani
    n64 kitovu_x;
    n64 kitovu_y;
    n64 kipimo;
    n64 taifa;              // taifa lililochaguliwa (madirisha yote hulionyesha)
    n64 taifa_dunia;        // taifa lililochaguliwa kwenye ramani ya dunia iliyokubaliwa
    n64 inavutwa;           // kitufe cha kushoto kimebonyezwa juu ya ramani
    n64 imesogea;           // tangu kubonyeza (bofya dhidi ya kuburuta)
    n64 vuta_x;
    n64 vuta_y;
    n64 haja;               // fremu mpya inahitajika
    n64 haja_msingi;        // ramani (msingi) lazima ichorwe upya
    n64 elea_taifa;         // taifa chini ya kielekezi, au -1
    n64 elea_x;
    n64 elea_y;
    n64 bandika_taifa;      // taifa lililobandikwa kwa kubofya, au -1
    n64 bandika_x;
    n64 bandika_y;
    Turubai* msingi;        // ramani na fremu ya mchezo, tayari kunakiliwa
    n64 shift;              // Shift imebonyezwa
    n64 skrini_nzima;       // 1 = skrini nzima (F11 hubadili)
}

w0 chafua_msingi(Hali* h) {
    h->haja = 1;
    h->haja_msingi = 1;
}

// Data imebadilika (zamu, taifa, lugha): ukurasa uchorwe upya.
w0 chafua_ukurasa(Hali* h) {
    h->haja = 1;
}

// Fungua ukurasa `skrini` (au rudi kwenye ramani).
w0 fungua_ukurasa(Hali* h, n64 skrini) {
    kama (skrini < 0) { rudisha; }
    h->skrini = skrini;
    h->elea_taifa = 0 - 1;
    chafua_msingi(h);
}

// Eneo la ramani ndani ya dirisha (lazima lilingane na skrini_ramani_chora).
n64 ramani_x() { rudisha SKRINI_UPANA_WA_PEMBENI + 1; }
n64 ramani_y() { rudisha SKRINI_UPAU_WA_JUU + 1; }

// Mipaka ya ukuzaji: atlasi ya zamani (vizio 1/1024 kwa pikseli) au dunia
// iliyokubaliwa (pikseli za dunia * 256 kwa pikseli: 24 = mara ~10, 1100 = dunia nzima).
n64 KIPIMO_CHINI = 3;
n64 KIPIMO_JUU = 60;

w0 badili_kipimo(Hali* h, Dirisha* d, n64 kipimo_kipya, n64 px, n64 py) {
    n64 k = kipimo_kipya;
    kama (k < KIPIMO_CHINI) { k = KIPIMO_CHINI; }
    kama (k > KIPIMO_JUU) { k = KIPIMO_JUU; }
    kama (k == h->kipimo) { rudisha; }
    // nukta ya dunia chini ya kielekezi ibaki pale pale
    n64 w = d->upana - ramani_x() - SKRINI_RAMANI_PANELI;
    n64 hh = d->kimo - ramani_y();
    n64 dx = px - ramani_x() - w / 2;
    n64 dy = py - ramani_y() - hh / 2;
    n64 wx = h->kitovu_x + dx * h->kipimo;
    n64 wy = h->kitovu_y + dy * h->kipimo;
    h->kitovu_x = wx - dx * k;
    h->kitovu_y = wy - dy * k;
    h->kipimo = k;
    chafua_msingi(h);
}

// Taifa lililo chini ya (px, py) kwenye ramani, au -1.
n64 taifa_chini_ya(Dirisha* d, n64 px, n64 py) {
    n64 w = d->upana - ramani_x() - SKRINI_RAMANI_PANELI;
    n64 hh = d->kimo - ramani_y();
    n64 i = px - ramani_x();
    n64 j = py - ramani_y();
    kama (i < 0 || j < 0 || i >= w || j >= hh) { rudisha 0 - 1; }
    kama (skrini_dunia != 0) {
        kama (dh_wamiliki_skrini == 0) { rudisha 0 - 1; }
        rudisha dh_wamiliki_skrini[j * w + i];
    }
    kama (atlasi_wamiliki == 0) { rudisha 0 - 1; }
    rudisha atlasi_wamiliki[j * w + i];
}

// Upana wa droo ya taifa upande wa kulia ikiwa wazi.
n64 DROO_UPANA = 360;

w0 funga_droo(Hali* h) {
    kama (SKRINI_RAMANI_PANELI == 0 && h->bandika_taifa < 0) { rudisha; }
    SKRINI_RAMANI_PANELI = 0;
    h->bandika_taifa = 0 - 1;
    chafua_msingi(h);
}

// Kubofya taifa: kadi yake hubandikwa pale ilipobofywa na droo ya kulia
// hufunguka na data zake zaidi. Kubofya bahari hufunga vyote.
w0 chagua_taifa(Hali* h, Dirisha* d, n64 px, n64 py) {
    n64 o = taifa_chini_ya(d, px, py);
    kama (o < 0) { funga_droo(h); rudisha; }
    h->taifa = o;
    kama (skrini_dunia != 0) { h->taifa_dunia = o; }
    h->bandika_taifa = o;
    h->bandika_x = px;
    h->bandika_y = py;
    SKRINI_RAMANI_PANELI = DROO_UPANA;
    chafua_msingi(h);
    chafua_ukurasa(h);
}

n32 ndani_ya_ramani(Dirisha* d, n64 px, n64 py) {
    rudisha px >= ramani_x() && py >= ramani_y() && px < d->upana - SKRINI_RAMANI_PANELI;
}

// Kadi ya taifa (dirisha dogo linaloelea) kwenye (px, py):
//   kichwa      rangi ya taifa, jina, aina ya utawala, kidonge cha nafasi
//   takwimu     watu, pato ghafi, pato kwa kila mtu
//   mwenendo    pato la zamu 12 za mwisho kama mstari, na mabadiliko
//   serikali    mgawanyo wa viti wa baraza la kwanza na sehemu ya serikali
//   vielezo     teknolojia, uchumi, jeshi, utamaduni kama pau ndogo
// `imebandikwa` huipa mstari wa njano juu; isiyobandikwa ina maelekezo chini.
n64 KADI_YA_TAIFA_UPANA = 330;

w0 chora_kadi_ya_taifa_kwa(Mchezo* g, Turubai* t, n64 taifa, n64 px, n64 py, n32 imebandikwa) {
    kama (taifa < 0) { rudisha; }
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    TaifaNchi* tn = dunia_taifa_mfumo_pata_kwa_faharisi(tm, taifa);
    Dola* dola = skrini_siasa_dola(g, taifa);
    kama (tn == 0 || dola == 0) { rudisha; }
    TakwimuHistoria* hist = mchezo_pata_historia_ya_taifa(g, taifa);
    n64 w = KADI_YA_TAIFA_UPANA;
    n64 hh = 318;
    kama (imebandikwa) { hh = 296; }
    n64 x = px + 18;
    n64 y = py + 18;
    kama (x + w > t->upana - SKRINI_RAMANI_PANELI - 8) { x = px - w - 16; }
    kama (y + hh > t->kimo - 8) { y = py - hh - 14; }
    kama (x < ramani_x() + 8) { x = ramani_x() + 8; }
    kama (y < SKRINI_UPAU_WA_JUU + 8) { y = SKRINI_UPAU_WA_JUU + 8; }
    // kivuli laini na uso
    n64 k = 6;
    wakati (k > 0) {
        turubai_brashi(t, 0, 18);
        turubai_mviringo(t, x - k + 2, y - k + 8, w + 2 * k - 4, hh + 2 * k - 4, 14 + k);
        k = k - 1;
    }
    turubai_brashi(t, SURA_PANELI_JUU, 250);
    turubai_mviringo(t, x, y, w, hh, 12);
    turubai_brashi(t, 16777215, 26);
    turubai_mpaka(t, x, y, w, hh, 12);
    kama (imebandikwa) {
        turubai_kata(t, x, y, w, 3);
        turubai_brashi(t, SURA_BAHARI, 255);
        turubai_mviringo(t, x, y, w, 12, 12);
        turubai_kata_yote(t);
    }
    // kichwa
    turubai_brashi(t, tn->rangi, 255);
    turubai_mviringo(t, x + 16, y + 18, 30, 22, 5);
    turubai_brashi(t, 16777215, 50);
    turubai_mpaka(t, x + 16, y + 18, 30, 22, 5);
    n8 cheo[24];
    n8 nafasi[16];
    sura_namba(nafasi, skrini_nafasi_ya_pato(tm, tn));
    mfuatano_umbiza(cheo, 24, "#%s", nafasi, 0, 0, 0, 0, 0);
    n64 wc = maandishi_upana(sura_nene, cheo, 11) + 16;
    turubai_kata(t, x, y, w - wc - 24, hh);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_nene(tn->jina, x + 58, y + 14, 16);
    sura_rangi(SURA_HAFIFU);
    sura_lebo(dola_aina_jina(dola->aina), x + 58, y + 35, 11);
    turubai_kata_yote(t);
    turubai_brashi(t, SURA_BAHARI, 46);
    turubai_mviringo(t, x + w - 16 - wc, y + 18, wc, 22, 11);
    turubai_brashi(t, SURA_BAHARI, 255);
    maandishi_chora(t, sura_nene, cheo, x + w - 16 - wc + 8, y + 21, 11);
    turubai_brashi(t, 16777215, 20);
    turubai_jaza(t, x + 16, y + 58, w - 32, 1);
    // takwimu tatu
    n64 wk = (w - 32) / 3;
    n8 m[32];
    n64 kila_mtu = 0;
    kama (tn->idadi_ya_watu > 0) { kila_mtu = skrini_pato_la_taifa(tn) / tn->idadi_ya_watu; }
    n64 c = 0;
    wakati (c < 3) {
        n8* lebo = ui("POPULATION");
        sura_namba_fupi(m, tn->idadi_ya_watu);
        kama (c == 1) { lebo = ui("tab|GDP"); sura_namba_fupi(m, skrini_pato_la_taifa(tn)); }
        kama (c == 2) { lebo = ui("PER CAPITA"); sura_namba(m, kila_mtu); }
        n64 cx = x + 16 + c * wk;
        sura_rangi(SURA_HAFIFU);
        sura_lebo_kati(lebo, cx, y + 70, 10);
        sura_rangi(SURA_MAANDISHI);
        sura_lebo_nene(m, cx, y + 86, 16);
        c = c + 1;
    }
    // mwenendo wa pato
    n64 ys = y + 122;
    sura_rangi(SURA_HAFIFU);
    sura_lebo(ui("GDP, last 12 turns"), x + 16, ys, 11);
    kama (hist != 0 && hist->idadi > 1) {
        n64 n = hist->idadi;
        kama (n > 12) { n = 12; }
        n64* sampuli = tenga(8 * n);
        n64 i = 0;
        wakati (i < n) {
            d64 sd = hist->sampuli[hist->idadi - n + i];
            sampuli[i] = sd * 1000000.0;
            i = i + 1;
        }
        n64 badiliko = skrini_mabadiliko(hist, n - 1);
        kama (badiliko != 0) {
            sura_asilimia(m, badiliko, 1);
            n64 wd = maandishi_upana(sura_kati, m, 11) + 14;
            chati_kidonge_cha_mabadiliko(x + w - 16 - wd, ys - 3, badiliko);
        }
        sura_sparkline(sampuli, n, x + 16, ys + 22, w - 32, 34, SURA_BAHARI, 40);
        achilia sampuli;
    } sivyo {
        sura_lebo(ui("History appears after two turns."), x + 16, ys + 30, 11);
    }
    // serikali
    n64 yg = y + 196;
    kama (dola->mabaraza > 0) {
        n64 viti[8];
        n64 rangi[8];
        n64 uwazi[8];
        n64 nv = skrini_siasa_viti_vya_baraza(dola, 0, viti, rangi, uwazi);
        sura_asilimia(m, (dola_viti_vya_serikali(dola, 0) * 10000) / dola->baraza_viti[0], 0);
        n8 mstari[96];
        mfuatano_umbiza(mstari, 96, ui("Government holds %s"), m, 0, 0, 0, 0, 0);
        sura_rangi(SURA_HAFIFU);
        sura_lebo(mstari, x + 16, yg, 11);
        kama (nv > 0) { sura_pau_lililopangwa(x + 16, yg + 20, w - 32, 8, viti, rangi, nv, dola->baraza_viti[0], 2); }
    } sivyo {
        sura_rangi(SURA_HAFIFU);
        sura_lebo(ui("No legislature"), x + 16, yg, 11);
    }
    // vielezo vinne
    n64 yv = y + 240;
    n64 wb = (w - 32 - 3 * 10) / 4;
    c = 0;
    wakati (c < 4) {
        n8* lebo = ui("TECH");
        n64 v = tn->kielezo_cha_teknolojia;
        n64 rangi_ya_pau = SURA_BAHARI;
        kama (c == 1) { lebo = ui("ECON"); v = tn->kielezo_cha_uchumi; rangi_ya_pau = SURA_CHANYA; }
        kama (c == 2) { lebo = ui("MIL"); v = tn->kielezo_cha_kijeshi; rangi_ya_pau = SURA_HASI; }
        kama (c == 3) { lebo = ui("CULT"); v = tn->kielezo_cha_utamaduni; rangi_ya_pau = SURA_LAFUDHI; }
        n64 bx = x + 16 + c * (wb + 10);
        sura_rangi(SURA_HAFIFU);
        sura_lebo_kati(lebo, bx, yv, 10);
        sura_namba(m, v);
        sura_rangi(SURA_MAANDISHI);
        sura_lebo_kulia(m, bx + wb, yv, 10);
        sura_pau(bx, yv + 18, wb, 4, v, rangi_ya_pau);
        c = c + 1;
    }
    kama (imebandikwa == 0) {
        turubai_brashi(t, 16777215, 20);
        turubai_jaza(t, x + 16, y + hh - 34, w - 32, 1);
        sura_rangi(SURA_HAFIFU);
        sura_lebo(ui("Click to pin and open the dossier"), x + 16, y + hh - 24, 11);
    }
}

// Kadi iliyobandikwa hubaki mahali pake; kadi ya kielekezi hufuata kielekezi.
w0 chora_kadi_za_taifa(Mchezo* g, Turubai* t, Hali* h) {
    chora_kadi_ya_taifa_kwa(g, t, h->bandika_taifa, h->bandika_x, h->bandika_y, 1);
    kama (h->elea_taifa >= 0 && h->elea_taifa != h->bandika_taifa) { chora_kadi_ya_taifa_kwa(g, t, h->elea_taifa, h->elea_x, h->elea_y, 0); }
}

// Sanduku la upau wa juu: mtu anayeshikwa na mchezaji (jina na cheo) na
// herufi zake za mwanzo.
w0 chora_sanduku_la_mtu(Mchezo* g, Turubai* t, Hali* h) {
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    Wahusika* w = skrini_mkutano_watu(g, tm->faharisi_ya_taifa_la_mchezaji);
    MhusikaWaDola* mimi = wahusika_pata(w, mkutano_ofisi);
    kama (mimi == 0) { rudisha; }
    n64 x = skrini_mtu_x(t->upana);
    n64 w_ = 288;
    kama (x < SKRINI_UPANA_WA_PEMBENI + 260) { rudisha; }       // dirisha jembamba: hakuna nafasi
    turubai_brashi(t, SURA_USULI, 255);
    turubai_mviringo(t, x, 10, w_, 44, 4);
    turubai_brashi(t, 16777215, 30);
    turubai_mpaka(t, x, 10, w_, 44, 4);
    turubai_brashi(t, SURA_PANELI_JUU, 255);
    turubai_duara(t, x + 24, 32, 15);
    n8 herufi[4];
    herufi[0] = mimi->jina[0];
    herufi[1] = 0;
    n64 i = 0;
    wakati (mimi->jina[i] != 0 && mimi->jina[i] != 32) { i = i + 1; }
    kama (mimi->jina[i] == 32) { herufi[1] = mimi->jina[i + 1]; herufi[2] = 0; }
    n64 wh = maandishi_upana(sura_nene, herufi, 12);
    turubai_brashi(t, SURA_MAANDISHI, 255);
    maandishi_chora(t, sura_nene, herufi, x + 24 - wh / 2, 25, 12);
    turubai_kata(t, x, 10, w_ - 34, 44);
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_kati(mimi->jina, x + 48, 14, 13);
    sura_rangi(SURA_HAFIFU);
    sura_lebo(mimi->cheo, x + 48, 32, 11);
    turubai_kata_yote(t);
    sura_ikoni(x + w_ - 18, 32, 10, SURA_ICON_ARROW_DOWN, SURA_HAFIFU, 255);
}

// ---------- kadi za muhtasari juu ya ramani ----------

// Safu ya kadi chini ya ramani: kila kadi ni muhtasari wa eneo moja la taifa
// lililochaguliwa, na kuibofya hufungua dirisha kamili la eneo hilo.
n64 KADI_IDADI = 4;
n64 KADI_KIMO = 104;
n64 KADI_PENGO = 10;

// Dirisha linalofunguliwa na kadi k.
n64 kadi_lengwa(n64 k) {
    kama (k == 0) { rudisha SKRINI_UCHUMI; }
    kama (k == 1) { rudisha SKRINI_SIASA; }
    kama (k == 2) { rudisha SKRINI_MKUTANO; }
    rudisha SKRINI_MUHTASARI;
}

// Kadi zinazotosha upana wa ramani (kila moja angalau px 200), hadi nne.
n64 kadi_zinazoonekana(Dirisha* d) {
    n64 eneo = d->upana - ramani_x() - SKRINI_RAMANI_PANELI - 24;
    n64 n = (eneo + KADI_PENGO) / (200 + KADI_PENGO);
    kama (n > KADI_IDADI) { n = KADI_IDADI; }
    kama (n < 1) { n = 1; }
    rudisha n;
}

// Upana wa kadi moja na x ya kadi k ndani ya eneo la ramani.
n64 kadi_upana(Dirisha* d) {
    n64 eneo = d->upana - ramani_x() - SKRINI_RAMANI_PANELI - 24;
    n64 n = kadi_zinazoonekana(d);
    n64 w = (eneo - (n - 1) * KADI_PENGO) / n;
    kama (w > 300) { w = 300; }
    rudisha w;
}

n64 kadi_x(Dirisha* d, n64 k) { rudisha ramani_x() + 12 + k * (kadi_upana(d) + KADI_PENGO); }
n64 kadi_y(Dirisha* d) { rudisha d->kimo - KADI_KIMO - 16; }

// Kadi iliyo chini ya (px, py), au -1.
n64 kadi_chini_ya(Dirisha* d, n64 px, n64 py) {
    n64 y = kadi_y(d);
    kama (py < y || py >= y + KADI_KIMO) { rudisha 0 - 1; }
    n64 k = 0;
    wakati (k < kadi_zinazoonekana(d)) {
        n64 x = kadi_x(d, k);
        kama (px >= x && px < x + kadi_upana(d)) { rudisha k; }
        k = k + 1;
    }
    rudisha 0 - 1;
}

// Msingi wa kadi: uso, ukingo, kichwa, na mshale mdogo wa "fungua".
w0 kadi_msingi(Turubai* t, n64 x, n64 y, n64 w, n8* kichwa, n32 imeelekezwa) {
    turubai_brashi(t, 0, 60);
    turubai_mviringo(t, x + 2, y + 4, w, KADI_KIMO, 9);
    turubai_brashi(t, SURA_PANELI, 244);
    turubai_mviringo(t, x, y, w, KADI_KIMO, 8);
    kama (imeelekezwa) { turubai_brashi(t, SURA_BAHARI, 200); }
    sivyo { turubai_brashi(t, 16777215, 30); }
    turubai_mpaka(t, x, y, w, KADI_KIMO, 8);
    turubai_brashi(t, SURA_BAHARI, 255);
    turubai_jaza(t, x + 12, y + 13, 3, 11);
    turubai_brashi(t, SURA_HAFIFU, 255);
    maandishi_chora(t, sura_nene, kichwa, x + 22, y + 11, 10);
    maandishi_chora(t, sura_nene, ">", x + w - 20, y + 10, 12);
}

w0 chora_kadi_za_muhtasari(Mchezo* g, Turubai* t, Hali* h, Dirisha* d) {
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    TaifaNchi* tn = dunia_taifa_mfumo_pata_kwa_faharisi(tm, h->taifa);
    Dola* dola = skrini_siasa_dola(g, h->taifa);
    kama (tn == 0 || dola == 0) { rudisha; }
    n64 w = kadi_upana(d);
    n64 y = kadi_y(d);
    n64 juu_ya = kadi_chini_ya(d, h->elea_x, h->elea_y);
    n8 chombo[96];
    n8 m[24];
    // 0: uchumi -- pato, pato kwa kila mtu, mwenendo
    n64 x = kadi_x(d, 0);
    kadi_msingi(t, x, y, w, ui("ECONOMY"), juu_ya == 0);
    sura_namba_fupi(chombo, skrini_pato_la_taifa(tn));
    sura_rangi(SURA_MAANDISHI);
    sura_lebo_nene(chombo, x + 14, y + 32, 24);
    n64 kila_mtu = 0;
    kama (tn->idadi_ya_watu > 0) { kila_mtu = skrini_pato_la_taifa(tn) / tn->idadi_ya_watu; }
    sura_namba(m, kila_mtu);
    mfuatano_umbiza(chombo, 96, ui("%s per head"), m, 0, 0, 0, 0, 0);
    sura_rangi(SURA_HAFIFU);
    sura_lebo(chombo, x + 14, y + 68, 11);
    TakwimuHistoria* hist = mchezo_pata_historia_ya_taifa(g, h->taifa);
    kama (hist != 0 && hist->idadi > 1) {
        n64 n = hist->idadi;
        kama (n > 24) { n = 24; }
        n64* sampuli = tenga(8 * n);
        n64 i = 0;
        wakati (i < n) {
            d64 sd = hist->sampuli[hist->idadi - n + i];
            sampuli[i] = sd * 1000000.0;
            i = i + 1;
        }
        sura_sparkline(sampuli, n, x + w - 96, y + 38, 82, 46, SURA_BAHARI, 40);
        achilia sampuli;
    }
    n64 zinazoonekana = kadi_zinazoonekana(d);
    kama (zinazoonekana < 2) { rudisha; }
    // 1: siasa -- aina ya utawala na wingi wa serikali
    x = kadi_x(d, 1);
    kadi_msingi(t, x, y, w, ui("POLITICS"), juu_ya == 1);
    sura_rangi(SURA_MAANDISHI);
    turubai_kata(t, x, y, w - 12, KADI_KIMO);
    sura_lebo_nene(dola_aina_jina(dola->aina), x + 14, y + 36, 13);
    turubai_kata_yote(t);
    kama (dola->mabaraza > 0) {
        n64 viti[8];
        n64 rangi[8];
        n64 uwazi[8];
        n64 nv = skrini_siasa_viti_vya_baraza(dola, 0, viti, rangi, uwazi);
        kama (nv > 0) { sura_pau_lililopangwa(x + 14, y + 62, w - 28, 8, viti, rangi, nv, dola->baraza_viti[0], 1); }
        sura_asilimia(m, (dola_viti_vya_serikali(dola, 0) * 10000) / dola->baraza_viti[0], 0);
        mfuatano_umbiza(chombo, 96, ui("Government holds %s"), m, 0, 0, 0, 0, 0);
    } sivyo { nakili_mfuatano(chombo, ui("No legislature")); }
    sura_rangi(SURA_HAFIFU);
    sura_lebo(chombo, x + 14, y + 78, 11);
    kama (zinazoonekana < 3) { rudisha; }
    // 2: serikali -- watu wa dola na wanaoomba kumwona mchezaji
    x = kadi_x(d, 2);
    kadi_msingi(t, x, y, w, ui("GOVERNMENT"), juu_ya == 2);
    Wahusika* watu = skrini_mkutano_watu(g, h->taifa);
    kama (watu != 0) {
        sura_namba(m, watu->idadi);
        sura_rangi(SURA_MAANDISHI);
        sura_lebo_nene(m, x + 14, y + 32, 24);
        sura_rangi(SURA_HAFIFU);
        sura_lebo(ui("officials"), x + 14 + maandishi_upana(sura_nene, m, 24) + 8, y + 44, 11);
        n64 maombi[3];
        n64 nq = katiba_maombi_yanayoingia(watu, mkutano_ofisi, g->zamu_ya_sasa, maombi, 3);
        sura_namba(m, nq);
        mfuatano_umbiza(chombo, 96, ui("%s ask to see you"), m, 0, 0, 0, 0, 0);
        sura_rangi(SURA_LAFUDHI);
        sura_lebo(chombo, x + 14, y + 78, 11);
    }
    kama (zinazoonekana < 4) { rudisha; }
    // 3: hali ya dola -- utulivu, uhalali, hazina
    x = kadi_x(d, 3);
    kadi_msingi(t, x, y, w, ui("STATE OF THE NATION"), juu_ya == 3);
    n64 k = 0;
    wakati (k < 3) {
        n8* lebo = ui("Stability");
        n64 v = dola->utulivu;
        n64 rangi_ya_pau = SURA_CHANYA;
        kama (k == 1) { lebo = ui("Legitimacy"); v = dola->uhalali; rangi_ya_pau = SURA_BAHARI; }
        kama (k == 2) { lebo = ui("Treasury"); v = dola->hazina; rangi_ya_pau = SURA_LAFUDHI; }
        n64 ry = y + 34 + k * 21;
        sura_rangi(SURA_HAFIFU);
        sura_lebo(lebo, x + 14, ry, 11);
        sura_namba(m, v);
        sura_rangi(SURA_MAANDISHI);
        sura_lebo_kulia(m, x + w - 14, ry, 11);
        sura_pau(x + 92, ry + 5, w - 140, 4, v * 10, rangi_ya_pau);
        k = k + 1;
    }
}

// ---------- ingizo ----------

// Bofya ndani ya maudhui ya skrini `skrini` yenye ukubwa (upana, kimo);
// (px, py) ni za maudhui. Vipimo vya SKRINI_* ni vya mpangilio uliochorwa.
w0 bofya_skrini(Mchezo* g, Hali* h, n64 skrini, n64 upana, n64 kimo, n64 px, n64 py) {
    n64 x0 = SKRINI_UPANA_WA_PEMBENI + 25;
    kama (skrini == SKRINI_MIPANGILIO) {
        n64 lugha_mpya = skrini_mipangilio_bofya(upana, px, py);
        kama (lugha_mpya >= 0 && lugha_mpya != maneno_lugha) {
            mipangilio_tumia_lugha(g, lugha_mpya);
            mipangilio_hifadhi_lugha(lugha_mpya);
            chafua_msingi(h);
            chafua_ukurasa(h);
        }
        mipangilio_akili_tekeleza(skrini_mipangilio_bofya_akili(upana, px, py));
    }
    kama (skrini == SKRINI_DUNIA_YOTE) { bofya_dunia(g, h, px, py); }
    // vipengele vya dashibodi (jopo.swa) kwenye kurasa za taifa: kubofya taifa hulifungua
    kama (skrini == SKRINI_SIASA || skrini == SKRINI_JESHI || skrini == SKRINI_UTAMADUNI || skrini == SKRINI_TEKNOLOJIA || skrini == SKRINI_DIPLOMASIA || skrini == SKRINI_UCHUMI) {
        n64 hoja = 0;
        n64 kitendo = bofya_tafuta(px, py, &hoja);
        kama (kitendo == JOPO_FUNGUA) { h->taifa = hoja; chafua_ukurasa(h); rudisha; }
        kama (kitendo == JOPO_WIGO) { skrini_wigo = hoja; chafua_ukurasa(h); rudisha; }
    }
    kama (skrini == SKRINI_JESHI && skrini_jeshi_bofya(g, h->taifa, px, py)) { chafua_ukurasa(h); rudisha; }
    kama (skrini == SKRINI_KATIBA && skrini_katiba_bofya(g, h->taifa, px, py)) { chafua_ukurasa(h); rudisha; }
    kama (skrini == SKRINI_WASIFU) {
        n64 kituo = 0;
        kama (skrini_wasifu_bofya(g, px, py, &kituo)) {
            kama (kituo == 1) { fungua_ukurasa(h, SKRINI_UCHUMI); }
            kama (kituo >= 2) { pakia_nafasi(g, h, kituo - 2); }
            chafua_ukurasa(h);
            rudisha;
        }
    }
    kama (skrini == SKRINI_UCHUMI) {
        n64 fungua = 0;
        n64 kutana = 0;
        kama (skrini_uchumi_bofya(g, px, py, &fungua, &kutana)) {
            kama (fungua >= 0) { h->taifa = fungua; }
            kama (kutana >= 0) {
                skrini_mkutano_chagua_tajiri(kutana);
                h->taifa = mchezo_pata_taifa(g)->faharisi_ya_taifa_la_mchezaji;
                fungua_ukurasa(h, SKRINI_MKUTANO);
            }
            chafua_ukurasa(h);
            rudisha;
        }
    }
    kama (skrini == SKRINI_DIPLOMASIA) { bofya_diplomasia(g, h, upana, kimo, px, py); }
    kama (skrini == SKRINI_KALENDA) { skrini_kalenda_bofya(upana, kimo, tarehe_siku_ya_zamu(g->zamu_ya_sasa), px, py); }
    kama (skrini == SKRINI_KIKASHA) { bofya_kikasha(g, h, upana, kimo, px, py); }
    kama (skrini == SKRINI_MKUTANO) {
        Dola* dola = skrini_siasa_dola(g, h->taifa);
        Wahusika* watu = skrini_mkutano_watu(g, h->taifa);
        kama (watu != 0 && dola != 0) { skrini_mkutano_bofya_eneo(px, py, g, dola, watu); }
    }
}

// Kitendo cha kikasha: kumwona mtumaji sasa, kumpangia, au kufungua kalenda.
w0 bofya_kikasha(Mchezo* g, Hali* h, n64 upana, n64 kimo, n64 px, n64 py) {
    n64 kitendo = skrini_kikasha_bofya(upana, kimo, px, py);
    kama (kitendo == KIKASHA_KITENDO_HAKUNA) { rudisha; }
    chafua_msingi(h);                                   // beji ya urambazaji
    Ujumbe* u = kikasha_pata(kikasha_teule);
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    Wahusika* watu = skrini_mkutano_watu(g, tm->faharisi_ya_taifa_la_mchezaji);
    kama (u == 0 || watu == 0) { rudisha; }
    kama (kitendo == KIKASHA_KITENDO_ONANA) {
        skrini_mkutano_fungua_na(u->mtumaji, watu);
        fungua_ukurasa(h, SKRINI_MKUTANO);
    }
    kama (kitendo == KIKASHA_KITENDO_PANGA) {
        skrini_mkutano_panga(u->mtumaji, 2, watu);
        chafua_ukurasa(h);
    }
    kama (kitendo == KIKASHA_KITENDO_KALENDA) { fungua_ukurasa(h, SKRINI_KALENDA); }
}

w0 bofya_diplomasia(Mchezo* g, Hali* h, n64 upana, n64 kimo, n64 px, n64 py) {
    n64 detail_x = SKRINI_UPANA_WA_PEMBENI + 25;
    n64 detail_w = upana - detail_x - 24;
    n64 detail_y = SKRINI_UPAU_WA_JUU + 25 + 44 + 158;
    n64 close_x = detail_x + detail_w - 50;
    kama (skrini_diplomasia_mstari_mteule >= 0 && px >= close_x && px < close_x + 24 && py >= kimo - 203 && py < kimo - 179) {
        skrini_diplomasia_mstari_mteule = 0 - 1;
        rudisha;
    }
    kama (px < detail_x || px >= detail_x + detail_w || py < detail_y + 66) { rudisha; }
    TaifaMfumo* countries = mchezo_pata_taifa(g);
    DiplomasiaMfumo* diplomacy = mchezo_pata_diplomasia(g);
    TaifaNchi* mwenyewe = dunia_taifa_mfumo_pata_kwa_faharisi(countries, h->taifa);
    kama (mwenyewe == 0) { rudisha; }
    n64 neighbor_count = 0;
    n64 ni = 0;
    wakati (ni < countries->idadi) {
        kama (dunia_atlasi_mpaka(h->taifa, ni) > 0) {
            TaifaNchi* neighbor = dunia_taifa_mfumo_pata_kwa_faharisi(countries, ni);
            kama (diplomasia_pata_kwa_taifa(diplomacy, mwenyewe->kitambulisho, neighbor->kitambulisho) != 0) { neighbor_count = neighbor_count + 1; }
        }
        ni = ni + 1;
    }
    n64 row = (py - detail_y - 66) / SKRINI_KIMO_CHA_SAFU;
    n64 row_limit = (kimo - detail_y - 90) / SKRINI_KIMO_CHA_SAFU;
    kama (row_limit > neighbor_count) { row_limit = neighbor_count; }
    kama (row >= 0 && row < row_limit) { skrini_diplomasia_mstari_mteule = row; }
}

// Bonyezo la kushoto: upau wa juu, urambazaji, ukurasa, au ramani.
w0 bonyeza(Mchezo* g, Hali* h, Dirisha* d, n64 px, n64 py) {
    // orodha ya vipindi ikiwa wazi, bofya lolote hulifunga (na huchagua kipindi)
    kama (skrini_kipindi_wazi) {
        n64 k = skrini_kipindi_chini_ya(d->upana, px, py);
        kama (k >= 0) { skrini_kipindi = k; }
        skrini_kipindi_wazi = 0;
        chafua_msingi(h);
        kama (k >= 0) { rudisha; }
    }
    kama (py < SKRINI_UPAU_WA_JUU) {
        // Continue: zamu inayofuata
        n64 xe = skrini_endelea_x(d->upana);
        kama (px >= xe + SKRINI_ENDELEA_UPANA - SKRINI_ENDELEA_MSHALE && px < xe + SKRINI_ENDELEA_UPANA && py >= 10 && py < 54) {
            skrini_kipindi_wazi = 1 - skrini_kipindi_wazi;
            h->haja = 1;
            rudisha;
        }
        kama (px >= xe && px < xe + SKRINI_ENDELEA_UPANA && py >= 10 && py < 54) { songa_kipindi(g, h); }
        rudisha;
    }
    kama (px < SKRINI_UPANA_WA_PEMBENI) {
        n64 i = skrini_nav_chini_ya(px, py, d->kimo);
        kama (i >= 0) { fungua_ukurasa(h, skrini_nav_skrini(i)); }
        rudisha;
    }
    kama (h->skrini != SKRINI_RAMANI) {
        bofya_skrini(g, h, h->skrini, d->upana, d->kimo, px, py);
        h->haja = 1;
        rudisha;
    }
    // kadi ya muhtasari: hufungua ukurasa kamili wa eneo lake
    n64 kadi = kadi_chini_ya(d, px, py);
    kama (kadi >= 0) { fungua_ukurasa(h, kadi_lengwa(kadi)); rudisha; }
    kama (ndani_ya_ramani(d, px, py)) {
        n64 zc_x = d->upana - SKRINI_RAMANI_PANELI - 98;
        n64 zc_y = skrini_ramani_vidhibiti_y();
        n32 kwenye_vidhibiti = py >= zc_y + 6 && py < zc_y + 36;
        kama (kwenye_vidhibiti && px >= zc_x + 10 && px < zc_x + 42) { badili_kipimo(h, d, (h->kipimo * 5) / 4 + 1, px, py); rudisha; }
        kama (kwenye_vidhibiti && px >= zc_x + 43 && px < zc_x + 76) { badili_kipimo(h, d, (h->kipimo * 4) / 5, px, py); rudisha; }
        h->inavutwa = 1;
        h->imesogea = 0;
        h->vuta_x = px;
        h->vuta_y = py;
    }
}

// Mwendo wa kielekezi: buruta ramani, au kadi ya taifa chini ya kielekezi.
w0 sogeza(Hali* h, Dirisha* d, n64 px, n64 py) {
    kama (h->skrini != SKRINI_RAMANI) { rudisha; }
    kama (h->inavutwa) {
        n64 dx = px - h->vuta_x;
        n64 dy = py - h->vuta_y;
        kama (dx * dx + dy * dy > 9) { h->imesogea = 1; }
        kama (h->imesogea) {
            h->kitovu_x = h->kitovu_x - dx * h->kipimo;
            h->kitovu_y = h->kitovu_y - dy * h->kipimo;
            h->vuta_x = px;
            h->vuta_y = py;
            h->elea_taifa = 0 - 1;
            chafua_msingi(h);
        }
        rudisha;
    }
    n64 o = 0 - 1;
    kama (ndani_ya_ramani(d, px, py) && kadi_chini_ya(d, px, py) < 0) { o = taifa_chini_ya(d, px, py); }
    // kadi inayoelekezwa hubadilisha ukingo wake
    kama (kadi_chini_ya(d, px, py) != kadi_chini_ya(d, h->elea_x, h->elea_y)) { h->haja = 1; }
    kama (o != h->elea_taifa || o >= 0) { h->haja = 1; }
    h->elea_taifa = o;
    h->elea_x = px;
    h->elea_y = py;
}

w0 achia(Hali* h, Dirisha* d, n64 px, n64 py) {
    kama (h->inavutwa && h->imesogea == 0) { chagua_taifa(h, d, px, py); }
    kama (h->inavutwa && h->imesogea) { chafua_msingi(h); }
    h->inavutwa = 0;
}

// Zamu inayofuata: uigaji husonga, ramani na madirisha huchorwa upya.
// Ujumbe wa zamu ya sasa kwa taifa la mchezaji, na beji ya kikasha.
w0 sasisha_kikasha(Mchezo* g) {
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    n64 taifa = tm->faharisi_ya_taifa_la_mchezaji;
    Dola* dola = skrini_siasa_dola(g, taifa);
    Wahusika* watu = skrini_mkutano_watu(g, taifa);
    kama (dola != 0 && watu != 0) { kikasha_zamu(dola, watu, mkutano_ofisi, g->zamu_ya_sasa); }
    skrini_nav_beji_kikasha = kikasha_visivyosomwa();
}

// Bofya kwenye ukurasa wa World: maeneo yaliyoandikishwa wakati wa kuchora.
w0 bofya_dunia(Mchezo* g, Hali* h, n64 px, n64 py) {
    n64 hoja = 0;
    n64 k = skrini_dunia_bofya(px, py, &hoja);
    kama (k == DUNIA_CHUJIO) { skrini_dunia_chujio = hoja; skrini_dunia_habari_ukurasa = 0; }
    kama (k == DUNIA_PANGA) { skrini_dunia_mpangilio = hoja; skrini_dunia_ukurasa = 0; }
    kama (k == DUNIA_UKURASA) { skrini_dunia_ukurasa = skrini_dunia_ukurasa + hoja; }
    kama (k == DUNIA_HABARI_UKURASA) { skrini_dunia_habari_ukurasa = skrini_dunia_habari_ukurasa + hoja; }
    kama (skrini_dunia_ukurasa < 0) { skrini_dunia_ukurasa = 0; }
    kama (skrini_dunia_habari_ukurasa < 0) { skrini_dunia_habari_ukurasa = 0; }
    kama (k == DUNIA_FUNGUA) {
        h->taifa = hoja;
        fungua_ukurasa(h, 0);
    }
    kama (k == DUNIA_JIBU) {
        skrini_dunia_jibu(hoja);
        h->taifa = mchezo_pata_taifa(g)->faharisi_ya_taifa_la_mchezaji;
        fungua_ukurasa(h, SKRINI_MKUTANO);
    }
    chafua_ukurasa(h);
}

// Pakia nafasi na kurudisha mtazamo kwa taifa la mchezaji.
w0 pakia_nafasi(Mchezo* g, Hali* h, n64 nafasi) {
    n64 r = hifadhi_pakia(g, nafasi);
    kama (r == HIFADHI_SAWA) {
        h->taifa = mchezo_pata_taifa(g)->faharisi_ya_taifa_la_mchezaji;
        mfuatano_umbiza(wasifu_ujumbe, 160, ui("Slot %d loaded."), nafasi, 0, 0, 0, 0, 0);
    } sivyo { nakili_mfuatano(wasifu_ujumbe, ui("That slot could not be loaded.")); }
    chafua_msingi(h);
    chafua_ukurasa(h);
}

w0 zamu_inayofuata(Mchezo* g, Hali* h) {
    mchezo_sasisha(g);
    mchezo_maliza_zamu(g);
    // maamuzi yaliyo hai (biashara, mikopo, vikwazo, vita...) hufanya kazi kila wiki
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    uamuzi_zamu(g->zamu_ya_sasa, skrini_siasa_dola(g, tm->faharisi_ya_taifa_la_mchezaji));
    // masoko na mataifa hai: bei, sarafu, matukio ya kila taifa, pochi
    soko_wiki_moja(g, g->zamu_ya_sasa, 1);
    soko_mataifa_hai(g, g->zamu_ya_sasa);
    soko_pochi_wiki();
    Pochi* pochi = soko_pochi_pata();
    kama (pochi != 0 && pochi->mshauri == MSHAURI_SIASA) { nguvu_mtaji = nguvu_bana(nguvu_mtaji + 1, 0, 100); }
    kama (pochi != 0 && pochi->mshauri == MSHAURI_ULINZI) { nguvu_hatari = nguvu_bana(nguvu_hatari - 1, 0, 100); }
    kama (pochi != 0 && pochi->mshauri == MSHAURI_HABARI && g->zamu_ya_sasa % 4 == 0) {
        Dola* dh = skrini_siasa_dola(g, tm->faharisi_ya_taifa_la_mchezaji);
        dh->uhalali = dola_rekebisha(dh->uhalali, 1);
    }
    // katiba: marekebisho yaliyopita barazani huthibitishwa (na kura ya maoni)
    hati_zamu(skrini_siasa_dola(g, tm->faharisi_ya_taifa_la_mchezaji), skrini_mkutano_watu(g, tm->faharisi_ya_taifa_la_mchezaji), g->zamu_ya_sasa);
    // siasa ya wiki: kazi za msaidizi, kura za hoja, upinzani, kashfa
    nguvu_zamu(skrini_siasa_dola(g, tm->faharisi_ya_taifa_la_mchezaji), skrini_mkutano_watu(g, tm->faharisi_ya_taifa_la_mchezaji), tm->faharisi_ya_taifa_la_mchezaji, g->zamu_ya_sasa);
    habari_zamu(g);
    // majeshi: kuajiri, vifaa, ari, uhamasishaji na vita
    vk_zamu(g, g->zamu_ya_sasa);
    // kuhifadhi kwa otomatiki kila wiki nne
    kama (g->zamu_ya_sasa % 4 == 0) { hifadhi_andika(g, 0); }
    sasisha_kikasha(g);
    chafua_msingi(h);
    chafua_ukurasa(h);
}

// Songa kwa kipindi kilichochaguliwa. Hadi tukio: simama ujumbe mpya wa
// ombi au tahadhari ukifika, au mkutano wa shajara ukiwa wiki hii.
w0 songa_kipindi(Mchezo* g, Hali* h) {
    n64 mwaka = 0;
    n64 mwezi_wa_mwanzo = 0;
    n64 siku = 0;
    tarehe_ya_siku(tarehe_siku_ya_zamu(g->zamu_ya_sasa), &mwaka, &mwezi_wa_mwanzo, &siku);
    n64 hatua = 0;
    n32 simama = 0;
    wakati (simama == 0) {
        n64 maombi_kabla = kikasha_idadi;
        zamu_inayofuata(g, h);
        hatua = hatua + 1;
        n64 leo = tarehe_siku_ya_zamu(g->zamu_ya_sasa);
        kama (skrini_kipindi == KIPINDI_WIKI) { simama = 1; }
        kama (skrini_kipindi == KIPINDI_MWEZI) {
            n64 mwezi = 0;
            tarehe_ya_siku(leo, &mwaka, &mwezi, &siku);
            kama (mwezi != mwezi_wa_mwanzo || hatua >= 5) { simama = 1; }
        }
        kama (skrini_kipindi == KIPINDI_MIEZI_MITATU && hatua >= 13) { simama = 1; }
        kama (skrini_kipindi == KIPINDI_TUKIO) {
            n64 i = maombi_kabla;
            wakati (i < kikasha_idadi) {
                Ujumbe* u = kikasha_pata(i);
                kama (u->aina == UJUMBE_OMBI || u->aina == UJUMBE_TAHADHARI) { simama = 1; }
                i = i + 1;
            }
            kama (kalenda_mikutano_kati(leo, leo + 6) > 0) { simama = 1; }
            kama (hatua >= 26) { simama = 1; }
        }
    }
}

w0 kibodi(Mchezo* g, Hali* h, Dirisha* d, n64 a) {
    // ukurasa wa mikutano hupokea maandishi yote; Esc pekee hurudi kwenye ramani
    kama (h->skrini == SKRINI_MKUTANO && a != KEY_ESC) {
        skrini_mkutano_kibodi(a, h->shift);
        h->haja = 1;
        rudisha;
    }
    kama (a == KEY_ESC) {
        // Esc: ukurasa -> ramani, kisha droo ya taifa; bila chochote, hutoka
        kama (h->skrini != SKRINI_RAMANI) { fungua_ukurasa(h, SKRINI_RAMANI); }
        sivyo { kama (SKRINI_RAMANI_PANELI != 0) { funga_droo(h); }
        sivyo { d->imefungwa = 1; } }
        rudisha;
    }
    kama (a == KEY_SPACE) { songa_kipindi(g, h); rudisha; }
    // F5 huhifadhi kwenye nafasi 1, F9 hupakia nafasi 1
    kama (a == 63) { hifadhi_andika(g, 1); nakili_mfuatano(wasifu_ujumbe, ui("Saved to slot 1.")); h->haja = 1; rudisha; }
    kama (a == 67) { pakia_nafasi(g, h, 1); rudisha; }
    kama (a == KEY_F11) {
        h->skrini_nzima = 1 - h->skrini_nzima;
        dirisha_skrini_nzima(d, h->skrini_nzima);
        rudisha;
    }
    n64 cx = d->upana / 2;
    n64 cy = d->kimo / 2;
    kama (a == KEY_EQUAL) { badili_kipimo(h, d, (h->kipimo * 4) / 5, cx, cy); }
    kama (a == KEY_MINUS) { badili_kipimo(h, d, (h->kipimo * 5) / 4 + 1, cx, cy); }
    n64 hatua = 120 * h->kipimo;
    kama (a == KEY_LEFT) { h->kitovu_x = h->kitovu_x - hatua; chafua_msingi(h); }
    kama (a == KEY_RIGHT) { h->kitovu_x = h->kitovu_x + hatua; chafua_msingi(h); }
    kama (a == KEY_UP) { h->kitovu_y = h->kitovu_y - hatua; chafua_msingi(h); }
    kama (a == KEY_DOWN) { h->kitovu_y = h->kitovu_y + hatua; chafua_msingi(h); }
}

w0 shughulikia(Mchezo* g, Hali* h, Dirisha* d) {
    wakati (dirisha_tukio(d)) {
        n64 aina = d->t_aina;
        n64 a = d->t_a;
        n64 b = d->t_b;
        kama (aina == DIRISHA_MWENDO) { sogeza(h, d, a, b); }
        kama (aina == DIRISHA_KITUFE && a == KITUFE_KUSHOTO) {
            kama (b == 1) { bonyeza(g, h, d, d->kielekezi_x, d->kielekezi_y); }
            sivyo { achia(h, d, d->kielekezi_x, d->kielekezi_y); }
        }
        kama (aina == DIRISHA_GURUDUMU && h->skrini == SKRINI_KATIBA) {
            kama (a > 0) { skrini_katiba_tembeza(80); }
            kama (a < 0) { skrini_katiba_tembeza(0 - 80); }
            h->haja = 1;
        }
        kama (aina == DIRISHA_GURUDUMU && h->skrini == SKRINI_MKUTANO) {
            // gurudumu kwenye ukurasa wa serikali husogeza mti wa dola
            kama (a > 0) { skrini_mkutano_tembeza(3); }
            kama (a < 0) { skrini_mkutano_tembeza(0 - 3); }
            h->haja = 1;
        }
        kama (aina == DIRISHA_GURUDUMU && h->skrini == SKRINI_RAMANI) {
            // gurudumu hukuza ramani tu kielekezi kikiwa juu yake
            kama (ndani_ya_ramani(d, d->kielekezi_x, d->kielekezi_y)) {
                kama (a > 0) { badili_kipimo(h, d, (h->kipimo * 5) / 4 + 1, d->kielekezi_x, d->kielekezi_y); }
                kama (a < 0) { badili_kipimo(h, d, (h->kipimo * 4) / 5, d->kielekezi_x, d->kielekezi_y); }
            }
        }
        kama (aina == DIRISHA_KIBODI && (a == 42 || a == 54)) { h->shift = b; }
        kama (aina == DIRISHA_KIBODI && b == 1 && a != 42 && a != 54) { kibodi(g, h, d, a); }
        kama (aina == DIRISHA_TOKA) { h->elea_taifa = 0 - 1; h->haja = 1; }
        kama (aina == DIRISHA_UKUBWA) { chafua_msingi(h); }
    }
}

// ---------- kuchora fremu ----------

// Msingi: ramani pamoja na fremu ya mchezo, kwenye turubai yake.
w0 chora_msingi(Mchezo* g, Hali* h, Dirisha* d) {
    kama (h->msingi != 0) {
        kama (h->msingi->upana != d->upana || h->msingi->kimo != d->kimo) {
            achilia h->msingi->pikseli;
            achilia h->msingi;
            h->msingi = 0;
        }
    }
    kama (h->msingi == 0) { h->msingi = turubai_unda(d->upana, d->kimo); }
    Turubai* t = h->msingi;
    n64 taifa = h->taifa;
    kama (skrini_dunia != 0) { taifa = h->taifa_dunia; }
    // wakati wa kuburuta: hakikisho la haraka; fremu kamili ikiachiliwa
    n32 haraka = 0;
    kama (h->inavutwa && h->imesogea) { haraka = skrini_ramani_hakikisho(g, t, h->kitovu_x, h->kitovu_y, h->kipimo, taifa); }
    kama (haraka == 0) {
        kama (skrini_dunia != 0) {
            // mipaka ya kaskazini-kusini; mashariki-magharibi huzunguka
            kama (h->kitovu_y < 0) { h->kitovu_y = 0; }
            kama (h->kitovu_y > skrini_dunia->kimo * 256) { h->kitovu_y = skrini_dunia->kimo * 256; }
            skrini_dunia_chora(g, t, skrini_dunia, h->kitovu_x, h->kitovu_y, h->kipimo, h->taifa_dunia);
        } sivyo {
            skrini_ramani_chora(g, t, h->kitovu_x, h->kitovu_y, h->kipimo, h->taifa);
        }
    }
    h->haja_msingi = 0;
}

// Nakili turubai s kwenye t (ukubwa sawa).
w0 nakili_turubai(Turubai* t, Turubai* s_) {
    n64 j = 0;
    wakati (j < t->kimo && j < s_->kimo) {
        nakili(&t->pikseli[j * t->hatua], &s_->pikseli[j * s_->hatua], t->upana * 4);
        j = j + 1;
    }
}

// Fremu moja. Ramani: msingi uliohifadhiwa, kadi za muhtasari, na kadi ya
// taifa. Ukurasa: ukurasa wenyewe (na fremu yake ya mchezo).
w0 chora_fremu(Mchezo* g, Hali* h, Dirisha* d, Turubai* t) {
    kama (skrini_nav_beji_kikasha != kikasha_visivyosomwa()) {
        skrini_nav_beji_kikasha = kikasha_visivyosomwa();
        h->haja_msingi = 1;
    }
    kama (h->skrini != SKRINI_RAMANI) {
        chora_skrini_ya_taifa(g, t, h->skrini, h->taifa);
        sura_anzisha(t);
        chora_sanduku_la_mtu(g, t, h);
        skrini_kipindi_chora(t);
        rudisha;
    }
    kama (h->haja_msingi || h->msingi == 0) { chora_msingi(g, h, d); }
    nakili_turubai(t, h->msingi);
    sura_anzisha(t);
    chora_sanduku_la_mtu(g, t, h);
    chora_kadi_za_muhtasari(g, t, h, d);
    kama (h->inavutwa == 0) { chora_kadi_za_taifa(g, t, h); }
    skrini_kipindi_chora(t);
}

// ---------- kuwaka ----------

// Subiri hadi compositor iwe tayari kwa fremu mpya (au dirisha lifungwe).
n32 kuwasha_subiri_fremu(Dirisha* d) {
    n64 jaribio = 0;
    wakati (d->fremu_tayari == 0 && d->imefungwa == 0 && jaribio < 120) {
        dirisha_soma(d, 16);
        jaribio = jaribio + 1;
    }
    kama (d->imefungwa != 0 || d->fremu_tayari == 0) { rudisha 0; }
    rudisha 1;
}

// Nembo ya studio: hufifia kuingia, hukaa, hufifia kutoka (~sekunde 2.4).
w0 kuwasha_nembo_ya_studio(Dirisha* d, Turubai* t) {
    n64 f = 0;
    wakati (f < 144 && d->imefungwa == 0) {
        dirisha_soma(d, 16);
        wakati (dirisha_tukio(d)) {
            // bonyezo lolote huruka nembo
            kama ((d->t_aina == DIRISHA_KIBODI || d->t_aina == DIRISHA_KITUFE) && d->t_b == 1 && f < 110) { f = 110; }
        }
        kama (kuwasha_subiri_fremu(d)) {
            n64 uwazi = 255;
            kama (f < 36) { uwazi = sura_alpha_ya_mpito(f, 36); }
            kama (f >= 110) { uwazi = 255 - sura_alpha_ya_mpito(f - 110, 34); }
            turubai_funga(t, dirisha_bafa(d), d->hatua, d->upana, d->kimo);
            skrini_kuwasha_studio(t, uwazi);
            dirisha_onyesha(d);
        }
        f = f + 1;
    }
}

// Fremu moja ya kupakia, kati ya hatua mbili za maandalizi.
w0 kuwasha_kupakia(Dirisha* d, Turubai* t, n64 maendeleo, n8* hatua, n64 tayari, n64 mpigo) {
    dirisha_soma(d, 0);
    wakati (dirisha_tukio(d)) { }
    kama (kuwasha_subiri_fremu(d) == 0) { rudisha; }
    turubai_funga(t, dirisha_bafa(d), d->hatua, d->upana, d->kimo);
    skrini_kuwasha_kupakia(t, maendeleo, hatua, tayari, mpigo);
    dirisha_onyesha(d);
}

// Bunge limejaa: subiri mchezaji abonyeze kitufe au kipanya.
w0 kuwasha_subiri_mchezaji(Dirisha* d, Turubai* t) {
    n64 mpigo = 0;
    n32 ameingia = 0;
    wakati (ameingia == 0 && d->imefungwa == 0) {
        dirisha_soma(d, 16);
        wakati (dirisha_tukio(d)) {
            kama ((d->t_aina == DIRISHA_KIBODI || d->t_aina == DIRISHA_KITUFE) && d->t_b == 1) { ameingia = 1; }
        }
        kuwasha_kupakia(d, t, 1000, 0, 1, mpigo);
        mpigo = mpigo + 1;
    }
}

n32 anza(n32 idadi_ya_hoja, n8** hoja_za_mstari) {
    n64 fremu_upeo = 0;
    n8* dampo = 0;
    n64 ukurasa_mwanzoni = 0 - 1;
    n32 bandika_mwanzoni = 0;
    n32 dirishani = 0;
    n64 bila_upana = 0;
    n64 bila_kimo = 0;
    n64 k = 1;
    wakati (k < idadi_ya_hoja) {
        kama (linganisha_mfuatano(hoja_za_mstari[k], "--fremu") == 0 && k + 1 < idadi_ya_hoja) {
            fremu_upeo = mfuatano_hadi_n64(hoja_za_mstari[k + 1]);
            k = k + 1;
        }
        kama (linganisha_mfuatano(hoja_za_mstari[k], "--dampo") == 0 && k + 1 < idadi_ya_hoja) {
            dampo = hoja_za_mstari[k + 1];
            k = k + 1;
        }
        kama (linganisha_mfuatano(hoja_za_mstari[k], "--bandika") == 0) { bandika_mwanzoni = 1; }
        kama (linganisha_mfuatano(hoja_za_mstari[k], "--dirishani") == 0) { dirishani = 1; }
        kama (linganisha_mfuatano(hoja_za_mstari[k], "--mwaka") == 0 && k + 1 < idadi_ya_hoja) {
            tarehe_weka_mwaka_wa_mwanzo(mfuatano_hadi_n64(hoja_za_mstari[k + 1]));
            k = k + 1;
        }
        kama (linganisha_mfuatano(hoja_za_mstari[k], "--bila-dirisha") == 0 && k + 2 < idadi_ya_hoja) {
            bila_upana = mfuatano_hadi_n64(hoja_za_mstari[k + 1]);
            bila_kimo = mfuatano_hadi_n64(hoja_za_mstari[k + 2]);
            k = k + 2;
        }
        kama (linganisha_mfuatano(hoja_za_mstari[k], "--skrini") == 0 && k + 1 < idadi_ya_hoja) {
            ukurasa_mwanzoni = mfuatano_hadi_n64(hoja_za_mstari[k + 1]);
            k = k + 1;
        }
        k = k + 1;
    }

    // lugha ya mchezaji husomwa kabla ya skrini ya kwanza
    maneno_weka_lugha(mipangilio_soma_lugha());

    Dirisha* d = 0;
    kama (bila_upana > 0 && bila_kimo > 0) { d = dirisha_bila_compositor(bila_upana, bila_kimo); }
    sivyo {
        n8** envp = wayland_mazingira_pata_envp(hoja_za_mstari);
        d = dirisha_fungua(envp, 1600, 900, "Dominion");
        kama (d == 0) { rudisha 1; }
        // mchezo hujaza skrini; --dirishani huacha dirisha la kawaida (F11 hubadili)
        kama (dirishani == 0 && fremu_upeo == 0) { dirisha_skrini_nzima(d, 1); }
    }
    Turubai* t = tenga(ukubwa(Turubai));

    // majaribio (--fremu) huruka nembo na mwaliko; kupakia hubaki
    n32 onyesha_kuwasha = 1;
    kama (fremu_upeo > 0) { onyesha_kuwasha = 0; }
    kama (onyesha_kuwasha) { kuwasha_nembo_ya_studio(d, t); }

    kuwasha_kupakia(d, t, 60, ui("Convening the assembly"), 0, 0);
    Mchezo* g = mchezo_unda();
    MchezoUsanidi usanidi;
    mchezo_usanidi_chaguomsingi(&usanidi);
    kuwasha_kupakia(d, t, 180, ui("Convening the assembly"), 0, 0);
    CivMatokeo r = mchezo_anzisha(g, &usanidi);
    kama (r.hitilafu != CIV_SAWA) { andika_kosa("mchezo_anzisha imeshindwa\n", 0, 0, 0, 0, 0, 0); rudisha 1; }
    mipangilio_tumia_lugha(g, maneno_lugha);
    kuwasha_kupakia(d, t, 620, ui("Drawing the borders"), 0, 0);

    Hali* h = tenga(ukubwa(Hali));
    weka_sifuri(h, ukubwa(Hali));
    h->elea_taifa = 0 - 1;
    h->bandika_taifa = 0 - 1;
    sasisha_kikasha(g);
    kama (dirishani == 0 && fremu_upeo == 0 && bila_upana == 0) { h->skrini_nzima = 1; }
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    Atlasi* a = mchezo_pata_atlasi(g);
    h->taifa = tm->faharisi_ya_taifa_la_mchezaji;
    // masoko, pochi na katiba ya taifa la mchezaji (hifadhi/hifadhi.swa)
    hifadhi_anzisha_dominion(g, TAREHE_MWAKA_WA_MWANZO);
    // daftari la maamuzi ya nafasi ya hifadhi: maamuzi ya zamani hurudi kazini
    n8* njia_ya_maamuzi = tenga(128);
    uamuzi_njia(njia_ya_maamuzi, 128, mkutano_nafasi);
    uamuzi_pakia(njia_ya_maamuzi, skrini_siasa_dola(g, h->taifa));
    achilia njia_ya_maamuzi;
    h->kitovu_x = a->mji_x[h->taifa];
    h->kitovu_y = a->mji_y[h->taifa];
    h->kipimo = 12;
    // dunia iliyokubaliwa ikiwepo: ramani huionyesha (bara la nyumbani, ukuzaji 1)
    DuniaHalisi* dh = skrini_dunia_pata();
    kama (dh != 0) {
        KIPIMO_CHINI = 24;
        KIPIMO_JUU = 1100;
        // anza kwenye mji mkuu wa taifa la mchezaji (taifa la mchezo == taifa la ramani)
        h->taifa_dunia = h->taifa;
        h->kitovu_x = 2250 * 256;
        h->kitovu_y = 600 * 256;
        kama (h->taifa >= 0 && h->taifa < dh->mataifa) {
            h->kitovu_x = dh->mji_x[h->taifa] * 256;
            h->kitovu_y = dh->mji_y[h->taifa] * 256;
        }
        h->kipimo = 128;
    }
    h->skrini = SKRINI_RAMANI;
    chafua_msingi(h);
    kuwasha_kupakia(d, t, 860, ui("Taking the census"), 0, 0);
    kuwasha_kupakia(d, t, 1000, ui("Swearing in the cabinet"), 0, 0);
    kama (onyesha_kuwasha) { kuwasha_subiri_mchezaji(d, t); }
    kama (bandika_mwanzoni) {
        // majaribio: bandika taifa la mchezaji katikati na ufungue droo yake
        h->bandika_taifa = h->taifa;
        h->bandika_x = d->upana / 3;
        h->bandika_y = d->kimo / 2;
        SKRINI_RAMANI_PANELI = DROO_UPANA;
        chafua_msingi(h);
    }
    kama (ukurasa_mwanzoni >= 0) { fungua_ukurasa(h, ukurasa_mwanzoni); }

    n64 fremu = 0;
    wakati (d->imefungwa == 0) {
        dirisha_soma(d, 16);
        kama (fremu_upeo > 0) {
            // majaribio: ingizo halisi la mtumiaji halihesabiwi, fremu ziwe zilezile
            wakati (dirisha_tukio(d)) {
                kama (d->t_aina == DIRISHA_UKUBWA) { chafua_msingi(h); }
            }
        } sivyo {
            shughulikia(g, h, d);
        }
        n32 inahitajika = h->haja != 0 || h->haja_msingi != 0;
        kama (fremu_upeo > 0) { inahitajika = 1; }      // majaribio huchora kila fremu hadi N
        kama (inahitajika && d->fremu_tayari && d->imefungwa == 0) {
            turubai_funga(t, dirisha_bafa(d), d->hatua, d->upana, d->kimo);
            chora_fremu(g, h, d, t);
            kama (dampo != 0) {
                n64 fd = mfumo_fungua(dampo, 577, 420);
                mfumo_andika(fd, t->pikseli, t->hatua * t->kimo);
                mfumo_funga(fd);
            }
            dirisha_onyesha(d);
            h->haja = 0;
            fremu = fremu + 1;
            // kauli inayosubiri: fremu ya "anafikiri" imeshaonyeshwa; sasa uliza AI
            kama (mkutano_hali == 1) {
                skrini_mkutano_tuma(g, h->taifa);
                chafua_ukurasa(h);
            }
            kama (fremu_upeo > 0 && fremu >= fremu_upeo) { d->imefungwa = 1; }
        }
    }
    andika("dominion: fremu %d, dirisha %dx%d\n", fremu, d->upana, d->kimo, 0, 0, 0);
    rudisha 0;
}
