// maarifa.swa — tafsiri ya src/core/knowledge_system.c (na .h)
// kwenda Swa. Maarifa yanayokua bila kikomo (badala ya mti wa
// teknolojia wenye kikomo).
//
// Kiambishi: maarifa_ — angalia ../../KANUNI-MAJINA.md.
// pow()/log() za libc zimebadilishwa na civ_kuinua/civ_logasili
// (msingi_civ.swa, ziliongezwa kikao hiki kama suluhisho la
// lugha-swa/swa#183). civ_knowledge_advance ya asili inapokea
// double* na kuibadilisha KWA MAREJEO -- d64* haiwezi kufunguliwa
// kabisa (lugha-swa/swa#181), kwa hiyo maarifa_endeleza inapokea
// THAMANI ya sasa na kurudisha THAMANI MPYA badala ya kubadilisha
// kupitia kielekezi; mwitaji anaandika matokeo kwenye field moja
// kwa moja (mfano: utafiti->sasa.sayansi = maarifa_endeleza(...)).
// civ_knowledge_format (uumbizaji wa maandishi K/M/B/T) haikuletwa
// -- si mantiki ya msingi ya uigaji, inaweza kuongezwa baadaye kwa
// kutumia mfuatano.swa.

husisha { msingi/msingi_civ.swa }

muundo MaarifaHali {
    d64 sayansi;
    d64 uhandisi;
    d64 utamaduni;
    d64 tiba;
    d64 hisabati;
    d64 kilimo;
    d64 madini;
    d64 usafiri_wa_baharini;
};

muundo MaarifaUtafiti {
    MaarifaHali sasa;
    d64 hazina_ya_pointi_za_utafiti;
    d64 kiwango_cha_utafiti;
};

d64 maarifa_gharama(d64 kiwango_cha_sasa, d64 gharama_ya_msingi, d64 kipeo) {
    d64 kiwango = kiwango_cha_sasa;
    kama (kiwango < 0.0) { kiwango = 0.0; }
    rudisha gharama_ya_msingi * civ_kuinua(1.0 + kiwango, kipeo);
}

d64 maarifa_endeleza(d64 kiwango_cha_awali, d64 pointi_za_utafiti,
                       d64 gharama_ya_msingi, d64 kipeo) {
    kama (pointi_za_utafiti <= 0.0) { rudisha kiwango_cha_awali; }

    d64 maarifa = kiwango_cha_awali;
    d64 iliyobaki = pointi_za_utafiti;
    d64 jumla_iliyoendelea = 0.0;
    n32 hatua = 0;

    wakati (iliyobaki > 0.0 && hatua < 10000) {
        d64 gharama = maarifa_gharama(maarifa, gharama_ya_msingi, kipeo);

        kama (iliyobaki >= gharama) {
            maarifa = maarifa + 1.0;
            iliyobaki = iliyobaki - gharama;
            jumla_iliyoendelea = jumla_iliyoendelea + 1.0;
        } sivyo {
            d64 sehemu = iliyobaki / gharama;
            maarifa = maarifa + sehemu;
            jumla_iliyoendelea = jumla_iliyoendelea + sehemu;
            iliyobaki = 0.0;
        }

        kama (jumla_iliyoendelea > 0.0 && jumla_iliyoendelea < 0.0001) {
            acha;
        }
        hatua = hatua + 1;
    }

    rudisha maarifa;
}

d64 maarifa_kizidishi(d64 maarifa_thamani, d64 mizani) {
    d64 m = maarifa_thamani;
    kama (m < 0.0) { m = 0.0; }
    d64 s = mizani;
    kama (s <= 0.0) { s = 1.0; }
    rudisha 1.0 + civ_logasili(1.0 + m / s);
}

d64 maarifa_faida_ya_hisabati(d64 kiwango_cha_hisabati) {
    kama (kiwango_cha_hisabati <= 0.0) { rudisha 1.0; }
    d64 upunguzaji = civ_logasili(1.0 + kiwango_cha_hisabati / 200.0) * 0.15;
    rudisha 1.0 - finya_d64(upunguzaji, 0.0, 0.4);
}

d64 maarifa_kiwango_cha_utafiti(MaarifaUtafiti* utafiti, n32 idadi_ya_watu, n32 maktaba) {
    kama (utafiti == 0) { rudisha 0.0; }
    d64 idadi_d = idadi_ya_watu;
    d64 utafiti_wa_watu = idadi_d * 0.01;
    d64 maktaba_d = maktaba;
    d64 kizidishi_cha_maktaba = 1.0 + maktaba_d * 0.2;
    d64 faida_ya_hisabati = maarifa_faida_ya_hisabati(utafiti->sasa.hisabati);
    d64 faida_ya_utamaduni = maarifa_kizidishi(utafiti->sasa.utamaduni, 200.0);
    rudisha utafiti_wa_watu * kizidishi_cha_maktaba * faida_ya_hisabati * faida_ya_utamaduni;
}

CivMatokeo maarifa_sasisha(MaarifaUtafiti* utafiti, n32 idadi_ya_watu, n32 maktaba) {
    CivMatokeo m;
    kama (utafiti == 0) {
        m.hitilafu = CIV_HITILAFU_KIELEKEZI_TUPU;
        m.ujumbe = "Hali ya utafiti tupu";
        rudisha m;
    }

    utafiti->kiwango_cha_utafiti = maarifa_kiwango_cha_utafiti(utafiti, idadi_ya_watu, maktaba);
    utafiti->hazina_ya_pointi_za_utafiti = utafiti->hazina_ya_pointi_za_utafiti + utafiti->kiwango_cha_utafiti;

    kama (utafiti->hazina_ya_pointi_za_utafiti > 0.0) {
        d64 upunguzaji_wa_hisabati = maarifa_faida_ya_hisabati(utafiti->sasa.hisabati);
        d64 gharama_yenye_ufanisi = 100.0 * upunguzaji_wa_hisabati;
        d64 kwa_kila_uwanja = utafiti->hazina_ya_pointi_za_utafiti / 8.0;

        utafiti->sasa.sayansi = maarifa_endeleza(utafiti->sasa.sayansi, kwa_kila_uwanja, gharama_yenye_ufanisi, 1.8);
        utafiti->sasa.uhandisi = maarifa_endeleza(utafiti->sasa.uhandisi, kwa_kila_uwanja, gharama_yenye_ufanisi, 1.8);
        utafiti->sasa.utamaduni = maarifa_endeleza(utafiti->sasa.utamaduni, kwa_kila_uwanja, gharama_yenye_ufanisi, 1.8);
        utafiti->sasa.tiba = maarifa_endeleza(utafiti->sasa.tiba, kwa_kila_uwanja, gharama_yenye_ufanisi, 1.8);
        utafiti->sasa.hisabati = maarifa_endeleza(utafiti->sasa.hisabati, kwa_kila_uwanja, gharama_yenye_ufanisi, 1.8);
        utafiti->sasa.kilimo = maarifa_endeleza(utafiti->sasa.kilimo, kwa_kila_uwanja, gharama_yenye_ufanisi, 1.8);
        utafiti->sasa.madini = maarifa_endeleza(utafiti->sasa.madini, kwa_kila_uwanja, gharama_yenye_ufanisi, 1.8);
        utafiti->sasa.usafiri_wa_baharini = maarifa_endeleza(utafiti->sasa.usafiri_wa_baharini, kwa_kila_uwanja, gharama_yenye_ufanisi, 1.8);

        utafiti->hazina_ya_pointi_za_utafiti = 0.0;
    }

    m.hitilafu = CIV_SAWA;
    m.ujumbe = 0;
    rudisha m;
}

w0 maarifa_anzisha(MaarifaUtafiti* utafiti) {
    utafiti->sasa.sayansi = 1.0;
    utafiti->sasa.uhandisi = 1.0;
    utafiti->sasa.utamaduni = 1.0;
    utafiti->sasa.tiba = 0.0;
    utafiti->sasa.hisabati = 1.0;
    utafiti->sasa.kilimo = 5.0;
    utafiti->sasa.madini = 0.0;
    utafiti->sasa.usafiri_wa_baharini = 0.0;
    utafiti->hazina_ya_pointi_za_utafiti = 0.0;
    utafiti->kiwango_cha_utafiti = 0.0;
}

MaarifaUtafiti* maarifa_unda() {
    MaarifaUtafiti* utafiti = tenga(ukubwa(MaarifaUtafiti));
    maarifa_anzisha(utafiti);
    rudisha utafiti;
}

w0 maarifa_uharibu(MaarifaUtafiti* utafiti) {
    achilia utafiti;
}
