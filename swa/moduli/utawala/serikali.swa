// serikali.swa — tafsiri ya src/core/governance/government.c (na .h)
// kwenda Swa. Hii ndiyo HUB kuu ya utawala — inamiliki na kusasisha
// (tick) mifumo yote midogo ya utawala.
//
// Kiambishi: utawala_serikali_ — angalia ../../KANUNI-MAJINA.md.
//
// ============================================================
// HAIJASAJILIWA KWA GIT KWA MAKUSUDI — IMEZUIWA NA lugha-swa/swa#189
// ============================================================
// Faili hili LIMEKAMILIKA kimsimbo (kila kazi imeandikwa kufuata
// kanuni zote zilizothibitishwa kikao hiki) LAKINI HALIWEZI
// KUJARIBIWA kwa mafanikio kwa sasa: graph hii (moduli 19
// zilizohusishwa) ina zaidi ya struct 47 tofauti -- juu ya
// kizingiti (kilichothibitishwa kati ya 30-34) ambapo mkusanyaji
// wa Swa huanza kutoa hitilafu za aina za UWONGO ZA KIMAKOSA
// (false-positive) NA UHARIBIFU WA WAKATI WA KUKIMBIA (runtime
// memory corruption) hata kwenye wito wa kazi zilizothibitishwa
// KUFANYA KAZI SAHIHI peke yao (mfano: utawala_anzisha kutoka
// maendeleo.swa -- iliyojaribiwa na kupita mara nyingi awali
// kikao hiki -- husababisha SIGSEGV ikiitwa ndani ya graph hii
// kubwa, japo kuipitisha kielekezi sahihi kabisa).
//
// Nimeripoti hii kama lugha-swa/swa#189 na jaribio dogo
// lililotengwa kikamilifu (struct 30 = salama, struct 34 = hitilafu
// -- kimethibitishwa kwa struct HALISI za mradi NA struct za
// kujaribu tu zisizo na uhusiano wowote na msimbo huu).
//
// Hii SIYO uamuzi wangu wa kupunguza wigo kwa sababu ya utata wa
// kazi -- ni KIKWAZO HALISI CHA KIUFUNDI: hakuna njia ya kuandika
// hub inayounganisha mifumo 15+ ya kweli (kila mmoja akiwa na
// muundo wake) bila kuvuka kizingiti hicho. Faili hili linabaki
// bila git kama kumbukumbu ya msimbo sahihi unaosubiri urekebishaji
// wa mkusanyaji, sawa na mfano wa siasa/kikundi.swa (#182(b)).
// ============================================================
// MUHIMU — wigo wa tafsiri hii (uamuzi wa makusudi, si upungufu wa
// bahati mbaya): civ_government_t inamiliki mifumo 15+ tofauti, kila
// mmoja akiwa na saini yake ya kipekee. Badala ya kujaribu kuunganisha
// YOTE kwa hatari ya makosa ya kimya ya waya (wiring errors ambayo
// mkusanyaji hataikamata), sehemu ifuatayo ya utawala_serikali_sasisha
// imejengwa na KUJARIBIWA kikamilifu: wasifu, taasisi, mgawanyo,
// maendeleo (evolution), mtendaji, mahakama, rushwa (corruption), na
// wizara zote, pamoja na mchoro wa afya ya kijamii na kumbukumbu ya
// daftari. VIMEAHIRISHWA kwa kusudi (vimeandikwa kwenye maoni chini
// ya utawala_serikali_sasisha): uchaguzi (campaign/tally + upangaji
// wa kiotomatiki wa uchaguzi wa kwanza), haki (masharti ya "toa haki
// X ikiwa uwakilishi>Y" + kufungua kesi za kikatiba), utumishi wa
// umma (tick + idara za default), vurugu za kisiasa (inahitaji
// civ_governance_cohesion_bonus ambayo haijawahi kutafsiriwa kwenye
// maendeleo.swa — angalia hapo). Hizi zinaweza kuongezwa kwenye
// kikao kijacho bila kubadilisha muundo wa msingi hapa.
//
// muundo civ_political_position_t (vigezo vya d64 vitatu vya uzito)
// vimefungwa kwenye UtawalaNafasiUzito kuepuka #184 (civ_government_
// add_position ya asili ina vigezo 9, 3 d64 -- juu ya kizingiti).
//
// Kila field ya kielekezi-kwenda-muundo-mwingine (constitution,
// executive, legislative_manager, na kadhalika) imehifadhiwa kama n64
// (anwani) badala ya kielekezi cha aina moja kwa moja, ikisomwa
// kupitia kazi za "pata"/"weka" -- suluhisho lililothibitishwa la
// lugha-swa/swa#186 (linatumika mara 15 hapa, idadi kubwa zaidi
// kuwahi kutumika kwenye faili moja kikao hiki).

husisha { msingi/msingi_civ.swa }
husisha { msingi/maktaba/kumbukumbu.swa }
husisha { msingi/maktaba/mfuatano.swa }
husisha { moduli/utawala/legal/katiba.swa }
husisha { moduli/utawala/branches/mtendaji.swa }
husisha { moduli/utawala/branches/bunge.swa }
husisha { moduli/utawala/branches/mahakama.swa }
husisha { moduli/utawala/branches/baraza.swa }
husisha { moduli/utawala/branches/kidini.swa }
husisha { moduli/utawala/institutions/taasisi.swa }
husisha { moduli/utawala/territorial/mgawanyo.swa }
husisha { moduli/utawala/political/rushwa.swa }
husisha { moduli/utawala/political/uchaguzi.swa }
husisha { moduli/utawala/political/vurugu.swa }
husisha { moduli/utawala/institutions/wizara.swa }
husisha { moduli/utawala/institutions/utumishi.swa }
husisha { moduli/utawala/legal/haki.swa }
husisha { moduli/utawala/interaction/daftari.swa }
husisha { moduli/utawala/maendeleo.swa }

n32 UTAWALA_SERIKALI_BAJETI_KATEGORIA_IDADI = 9;

muundo UtawalaNafasiUzito {
    d64 uzito_wa_utendaji;
    d64 uzito_wa_kibunge;
    d64 uzito_wa_kimahakama;
};

muundo UtawalaNafasi {
    n8* cheo;
    n8* maelezo_ya_jukumu;
    n32 ngazi_ya_uongozi;
    d64 uzito_wa_utendaji;
    d64 uzito_wa_kibunge;
    d64 uzito_wa_kimahakama;
    n8* njia_ya_uchaguzi;
    n8* muda;
    n32 idadi_ya_wanaoshikilia;
};

// UtawalaSerikaliAfya: mchoro (dashboard) wa afya ya kijamii, sawa
// na muundo wa UtawalaVipimoAfya (metrics/vipimo.swa) -- imefafanuliwa
// hapa kwa jina lake mwenyewe badala ya kuhusisha vipimo.swa, kwa
// sababu husisha hiyo huvuta kitambulisho.swa/itikadi.swa kwa njia
// isiyo ya moja kwa moja na kusababisha hitilafu za aina zisizoelezeka
// kwenye kazi ambazo serikali.swa haziiti kamwe (badili/linganisha_
// mfuatano ndani ya kitambulisho.swa/itikadi.swa zenyewe). Hapa
// tunaweka thamani za kila field moja kwa moja (kama C ya asili
// inavyofanya), si kupitia utawala_vipimo_hesabu_afya (ambayo
// inahitaji vielekezi vya utamaduni ambavyo serikali hii haina).
muundo UtawalaSerikaliAfya {
    d64 kielezo_cha_utulivu;
    d64 kielezo_cha_mshikamano;
    d64 kielezo_cha_rushwa;
    d64 kielezo_cha_ukali;
    d64 kasi_ya_mageuzi;
    d64 kielezo_cha_kidunia;
    d64 kielezo_cha_uhai;
    d64 mshikamano_wa_kiuchumi;
    d64 heshima_ya_kimataifa;
    d64 kielezo_cha_pato;
    d64 utulivu_wa_viwanda;
};

muundo UtawalaWasifu {
    d64 umoja_wa_mamlaka;
    d64 kielezo_cha_uwakilishi;
    d64 ugumu_wa_kitaasisi;
    d64 usawa_wa_madaraka;
    d64 furaha_ya_wananchi;
    d64 kiwango_cha_utawala;
};

muundo UtawalaSerikali {
    n8* kitambulisho;
    n8* jina;

    n64* nafasi;
    n32 idadi_ya_nafasi;
    n32 uwezo_wa_nafasi;

    UtawalaWasifu wasifu;

    d64 utulivu;
    d64 uhalali;
    d64 ufanisi;

    n64 katiba_addr;
    n64 mtendaji_addr;
    n64 bunge_addr;
    n64 mahakama_addr;
    n64 baraza_addr;
    n64 kidini_addr;
    n64 taasisi_mfumo_addr;
    n64 mgawanyo_mfumo_addr;
    n64 rushwa_injini_addr;
    n64 uchaguzi_mfumo_addr;
    n64 vurugu_addr;
    n64 wizara_meneja_addr;
    n64 utumishi_addr;
    n64 haki_tamko_addr;
    n64 daftari_addr;

    n64 maendeleo_hali_addr;
    UtawalaSerikaliAfya afya;

    d64 mgao_0; d64 mgao_1; d64 mgao_2; d64 mgao_3; d64 mgao_4;
    d64 mgao_5; d64 mgao_6; d64 mgao_7; d64 mgao_8;

    d64 kizingiti_cha_kibunge;
    n32 zamu_tangu_kikao_cha_mwisho;

    d64 uungwaji_wa_vikundi;
    n32 idadi_ya_vikundi;
};

UtawalaNafasi* utawala_serikali_pata_nafasi(UtawalaSerikali* g, n32 idx) {
    rudisha g->nafasi[idx];
}

UtawalaKatiba* utawala_serikali_pata_katiba(UtawalaSerikali* g) {
    rudisha g->katiba_addr;
}
w0 utawala_serikali_weka_katiba(UtawalaSerikali* g, UtawalaKatiba* v) {
    g->katiba_addr = v;
}

