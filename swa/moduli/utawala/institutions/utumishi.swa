// utumishi.swa — tafsiri ya src/core/governance/institutions/civil_service.c
// (na .h) kwenda Swa. Utumishi wa umma wa kazi — urasimu, sifa dhidi
// ya upendeleo.
//
// Kiambishi: utawala_utumishi_ — angalia ../../../KANUNI-MAJINA.md.
// departments[] (kikomo 8 asili, malloc+realloc) imebadilishwa kuwa
// kikomo kisichobadilika cha idara 8. switch(recruitment_model)
// imebadilishwa kuwa kama/sivyo.

husisha { msingi/msingi_civ.swa }

n32 UTAWALA_UTUMISHI_MTIHANI = 0;
n32 UTAWALA_UTUMISHI_UTEUZI = 1;
n32 UTAWALA_UTUMISHI_UPENDELEO = 2;
n32 UTAWALA_UTUMISHI_MCHANGANYIKO = 3;

n32 UTAWALA_UTUMISHI_IDARA_UPEO = 8;

muundo UtawalaUtumishiIdara {
    n8* jina;
    n32 idadi_ya_wafanyakazi;
    d64 umahiri_wa_wastani;
    d64 uaminifu_wa_wastani;
    d64 ari;
    d64 bajeti;
    d64 matokeo;
};

muundo UtawalaUtumishi {
    UtawalaUtumishiIdara idara_0; UtawalaUtumishiIdara idara_1;
    UtawalaUtumishiIdara idara_2; UtawalaUtumishiIdara idara_3;
    UtawalaUtumishiIdara idara_4; UtawalaUtumishiIdara idara_5;
    UtawalaUtumishiIdara idara_6; UtawalaUtumishiIdara idara_7;
    n32 idadi_ya_idara;

    n32 mfano_wa_uajiri;
    d64 wafanyakazi_jumla;
    d64 umahiri_wa_wastani;
    d64 kumbukumbu_ya_kitaasisi;
    d64 ugumu_wa_kiurasimu;
    d64 udhaifu_wa_rushwa;
    d64 upande_wowote_wa_kisiasa;
    d64 ufanisi_wa_bajeti;
};

UtawalaUtumishiIdara* utawala_utumishi_pata_idara(UtawalaUtumishi* cs, n32 idx) {
    kama (idx == 0) { rudisha &cs->idara_0; }
    kama (idx == 1) { rudisha &cs->idara_1; }
    kama (idx == 2) { rudisha &cs->idara_2; }
    kama (idx == 3) { rudisha &cs->idara_3; }
    kama (idx == 4) { rudisha &cs->idara_4; }
    kama (idx == 5) { rudisha &cs->idara_5; }
    kama (idx == 6) { rudisha &cs->idara_6; }
    rudisha &cs->idara_7;
}

UtawalaUtumishi* utawala_utumishi_unda() {
    UtawalaUtumishi* cs = tenga(ukubwa(UtawalaUtumishi));
    cs->idadi_ya_idara = 0;
    cs->mfano_wa_uajiri = UTAWALA_UTUMISHI_MCHANGANYIKO;
    cs->wafanyakazi_jumla = 1000.0;
    cs->umahiri_wa_wastani = 0.45;
    cs->kumbukumbu_ya_kitaasisi = 0.50;
    cs->ugumu_wa_kiurasimu = 0.35;
    cs->udhaifu_wa_rushwa = 0.20;
    cs->upande_wowote_wa_kisiasa = 0.50;
    cs->ufanisi_wa_bajeti = 0.55;
    rudisha cs;
}

w0 utawala_utumishi_uharibu(UtawalaUtumishi* cs) {
    achilia cs;
}

w0 utawala_utumishi_sasisha(UtawalaUtumishi* cs, d64 muda, d64 sifa_ya_umahiri,
                              d64 rushwa, d64 kiwango_cha_elimu, d64 bajeti_jumla) {
    kama (cs->mfano_wa_uajiri == UTAWALA_UTUMISHI_MTIHANI) {
        cs->umahiri_wa_wastani = cs->umahiri_wa_wastani
            + (sifa_ya_umahiri * 0.6 + kiwango_cha_elimu * 0.3 - cs->umahiri_wa_wastani) * 0.04 * muda;
        cs->upande_wowote_wa_kisiasa = cs->upande_wowote_wa_kisiasa + (0.80 - cs->upande_wowote_wa_kisiasa) * 0.03 * muda;
        cs->ugumu_wa_kiurasimu = cs->ugumu_wa_kiurasimu + (0.65 - cs->ugumu_wa_kiurasimu) * 0.02 * muda;
        cs->udhaifu_wa_rushwa = 0.10;
    } sivyo { kama (cs->mfano_wa_uajiri == UTAWALA_UTUMISHI_UTEUZI) {
        cs->umahiri_wa_wastani = cs->umahiri_wa_wastani + (0.50 - cs->umahiri_wa_wastani) * 0.04 * muda;
        cs->upande_wowote_wa_kisiasa = cs->upande_wowote_wa_kisiasa + (0.30 - cs->upande_wowote_wa_kisiasa) * 0.04 * muda;
        cs->ugumu_wa_kiurasimu = cs->ugumu_wa_kiurasimu + (0.25 - cs->ugumu_wa_kiurasimu) * 0.03 * muda;
        cs->udhaifu_wa_rushwa = 0.35;
    } sivyo { kama (cs->mfano_wa_uajiri == UTAWALA_UTUMISHI_UPENDELEO) {
        cs->umahiri_wa_wastani = cs->umahiri_wa_wastani + (0.30 - cs->umahiri_wa_wastani) * 0.04 * muda;
        cs->upande_wowote_wa_kisiasa = cs->upande_wowote_wa_kisiasa + (0.15 - cs->upande_wowote_wa_kisiasa) * 0.05 * muda;
        cs->ugumu_wa_kiurasimu = cs->ugumu_wa_kiurasimu + (0.15 - cs->ugumu_wa_kiurasimu) * 0.04 * muda;
        cs->udhaifu_wa_rushwa = 0.55;
    } sivyo {
        cs->umahiri_wa_wastani = cs->umahiri_wa_wastani + (sifa_ya_umahiri * 0.4 + 0.30 - cs->umahiri_wa_wastani) * 0.03 * muda;
        cs->upande_wowote_wa_kisiasa = cs->upande_wowote_wa_kisiasa + (0.50 - cs->upande_wowote_wa_kisiasa) * 0.03 * muda;
        cs->ugumu_wa_kiurasimu = cs->ugumu_wa_kiurasimu + (0.40 - cs->ugumu_wa_kiurasimu) * 0.02 * muda;
        cs->udhaifu_wa_rushwa = 0.25;
    } } }

    d64 rushwa_halisi = rushwa * cs->udhaifu_wa_rushwa * 2.0;
    cs->umahiri_wa_wastani = cs->umahiri_wa_wastani - rushwa_halisi * 0.01 * muda;

    d64 lengo_la_kumbukumbu = 0.55;
    kama (cs->mfano_wa_uajiri == UTAWALA_UTUMISHI_MTIHANI) { lengo_la_kumbukumbu = 0.80; }
    sivyo { kama (cs->mfano_wa_uajiri == UTAWALA_UTUMISHI_UPENDELEO) { lengo_la_kumbukumbu = 0.25; } }
    cs->kumbukumbu_ya_kitaasisi = cs->kumbukumbu_ya_kitaasisi
        + (lengo_la_kumbukumbu - cs->kumbukumbu_ya_kitaasisi) * 0.02 * muda;

    cs->ufanisi_wa_bajeti = cs->umahiri_wa_wastani * 0.5 + cs->upande_wowote_wa_kisiasa * 0.3
        + (1.0 - rushwa_halisi) * 0.2;

    n32 kwa_idara_bajeti_n = cs->idadi_ya_idara;
    d64 bajeti_kwa_idara = bajeti_jumla;
    kama (cs->idadi_ya_idara > 0) {
        d64 idadi_d = kwa_idara_bajeti_n;
        bajeti_kwa_idara = bajeti_jumla / idadi_d;
    }

    n32 i = 0;
    wakati (i < cs->idadi_ya_idara) {
        UtawalaUtumishiIdara* d = utawala_utumishi_pata_idara(cs, i);
        d->bajeti = bajeti_kwa_idara;
        d->umahiri_wa_wastani = d->umahiri_wa_wastani + (cs->umahiri_wa_wastani - d->umahiri_wa_wastani) * 0.05 * muda;
        d->ari = d->ari + (kiwango_cha_elimu * 0.0 + 0.3 - d->ari * 0.1) * 0.05 * muda;
        kama (d->ari < 0.10) { d->ari = 0.10; }
        kama (d->ari > 1.0) { d->ari = 1.0; }
        n32 wafanyakazi_n = d->idadi_ya_wafanyakazi;
        d64 wafanyakazi_d = wafanyakazi_n;
        d->matokeo = wafanyakazi_d * d->umahiri_wa_wastani * d->ari * cs->ufanisi_wa_bajeti;
        i = i + 1;
    }

    cs->wafanyakazi_jumla = 0.0;
    i = 0;
    wakati (i < cs->idadi_ya_idara) {
        UtawalaUtumishiIdara* d = utawala_utumishi_pata_idara(cs, i);
        n32 wafanyakazi_n = d->idadi_ya_wafanyakazi;
        d64 wafanyakazi_d = wafanyakazi_n;
        cs->wafanyakazi_jumla = cs->wafanyakazi_jumla + wafanyakazi_d;
        i = i + 1;
    }
}

UtawalaUtumishiIdara* utawala_utumishi_ongeza_idara(UtawalaUtumishi* cs, n8* jina, n32 idadi_ya_wafanyakazi) {
    kama (cs == 0 || jina == 0 || cs->idadi_ya_idara >= UTAWALA_UTUMISHI_IDARA_UPEO) { rudisha 0; }
    UtawalaUtumishiIdara* d = utawala_utumishi_pata_idara(cs, cs->idadi_ya_idara);
    d->jina = jina;
    d->idadi_ya_wafanyakazi = idadi_ya_wafanyakazi;
    d->umahiri_wa_wastani = cs->umahiri_wa_wastani;
    d->ari = 0.60;
    d->bajeti = 0.0;
    d->matokeo = 0.0;
    cs->idadi_ya_idara = cs->idadi_ya_idara + 1;
    rudisha d;
}

w0 utawala_utumishi_weka_uajiri(UtawalaUtumishi* cs, n32 mfano) {
    kama (cs == 0) { rudisha; }
    cs->mfano_wa_uajiri = mfano;
}

d64 utawala_utumishi_kinga_ya_utawala(UtawalaUtumishi* cs) {
    kama (cs == 0) { rudisha 0.0; }
    rudisha cs->kumbukumbu_ya_kitaasisi * 0.6 + cs->upande_wowote_wa_kisiasa * 0.4;
}

d64 utawala_utumishi_upinzani_wa_mageuzi(UtawalaUtumishi* cs) {
    kama (cs == 0) { rudisha 0.0; }
    rudisha cs->ugumu_wa_kiurasimu;
}

d64 utawala_utumishi_nyongeza_ya_umahiri(UtawalaUtumishi* cs) {
    kama (cs == 0) { rudisha 0.0; }
    rudisha cs->umahiri_wa_wastani * cs->ufanisi_wa_bajeti;
}
