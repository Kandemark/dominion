// desturi.swa — tafsiri ya src/core/governance/custom_governance.c (na
// .h) kwenda Swa. Mfumo wa utawala unaoibuka/maalum (custom, emergent
// governance) — majukumu ya kisiasa, chama, mvutano, na mageuzi.
//
// Kiambishi: utawala_desturi_ — angalia ../../KANUNI-MAJINA.md.
//
// Tofauti za kimakusudi kutoka kwa chanzo cha C:
//   - civ_party_system_t (enum) imekuwa viambatanisho vya n32.
//   - roles[] (safu inayokua ya muundo) imekuwa safu ya n64*
//     (vielekezi vya UtawalaDesturiJukumu, angalia lugha-swa/swa#185)
//     badala ya safu ya thamani — inaepuka #182(b) kabisa (hakuna
//     kunakili muundo kupitia kielekezi cha safu).
//   - custom_rules (mfuatano unaokua bila kikomo, ulioongezwa kwa
//     historia kamili ya marekebisho) umepunguzwa kuwa
//     "kanuni_ya_hivi_karibuni" (maelezo ya marekebisho la mwisho
//     tu) — historia kamili ya mfuatano unaokua bila kikomo si rahisi
//     kwa usalama bila realloc ya mfuatano iliyothibitishwa.
//   - civ_custom_governance_manager_add (asili: kunakili muundo *gov
//     kwa THAMANI kwenye safu, kisha kuachilia gov) imekuwa
//     kuhifadhi KIELEKEZI moja kwa moja (angalia #185) -- inaepuka
//     hatari ya #182(b) na inalingana na umiliki uliokusudiwa (asili
//     ilikataza waziwazi kuachilia gov baada ya add).
//   - constitution (kielekezi cha UtawalaKatiba) ni field ya muundo —
//     mfano wa #186, imehifadhiwa kama anwani ya n64 + kazi ya
//     "pata" (angalia mbinu.swa kwa mfano halisi wa mtindo huu).
//   - time_t creation_time/last_reform havikuletwa (hazihitajiki kwa
//     mantiki ya mchezo).

husisha { msingi/msingi_civ.swa }
husisha { msingi/maktaba/mfuatano.swa }
husisha { msingi/lugha_dominion.swa }
husisha { moduli/utawala/legal/katiba.swa }

n32 UTAWALA_DESTURI_CHAMA_HAKUNA = 0;
n32 UTAWALA_DESTURI_CHAMA_KIMOJA = 1;
n32 UTAWALA_DESTURI_CHAMA_MENGI = 2;

muundo UtawalaDesturiJukumu {
    n8* jina_la_jukumu;
    n8* maelezo;
    d64 mamlaka;
    d64 wajibu;
    n32 idadi_ya_wamiliki;
};

muundo UtawalaDesturi {
    n8* kitambulisho;
    n8* jina;
    n8* maelezo;

    n64* majukumu;              // safu ya UtawalaDesturiJukumu*, #185
    n32 idadi_ya_majukumu;
    n32 uwezo_wa_majukumu;

    d64 umoja;                  // centralization
    d64 kiwango_cha_demokrasia; // democracy_level
    d64 rushwa;                 // corruption
    d64 uthabiti;               // stability
    d64 ufanisi;                // efficiency

    n8* kanuni_ya_hivi_karibuni; // angalia maelezo hapo juu

    n32 mfumo_wa_chama;         // party_system
    d64 mvutano_wa_kisiasa;     // political_tension

    n64 katiba_addr;            // UtawalaKatiba*, #186
};

muundo UtawalaDesturiMsimamizi {
    n64* serikali_zote;         // safu ya UtawalaDesturi*, #185
    n32 idadi;
    n32 uwezo;
};

UtawalaDesturiJukumu* utawala_desturi_pata_jukumu(UtawalaDesturi* g, n32 idx) {
    rudisha g->majukumu[idx];
}

UtawalaKatiba* utawala_desturi_pata_katiba(UtawalaDesturi* g) {
    rudisha g->katiba_addr;
}

UtawalaDesturi* utawala_desturi_msimamizi_pata(UtawalaDesturiMsimamizi* m, n32 idx) {
    rudisha m->serikali_zote[idx];
}

UtawalaDesturiMsimamizi* utawala_desturi_msimamizi_unda() {
    UtawalaDesturiMsimamizi* m = tenga(ukubwa(UtawalaDesturiMsimamizi));
    m->uwezo = 32;
    m->idadi = 0;
    m->serikali_zote = tenga(ukubwa(n64) * m->uwezo);
    rudisha m;
}

w0 utawala_desturi_msimamizi_uharibu(UtawalaDesturiMsimamizi* m) {
    achilia m->serikali_zote;
    achilia m;
}

UtawalaDesturi* utawala_desturi_unda(n8* kitambulisho, n8* jina) {
    kama (kitambulisho == 0 || jina == 0) { rudisha 0; }

    UtawalaDesturi* g = tenga(ukubwa(UtawalaDesturi));
    g->kitambulisho = kitambulisho;
    g->jina = jina;
    g->maelezo = 0;

    g->uwezo_wa_majukumu = 16;
    g->idadi_ya_majukumu = 0;
    g->majukumu = tenga(ukubwa(n64) * g->uwezo_wa_majukumu);

    g->umoja = 0.5;
    g->kiwango_cha_demokrasia = 0.3;
    g->rushwa = 0.0;
    g->uthabiti = 0.7;
    g->ufanisi = 0.5;
    g->kanuni_ya_hivi_karibuni = 0;
    g->mfumo_wa_chama = UTAWALA_DESTURI_CHAMA_HAKUNA;
    g->mvutano_wa_kisiasa = 0.0;

    UtawalaKatiba* k = utawala_katiba_unda(jina);
    g->katiba_addr = k;

    rudisha g;
}

w0 utawala_desturi_uharibu(UtawalaDesturi* g) {
    kama (g == 0) { rudisha; }
    achilia g->majukumu;
    UtawalaKatiba* k = utawala_desturi_pata_katiba(g);
    kama (k != 0) { utawala_katiba_uharibu(k); }
    achilia g;
}

CivMatokeo utawala_desturi_ongeza_jukumu(UtawalaDesturi* g, n8* jina_la_jukumu,
                                           n8* maelezo, d64 mamlaka) {
    CivMatokeo r;
    r.hitilafu = CIV_SAWA;
    r.ujumbe = 0;
    kama (g == 0 || jina_la_jukumu == 0) {
        r.hitilafu = CIV_HITILAFU_KIELEKEZI_TUPU;
        r.ujumbe = "Kielekezi tupu";
        rudisha r;
    }

    d64 mamlaka_f = finya_d64(mamlaka, 0.0, 1.0);

    kama (g->idadi_ya_majukumu >= g->uwezo_wa_majukumu) {
        g->uwezo_wa_majukumu = g->uwezo_wa_majukumu * 2;
        g->majukumu = badili(g->majukumu, ukubwa(n64) * g->uwezo_wa_majukumu);
    }

    UtawalaDesturiJukumu* jukumu = tenga(ukubwa(UtawalaDesturiJukumu));
    jukumu->jina_la_jukumu = jina_la_jukumu;
    jukumu->maelezo = maelezo;
    jukumu->mamlaka = mamlaka_f;
    jukumu->wajibu = mamlaka_f * 0.8;
    jukumu->idadi_ya_wamiliki = 1;

    g->majukumu[g->idadi_ya_majukumu] = jukumu;
    g->idadi_ya_majukumu = g->idadi_ya_majukumu + 1;

    rudisha r;
}

w0 utawala_desturi_badilika(UtawalaDesturi* g, d64 muda) {
    d64 ukuaji_wa_rushwa = 0.0;
    kama (g->kiwango_cha_demokrasia < 0.5) {
        ukuaji_wa_rushwa = ukuaji_wa_rushwa + 0.01 * g->umoja;
    }
    kama (g->uthabiti < 0.4) {
        ukuaji_wa_rushwa = ukuaji_wa_rushwa + 0.02;
    }
    kama (g->kiwango_cha_demokrasia > 0.7) {
        ukuaji_wa_rushwa = ukuaji_wa_rushwa - 0.02;
    }
    g->rushwa = finya_d64(g->rushwa + ukuaji_wa_rushwa * muda, 0.0, 1.0);

    kama (g->ufanisi < 0.4 || g->rushwa > 0.6) {
        g->mvutano_wa_kisiasa = g->mvutano_wa_kisiasa + 0.05 * muda;
    } sivyo {
        g->mvutano_wa_kisiasa = g->mvutano_wa_kisiasa - 0.02 * muda;
    }
    g->mvutano_wa_kisiasa = finya_d64(g->mvutano_wa_kisiasa, 0.0, 1.0);

    kama (g->mvutano_wa_kisiasa > 0.8) {
        kama (g->umoja > 0.5) {
            g->umoja = g->umoja + 0.05;
            g->kiwango_cha_demokrasia = g->kiwango_cha_demokrasia - 0.05;
        } sivyo {
            g->umoja = g->umoja - 0.05;
        }
        g->mvutano_wa_kisiasa = g->mvutano_wa_kisiasa - 0.1;
        g->uthabiti = g->uthabiti - 0.1;
    }

    g->umoja = finya_d64(g->umoja, 0.0, 1.0);
    g->kiwango_cha_demokrasia = finya_d64(g->kiwango_cha_demokrasia, 0.0, 1.0);
}

CivMatokeo utawala_desturi_sasisha(UtawalaDesturi* g, d64 muda) {
    CivMatokeo r;
    r.hitilafu = CIV_SAWA;
    r.ujumbe = 0;
    kama (g == 0) {
        r.hitilafu = CIV_HITILAFU_KIELEKEZI_TUPU;
        r.ujumbe = "Kielekezi tupu";
        rudisha r;
    }

    d64 ufanisi_wa_majukumu = 0.1;
    kama (g->idadi_ya_majukumu > 0) {
        d64 jumla = 0.0;
        n32 i = 0;
        wakati (i < g->idadi_ya_majukumu) {
            UtawalaDesturiJukumu* j = utawala_desturi_pata_jukumu(g, i);
            jumla = jumla + j->wajibu * j->mamlaka;
            i = i + 1;
        }
        n32 idadi = g->idadi_ya_majukumu;
        d64 idadi_d = idadi;
        ufanisi_wa_majukumu = jumla / idadi_d;
    }

    d64 ufanisi_wa_umoja = g->umoja;
    kama (g->kiwango_cha_demokrasia < 0.3) {
        ufanisi_wa_umoja = ufanisi_wa_umoja * 0.8;
    }
    g->ufanisi = ufanisi_wa_umoja * 0.5 + ufanisi_wa_majukumu * 0.5;

    d64 urejeshaji_wa_uthabiti = 0.02 * muda;
    kama (g->ufanisi < 0.3) {
        urejeshaji_wa_uthabiti = urejeshaji_wa_uthabiti - 0.05 * muda;
    }

    utawala_desturi_badilika(g, muda);

    g->uthabiti = finya_d64(g->uthabiti + urejeshaji_wa_uthabiti, 0.0, 1.0);

    rudisha r;
}

CivMatokeo utawala_desturi_marekebisho(UtawalaDesturi* g, n8* maelezo_ya_marekebisho) {
    CivMatokeo r;
    r.hitilafu = CIV_SAWA;
    r.ujumbe = 0;
    kama (g == 0 || maelezo_ya_marekebisho == 0) {
        r.hitilafu = CIV_HITILAFU_KIELEKEZI_TUPU;
        r.ujumbe = "Kielekezi tupu";
        rudisha r;
    }

    g->kanuni_ya_hivi_karibuni = maelezo_ya_marekebisho;

    // KUMBUKA: chanzo cha C kina if/else-if ya "Centralize"/"Decentralize"
    // -- lakini "Decentralize" YENYEWE ina "centralize" ndani yake kama
    // substring, hivyo tawi la "Decentralize" la C halifikiwi KAMWE kwa
    // vitendo (bug ya kimya kwenye chanzo asili). Hapa tunachunguza
    // "decentralize" NDANI ya tawi la jumla badala yake -- tabia
    // inayotarajiwa kimantiki, tofauti kidogo na chanzo (ambacho
    // hakiwezi kufikia tawi hilo kamwe).
    n32 ina_centralize = tafuta_mfuatano(maelezo_ya_marekebisho, "entralize");
    kama (ina_centralize >= 0) {
        n32 ina_de = tafuta_mfuatano(maelezo_ya_marekebisho, "Decentralize");
        n32 ina_de2 = tafuta_mfuatano(maelezo_ya_marekebisho, "decentralize");
        kama (ina_de >= 0 || ina_de2 >= 0) {
            g->umoja = g->umoja - 0.1;
            g->kiwango_cha_demokrasia = g->kiwango_cha_demokrasia + 0.05;
        } sivyo {
            g->umoja = g->umoja + 0.1;
            g->kiwango_cha_demokrasia = g->kiwango_cha_demokrasia - 0.05;
        }
    }

    n32 ina_democratize = tafuta_mfuatano(maelezo_ya_marekebisho, "emocratize");
    kama (ina_democratize >= 0) {
        n32 ina_auto = tafuta_mfuatano(maelezo_ya_marekebisho, "Autocratize");
        n32 ina_auto2 = tafuta_mfuatano(maelezo_ya_marekebisho, "autocratize");
        kama (ina_auto >= 0 || ina_auto2 >= 0) {
            g->kiwango_cha_demokrasia = g->kiwango_cha_demokrasia - 0.1;
        } sivyo {
            g->kiwango_cha_demokrasia = g->kiwango_cha_demokrasia + 0.1;
        }
    }

    g->umoja = finya_d64(g->umoja, 0.0, 1.0);
    g->kiwango_cha_demokrasia = finya_d64(g->kiwango_cha_demokrasia, 0.0, 1.0);
    g->uthabiti = finya_d64(g->uthabiti - 0.15, 0.05, 1.0);

    rudisha r;
}

n8* utawala_desturi_zalisha_jina(UtawalaDesturi* g) {
    kama (g == 0) { rudisha "Serikali"; }

    n8* nomino = "Serikali";
    kama (g->umoja > 0.8) {
        kama (g->kiwango_cha_demokrasia < 0.2) { nomino = "Milki"; }
        sivyo { kama (g->kiwango_cha_demokrasia < 0.5) { nomino = "Udikteta"; }
        sivyo { nomino = "Muungano"; } }
    } sivyo { kama (g->umoja < 0.2) {
        kama (g->kiwango_cha_demokrasia > 0.8) { nomino = "Jumuiya"; }
        sivyo { nomino = "Shirikisho"; }
    } sivyo {
        kama (g->kiwango_cha_demokrasia > 0.6) { nomino = "Jamhuri"; }
        sivyo { nomino = "Taifa"; }
    } }

    n8* kivumishi = "";
    kama (g->rushwa > 0.7) { kivumishi = "Lenye Rushwa "; }
    sivyo { kama (g->uthabiti < 0.3) { kivumishi = "Lililogawanyika "; }
    sivyo { kama (g->ufanisi > 0.8) { kivumishi = "Lililopangwa "; }
    sivyo { kama (g->kiwango_cha_demokrasia > 0.9) { kivumishi = "Huru "; } } } }

    n8* jina_kamili = tenga(128);
    unganisha_mfuatano(jina_kamili, kivumishi, nomino);
    rudisha jina_kamili;
}

CivMatokeo utawala_desturi_msimamizi_ongeza(UtawalaDesturiMsimamizi* m, UtawalaDesturi* g) {
    CivMatokeo r;
    r.hitilafu = CIV_SAWA;
    r.ujumbe = 0;
    kama (m == 0 || g == 0) {
        r.hitilafu = CIV_HITILAFU_KIELEKEZI_TUPU;
        r.ujumbe = "Kielekezi tupu";
        rudisha r;
    }

    kama (m->idadi >= m->uwezo) {
        m->uwezo = m->uwezo * 2;
        m->serikali_zote = badili(m->serikali_zote, ukubwa(n64) * m->uwezo);
    }

    m->serikali_zote[m->idadi] = g;
    m->idadi = m->idadi + 1;

    rudisha r;
}

UtawalaDesturi* utawala_desturi_msimamizi_tafuta(UtawalaDesturiMsimamizi* m, n8* kitambulisho) {
    kama (m == 0 || kitambulisho == 0) { rudisha 0; }
    n32 i = 0;
    wakati (i < m->idadi) {
        UtawalaDesturi* g = utawala_desturi_msimamizi_pata(m, i);
        kama (linganisha_mfuatano(g->kitambulisho, kitambulisho) == 0) {
            rudisha g;
        }
        i = i + 1;
    }
    rudisha 0;
}

CivMatokeo utawala_desturi_ramanisha_cheo(UtawalaDesturi* g, n8* cheo, n8* jukumu_la_kazi) {
    kama (g == 0 || cheo == 0 || jukumu_la_kazi == 0) {
        CivMatokeo r;
        r.hitilafu = CIV_HITILAFU_KIELEKEZI_TUPU;
        r.ujumbe = "Kielekezi tupu";
        rudisha r;
    }
    andika(d_tafsiri("m18"),
        cheo, jukumu_la_kazi, g->kitambulisho, 0, 0, 0);
    CivMatokeo r2;
    r2.hitilafu = CIV_SAWA;
    r2.ujumbe = 0;
    rudisha r2;
}
