// katiba.swa — tafsiri ya src/core/governance/legal/constitution.c
// (na .h) kwenda Swa. Mfumo wa kanuni na katiba unaobadilika.
//
// Kiambishi: utawala_katiba_ — angalia ../../../KANUNI-MAJINA.md.
// rules[] (safu inayokua, malloc+realloc, "rules[count++] = *rule"
// kwenye C asili) imebadilishwa kuwa kikomo kisichobadilika cha
// kanuni 8 (vigezo vyenye majina + kazi ya kupata). MUHIMU: "add
// rule" haiandiki muundo mzima kwa THAMANI kwenye nafasi ya safu
// (hiyo ingekuwa mdudu #182(b)) — badala yake, kila nyanja
// inanakiliwa MOJA KWA MOJA kupitia kielekezi, sawa na mtindo wa
// utawala_baraza_ondoa_mwanachama.
//
// time_t (saa ya mfumo) haipo kwenye Swa (hakuna wakati.swa,
// libc-tegemezi, angalia SOMA.md) — nafasi za tarehe (enacted_date,
// last_amendment) zimebadilishwa kuwa kaunta ya N32 inayoongezeka kwa
// kila mwito wa utawala_katiba_sasisha (mbadala mbaya lakini wa
// kutosha kwa ulinganisho wa "hivi karibuni zaidi ya X").

husisha { msingi/msingi_civ.swa }
husisha { msingi/maktaba/mfuatano.swa }

N32 UTAWALA_KANUNI_WIGO_MAHALI = 0;
N32 UTAWALA_KANUNI_WIGO_MKOA = 1;
N32 UTAWALA_KANUNI_WIGO_TAIFA = 2;
N32 UTAWALA_KANUNI_WIGO_KIMATAIFA = 3;

N32 UTAWALA_KANUNI_AINA_SHERIA = 0;
N32 UTAWALA_KANUNI_AINA_HAKI = 1;
N32 UTAWALA_KANUNI_AINA_TARATIBU = 2;
N32 UTAWALA_KANUNI_AINA_DESTURI = 3;

N32 UTAWALA_KATIBA_KANUNI_UPEO = 8;

muundo UtawalaKanuni {
    N8* kitambulisho;
    N8* jina;
    N8* maelezo;
    N32 wigo;
    N32 aina;
    N8* jukumu_la_mamlaka;
    D64 mamlaka_inayohitajika;
    N8* sifa_lengwa;
    D64 thamani_ya_marekebisho;
    N32 inafanya_kazi;
    N32 tarehe_ya_kuwekwa;
};

muundo UtawalaKatiba {
    N8* kitambulisho;
    N8* jina;
    UtawalaKanuni kanuni_0; UtawalaKanuni kanuni_1; UtawalaKanuni kanuni_2;
    UtawalaKanuni kanuni_3; UtawalaKanuni kanuni_4; UtawalaKanuni kanuni_5;
    UtawalaKanuni kanuni_6; UtawalaKanuni kanuni_7;
    N32 idadi_ya_kanuni;
    D64 kizingiti_cha_marekebisho;
    N8* mwili_wa_marekebisho;
    N32 marekebisho_ya_mwisho;
    N32 saa_ya_ndani;
};

UtawalaKanuni* utawala_katiba_pata_kanuni(UtawalaKatiba* c, N32 idx) {
    kama (idx == 0) { rudisha &c->kanuni_0; }
    kama (idx == 1) { rudisha &c->kanuni_1; }
    kama (idx == 2) { rudisha &c->kanuni_2; }
    kama (idx == 3) { rudisha &c->kanuni_3; }
    kama (idx == 4) { rudisha &c->kanuni_4; }
    kama (idx == 5) { rudisha &c->kanuni_5; }
    kama (idx == 6) { rudisha &c->kanuni_6; }
    rudisha &c->kanuni_7;
}

UtawalaKatiba* utawala_katiba_unda(N8* jina) {
    UtawalaKatiba* c = tenga(ukubwa(UtawalaKatiba));
    c->kitambulisho = "const_0";
    c->jina = jina;
    c->idadi_ya_kanuni = 0;
    c->kizingiti_cha_marekebisho = 0.51;
    c->mwili_wa_marekebisho = 0;
    c->marekebisho_ya_mwisho = 0;
    c->saa_ya_ndani = 0;
    rudisha c;
}

W0 utawala_katiba_uharibu(UtawalaKatiba* c) {
    achilia c;
}

UtawalaKanuni* utawala_kanuni_unda(N8* jina, N32 wigo, N32 aina) {
    UtawalaKanuni* r = tenga(ukubwa(UtawalaKanuni));
    r->kitambulisho = "rule_0";
    r->jina = jina;
    r->maelezo = 0;
    r->wigo = wigo;
    r->aina = aina;
    r->jukumu_la_mamlaka = 0;
    r->mamlaka_inayohitajika = 0.5;
    r->sifa_lengwa = 0;
    r->thamani_ya_marekebisho = 0.0;
    r->inafanya_kazi = 1;
    r->tarehe_ya_kuwekwa = 0;
    rudisha r;
}

W0 utawala_kanuni_uharibu(UtawalaKanuni* r) {
    achilia r;
}

CivMatokeo utawala_katiba_ongeza_kanuni(UtawalaKatiba* c, UtawalaKanuni* kanuni) {
    CivMatokeo m;
    kama (c == 0 || kanuni == 0) {
        m.hitilafu = CIV_HITILAFU_HOJA_MBAYA;
        m.ujumbe = "Hoja batili";
        rudisha m;
    }
    kama (c->idadi_ya_kanuni >= UTAWALA_KATIBA_KANUNI_UPEO) {
        m.hitilafu = CIV_HITILAFU_KUMBUKUMBU_IMEISHA;
        m.ujumbe = "Kikomo cha kanuni kimefikiwa";
        rudisha m;
    }

    UtawalaKanuni* nafasi = utawala_katiba_pata_kanuni(c, c->idadi_ya_kanuni);
    nafasi->kitambulisho = kanuni->kitambulisho;
    nafasi->jina = kanuni->jina;
    nafasi->maelezo = kanuni->maelezo;
    nafasi->wigo = kanuni->wigo;
    nafasi->aina = kanuni->aina;
    nafasi->jukumu_la_mamlaka = kanuni->jukumu_la_mamlaka;
    nafasi->mamlaka_inayohitajika = kanuni->mamlaka_inayohitajika;
    nafasi->sifa_lengwa = kanuni->sifa_lengwa;
    nafasi->thamani_ya_marekebisho = kanuni->thamani_ya_marekebisho;
    nafasi->inafanya_kazi = kanuni->inafanya_kazi;
    nafasi->tarehe_ya_kuwekwa = kanuni->tarehe_ya_kuwekwa;
    c->idadi_ya_kanuni = c->idadi_ya_kanuni + 1;

    m.hitilafu = CIV_SAWA;
    m.ujumbe = "Kanuni imeongezwa";
    rudisha m;
}

CivMatokeo utawala_katiba_ondoa_kanuni(UtawalaKatiba* c, N8* kitambulisho_cha_kanuni) {
    CivMatokeo m;
    kama (c == 0 || kitambulisho_cha_kanuni == 0) {
        m.hitilafu = CIV_HITILAFU_HOJA_MBAYA;
        m.ujumbe = "Hoja batili";
        rudisha m;
    }

    N32 i = 0;
    wakati (i < c->idadi_ya_kanuni) {
        UtawalaKanuni* r = utawala_katiba_pata_kanuni(c, i);
        kama (linganisha_mfuatano(r->kitambulisho, kitambulisho_cha_kanuni) == 0) {
            N32 j = i;
            wakati (j < c->idadi_ya_kanuni - 1) {
                UtawalaKanuni* lengwa = utawala_katiba_pata_kanuni(c, j);
                UtawalaKanuni* kutoka = utawala_katiba_pata_kanuni(c, j + 1);
                lengwa->kitambulisho = kutoka->kitambulisho;
                lengwa->jina = kutoka->jina;
                lengwa->maelezo = kutoka->maelezo;
                lengwa->wigo = kutoka->wigo;
                lengwa->aina = kutoka->aina;
                lengwa->jukumu_la_mamlaka = kutoka->jukumu_la_mamlaka;
                lengwa->mamlaka_inayohitajika = kutoka->mamlaka_inayohitajika;
                lengwa->sifa_lengwa = kutoka->sifa_lengwa;
                lengwa->thamani_ya_marekebisho = kutoka->thamani_ya_marekebisho;
                lengwa->inafanya_kazi = kutoka->inafanya_kazi;
                lengwa->tarehe_ya_kuwekwa = kutoka->tarehe_ya_kuwekwa;
                j = j + 1;
            }
            c->idadi_ya_kanuni = c->idadi_ya_kanuni - 1;
            m.hitilafu = CIV_SAWA;
            m.ujumbe = "Kanuni imeondolewa";
            rudisha m;
        }
        i = i + 1;
    }

    m.hitilafu = CIV_HITILAFU_HAIJAPATIKANA;
    m.ujumbe = "Kanuni haikupatikana";
    rudisha m;
}

UtawalaKanuni* utawala_katiba_tafuta_kanuni(UtawalaKatiba* c, N8* kitambulisho_cha_kanuni) {
    kama (c == 0 || kitambulisho_cha_kanuni == 0) { rudisha 0; }
    N32 i = 0;
    wakati (i < c->idadi_ya_kanuni) {
        UtawalaKanuni* r = utawala_katiba_pata_kanuni(c, i);
        kama (linganisha_mfuatano(r->kitambulisho, kitambulisho_cha_kanuni) == 0) { rudisha r; }
        i = i + 1;
    }
    rudisha 0;
}

N32 utawala_kanuni_ni_halali_kwenye_wigo(UtawalaKanuni* kanuni, N32 wigo_wa_muktadha) {
    kama (kanuni == 0) { rudisha 0; }
    kama (wigo_wa_muktadha == UTAWALA_KANUNI_WIGO_MAHALI) { rudisha 1; }
    kama (kanuni->wigo == wigo_wa_muktadha) { rudisha 1; }
    rudisha 0;
}

N32 utawala_katiba_pendekeza_marekebisho(UtawalaKatiba* c, N8* kitambulisho_cha_kanuni,
                                            N8* maandishi_mapya, D64 uungwaji_mkono) {
    kama (c == 0 || kitambulisho_cha_kanuni == 0) { rudisha 0; }
    kama (uungwaji_mkono >= c->kizingiti_cha_marekebisho) { rudisha 1; }
    rudisha 0;
}

N32 utawala_katiba_thibitisha_marekebisho(UtawalaKatiba* c, N8* kitambulisho_cha_kanuni,
                                             D64 uungwaji_wa_kibunge) {
    kama (c == 0 || kitambulisho_cha_kanuni == 0) { rudisha 0; }
    kama (uungwaji_wa_kibunge < c->kizingiti_cha_marekebisho) { rudisha 0; }
    c->saa_ya_ndani = c->saa_ya_ndani + 1;
    c->marekebisho_ya_mwisho = c->saa_ya_ndani;
    rudisha 1;
}

N32 utawala_katiba_hesabu_ya_marekebisho(UtawalaKatiba* c) {
    kama (c == 0) { rudisha 0; }
    N32 hesabu = 0;
    N32 i = 0;
    wakati (i < c->idadi_ya_kanuni) {
        UtawalaKanuni* r = utawala_katiba_pata_kanuni(c, i);
        kama (r->thamani_ya_marekebisho != 0.0) { hesabu = hesabu + 1; }
        i = i + 1;
    }
    rudisha hesabu;
}

W0 utawala_katiba_rekebisha_kanuni(UtawalaKatiba* c, N8* kitambulisho_cha_kanuni,
                                     N8* maelezo_mapya, D64 thamani_mpya) {
    kama (c == 0 || kitambulisho_cha_kanuni == 0) { rudisha; }
    UtawalaKanuni* r = utawala_katiba_tafuta_kanuni(c, kitambulisho_cha_kanuni);
    kama (r == 0) { rudisha; }
    kama (maelezo_mapya != 0) { r->maelezo = maelezo_mapya; }
    r->thamani_ya_marekebisho = thamani_mpya;
    c->saa_ya_ndani = c->saa_ya_ndani + 1;
    c->marekebisho_ya_mwisho = c->saa_ya_ndani;
}
