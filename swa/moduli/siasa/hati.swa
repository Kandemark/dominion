}

n64 haki_mwaka(n64 h) {
    kama (h == 22 || h == 23) { rudisha 1840; }
    kama (h == 24) { rudisha 1860; }
    kama (h == 25) { rudisha 1880; }
    kama (h == 26 || h == 27 || h == 29) { rudisha 1900; }
    kama (h == 30) { rudisha 1910; }
    rudisha 1700;
}

// Kila haki ina mwelekeo kwenye mihimili ya itikadi (siasa/dola.swa):
// uhuru wa habari huelekea uhuru na mbali na mamlaka ya kati, mali binafsi
// huelekea mbali na usawa, na kadhalika. Hakuna haki iliyo "ya demokrasia"
// au "ya udikteta": waandishi wa katiba (vyama vya serikali kwa viti vyao)
// huamua kila haki kwa misimamo yao.
n64 haki_mwelekeo(n64 h, n64 m) {
    n64 v0 = 0; n64 v1 = 0; n64 v2 = 0; n64 v3 = 0; n64 v4 = 0;
    kama (h == 0) { v0 = 30; v1 = 60; }
    kama (h == 1) { v0 = 20; v3 = 20; }
    kama (h == 2) { v0 = 50; v2 = -30; }
    kama (h == 3) { v0 = 50; v1 = 40; }
    kama (h == 4 || h == 5) { v0 = 60; v2 = -40; }
    kama (h == 6 || h == 7) { v0 = 50; v2 = -20; }
    kama (h == 8) { v0 = 40; }
    kama (h == 9) { v0 = 60; v2 = -30; }
    kama (h == 10) { v0 = 60; v3 = -30; }
    kama (h == 11) { v0 = 80; v2 = -30; }
    kama (h == 12) { v0 = 80; v2 = -40; }
    kama (h == 13 || h == 14) { v0 = 70; v2 = -30; }
    kama (h == 15) { v0 = 60; }
    kama (h == 16) { v0 = 60; v4 = -20; }
    kama (h == 17) { v0 = 40; v1 = -60; }
    kama (h == 18) { v0 = 30; v1 = -40; }
    kama (h == 19) { v0 = 40; v2 = -10; }
    kama (h == 20) { v0 = 50; v1 = 30; v2 = -30; }
    kama (h == 21) { v1 = 40; v3 = -30; }
    kama (h == 22) { v1 = 60; }
    kama (h == 23) { v1 = 70; }
    kama (h == 24) { v0 = 30; v1 = 60; }
    kama (h == 25) { v0 = 40; v1 = 60; v2 = -30; }
    kama (h == 26) { v1 = 40; v3 = 30; }
    kama (h == 27) { v1 = 70; }
    kama (h == 28) { v0 = 40; v4 = -40; }
    kama (h == 29) { v0 = 40; v4 = -50; }
    kama (h == 30) { v0 = 60; v3 = -30; }
    kama (h == 31) { v0 = 60; v2 = -50; }
    kama (h == 32) { v0 = 40; v2 = -30; }
    kama (h == 33) { v0 = 40; v4 = -50; }
    kama (h == 34) { v1 = -50; v3 = 30; }
    kama (h == 35) { v0 = 50; v1 = -60; }
    kama (m == 0) { rudisha v0; }
    kama (m == 1) { rudisha v1; }
    kama (m == 2) { rudisha v2; }
    kama (m == 3) { rudisha v3; }
    rudisha v4;
}

// Msimamo wa waandishi wa katiba (vyama vya serikali kwa viti vyao) kwenye mhimili m.
n64 hati_w(Dola* d, n64 m) { rudisha dola_msimamo(d, m, 1); }

// Kiasi waandishi wanavyopendelea kuweka mamlaka chini ya mipaka (-100..100).
n64 hati_huria(Dola* d) { rudisha (hati_w(d, MHIMILI_UHURU) - hati_w(d, MHIMILI_MAMLAKA)) / 2; }

// Jinsi waandishi wanavyoiona haki h: -100 (wanaipinga) .. 100 (wanaitaka).
n64 haki_alama(Dola* d, n64 h) {
    n64 dot = 0;
    n64 ukubwa = 0;
    n64 m = 0;
    wakati (m < MIHIMILI) {
        dot = dot + hati_w(d, m) * haki_mwelekeo(h, m);
        ukubwa = ukubwa + haki_mwelekeo(h, m) * haki_mwelekeo(h, m);
        m = m + 1;
    }
    kama (ukubwa == 0) { rudisha 0; }
    n64 b = 1;
    wakati ((b + 1) * (b + 1) <= ukubwa) { b = b + 1; }
    rudisha dot / b;
}

// Haki huwekwa kwenye katiba isipokuwa waandishi wake wanaipinga waziwazi.
n32 haki_inakubalika(Dola* d, n64 h) { rudisha haki_alama(d, h) > -35; }

