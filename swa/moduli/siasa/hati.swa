    kama (h == 6) { rudisha ui("a fair and public trial"); }
    kama (h == 7) { rudisha ui("the presumption of innocence"); }
    kama (h == 8) { rudisha ui("protection from retroactive punishment"); }
    kama (h == 9) { rudisha ui("privacy of the home and of correspondence"); }
    kama (h == 10) { rudisha ui("freedom of conscience and religion"); }
    kama (h == 11) { rudisha ui("freedom of expression"); }
    kama (h == 12) { rudisha ui("freedom of the press"); }
    kama (h == 13) { rudisha ui("freedom of peaceful assembly"); }
    kama (h == 14) { rudisha ui("freedom of association"); }
    kama (h == 15) { rudisha ui("freedom of movement and residence"); }
    kama (h == 16) { rudisha ui("leave and return to the country"); }
    kama (h == 17) { rudisha ui("property"); }
    kama (h == 18) { rudisha ui("compensation for property taken by the state"); }
    kama (h == 19) { rudisha ui("petition the authorities"); }
    kama (h == 20) { rudisha ui("vote and to stand for office"); }
    kama (h == 21) { rudisha ui("access to public office on merit"); }
    kama (h == 22) { rudisha ui("education"); }
    kama (h == 23) { rudisha ui("work"); }
    kama (h == 24) { rudisha ui("form trade unions"); }
    kama (h == 25) { rudisha ui("strike"); }
    kama (h == 26) { rudisha ui("protection of mothers and children"); }
    kama (h == 27) { rudisha ui("care in sickness and old age"); }
    kama (h == 28) { rudisha ui("the use of one's own language"); }
    kama (h == 29) { rudisha ui("the protection of minorities"); }
    kama (h == 30) { rudisha ui("freedom of scientific and artistic work"); }
    kama (h == 31) { rudisha ui("bear arms"); }
    kama (h == 32) { rudisha ui("trial by jury"); }
    kama (h == 33) { rudisha ui("asylum for the persecuted"); }
    kama (h == 34) { rudisha ui("inherit property"); }
