husisha { moduli/siasa/nguvu.swa }
husisha { moduli/jeshi/vikosi.swa }

// hati.swa -- injini ya katiba: vifungu kama data inayozalishwa na kubadilika.
//
// Katiba si maandishi yaliyoandikwa mara moja. Kizalishaji hupitia kila
// taasisi ya dola na kutoa vifungu kwa kanuni:
//   kila cheo cha mti wa dola        uteuzi, uthibitisho, mamlaka, urithi
//   kila wizara                      kuanzishwa kwake
//   kila baraza                      muundo, muhula, sifa, akidi, spika,
//                                    vikao, kinga, nafasi wazi; utaratibu wa
//                                    miswada; kamati zake zote
//   kila mkoa wa ramani              kuanzishwa na gavana wake
//   orodha ya haki                   haki zinazoruhusiwa na aina ya utawala
//                                    na mwaka (mgomo baada ya 1880...), na
//                                    mipaka yake na ulinzi wa mahakama
//   fedha, uchaguzi, mahakama, ulinzi, dharura, marekebisho, mpito
//   kila haki                        sababu za kuiwekea mipaka, kama
//                                    inaweza kusimamishwa wakati wa dharura
//   kila njia ya uraia, kila dhamana ya kesi ya haki, alama za taifa
//   kila wizara                      kazi zake (kutoka jina lake) na
//                                    kujibu maswali barazani
//   kila baraza                      kuvunjwa, kutostahili, kupoteza kiti;
//                                    miswada ya fedha na vikao vya pamoja
//   kila ngazi ya mahakama           mamlaka yake; mahakama maalum za zama
//   kila tawi la jeshi               kikomo cha askari (kutoka majeshi
//                                    halisi ya taifa); jeshi la lazima
//   kila mkoa                        kamati yake ya utendaji na fungu lake
//                                    la mapato
// Majedwali (schedules) kama katiba halisi: kila wilaya (kutoka miji halisi
// ya ramani), kila jimbo la uchaguzi (viti vya baraza la chini kwa watu wa
// wilaya), kiapo cha kila cheo, na mgao wa mapato kwa mikoa.
// Kila kifungu kina aina, mada (cheo, baraza, mkoa, haki) na vigezo vinne vya
// namba (asilimia, siku, miaka, viti). Maandishi huundwa kutoka vigezo kwa
// sarufi ya vipande (kitenzi cha lazima, muda, sharti) kinachobadilika kwa
// mbegu ya kifungu. Injini husoma vigezo: kiwango cha kura cha kila hoja,
// wiki za kura na idhini, kiwango cha kupindua turufu, muhula, utaratibu wa
// marekebisho.
//
// Mageuko: marekebisho hubadilisha vigezo au kufuta vifungu, kila badiliko
// likihifadhiwa. Mataifa mengine hubadilisha katiba zao (toleo la katiba
// hupanda kwa marekebisho na mapinduzi), na kila toleo hubadilisha baadhi ya
// vigezo kidogo kutoka toleo lililotangulia.

// ---------- sehemu za katiba ----------

n64 SEHEMU_IDADI = 17;
n64 HATI_SEHEMU_ZA_KATIBA = 13;     // sehemu 13 na zaidi ni majedwali

n8* sehemu_jina(n64 s) {
    kama (s == 0) { rudisha ui("General Provisions"); }
    kama (s == 1) { rudisha ui("Fundamental Rights and Freedoms"); }
    kama (s == 2) { rudisha ui("The Head of State"); }
    kama (s == 3) { rudisha ui("The Executive"); }
    kama (s == 4) { rudisha ui("The Legislature"); }
    kama (s == 5) { rudisha ui("The Judiciary"); }
    kama (s == 6) { rudisha ui("Defence and Security"); }
    kama (s == 7) { rudisha ui("Regions and Local Government"); }
    kama (s == 8) { rudisha ui("Public Finance"); }
    kama (s == 9) { rudisha ui("Elections and Political Parties"); }
    kama (s == 10) { rudisha ui("States of Emergency"); }
    kama (s == 11) { rudisha ui("Amendment of this Constitution"); }
    kama (s == 12) { rudisha ui("Transitional and Final Provisions"); }
    kama (s == 13) { rudisha ui("First Schedule: Regions and Districts"); }
    kama (s == 14) { rudisha ui("Second Schedule: Electoral Constituencies"); }
    kama (s == 15) { rudisha ui("Third Schedule: Oaths of Office"); }
    rudisha ui("Fourth Schedule: Division of Revenue");
}

// ---------- aina za vifungu ----------

n64 K_DOLA = 0;
n64 K_MAMLAKA = 1;
n64 K_ENEO = 2;             // p0 idadi ya mikoa
n64 K_SARAFU = 3;
n64 K_URAIA = 4;            // p0 miaka ya ukaazi
n64 K_HAKI = 5;             // mada haki; p0 mipaka (0 kamili, 1 kwa sheria, 2 kwa amri); p1 mahakama huilinda
n64 K_MKUU_UTEUZI = 6;      // p0 namna, p1 muhula, p2 kikomo, p3 umri wa chini
n64 K_MKUU_KIAPO = 7;
n64 K_MKUU_TURUFU = 8;      // p0 turufu, p1 asilimia ya kupindua, p2 siku za idhini
n64 K_MKUU_MSAMAHA = 9;
n64 K_MKUU_KUONDOLEWA = 10; // p0 asilimia
n64 K_URITHI = 11;          // mada cheo; p0 nafasi
n64 K_UTEUZI = 12;          // mada cheo; p0 baraza la uthibitisho + 1; p1 siku
n64 K_WIZARA = 13;          // mada cheo
n64 K_IMANI = 14;           // p0 asilimia, p1 siku za kuunda serikali
n64 K_BARAZA = 15;          // mada baraza; p0 viti, p1 namna
n64 K_BARAZA_MUHULA = 16;   // p0 miaka
n64 K_BARAZA_SIFA = 17;     // p0 umri
n64 K_AKIDI = 18;           // p0 asilimia
n64 K_SPIKA = 19;           // p0 asilimia ya kumwondoa
n64 K_VIKAO = 20;           // p0 vikao kwa mwaka
n64 K_KINGA = 21;           // p0
n64 K_NAFASI_WAZI = 22;     // p0 siku
n64 K_MSWADA = 23;          // p0 asilimia, p1 siku kabla ya kura
n64 K_KAMATI = 24;          // mada cheo
n64 K_MAHAKAMA = 25;        // p0 majaji
n64 K_JAJI_MUDA = 26;       // p0 umri wa kustaafu
n64 K_JAJI_KUONDOLEWA = 27; // p0 asilimia
n64 K_MAPITIO = 28;         // p0
n64 K_AMRI_JESHI = 29;      // mada cheo
n64 K_VITA = 30;            // p0 bunge huamua, p1 asilimia
n64 K_MKOA = 31;            // mada mkoa; p0 gavana huchaguliwa
n64 K_BAJETI = 32;          // p0 mwezi
n64 K_KODI = 33;
n64 K_DENI = 34;            // p0 asilimia ya pato
n64 K_BENKI = 35;           // p0 uhuru
n64 K_UKAGUZI = 36;         // p0 miaka
n64 K_KURA = 37;            // p0 haki ya kura, p1 umri
n64 K_TUME = 38;            // p0 wajumbe
n64 K_VYAMA = 39;           // p0 vyama vingi, p1 saini (maelfu)
n64 K_DHARURA = 40;         // p0 siku, p1 asilimia ya kuongeza, p2 iko sasa
n64 K_MAREKEBISHO = 41;     // p0 asilimia, p1 kura ya maoni, p2 siku
n64 K_ZISIZOGUSWA = 42;     // p0
n64 K_MPITO = 43;           // p0 miaka
n64 K_UHURU_HABARI = 44;    // p0
n64 K_MGAWANYO = 45;        // mada eneo la sera; p0 0 taifa, 1 pamoja, 2 mikoa
n64 K_SIFA_YA_CHEO = 46;    // mada cheo; p0 umri wa chini, p1 miaka ya uraia
n64 K_MAHAKAMA_NDOGO = 47;  // mada ngazi; p0 majaji kwa kila mahakama
n64 K_TAASISI = 48;         // mada taasisi huru; p0 muhula wa mkuu wake
n64 K_MKOA_BARAZA = 49;     // mada mkoa; p0 viti vya baraza la mkoa
n64 K_HAKI_MIPAKA = 50;     // mada haki; p0 sababu (biti: 1 usalama, 2 utulivu, 4 afya, 8 maadili, 16 haki za wengine, 32 umoja wa nchi, 64 kuzuia uhalifu, 128 heshima ya mahakama)
n64 K_HAKI_DHARURA = 51;    // mada haki; p0 1 inaweza kusimamishwa wakati wa dharura
n64 K_KESI = 52;            // mada dhamana; p0 ipo, p1 saa/siku pale inapohusika
n64 K_URAIA_NJIA = 53;      // mada njia; p0 ipo, p1 miaka
n64 K_ALAMA = 54;           // mada 0 mji mkuu, 1 bendera, 2 wimbo, 3 muhuri, 4 lugha, 5 sikukuu; p0
n64 K_WIZARA_KAZI = 55;     // mada cheo; p0 maeneo ya sera (biti)
n64 K_WIZARA_MASWALI = 56;  // mada cheo; p0 siku kwa mwezi za kujibu maswali
n64 K_BARAZA_KUVUNJWA = 57; // mada baraza; p0 0 haivunjwi, 1 mkuu wa dola, 2 mkuu wa serikali; p1 siku za uchaguzi
n64 K_BARAZA_KUTOSTAHILI = 58; // mada baraza; p0 sababu (biti), p1 miaka ya kifungo
n64 K_BARAZA_KUPOTEZA = 59; // mada baraza; p0 vikao vya kutohudhuria, p1 kuhama chama hupoteza kiti
n64 K_MSWADA_FEDHA = 60;    // p0 siku ambazo baraza la juu laweza kuchelewesha
n64 K_KIKAO_PAMOJA = 61;    // p0 asilimia
n64 K_MAHAKAMA_MAMLAKA = 62; // mada ngazi (-1 Mahakama Kuu); p0 mamlaka (biti)
n64 K_MAHAKAMA_MAALUM = 63; // mada aina; p0 majaji
n64 K_MAJESHI = 64;         // mada tawi (VK_*); p0 kikomo cha askari (maelfu)
n64 K_LAZIMA_JESHI = 65;    // p0 miezi ya utumishi (0 hakuna), p1 umri
n64 K_BARAZA_ULINZI = 66;   // p0 wajumbe
n64 K_POLISI = 67;          // p0 0 la taifa, 1 la mikoa
n64 K_UJASUSI = 68;         // p0 kamati ya bunge huisimamia
n64 K_MKOA_MTENDAJI = 69;   // mada mkoa; p0 wajumbe wa kamati ya utendaji
n64 K_MGAO_JUMLA = 70;      // p0 asilimia ya mapato ya taifa kwa mikoa
n64 K_MGAO_MKOA = 71;       // mada mkoa; p0 fungu kwa elfu
n64 K_WILAYA = 72;          // mada wilaya; p0 mkoa, p1 watu (maelfu), p2 viti vya baraza la wilaya
n64 K_JIMBO = 73;           // mada wilaya; p0 wabunge, p1 wilaya inayounganishwa nayo (-1)
n64 K_KIAPO = 74;           // mada cheo
n64 K_UCHAGUZI_MIGOGORO = 75; // p0 siku za kuamua malalamiko
n64 K_UCHAGUZI_TAREHE = 76; // p0 mwezi, p1 siku za tangazo
n64 K_WILAYA_MAMLAKA = 77;  // mada wilaya; p0 kazi za baraza la wilaya (biti)
n64 K_WAJIBU = 78;          // mada kanuni ya sera ya dola; p0 ipo
n64 K_KAZI_UTENDAJI = 79;   // mada cheo: kazi na anayemjibu
n64 K_KAZI_BUNGE = 80;
n64 K_KAZI_MAHAKAMA = 81;
n64 K_KAZI_JESHI = 82;
n64 K_KAZI_MIKOA = 83;
n64 K_AINA_IDADI = 84;

n64 hati_sehemu_ya_aina(n64 k) {
    kama (k == K_WILAYA) { rudisha 13; }
    kama (k == K_WILAYA_MAMLAKA || k == K_KAZI_MIKOA) { rudisha 7; }
    kama (k == K_WAJIBU) { rudisha 1; }
    kama (k == K_KAZI_UTENDAJI) { rudisha 3; }
    kama (k == K_KAZI_BUNGE) { rudisha 4; }
    kama (k == K_KAZI_MAHAKAMA) { rudisha 5; }
    kama (k == K_KAZI_JESHI) { rudisha 6; }
    kama (k == K_JIMBO) { rudisha 14; }
    kama (k == K_KIAPO) { rudisha 15; }
    kama (k == K_MGAO_MKOA) { rudisha 16; }
    kama (k == K_URAIA_NJIA || k == K_ALAMA) { rudisha 0; }
    kama (k == K_HAKI_MIPAKA || k == K_HAKI_DHARURA || k == K_KESI) { rudisha 1; }
    kama (k == K_WIZARA_KAZI || k == K_WIZARA_MASWALI) { rudisha 3; }
    kama (k >= K_BARAZA_KUVUNJWA && k <= K_KIKAO_PAMOJA) { rudisha 4; }
    kama (k == K_MAHAKAMA_MAMLAKA || k == K_MAHAKAMA_MAALUM) { rudisha 5; }
    kama (k >= K_MAJESHI && k <= K_UJASUSI) { rudisha 6; }
    kama (k == K_MKOA_MTENDAJI) { rudisha 7; }
    kama (k == K_MGAO_JUMLA) { rudisha 8; }
    kama (k == K_UCHAGUZI_MIGOGORO || k == K_UCHAGUZI_TAREHE) { rudisha 9; }
    kama (k == K_MGAWANYO || k == K_MKOA_BARAZA) { rudisha 7; }
    kama (k == K_SIFA_YA_CHEO) { rudisha 3; }
    kama (k == K_MAHAKAMA_NDOGO) { rudisha 5; }
    kama (k == K_TAASISI) { rudisha 12; }
    kama (k <= K_URAIA) { rudisha 0; }
    kama (k == K_HAKI || k == K_UHURU_HABARI) { rudisha 1; }
    kama (k <= K_URITHI) { rudisha 2; }
    kama (k <= K_IMANI) { rudisha 3; }
    kama (k <= K_KAMATI) { rudisha 4; }
    kama (k <= K_MAPITIO) { rudisha 5; }
    kama (k <= K_VITA) { rudisha 6; }
    kama (k == K_MKOA) { rudisha 7; }
    kama (k <= K_UKAGUZI) { rudisha 8; }
    kama (k <= K_VYAMA) { rudisha 9; }
    kama (k == K_DHARURA) { rudisha 10; }
    kama (k <= K_ZISIZOGUSWA) { rudisha 11; }
    rudisha 12;
}

// Jina la kigezo i cha aina k, au 0 ikiwa aina haina kigezo hicho.
n8* hati_jina_la_kigezo(n64 k, n64 i) {
    kama (i == 0) {
        kama (k == K_DOLA) { rudisha ui("Form of government"); }
        kama (k == K_URAIA) { rudisha ui("Years of residence"); }
        kama (k == K_HAKI) { rudisha ui("Limitation (0 none, 1 by law, 2 by decree)"); }
        kama (k == K_MKUU_UTEUZI) { rudisha ui("Selection (0 hereditary, 1 people, 2 legislature, 3 council)"); }
        kama (k == K_MKUU_TURUFU) { rudisha ui("Veto (1 yes)"); }
        kama (k == K_KINGA || k == K_MAPITIO || k == K_BENKI || k == K_UHURU_HABARI || k == K_ZISIZOGUSWA) { rudisha ui("In force (1 yes)"); }
        kama (k == K_MKUU_KUONDOLEWA || k == K_IMANI || k == K_SPIKA || k == K_JAJI_KUONDOLEWA || k == K_MSWADA || k == K_MAREKEBISHO) { rudisha ui("Votes required (%)"); }
        kama (k == K_UTEUZI) { rudisha ui("Confirming chamber (0 none)"); }
        kama (k == K_BARAZA) { rudisha ui("Seats"); }
        kama (k == K_BARAZA_MUHULA || k == K_UKAGUZI) { rudisha ui("Term (years)"); }
        kama (k == K_BARAZA_SIFA) { rudisha ui("Minimum age"); }
        kama (k == K_AKIDI) { rudisha ui("Quorum (%)"); }
        kama (k == K_VIKAO) { rudisha ui("Sittings a year"); }
        kama (k == K_NAFASI_WAZI) { rudisha ui("Days to fill a vacancy"); }
        kama (k == K_MAHAKAMA) { rudisha ui("Justices"); }
        kama (k == K_JAJI_MUDA) { rudisha ui("Retirement age"); }
        kama (k == K_VITA) { rudisha ui("Declared by the legislature (1 yes)"); }
        kama (k == K_MKOA) { rudisha ui("Governor elected (1 yes)"); }
        kama (k == K_BAJETI) { rudisha ui("Budget month"); }
        kama (k == K_DENI) { rudisha ui("Debt limit (% of output)"); }
        kama (k == K_KURA) { rudisha ui("Franchise (0 all, 1 property, 2 estates, 3 none)"); }
        kama (k == K_TUME) { rudisha ui("Commissioners"); }
        kama (k == K_VYAMA) { rudisha ui("Several parties (1 yes)"); }
        kama (k == K_DHARURA) { rudisha ui("Duration (days)"); }
        kama (k == K_MGAWANYO) { rudisha ui("Level (0 national, 1 shared, 2 regional)"); }
        kama (k == K_SIFA_YA_CHEO) { rudisha ui("Minimum age"); }
        kama (k == K_MAHAKAMA_NDOGO) { rudisha ui("Judges on each bench"); }
        kama (k == K_TAASISI) { rudisha ui("Term of its head (years)"); }
        kama (k == K_MKOA_BARAZA) { rudisha ui("Council seats"); }
        kama (k == K_HAKI_MIPAKA) { rudisha ui("Grounds of limitation (bits)"); }
        kama (k == K_HAKI_DHARURA) { rudisha ui("May be suspended in an emergency (1 yes)"); }
        kama (k == K_KESI || k == K_URAIA_NJIA || k == K_UJASUSI) { rudisha ui("In force (1 yes)"); }
        kama (k == K_WIZARA_KAZI) { rudisha ui("Policy areas (bits)"); }
        kama (k == K_WIZARA_MASWALI) { rudisha ui("Question days a month"); }
        kama (k == K_BARAZA_KUVUNJWA) { rudisha ui("Dissolved by (0 none, 1 head of state, 2 head of government)"); }
        kama (k == K_BARAZA_KUTOSTAHILI) { rudisha ui("Grounds of disqualification (bits)"); }
        kama (k == K_BARAZA_KUPOTEZA) { rudisha ui("Sittings missed"); }
        kama (k == K_MSWADA_FEDHA) { rudisha ui("Days the upper chamber may delay"); }
        kama (k == K_KIKAO_PAMOJA) { rudisha ui("Votes in joint sitting (%)"); }
        kama (k == K_MAHAKAMA_MAMLAKA) { rudisha ui("Jurisdiction (bits)"); }
        kama (k == K_MAHAKAMA_MAALUM) { rudisha ui("Judges"); }
        kama (k == K_MAJESHI) { rudisha ui("Ceiling (thousands)"); }
        kama (k == K_LAZIMA_JESHI) { rudisha ui("Months of service (0 none)"); }
        kama (k == K_BARAZA_ULINZI) { rudisha ui("Members"); }
        kama (k == K_POLISI) { rudisha ui("Level (0 national, 1 regional)"); }
        kama (k == K_MKOA_MTENDAJI) { rudisha ui("Executive members"); }
        kama (k == K_MGAO_JUMLA) { rudisha ui("Share of revenue (%)"); }
        kama (k == K_MGAO_MKOA) { rudisha ui("Share (per thousand)"); }
        kama (k == K_JIMBO) { rudisha ui("Members returned"); }
        kama (k == K_UCHAGUZI_MIGOGORO) { rudisha ui("Days to decide a petition"); }
        kama (k == K_UCHAGUZI_TAREHE) { rudisha ui("Month of general elections"); }
        kama (k == K_WILAYA_MAMLAKA) { rudisha ui("Functions of the council (bits)"); }
        kama (k == K_WAJIBU) { rudisha ui("In force (1 yes)"); }
        rudisha 0;
    }
    kama (i == 1) {
        kama (k == K_HAKI) { rudisha ui("Enforced by the courts (1 yes)"); }
        kama (k == K_MKUU_UTEUZI) { rudisha ui("Term (years, 0 life)"); }
        kama (k == K_MKUU_TURUFU) { rudisha ui("Override (%)"); }
        kama (k == K_UTEUZI) { rudisha ui("Days to confirm"); }
        kama (k == K_IMANI) { rudisha ui("Days to form a government"); }
        kama (k == K_MSWADA) { rudisha ui("Days before the vote"); }
        kama (k == K_VITA) { rudisha ui("Votes required (%)"); }
        kama (k == K_KURA) { rudisha ui("Voting age"); }
        kama (k == K_VYAMA) { rudisha ui("Signatures to register (thousands)"); }
        kama (k == K_DHARURA) { rudisha ui("Votes to extend (%)"); }
        kama (k == K_MAREKEBISHO) { rudisha ui("Referendum (1 yes)"); }
        kama (k == K_SIFA_YA_CHEO) { rudisha ui("Years of citizenship"); }
        kama (k == K_KESI) { rudisha ui("Hours or days allowed"); }
        kama (k == K_URAIA_NJIA) { rudisha ui("Years required"); }
        kama (k == K_BARAZA_KUVUNJWA) { rudisha ui("Days to the election"); }
        kama (k == K_BARAZA_KUTOSTAHILI) { rudisha ui("Prison term that disqualifies (years)"); }
        kama (k == K_BARAZA_KUPOTEZA) { rudisha ui("Floor-crossing loses the seat (1 yes)"); }
        kama (k == K_LAZIMA_JESHI) { rudisha ui("Age of call-up"); }
        kama (k == K_UCHAGUZI_TAREHE) { rudisha ui("Days of notice"); }
        rudisha 0;
    }
    kama (i == 2) {
        kama (k == K_MKUU_UTEUZI) { rudisha ui("Term limit (0 none)"); }
        kama (k == K_MKUU_TURUFU) { rudisha ui("Days to assent"); }
        kama (k == K_DHARURA) { rudisha ui("Emergency declared (1 yes)"); }
        kama (k == K_MAREKEBISHO) { rudisha ui("Days of waiting"); }
        rudisha 0;
    }
    kama (i == 3 && k == K_MKUU_UTEUZI) { rudisha ui("Minimum age"); }
    rudisha 0;
}

n64 hati_kigezo_chini(n64 k, n64 i) {
    kama (i == 0 && (k == K_MSWADA || k == K_MAREKEBISHO || k == K_IMANI || k == K_SPIKA || k == K_MKUU_KUONDOLEWA || k == K_JAJI_KUONDOLEWA || k == K_AKIDI)) { rudisha 10; }
    kama (k == K_MKUU_TURUFU && i == 1) { rudisha 51; }
    kama (k == K_BAJETI) { rudisha 1; }
    rudisha 0;
}

n64 hati_kigezo_juu(n64 k, n64 i) {
    kama (hati_jina_la_kigezo(k, i) == 0) { rudisha 0; }
    kama (k == K_DOLA) { rudisha DOLA_AINA_IDADI - 1; }
    kama (k == K_MGAWANYO) { rudisha 2; }
    kama (k == K_SIFA_YA_CHEO) { kama (i == 0) { rudisha 80; } rudisha 40; }
    kama (k == K_MAHAKAMA_NDOGO) { rudisha 15; }
    kama (k == K_TAASISI) { rudisha 15; }
    kama (k == K_MKOA_BARAZA) { rudisha 200; }
    kama (k == K_HAKI_MIPAKA || k == K_MAHAKAMA_MAMLAKA) { rudisha 255; }
    kama (k == K_WILAYA_MAMLAKA) { rudisha 2047; }
    kama (k == K_BARAZA_KUTOSTAHILI && i == 0) { rudisha 63; }
    kama (k == K_BARAZA_KUTOSTAHILI && i == 1) { rudisha 10; }
    kama (k == K_WIZARA_KAZI) { rudisha 4194303; }
    kama (k == K_WIZARA_MASWALI) { rudisha 12; }
    kama (k == K_KESI && i == 1) { rudisha 168; }
    kama (k == K_URAIA_NJIA && i == 1) { rudisha 30; }
    kama (k == K_BARAZA_KUVUNJWA && i == 0) { rudisha 2; }
    kama (k == K_BARAZA_KUVUNJWA && i == 1) { rudisha 180; }
    kama (k == K_BARAZA_KUPOTEZA && i == 0) { rudisha 60; }
    kama (k == K_MSWADA_FEDHA) { rudisha 180; }
    kama (k == K_KIKAO_PAMOJA || k == K_MGAO_JUMLA) { rudisha 100; }
    kama (k == K_MAHAKAMA_MAALUM) { rudisha 25; }
    kama (k == K_MAJESHI) { rudisha 20000; }
    kama (k == K_LAZIMA_JESHI && i == 0) { rudisha 48; }
    kama (k == K_LAZIMA_JESHI && i == 1) { rudisha 30; }
    kama (k == K_BARAZA_ULINZI) { rudisha 25; }
    kama (k == K_MKOA_MTENDAJI) { rudisha 20; }
    kama (k == K_MGAO_MKOA) { rudisha 1000; }
    kama (k == K_JIMBO) { rudisha 40; }
    kama (k == K_UCHAGUZI_MIGOGORO) { rudisha 365; }
    kama (k == K_UCHAGUZI_TAREHE && i == 0) { rudisha 12; }
    kama (k == K_UCHAGUZI_TAREHE && i == 1) { rudisha 180; }
    kama (k == K_HAKI && i == 0) { rudisha 2; }
    kama ((k == K_MKUU_UTEUZI || k == K_KURA) && i == 0) { rudisha 3; }
    kama (k == K_BAJETI) { rudisha 12; }
    kama (k == K_UTEUZI && i == 0) { rudisha 4; }
    kama (k == K_BARAZA) { rudisha 2000; }
    kama (k == K_VYAMA && i == 1) { rudisha 500; }
    kama ((k == K_DHARURA && i == 0) || (k == K_MAREKEBISHO && i == 2)) { rudisha 365; }
    kama (k == K_NAFASI_WAZI || ((k == K_UTEUZI || k == K_IMANI || k == K_MSWADA) && i == 1) || (k == K_MKUU_TURUFU && i == 2)) { rudisha 180; }
    kama (k == K_VIKAO) { rudisha 52; }
    kama (k == K_MAHAKAMA || k == K_TUME) { rudisha 25; }
    kama (k == K_JAJI_MUDA || k == K_BARAZA_SIFA || (k == K_MKUU_UTEUZI && i == 3) || (k == K_KURA && i == 1)) { rudisha 90; }
    kama (k == K_DENI) { rudisha 200; }
    kama (k == K_URAIA || k == K_UKAGUZI || k == K_BARAZA_MUHULA || (k == K_MKUU_UTEUZI && i == 1)) { rudisha 15; }
    kama (k == K_MKUU_UTEUZI && i == 2) { rudisha 5; }
    kama (i == 0 && (k == K_MSWADA || k == K_MAREKEBISHO || k == K_IMANI || k == K_SPIKA || k == K_MKUU_KUONDOLEWA || k == K_JAJI_KUONDOLEWA || k == K_AKIDI)) { rudisha 100; }
    kama (i == 1 && (k == K_MKUU_TURUFU || k == K_VITA || k == K_DHARURA)) { rudisha 100; }
    rudisha 1;
}

// ---------- haki ----------

n64 HAKI_IDADI = 36;

n8* haki_jina(n64 h) {
    kama (h == 0) { rudisha ui("equality before the law"); }
    kama (h == 1) { rudisha ui("life"); }
    kama (h == 2) { rudisha ui("freedom from torture and cruel punishment"); }
    kama (h == 3) { rudisha ui("freedom from slavery and forced labour"); }
