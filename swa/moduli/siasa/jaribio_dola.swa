husisha { moduli/siasa/dola.swa }

// jaribio_dola.swa -- dola za kila aina: idadi ya mabaraza ni 0..4, viti vya
// vyama hujumlisha viti vya baraza kamili, na serikali ina wingi pale ambapo
// kuna ushindani. Huchapisha muhtasari wa dola chache.

n64 makosa = 0;

w0 kagua(n8* cheo, n64 mbegu, n64 watu, n64 mabaraza_tarajiwa) {
    Dola* d = dola_unda(mbegu, cheo, watu);
    kama (d->mabaraza < 0 || d->mabaraza > 4) { andika("SHINDWA %s: mabaraza %d\n", cheo, d->mabaraza, 0, 0, 0, 0); makosa = makosa + 1; }
    kama (mabaraza_tarajiwa >= 0 && d->mabaraza != mabaraza_tarajiwa) {
        andika("SHINDWA %s: mabaraza %d, si %d\n", cheo, d->mabaraza, mabaraza_tarajiwa, 0, 0, 0);
        makosa = makosa + 1;
    }
    n64 b = 0;
    wakati (b < d->mabaraza) {
        n64 jumla = 0;
        n64 c = 0;
        wakati (c < d->vyama) { jumla = jumla + d->viti[b * DOLA_VYAMA_JUU + c]; c = c + 1; }
        kama (jumla != d->baraza_viti[b]) {
            andika("SHINDWA %s: baraza %d viti %d, vyama vina %d\n", cheo, b, d->baraza_viti[b], jumla, 0, 0);
            makosa = makosa + 1;
        }
        b = b + 1;
    }
    andika("%s -> %s, mabaraza %d, vyama %d\n", cheo, dola_aina_jina(d->aina), d->mabaraza, d->vyama, 0, 0);
}

n32 anza(n32 idadi_ya_hoja, n8** hoja_za_mstari) {
    kagua("Empire of Varn", 3, 90000000, 4);                // mabaraza manne ya matabaka
    kagua("Rogin Commonwealth", 4, 30000000, 3);            // matatu
    kagua("People's Republic of Volsk", 5, 50000000, 1);    // moja
    kagua("Tribes of Osty", 6, 900000, 1);
    kagua("Caliphate of Qadr", 7, 12000000, 0 - 1);
    kagua("Concord of Syntheon", 0, 8000000, 2);
    kagua("Federal Union of Birie", 9, 346000000, 0 - 1);
    // mataifa 232: kila moja lazima lipite; hesabu dola zisizo na baraza
    n64 bila = 0;
    n64 kwa_idadi[5];
    n64 i = 0;
    wakati (i < 5) { kwa_idadi[i] = 0; i = i + 1; }
    i = 0;
    wakati (i < 232) {
        n8* cheo = "Republic of Test";
        kama (i % 5 == 1) { cheo = "Kingdom of Test"; }
        kama (i % 5 == 2) { cheo = "Emirate of Test"; }
        kama (i % 5 == 3) { cheo = "Test"; }
        kama (i % 5 == 4) { cheo = "State of Test"; }
        Dola* d = dola_ya_taifa(i, cheo, 1000000 + i * 250000);
        kama (d == 0 || d->mabaraza < 0 || d->mabaraza > 4) { makosa = makosa + 1; }
        sivyo { kwa_idadi[d->mabaraza] = kwa_idadi[d->mabaraza] + 1; }
        kama (dola_ya_taifa(i, cheo, 5) != d) { andika("SHINDWA: akiba %d\n", i, 0, 0, 0, 0, 0); makosa = makosa + 1; }
        i = i + 1;
    }
    andika("mabaraza 0:%d 1:%d 2:%d 3:%d 4:%d\n", kwa_idadi[0], kwa_idadi[1], kwa_idadi[2], kwa_idadi[3], kwa_idadi[4], 0);
    kama (kwa_idadi[0] == 0 || kwa_idadi[1] == 0 || kwa_idadi[2] == 0) { andika("SHINDWA: aina za mabaraza hazitofautiani\n", 0, 0, 0, 0, 0, 0); makosa = makosa + 1; }
    // zama: 1750 haina jamhuri za rais, chama kimoja wala shirikisho; 1960 ina chama kimoja
    n64 marufuku = 0;
    n64 chama = 0;
    dola_mwaka_wa_zama = 1750;
    n64 m = 0;
    wakati (m < 600) {
        Dola* a1 = dola_unda(m, "Republic of Zama", 9000000);
        Dola* a2 = dola_unda(m, "People's Republic of Zama", 9000000);
        Dola* a3 = dola_unda(m, "Federation of Zama", 9000000);
        n64 c = 0;
        wakati (c < a1->vyama) { kama (itikadi_mwaka(a1->chama_itikadi[c]) > 1750) { marufuku = marufuku + 1; } c = c + 1; }
        kama (a1->aina == DOLA_JAMHURI_YA_RAIS || a1->aina == DOLA_JAMHURI_NUSU_RAIS || a2->aina == DOLA_CHAMA_KIMOJA || a3->aina == DOLA_JAMHURI_YA_SHIRIKISHO) { marufuku = marufuku + 1; }
        m = m + 1;
    }
    dola_mwaka_wa_zama = 1960;
    m = 0;
    wakati (m < 200) { kama (dola_unda(m, "People's Republic of Zama", 9000000)->aina == DOLA_CHAMA_KIMOJA) { chama = chama + 1; } m = m + 1; }
    dola_mwaka_wa_zama = 0;
    kama (marufuku > 0) { andika("SHINDWA: aina za utawala za baadaye mwaka 1750: %d\n", marufuku, 0, 0, 0, 0, 0); makosa = makosa + 1; }
    kama (chama == 0) { andika("SHINDWA: hakuna chama kimoja mwaka 1960\n", 0, 0, 0, 0, 0, 0); makosa = makosa + 1; }
    kama (makosa == 0) { andika("dola: sawa\n", 0, 0, 0, 0, 0, 0); rudisha 0; }
    rudisha 1;
}
