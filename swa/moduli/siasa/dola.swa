husisha { moduli/dunia/asili.swa }
husisha { msingi/maktaba/kumbukumbu.swa }
husisha { msingi/maktaba/mfuatano.swa }
husisha { moduli/onyesho/maneno.swa }

// dola.swa -- muundo wa dola ya kila taifa: aina ya utawala, mabaraza ya
// kutunga sheria (hakuna, moja, mawili, matatu au manne), vyama na itikadi
// zake, na katiba (vyeo, muhula, haki ya kura).
//
// Mataifa hayatawaliwi kwa namna moja. Aina ya utawala hutokana na cheo cha
// dola kwenye ramani ("Kingdom of X", "People's Republic of X", "Tribes of
// X") pamoja na mbegu ya taifa, hivyo taifa lilelile huwa na dola ileile
// kila mara. Ufalme kamili hauna bunge; jamhuri ya bunge ina baraza moja au
// mawili; jumuiya ya waungwana ina matatu; milki ina mabaraza manne ya
// matabaka. Kila baraza lina namna yake ya kukaa (nusu-duara, pande
// zinazotazamana, duara, darasa) na namna yake ya kupata wajumbe.
//
// Hii ni hali ya mwanzo ya dola. Uchaguzi, mapinduzi na mabadiliko ya
// katiba bado hayajaunganishwa na uigaji.

// ---------- aina za utawala ----------
n64 DOLA_JAMHURI_YA_BUNGE = 0;
n64 DOLA_JAMHURI_YA_RAIS = 1;
n64 DOLA_JAMHURI_NUSU_RAIS = 2;
n64 DOLA_JAMHURI_YA_SHIRIKISHO = 3;
n64 DOLA_UFALME_WA_KATIBA = 4;
n64 DOLA_UFALME_KAMILI = 5;
n64 DOLA_UFALME_WA_KUCHAGULIWA = 6;
n64 DOLA_UTAWALA_WA_KIDINI = 7;
n64 DOLA_CHAMA_KIMOJA = 8;
n64 DOLA_UTAWALA_WA_KIJESHI = 9;
n64 DOLA_MUUNGANO_WA_DOLA = 10;
n64 DOLA_MUUNGANO_WA_KABILA = 11;
n64 DOLA_MILKI = 12;
n64 DOLA_UTAWALA_WA_WATAALAMU = 13;
n64 DOLA_JUMUIYA_YA_WAUNGWANA = 14;
n64 DOLA_SERIKALI_YA_MPITO = 15;
n64 DOLA_UDIKTETA = 16;
n64 DOLA_DEMOKRASIA_YA_MOJA_KWA_MOJA = 17;
n64 DOLA_JAMHURI_YA_WAFANYABIASHARA = 18;
n64 DOLA_BILA_SERIKALI = 19;
n64 DOLA_AINA_IDADI = 20;

n8* dola_aina_jina(n64 a) {
    kama (a == DOLA_JAMHURI_YA_RAIS) { rudisha ui("Presidential republic"); }
    kama (a == DOLA_JAMHURI_NUSU_RAIS) { rudisha ui("Semi-presidential republic"); }
    kama (a == DOLA_JAMHURI_YA_SHIRIKISHO) { rudisha ui("Federal republic"); }
    kama (a == DOLA_UFALME_WA_KATIBA) { rudisha ui("Constitutional monarchy"); }
    kama (a == DOLA_UFALME_KAMILI) { rudisha ui("Absolute monarchy"); }
    kama (a == DOLA_UFALME_WA_KUCHAGULIWA) { rudisha ui("Elective monarchy"); }
    kama (a == DOLA_UTAWALA_WA_KIDINI) { rudisha ui("Theocracy"); }
    kama (a == DOLA_CHAMA_KIMOJA) { rudisha ui("One-party state"); }
    kama (a == DOLA_UTAWALA_WA_KIJESHI) { rudisha ui("Military government"); }
    kama (a == DOLA_MUUNGANO_WA_DOLA) { rudisha ui("Confederation"); }
    kama (a == DOLA_MUUNGANO_WA_KABILA) { rudisha ui("Tribal confederation"); }
    kama (a == DOLA_MILKI) { rudisha ui("Empire"); }
    kama (a == DOLA_UTAWALA_WA_WATAALAMU) { rudisha ui("Technocracy"); }
    kama (a == DOLA_JUMUIYA_YA_WAUNGWANA) { rudisha ui("Noble commonwealth"); }
    kama (a == DOLA_SERIKALI_YA_MPITO) { rudisha ui("Provisional government"); }
    kama (a == DOLA_UDIKTETA) { rudisha ui("Dictatorship"); }
    kama (a == DOLA_DEMOKRASIA_YA_MOJA_KWA_MOJA) { rudisha ui("Direct democracy"); }
    kama (a == DOLA_JAMHURI_YA_WAFANYABIASHARA) { rudisha ui("Merchant republic"); }
    kama (a == DOLA_BILA_SERIKALI) { rudisha ui("Stateless commune"); }
    rudisha ui("Parliamentary republic");
}

// ---------- itikadi ----------
n64 ITIKADI_UKOMUNISTI = 0;
n64 ITIKADI_UJAMAA = 1;
n64 ITIKADI_DEMOKRASIA_YA_KIJAMII = 2;
n64 ITIKADI_KIJANI = 3;
n64 ITIKADI_ULIBERALI = 4;
n64 ITIKADI_KATI = 5;
n64 ITIKADI_DEMOKRASIA_YA_KIDINI = 6;
n64 ITIKADI_UHAFIDHINA = 7;
n64 ITIKADI_UTAIFA = 8;
n64 ITIKADI_UFASHISTI = 9;
n64 ITIKADI_UFALME = 10;
n64 ITIKADI_UKLERO = 11;
n64 ITIKADI_WAKULIMA = 12;
n64 ITIKADI_UHURU_BINAFSI = 13;
n64 ITIKADI_UANAKI = 14;
n64 ITIKADI_UTAALAMU = 15;
n64 ITIKADI_UMAARUFU = 16;
n64 ITIKADI_UJESHI = 17;
n64 ITIKADI_UKANDA = 18;
n64 ITIKADI_VYAMA_VYA_WAFANYAKAZI = 19;
n64 ITIKADI_MILA = 20;
n64 ITIKADI_HURU = 21;
n64 ITIKADI_IDADI = 22;

n8* itikadi_jina(n64 i) {
    kama (i == ITIKADI_UKOMUNISTI) { rudisha ui("Communism"); }
    kama (i == ITIKADI_UJAMAA) { rudisha ui("Socialism"); }
    kama (i == ITIKADI_DEMOKRASIA_YA_KIJAMII) { rudisha ui("Social democracy"); }
    kama (i == ITIKADI_KIJANI) { rudisha ui("Green politics"); }
    kama (i == ITIKADI_ULIBERALI) { rudisha ui("Liberalism"); }
    kama (i == ITIKADI_KATI) { rudisha ui("Centrism"); }
    kama (i == ITIKADI_DEMOKRASIA_YA_KIDINI) { rudisha ui("Religious democracy"); }
    kama (i == ITIKADI_UHAFIDHINA) { rudisha ui("Conservatism"); }
    kama (i == ITIKADI_UTAIFA) { rudisha ui("Nationalism"); }
    kama (i == ITIKADI_UFASHISTI) { rudisha ui("Fascism"); }
    kama (i == ITIKADI_UFALME) { rudisha ui("Monarchism"); }
    kama (i == ITIKADI_UKLERO) { rudisha ui("Clericalism"); }
    kama (i == ITIKADI_WAKULIMA) { rudisha ui("Agrarianism"); }
    kama (i == ITIKADI_UHURU_BINAFSI) { rudisha ui("Libertarianism"); }
    kama (i == ITIKADI_UANAKI) { rudisha ui("Anarchism"); }
    kama (i == ITIKADI_UTAALAMU) { rudisha ui("Technocracy"); }
    kama (i == ITIKADI_UMAARUFU) { rudisha ui("Populism"); }
    kama (i == ITIKADI_UJESHI) { rudisha ui("Militarism"); }
    kama (i == ITIKADI_UKANDA) { rudisha ui("Regionalism"); }
    kama (i == ITIKADI_VYAMA_VYA_WAFANYAKAZI) { rudisha ui("Syndicalism"); }
    kama (i == ITIKADI_MILA) { rudisha ui("Traditionalism"); }
    rudisha ui("Independent");
}

// Rangi ya itikadi (0xRRGGBB kwa desimali): kushoto nyekundu, kulia buluu.
n64 itikadi_rangi(n64 i) {
    kama (i == ITIKADI_UKOMUNISTI) { rudisha 12597547; }              // C0392B
    kama (i == ITIKADI_UJAMAA) { rudisha 15158332; }                  // E74C3C
    kama (i == ITIKADI_DEMOKRASIA_YA_KIJAMII) { rudisha 15954266; }   // F3715A
    kama (i == ITIKADI_KIJANI) { rudisha 5025642; }                   // 4CAF6A
    kama (i == ITIKADI_ULIBERALI) { rudisha 15909198; }               // F2C14E
    kama (i == ITIKADI_KATI) { rudisha 12105928; }                    // B8B8C8
    kama (i == ITIKADI_DEMOKRASIA_YA_KIDINI) { rudisha 15768126; }    // F09A3E
    kama (i == ITIKADI_UHAFIDHINA) { rudisha 4029912; }               // 3D7DD8
    kama (i == ITIKADI_UTAIFA) { rudisha 4219582; }                   // 4062BE
    kama (i == ITIKADI_UFASHISTI) { rudisha 8016435; }                // 7A5233
    kama (i == ITIKADI_UFALME) { rudisha 9329616; }                   // 8E5BD0
    kama (i == ITIKADI_UKLERO) { rudisha 3050350; }                   // 2E8B6E
    kama (i == ITIKADI_WAKULIMA) { rudisha 9286229; }                 // 8DB255
    kama (i == ITIKADI_UHURU_BINAFSI) { rudisha 14932298; }           // E3D94A
    kama (i == ITIKADI_UANAKI) { rudisha 7895170; }                   // 787882
    kama (i == ITIKADI_UTAALAMU) { rudisha 3523265; }                 // 35C2C1
    kama (i == ITIKADI_UMAARUFU) { rudisha 13920934; }                // D46AA6
    kama (i == ITIKADI_UJESHI) { rudisha 7895887; }                   // 787B4F
    kama (i == ITIKADI_UKANDA) { rudisha 12750684; }                  // C28F5C
    kama (i == ITIKADI_VYAMA_VYA_WAFANYAKAZI) { rudisha 11874367; }   // B5303F
