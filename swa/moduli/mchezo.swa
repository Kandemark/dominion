// ---------- kodi (KodiMfumo) ----------
w0 mchezo_hifadhi_andika_kodi_sera(n8* f, KodiSera* s) {
    injini_uhifadhi_andika_n32(f, s->aina);
    injini_uhifadhi_andika_n32(f, s->inafanya_kazi);
    injini_uhifadhi_andika_d64(f, s->kiwango_gorofa);
    injini_uhifadhi_andika_d64(f, s->ufanisi_wa_ukusanyaji);
    injini_uhifadhi_andika_d64(f, s->kiwango_cha_ukwepaji);
}
w0 mchezo_hifadhi_soma_kodi_sera(n8* f, KodiSera* s) {
    s->aina = injini_uhifadhi_soma_n32(f);
    s->inafanya_kazi = injini_uhifadhi_soma_n32(f);
    s->kiwango_gorofa = injini_uhifadhi_soma_d64(f);
    s->ufanisi_wa_ukusanyaji = injini_uhifadhi_soma_d64(f);
    s->kiwango_cha_ukwepaji = injini_uhifadhi_soma_d64(f);
}
w0 mchezo_hifadhi_andika_kodi(n8* f, KodiMfumo* m) {
    kama (m == 0) { rudisha; }
    mchezo_hifadhi_andika_kodi_sera(f, &m->s_0);
    mchezo_hifadhi_andika_kodi_sera(f, &m->s_1);
    mchezo_hifadhi_andika_kodi_sera(f, &m->s_2);
    mchezo_hifadhi_andika_kodi_sera(f, &m->s_3);
    mchezo_hifadhi_andika_kodi_sera(f, &m->s_4);
    mchezo_hifadhi_andika_kodi_sera(f, &m->s_5);
    mchezo_hifadhi_andika_kodi_sera(f, &m->s_6);
    injini_uhifadhi_andika_d64(f, m->kizingiti_0); injini_uhifadhi_andika_d64(f, m->kiwango_0);
    injini_uhifadhi_andika_d64(f, m->kizingiti_1); injini_uhifadhi_andika_d64(f, m->kiwango_1);
    injini_uhifadhi_andika_d64(f, m->kizingiti_2); injini_uhifadhi_andika_d64(f, m->kiwango_2);
    injini_uhifadhi_andika_d64(f, m->kizingiti_3); injini_uhifadhi_andika_d64(f, m->kiwango_3);
    injini_uhifadhi_andika_d64(f, m->kizingiti_4); injini_uhifadhi_andika_d64(f, m->kiwango_4);
    injini_uhifadhi_andika_d64(f, m->kizingiti_5); injini_uhifadhi_andika_d64(f, m->kiwango_5);
    injini_uhifadhi_andika_n32(f, m->idadi_ya_vizingiti);
    injini_uhifadhi_andika_d64(f, m->mapato_jumla);
    injini_uhifadhi_andika_d64(f, m->mapato_yanayotarajiwa);
    injini_uhifadhi_andika_d64(f, m->kiashiria_cha_mzigo_wa_kodi);
    injini_uhifadhi_andika_d64(f, m->mgawanyo_wa_gini);
}
w0 mchezo_hifadhi_soma_kodi(n8* f, KodiMfumo* m) {
    kama (m == 0) { rudisha; }
    mchezo_hifadhi_soma_kodi_sera(f, &m->s_0);
    mchezo_hifadhi_soma_kodi_sera(f, &m->s_1);
    mchezo_hifadhi_soma_kodi_sera(f, &m->s_2);
    mchezo_hifadhi_soma_kodi_sera(f, &m->s_3);
    mchezo_hifadhi_soma_kodi_sera(f, &m->s_4);
    mchezo_hifadhi_soma_kodi_sera(f, &m->s_5);
    mchezo_hifadhi_soma_kodi_sera(f, &m->s_6);
    m->kizingiti_0 = injini_uhifadhi_soma_d64(f); m->kiwango_0 = injini_uhifadhi_soma_d64(f);
    m->kizingiti_1 = injini_uhifadhi_soma_d64(f); m->kiwango_1 = injini_uhifadhi_soma_d64(f);
