// ---------- mipaka_hai (DuniaMipakaHai) ----------
w0 mchezo_hifadhi_andika_mpaka_kipande(n8* f, DuniaMpakaKipande* k) {
    injini_uhifadhi_andika_mfuatano(f, k->eneo_a);
    injini_uhifadhi_andika_mfuatano(f, k->eneo_b);
    injini_uhifadhi_andika_d64(f, k->mwanzo_x);
    injini_uhifadhi_andika_d64(f, k->mwanzo_y);
    injini_uhifadhi_andika_d64(f, k->mwisho_x);
    injini_uhifadhi_andika_d64(f, k->mwisho_y);
    injini_uhifadhi_andika_n32(f, k->aina);
    injini_uhifadhi_andika_d64(f, k->kiwango_cha_uimarishaji);
    injini_uhifadhi_andika_d64(f, k->kiwango_cha_mvutano);
}
w0 mchezo_hifadhi_andika_mipaka_hai(n8* f, DuniaMipakaHai* db) {
    kama (db == 0) { rudisha; }
    injini_uhifadhi_andika_n32(f, db->idadi);
    n32 i = 0;
    wakati (i < db->idadi) {
        DuniaMpakaKipande* k = db->vipande[i];
        mchezo_hifadhi_andika_mpaka_kipande(f, k);
        i = i + 1;
    }
}
w0 mchezo_hifadhi_soma_mipaka_hai(n8* f, DuniaMipakaHai* db) {
    kama (db == 0) { rudisha; }
    n32 idadi_iliyohifadhiwa = injini_uhifadhi_soma_n32(f);
    db->idadi = 0;
    n32 i = 0;
    wakati (i < idadi_iliyohifadhiwa) {
        DuniaMpakaHoja hoja;
        hoja.eneo_a = injini_uhifadhi_soma_mfuatano(f);
        hoja.eneo_b = injini_uhifadhi_soma_mfuatano(f);
        hoja.mwanzo_x = injini_uhifadhi_soma_d64(f);
        hoja.mwanzo_y = injini_uhifadhi_soma_d64(f);
        hoja.mwisho_x = injini_uhifadhi_soma_d64(f);
        hoja.mwisho_y = injini_uhifadhi_soma_d64(f);
        hoja.aina = injini_uhifadhi_soma_n32(f);
        d64 uimarishaji_v = injini_uhifadhi_soma_d64(f);
        d64 mvutano_v = injini_uhifadhi_soma_d64(f);
        dunia_mpaka_hai_unda_kipande(db, &hoja);
        DuniaMpakaKipande* k = dunia_mpaka_hai_pata_kipande(db, i);
        kama (k != 0) {
            k->kiwango_cha_uimarishaji = uimarishaji_v;
            k->kiwango_cha_mvutano = mvutano_v;
        }
        i = i + 1;
    }
}

// ---------- majanga (MazingiraMajangaMfumo) ----------
// majanga_yanayofanya_kazi ni ya MUDA MFUPI (majanga yanayoendelea
// SASA, yanayotoweka ndani ya mizunguko michache -- angalia
// MazingiraJangaTukio.muda_uliopita/muda_wa_kudumu) -- si historia ya
// kudumu kama matukio ya historia_db. Metadata tu.
w0 mchezo_hifadhi_andika_majanga(n8* f, MazingiraMajangaMfumo* mj) {
    kama (mj == 0) { rudisha; }
    injini_uhifadhi_andika_n32(f, mj->idadi_ya_majanga);
}
w0 mchezo_hifadhi_soma_majanga(n8* f, MazingiraMajangaMfumo* mj) {
    n32 idadi_v = injini_uhifadhi_soma_n32(f);
    kama (mj == 0) { rudisha; }
    kama (idadi_v < 0) { rudisha; }
}

// ---------- eneo (DuniaEneoMsimamizi) ----------
