    injini_uhifadhi_andika_d64(f, a->utata);
    injini_uhifadhi_andika_d64(f, a->ufanisi);
    injini_uhifadhi_andika_mfuatano(f, a->konsonanti);
    injini_uhifadhi_andika_mfuatano(f, a->vokali);
    injini_uhifadhi_andika_n32(f, a->idadi_ya_konsonanti);
    injini_uhifadhi_andika_n32(f, a->idadi_ya_vokali);
    injini_uhifadhi_andika_n64(f, a->muda_wa_kuundwa);
}
w0 mchezo_hifadhi_soma_andiko(n8* f, UtamaduniAndiko* a) {
    a->kitambulisho = injini_uhifadhi_soma_mfuatano(f);
    a->jina = injini_uhifadhi_soma_mfuatano(f);
