// ---------- jamii (JamiiMsimamizi) ----------
// Nafasi 16 (jamii_0..15) hazibadiliki kiukubwa, lakini mchezo_anzisha
// ya sasa hujaza MOJA TU (jamii_0, kupitia jamii_ibuka) -- angalia
// maelezo kamili ya uamuzi huu juu ya faili (sehemu ya historia ya
// utekelezaji wa kazi hii): kuandika nafasi zote 16 (kila moja ikiwa
// na JamiiSifaYaDNA 8, kila moja ikiwa na baiti 16 za jina) bila
// sababu ya kiutendaji kungeongeza maelfu ya maandishi tupu ya
// shamba kwa nafasi 15 zisizotumika. Tunahifadhi idadi_ya_jamii TU +
// jamii_0 KAMILI (nafasi pekee inayotumika kwa sasa) -- ikiwa
// jamii_ibuka itaitwa tena baadaye (jamii ya pili), nafasi za 1..
// zitahitaji kuongezwa hapa KWA UFUATAJI (si kosa la kushindwa
// kugundua, ni uamuzi wa wigo ulioandikwa wazi).
w0 mchezo_hifadhi_andika_dna(n8* f, JamiiSifaYaDNA* d) {
    injini_uhifadhi_andika_n8(f, d->jina_0); injini_uhifadhi_andika_n8(f, d->jina_1);
    injini_uhifadhi_andika_n8(f, d->jina_2); injini_uhifadhi_andika_n8(f, d->jina_3);
    injini_uhifadhi_andika_n8(f, d->jina_4); injini_uhifadhi_andika_n8(f, d->jina_5);
    injini_uhifadhi_andika_n8(f, d->jina_6); injini_uhifadhi_andika_n8(f, d->jina_7);
    injini_uhifadhi_andika_n8(f, d->jina_8); injini_uhifadhi_andika_n8(f, d->jina_9);
    injini_uhifadhi_andika_n8(f, d->jina_10); injini_uhifadhi_andika_n8(f, d->jina_11);
    injini_uhifadhi_andika_n8(f, d->jina_12); injini_uhifadhi_andika_n8(f, d->jina_13);
    injini_uhifadhi_andika_n8(f, d->jina_14); injini_uhifadhi_andika_n8(f, d->jina_15);
    injini_uhifadhi_andika_d64(f, d->kiwango_cha_kujitokeza);
    injini_uhifadhi_andika_n32(f, d->kubwa_zaidi);
}
w0 mchezo_hifadhi_soma_dna(n8* f, JamiiSifaYaDNA* d) {
    d->jina_0 = injini_uhifadhi_soma_n8(f); d->jina_1 = injini_uhifadhi_soma_n8(f);
    d->jina_2 = injini_uhifadhi_soma_n8(f); d->jina_3 = injini_uhifadhi_soma_n8(f);
    d->jina_4 = injini_uhifadhi_soma_n8(f); d->jina_5 = injini_uhifadhi_soma_n8(f);
    d->jina_6 = injini_uhifadhi_soma_n8(f); d->jina_7 = injini_uhifadhi_soma_n8(f);
    d->jina_8 = injini_uhifadhi_soma_n8(f); d->jina_9 = injini_uhifadhi_soma_n8(f);
    d->jina_10 = injini_uhifadhi_soma_n8(f); d->jina_11 = injini_uhifadhi_soma_n8(f);
    d->jina_12 = injini_uhifadhi_soma_n8(f); d->jina_13 = injini_uhifadhi_soma_n8(f);
    d->jina_14 = injini_uhifadhi_soma_n8(f); d->jina_15 = injini_uhifadhi_soma_n8(f);
    d->kiwango_cha_kujitokeza = injini_uhifadhi_soma_d64(f);
    d->kubwa_zaidi = injini_uhifadhi_soma_n32(f);
}
w0 mchezo_hifadhi_andika_jamii_moja(n8* f, Jamii* j) {
    injini_uhifadhi_andika_mfuatano(f, j->kitambulisho);
    injini_uhifadhi_andika_mfuatano(f, j->jina);
    injini_uhifadhi_andika_mfuatano(f, j->eneo_asilia_id);
    mchezo_hifadhi_andika_dna(f, &j->sifa_0);
    mchezo_hifadhi_andika_dna(f, &j->sifa_1);
    mchezo_hifadhi_andika_dna(f, &j->sifa_2);
    mchezo_hifadhi_andika_dna(f, &j->sifa_3);
    mchezo_hifadhi_andika_dna(f, &j->sifa_4);
    mchezo_hifadhi_andika_dna(f, &j->sifa_5);
    mchezo_hifadhi_andika_dna(f, &j->sifa_6);
    mchezo_hifadhi_andika_dna(f, &j->sifa_7);
    injini_uhifadhi_andika_n32(f, j->idadi_ya_sifa);
    injini_uhifadhi_andika_d64(f, j->uthabiti_wa_kijenetiki);
    injini_uhifadhi_andika_n64(f, j->wakati_wa_kuibuka);
}
w0 mchezo_hifadhi_soma_jamii_moja(n8* f, Jamii* j) {
    j->kitambulisho = injini_uhifadhi_soma_mfuatano(f);
    j->jina = injini_uhifadhi_soma_mfuatano(f);
    j->eneo_asilia_id = injini_uhifadhi_soma_mfuatano(f);
    mchezo_hifadhi_soma_dna(f, &j->sifa_0);
    mchezo_hifadhi_soma_dna(f, &j->sifa_1);
    mchezo_hifadhi_soma_dna(f, &j->sifa_2);
    mchezo_hifadhi_soma_dna(f, &j->sifa_3);
    mchezo_hifadhi_soma_dna(f, &j->sifa_4);
