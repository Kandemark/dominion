// kwenye maelezo ya wigo juu ya faili. Metadata tu.
w0 mchezo_hifadhi_andika_eneo(n8* f, DuniaEneoMsimamizi* e) {
    kama (e == 0) { rudisha; }
    injini_uhifadhi_andika_n32(f, e->idadi);
}
w0 mchezo_hifadhi_soma_eneo(n8* f, DuniaEneoMsimamizi* e) {
    n32 idadi_v = injini_uhifadhi_soma_n32(f);
    kama (e == 0) { rudisha; }
    kama (idadi_v < 0) { rudisha; }
}

