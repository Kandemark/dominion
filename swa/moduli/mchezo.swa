    a->ufanisi = injini_uhifadhi_soma_d64(f);
    a->konsonanti = injini_uhifadhi_soma_mfuatano(f);
    a->vokali = injini_uhifadhi_soma_mfuatano(f);
    a->idadi_ya_konsonanti = injini_uhifadhi_soma_n32(f);
    a->idadi_ya_vokali = injini_uhifadhi_soma_n32(f);
    a->muda_wa_kuundwa = injini_uhifadhi_soma_n64(f);
}
w0 mchezo_hifadhi_andika_uandishi(n8* f, UtamaduniAndikoMsimamizi* m) {
    kama (m == 0) { rudisha; }
    injini_uhifadhi_andika_n32(f, m->idadi);
    n32 i = 0;
    wakati (i < m->idadi) {
        UtamaduniAndiko* a = m->maandiko[i];
        mchezo_hifadhi_andika_andiko(f, a);
        i = i + 1;
    }
}
w0 mchezo_hifadhi_soma_uandishi(n8* f, UtamaduniAndikoMsimamizi* m) {
    kama (m == 0) { rudisha; }
    n32 idadi_iliyohifadhiwa = injini_uhifadhi_soma_n32(f);
    m->idadi = 0;
    n32 i = 0;
    wakati (i < idadi_iliyohifadhiwa) {
        n8* id_tupu = "";
        n8* jina_tupu = "";
        UtamaduniAndiko* a = uandishi_unda(id_tupu, jina_tupu, 0);
        mchezo_hifadhi_soma_andiko(f, a);
        uandishi_msimamizi_ongeza(m, a);
        i = i + 1;
    }
}

// ---------- soko_fedha (SokoFedhaInjini) ----------
// makampuni (safu ya anwani za SokoFedhaKampuni*) HAYAHIFADHIWI
// kimakusudi kwa toleo hili (hayajazwi na soko_fedha_sasisha_uzalishaji
// ya sasa -- angalia maelezo ya mchezo_sasisha_mifumo_huru). sarafu
// (SokoFedhaSarafu*) NDIYO hasa inayosasishwa kwa kila mzunguko
// (angalia jaribio_mchezo_kamili.swa -- USD kiwango_cha_sasa
// kinabadilika) -- imehifadhiwa KIKAMILIFU.
w0 mchezo_hifadhi_andika_soko_sarafu(n8* f, SokoFedhaSarafu* s) {
    injini_uhifadhi_andika_mfuatano(f, s->iso);
    injini_uhifadhi_andika_mfuatano(f, s->jina);
    injini_uhifadhi_andika_mfuatano(f, s->alama);
    injini_uhifadhi_andika_d64(f, s->kiwango_cha_msingi);
    injini_uhifadhi_andika_d64(f, s->kiwango_cha_sasa);
    injini_uhifadhi_andika_d64(f, s->mzunguko);
    injini_uhifadhi_andika_n32(f, s->idadi_ya_mataifa);
    injini_uhifadhi_andika_d64(f, s->mfumuko);
}
w0 mchezo_hifadhi_soma_soko_sarafu(n8* f, SokoFedhaSarafu* s) {
    s->iso = injini_uhifadhi_soma_mfuatano(f);
    s->jina = injini_uhifadhi_soma_mfuatano(f);
    s->alama = injini_uhifadhi_soma_mfuatano(f);
    s->kiwango_cha_msingi = injini_uhifadhi_soma_d64(f);
    s->kiwango_cha_sasa = injini_uhifadhi_soma_d64(f);
    s->mzunguko = injini_uhifadhi_soma_d64(f);
    s->idadi_ya_mataifa = injini_uhifadhi_soma_n32(f);
    s->mfumuko = injini_uhifadhi_soma_d64(f);
}
w0 mchezo_hifadhi_andika_soko_bidhaa(n8* f, SokoFedhaBidhaa* b) {
    injini_uhifadhi_andika_mfuatano(f, b->jina);
    injini_uhifadhi_andika_mfuatano(f, b->kipimo);
    injini_uhifadhi_andika_d64(f, b->bei_kwa_kipimo);
    injini_uhifadhi_andika_d64(f, b->mzunguko);
    injini_uhifadhi_andika_d64(f, b->ugavi);
    injini_uhifadhi_andika_d64(f, b->mahitaji);
}
w0 mchezo_hifadhi_soma_soko_bidhaa(n8* f, SokoFedhaBidhaa* b) {
    b->jina = injini_uhifadhi_soma_mfuatano(f);
    b->kipimo = injini_uhifadhi_soma_mfuatano(f);
    b->bei_kwa_kipimo = injini_uhifadhi_soma_d64(f);
    b->mzunguko = injini_uhifadhi_soma_d64(f);
    b->ugavi = injini_uhifadhi_soma_d64(f);
    b->mahitaji = injini_uhifadhi_soma_d64(f);
}
w0 mchezo_hifadhi_andika_soko_fedha(n8* f, SokoFedhaInjini* m) {
    kama (m == 0) { rudisha; }
    injini_uhifadhi_andika_n32(f, m->idadi_ya_sarafu);
    n32 i = 0;
    wakati (i < m->idadi_ya_sarafu) {
        SokoFedhaSarafu* s = m->sarafu[i];
        mchezo_hifadhi_andika_soko_sarafu(f, s);
        i = i + 1;
    }
    mchezo_hifadhi_andika_soko_bidhaa(f, &m->bidhaa_0);
    mchezo_hifadhi_andika_soko_bidhaa(f, &m->bidhaa_1);
    mchezo_hifadhi_andika_soko_bidhaa(f, &m->bidhaa_2);
    mchezo_hifadhi_andika_soko_bidhaa(f, &m->bidhaa_3);
    mchezo_hifadhi_andika_soko_bidhaa(f, &m->bidhaa_4);
    mchezo_hifadhi_andika_soko_bidhaa(f, &m->bidhaa_5);
    mchezo_hifadhi_andika_soko_bidhaa(f, &m->bidhaa_6);
    mchezo_hifadhi_andika_soko_bidhaa(f, &m->bidhaa_7);
    mchezo_hifadhi_andika_soko_bidhaa(f, &m->bidhaa_8);
    mchezo_hifadhi_andika_soko_bidhaa(f, &m->bidhaa_9);
    mchezo_hifadhi_andika_soko_bidhaa(f, &m->bidhaa_10);
    mchezo_hifadhi_andika_soko_bidhaa(f, &m->bidhaa_11);
    injini_uhifadhi_andika_n32(f, m->idadi_ya_bidhaa);
    injini_uhifadhi_andika_n32(f, m->idadi_ya_makampuni);
}
w0 mchezo_hifadhi_soma_soko_fedha(n8* f, SokoFedhaInjini* m) {
    kama (m == 0) { rudisha; }
    n32 idadi_sarafu_iliyohifadhiwa = injini_uhifadhi_soma_n32(f);
    // SokoFedhaSarafu zote zinaundwa na soko_fedha_injini_unda wakati
    // wa mchezo_anzisha (hazina "ongeza" ya nje -- angalia maelezo ya
    // soko_fedha.swa) -- tunasoma HIFADHI YA SASA kwenye nafasi
    // ZILIZOPO TAYARI badala ya kujenga mpya, kwa sababu idadi
    // haibadiliki kati ya kuhifadhi na kupakia (sarafu sawa kila
    // wakati -- angalia soko_fedha_injini_unda).
    n32 i = 0;
    wakati (i < idadi_sarafu_iliyohifadhiwa && i < m->idadi_ya_sarafu) {
        SokoFedhaSarafu* s = m->sarafu[i];
        mchezo_hifadhi_soma_soko_sarafu(f, s);
        i = i + 1;
    }
    mchezo_hifadhi_soma_soko_bidhaa(f, &m->bidhaa_0);
    mchezo_hifadhi_soma_soko_bidhaa(f, &m->bidhaa_1);
    mchezo_hifadhi_soma_soko_bidhaa(f, &m->bidhaa_2);
    mchezo_hifadhi_soma_soko_bidhaa(f, &m->bidhaa_3);
    mchezo_hifadhi_soma_soko_bidhaa(f, &m->bidhaa_4);
    mchezo_hifadhi_soma_soko_bidhaa(f, &m->bidhaa_5);
    mchezo_hifadhi_soma_soko_bidhaa(f, &m->bidhaa_6);
    mchezo_hifadhi_soma_soko_bidhaa(f, &m->bidhaa_7);
    mchezo_hifadhi_soma_soko_bidhaa(f, &m->bidhaa_8);
    mchezo_hifadhi_soma_soko_bidhaa(f, &m->bidhaa_9);
    mchezo_hifadhi_soma_soko_bidhaa(f, &m->bidhaa_10);
    mchezo_hifadhi_soma_soko_bidhaa(f, &m->bidhaa_11);
    m->idadi_ya_bidhaa = injini_uhifadhi_soma_n32(f);
    m->idadi_ya_makampuni = injini_uhifadhi_soma_n32(f);
}

// ---------- mageuko_lugha (UtamaduniMageukoMfumo) ----------
// msamiati/mikopo (safu NESTED za kila lugha) HAZIHIFADHIWI
// kimakusudi -- angalia (d) juu ya faili.
w0 mchezo_hifadhi_andika_lugha(n8* f, UtamaduniMageukoLugha* l) {
    injini_uhifadhi_andika_mfuatano(f, l->kitambulisho);
    injini_uhifadhi_andika_mfuatano(f, l->jina);
    injini_uhifadhi_andika_mfuatano(f, l->mzazi_id);
    injini_uhifadhi_andika_mfuatano(f, l->mfumo_uandishi_id);
    injini_uhifadhi_andika_mfuatano(f, l->fonolojia.konsonanti);
    injini_uhifadhi_andika_mfuatano(f, l->fonolojia.vokali);
    injini_uhifadhi_andika_d64(f, l->fonolojia.uwiano_wa_pua);
    injini_uhifadhi_andika_d64(f, l->fonolojia.uwiano_wa_kuzomea);
    injini_uhifadhi_andika_n32(f, l->sarufi.mofolojia);
    injini_uhifadhi_andika_n32(f, l->sarufi.mpangilio_wa_maneno);
    injini_uhifadhi_andika_n32(f, l->sarufi.ina_jinsia);
    injini_uhifadhi_andika_n32(f, l->sarufi.ina_hali);
    injini_uhifadhi_andika_n32(f, l->sarufi.idadi_ya_hali);
    injini_uhifadhi_andika_d64(f, l->utata);
    injini_uhifadhi_andika_d64(f, l->fahari);
    injini_uhifadhi_andika_d64(f, l->wazungumzaji);
}
w0 mchezo_hifadhi_soma_lugha(n8* f, UtamaduniMageukoLugha* l) {
    l->kitambulisho = injini_uhifadhi_soma_mfuatano(f);
    l->jina = injini_uhifadhi_soma_mfuatano(f);
    l->mzazi_id = injini_uhifadhi_soma_mfuatano(f);
    l->mfumo_uandishi_id = injini_uhifadhi_soma_mfuatano(f);
    l->fonolojia.konsonanti = injini_uhifadhi_soma_mfuatano(f);
    l->fonolojia.vokali = injini_uhifadhi_soma_mfuatano(f);
    l->fonolojia.uwiano_wa_pua = injini_uhifadhi_soma_d64(f);
    l->fonolojia.uwiano_wa_kuzomea = injini_uhifadhi_soma_d64(f);
    l->sarufi.mofolojia = injini_uhifadhi_soma_n32(f);
    l->sarufi.mpangilio_wa_maneno = injini_uhifadhi_soma_n32(f);
    l->sarufi.ina_jinsia = injini_uhifadhi_soma_n32(f);
    l->sarufi.ina_hali = injini_uhifadhi_soma_n32(f);
    l->sarufi.idadi_ya_hali = injini_uhifadhi_soma_n32(f);
    l->utata = injini_uhifadhi_soma_d64(f);
    l->fahari = injini_uhifadhi_soma_d64(f);
    l->wazungumzaji = injini_uhifadhi_soma_d64(f);
}
w0 mchezo_hifadhi_andika_mageuko_lugha(n8* f, UtamaduniMageukoMfumo* m) {
    kama (m == 0) { rudisha; }
    injini_uhifadhi_andika_n32(f, m->idadi);
    injini_uhifadhi_andika_d64(f, m->kiwango_cha_mageuko);
    injini_uhifadhi_andika_d64(f, m->kizingiti_cha_mgawanyiko);
    n32 i = 0;
    wakati (i < m->idadi) {
        UtamaduniMageukoLugha* l = utamaduni_mageuko_mfumo_pata(m, i);
        mchezo_hifadhi_andika_lugha(f, l);
        i = i + 1;
    }
}
w0 mchezo_hifadhi_soma_mageuko_lugha(n8* f, UtamaduniMageukoMfumo* m) {
    kama (m == 0) { rudisha; }
    n32 idadi_iliyohifadhiwa = injini_uhifadhi_soma_n32(f);
    m->kiwango_cha_mageuko = injini_uhifadhi_soma_d64(f);
    m->kizingiti_cha_mgawanyiko = injini_uhifadhi_soma_d64(f);
    m->idadi = 0;
    n32 i = 0;
    wakati (i < idadi_iliyohifadhiwa) {
        n8* id_tupu = "";
        n8* jina_tupu = "";
        n8* mzazi_tupu = 0;
        UtamaduniMageukoLugha* l = utamaduni_mageuko_unda(id_tupu, jina_tupu, mzazi_tupu);
        mchezo_hifadhi_soma_lugha(f, l);
        utamaduni_mageuko_mfumo_ongeza(m, l);
        i = i + 1;
    }
}

// ---------- siasa (SiasaMfumo) ----------
w0 mchezo_hifadhi_andika_siasa(n8* f, SiasaMfumo* m) {
    kama (m == 0) { rudisha; }
    injini_uhifadhi_andika_d64(f, m->uhalali);
    injini_uhifadhi_andika_d64(f, m->utulivu);
}
w0 mchezo_hifadhi_soma_siasa(n8* f, SiasaMfumo* m) {
    kama (m == 0) { rudisha; }
    m->uhalali = injini_uhifadhi_soma_d64(f);
    m->utulivu = injini_uhifadhi_soma_d64(f);
}

// ---------- Viendeshi vya juu: mchezo_hifadhi / mchezo_pakia ----------

// Huhifadhi hali KAMILI ya g kwenye jina_la_faili (ndani ya saraka ya
// injini_uhifadhi ya g, mfano "saves/jina_la_faili"). Mifumo YOTE 47
// (angalia maelezo ya wigo juu ya faili kwa ubaguzi ulioandikwa wazi)
// huandikwa kwa mpangilio UDUMUFU mmoja.
CivMatokeo mchezo_hifadhi(Mchezo* g, n8* jina_la_faili) {
    CivMatokeo r;
    r.hitilafu = CIV_SAWA;
    r.ujumbe = 0;
    kama (g == 0 || jina_la_faili == 0) {
        r.hitilafu = CIV_HITILAFU_KIELEKEZI_TUPU;
        r.ujumbe = "Mchezo au jina la faili ni tupu";
        rudisha r;
    }
    InjiniUhifadhi* sp = mchezo_pata_uhifadhi(g);
    kama (sp == 0) {
        r.hitilafu = CIV_HITILAFU_HALI_MBAYA;
        r.ujumbe = "Injini ya uhifadhi haijaanzishwa";
        rudisha r;
    }
    n8* njia = injini_uhifadhi_njia_kamili(sp, jina_la_faili);
    n8* f = faili_fungua(njia, "w");
    kama (f == 0) {
        r.hitilafu = CIV_HITILAFU_IO;
        r.ujumbe = "Imeshindwa kufungua faili kwa kuandika";
        rudisha r;
    }

    injini_uhifadhi_andika_n32(f, MCHEZO_HIFADHI_ALAMA);
    injini_uhifadhi_andika_n32(f, MCHEZO_HIFADHI_TOLEO);
    injini_uhifadhi_andika_n32(f, g->hali_ya_mchezo);
    injini_uhifadhi_andika_n32(f, g->zamu_ya_sasa);
    injini_uhifadhi_andika_n32(f, g->inafanya_kazi);
    injini_uhifadhi_andika_n32(f, g->imesimamishwa);
    mchezo_hifadhi_andika_usanidi(f, &g->usanidi);
    mchezo_hifadhi_andika_muda(f, mchezo_pata_muda(g));
    mchezo_hifadhi_andika_saa_kuu(f, mchezo_pata_saa_kuu(g));
    mchezo_hifadhi_andika_idadi_ya_watu(f, mchezo_pata_idadi_ya_watu(g));
    mchezo_hifadhi_andika_serikali(f, mchezo_pata_serikali(g));
    mchezo_hifadhi_andika_ramani(f, mchezo_pata_ramani(g));
    mchezo_hifadhi_andika_makazi(f, mchezo_pata_makazi(g));
    mchezo_hifadhi_andika_akili(f, mchezo_pata_akili(g));
    mchezo_hifadhi_andika_diplomasia(f, mchezo_pata_diplomasia(g));
    mchezo_hifadhi_andika_taifa(f, mchezo_pata_taifa(g));
    mchezo_hifadhi_andika_uchumi_mkuu(f, mchezo_pata_uchumi_mkuu(g));
    mchezo_hifadhi_andika_nguvukazi(f, mchezo_pata_nguvukazi(g));
    mchezo_hifadhi_andika_sera(f, mchezo_pata_sera(g));
    mchezo_hifadhi_andika_kodi(f, mchezo_pata_kodi(g));
    mchezo_hifadhi_andika_bajeti(f, mchezo_pata_bajeti(g));
    mchezo_hifadhi_andika_bidhaa(f, mchezo_pata_bidhaa(g));
    mchezo_hifadhi_andika_benki(f, mchezo_pata_benki(g));
    mchezo_hifadhi_andika_kilimo(f, mchezo_pata_kilimo(g));
    mchezo_hifadhi_andika_uchimbaji(f, mchezo_pata_uchimbaji(g));
    mchezo_hifadhi_andika_miundombinu(f, mchezo_pata_miundombinu(g));
    mchezo_hifadhi_andika_viwanda(f, mchezo_pata_viwanda(g));
    mchezo_hifadhi_andika_nishati(f, mchezo_pata_nishati(g));
    mchezo_hifadhi_andika_uchumi_makazi(f, mchezo_pata_uchumi_makazi(g));
    mchezo_hifadhi_andika_ardhi(f, mchezo_pata_ardhi(g));
    mchezo_hifadhi_andika_mtaji(f, mchezo_pata_mtaji(g));
    mchezo_hifadhi_andika_biashara_ndani(f, mchezo_pata_biashara_ndani(g));
    mchezo_hifadhi_andika_biashara_nje(f, mchezo_pata_biashara_nje(g));
    mchezo_hifadhi_andika_uvumbuzi(f, mchezo_pata_uvumbuzi(g));
    mchezo_hifadhi_andika_soko_haramu(f, mchezo_pata_soko_haramu(g));
    mchezo_hifadhi_andika_vita(f, mchezo_pata_vita(g));
    mchezo_hifadhi_andika_utamaduni_metadata(f, g);
    mchezo_hifadhi_andika_matukio(f, mchezo_pata_matukio(g));
    mchezo_hifadhi_andika_wakala(f, mchezo_pata_wakala(g));
    mchezo_hifadhi_andika_okestra_utendaji(f, mchezo_pata_okestra(g), mchezo_pata_utendaji(g));
    mchezo_hifadhi_andika_jeshi_metadata(f, g);
    mchezo_hifadhi_andika_kikundi(f, mchezo_pata_kikundi(g));
    mchezo_hifadhi_andika_teknolojia(f, mchezo_pata_teknolojia(g));
    mchezo_hifadhi_andika_maarifa(f, mchezo_pata_maarifa(g));
    mchezo_hifadhi_andika_mipaka_hai(f, mchezo_pata_mipaka_hai(g));
    mchezo_hifadhi_andika_majanga(f, mchezo_pata_majanga(g));
    mchezo_hifadhi_andika_eneo(f, mchezo_pata_eneo(g));
    mchezo_hifadhi_andika_uhai(f, mchezo_pata_uhai(g));
    mchezo_hifadhi_andika_sarafu(f, mchezo_pata_sarafu(g));
    mchezo_hifadhi_andika_maajabu(f, mchezo_pata_maajabu(g));
    mchezo_hifadhi_andika_jamii(f, mchezo_pata_jamii(g));
    mchezo_hifadhi_andika_desturi(f, mchezo_pata_desturi(g));
    mchezo_hifadhi_andika_mwingiliano(f, mchezo_pata_mwingiliano(g));
    mchezo_hifadhi_andika_mhusika(f, mchezo_pata_mhusika(g));
    mchezo_hifadhi_andika_upinzani(f, mchezo_pata_upinzani(g));
    mchezo_hifadhi_andika_mashirika(f, mchezo_pata_mashirika(g));
    mchezo_hifadhi_andika_vipimo_laini(f, mchezo_pata_vipimo_laini(g));
    mchezo_hifadhi_andika_kitengo_chini(f, mchezo_pata_kitengo_chini(g));
    mchezo_hifadhi_andika_uandishi(f, mchezo_pata_uandishi(g));
    mchezo_hifadhi_andika_soko_fedha(f, mchezo_pata_soko_fedha(g));
    mchezo_hifadhi_andika_mageuko_lugha(f, mchezo_pata_mageuko_lugha(g));
    mchezo_hifadhi_andika_siasa(f, mchezo_pata_siasa(g));

    faili_funga(f);

    // historia_db ina uhifadhi wake KAMILI uliopo tayari (historia_db.swa,
    // umbizo lake la pekee lenye alama/toleo yake) -- tunauita moja kwa
    // moja (faili TOFAUTI, njia_ya_db yake yenyewe) badala ya
    // kuuandika upya hapa.
    HistoriaDB* jarida = mchezo_pata_historia_db(g);
    kama (jarida != 0) {
        historia_db_safisha(jarida);
    }

    rudisha r;
}

// Hupakia hali kutoka jina_la_faili kuiweka moja kwa moja kwenye g
// (ambayo LAZIMA iwe tayari imepita mchezo_anzisha -- mifumo yote
// midogo lazima iwepo tayari ili shamba zake ziweze kuandikwa).
CivMatokeo mchezo_pakia(Mchezo* g, n8* jina_la_faili) {
    CivMatokeo r;
    r.hitilafu = CIV_SAWA;
    r.ujumbe = 0;
    kama (g == 0 || jina_la_faili == 0) {
        r.hitilafu = CIV_HITILAFU_KIELEKEZI_TUPU;
        r.ujumbe = "Mchezo au jina la faili ni tupu";
        rudisha r;
    }
    InjiniUhifadhi* sp = mchezo_pata_uhifadhi(g);
    kama (sp == 0) {
        r.hitilafu = CIV_HITILAFU_HALI_MBAYA;
        r.ujumbe = "Injini ya uhifadhi haijaanzishwa";
        rudisha r;
    }
    n8* njia = injini_uhifadhi_njia_kamili(sp, jina_la_faili);
    kama (faili_ipo(njia) == 0) {
        r.hitilafu = CIV_HITILAFU_HAIJAPATIKANA;
        r.ujumbe = "Faili la uhifadhi halijapatikana";
        rudisha r;
    }
    n8* f = faili_fungua(njia, "r");
    kama (f == 0) {
        r.hitilafu = CIV_HITILAFU_IO;
        r.ujumbe = "Imeshindwa kufungua faili kwa kusoma";
        rudisha r;
    }

    n32 alama = injini_uhifadhi_soma_n32(f);
    n32 toleo = injini_uhifadhi_soma_n32(f);
    kama (alama != MCHEZO_HIFADHI_ALAMA) {
        faili_funga(f);
        r.hitilafu = CIV_HITILAFU_DATA_MBAYA;
        r.ujumbe = "Umbizo la faili la uhifadhi halitambuliki";
        rudisha r;
    }
    kama (toleo > MCHEZO_HIFADHI_TOLEO) {
        faili_funga(f);
        r.hitilafu = CIV_HITILAFU_DATA_MBAYA;
        r.ujumbe = "Toleo la faili la uhifadhi ni jipya kuliko linalotambulika";
        rudisha r;
    }

    g->hali_ya_mchezo = injini_uhifadhi_soma_n32(f);
    g->zamu_ya_sasa = injini_uhifadhi_soma_n32(f);
    g->inafanya_kazi = injini_uhifadhi_soma_n32(f);
    g->imesimamishwa = injini_uhifadhi_soma_n32(f);
    mchezo_hifadhi_soma_usanidi(f, &g->usanidi);
    mchezo_hifadhi_soma_muda(f, mchezo_pata_muda(g));
    mchezo_hifadhi_soma_saa_kuu(f, mchezo_pata_saa_kuu(g));
    mchezo_hifadhi_soma_idadi_ya_watu(f, mchezo_pata_idadi_ya_watu(g));
    mchezo_hifadhi_soma_serikali(f, mchezo_pata_serikali(g));
    mchezo_hifadhi_soma_ramani(f, mchezo_pata_ramani(g));
    mchezo_hifadhi_soma_makazi(f, mchezo_pata_makazi(g));
    mchezo_hifadhi_soma_akili(f, mchezo_pata_akili(g));
    mchezo_hifadhi_soma_diplomasia(f, mchezo_pata_diplomasia(g));
    mchezo_hifadhi_soma_taifa(f, mchezo_pata_taifa(g));
    mchezo_hifadhi_soma_uchumi_mkuu(f, mchezo_pata_uchumi_mkuu(g));
    mchezo_hifadhi_soma_nguvukazi(f, mchezo_pata_nguvukazi(g));
    mchezo_hifadhi_soma_sera(f, mchezo_pata_sera(g));
    mchezo_hifadhi_soma_kodi(f, mchezo_pata_kodi(g));
    mchezo_hifadhi_soma_bajeti(f, mchezo_pata_bajeti(g));
    mchezo_hifadhi_soma_bidhaa(f, mchezo_pata_bidhaa(g));
    mchezo_hifadhi_soma_benki(f, mchezo_pata_benki(g));
    mchezo_hifadhi_soma_kilimo(f, mchezo_pata_kilimo(g));
    mchezo_hifadhi_soma_uchimbaji(f, mchezo_pata_uchimbaji(g));
    mchezo_hifadhi_soma_miundombinu(f, mchezo_pata_miundombinu(g));
    mchezo_hifadhi_soma_viwanda(f, mchezo_pata_viwanda(g));
    mchezo_hifadhi_soma_nishati(f, mchezo_pata_nishati(g));
    mchezo_hifadhi_soma_uchumi_makazi(f, mchezo_pata_uchumi_makazi(g));
    mchezo_hifadhi_soma_ardhi(f, mchezo_pata_ardhi(g));
    mchezo_hifadhi_soma_mtaji(f, mchezo_pata_mtaji(g));
    mchezo_hifadhi_soma_biashara_ndani(f, mchezo_pata_biashara_ndani(g));
    mchezo_hifadhi_soma_biashara_nje(f, mchezo_pata_biashara_nje(g));
    mchezo_hifadhi_soma_uvumbuzi(f, mchezo_pata_uvumbuzi(g));
    mchezo_hifadhi_soma_soko_haramu(f, mchezo_pata_soko_haramu(g));
    mchezo_hifadhi_soma_vita(f, mchezo_pata_vita(g));
    mchezo_hifadhi_soma_utamaduni_metadata(f, g);
    mchezo_hifadhi_soma_matukio(f, mchezo_pata_matukio(g));
    mchezo_hifadhi_soma_wakala(f, mchezo_pata_wakala(g));
    mchezo_hifadhi_soma_okestra_utendaji(f, mchezo_pata_utendaji(g));
    mchezo_hifadhi_soma_jeshi_metadata(f, g);
    mchezo_hifadhi_soma_kikundi(f, mchezo_pata_kikundi(g));
    mchezo_hifadhi_soma_teknolojia(f, mchezo_pata_teknolojia(g));
    mchezo_hifadhi_soma_maarifa(f, mchezo_pata_maarifa(g));
    mchezo_hifadhi_soma_mipaka_hai(f, mchezo_pata_mipaka_hai(g));
    mchezo_hifadhi_soma_majanga(f, mchezo_pata_majanga(g));
    mchezo_hifadhi_soma_eneo(f, mchezo_pata_eneo(g));
    mchezo_hifadhi_soma_uhai(f, mchezo_pata_uhai(g));
    mchezo_hifadhi_soma_sarafu(f, mchezo_pata_sarafu(g));
    mchezo_hifadhi_soma_maajabu(f, mchezo_pata_maajabu(g));
    mchezo_hifadhi_soma_jamii(f, mchezo_pata_jamii(g));
    mchezo_hifadhi_soma_desturi(f, mchezo_pata_desturi(g));
    mchezo_hifadhi_soma_mwingiliano(f, mchezo_pata_mwingiliano(g));
    mchezo_hifadhi_soma_mhusika(f, mchezo_pata_mhusika(g));
    mchezo_hifadhi_soma_upinzani(f, mchezo_pata_upinzani(g));
    mchezo_hifadhi_soma_mashirika(f, mchezo_pata_mashirika(g));
    mchezo_hifadhi_soma_vipimo_laini(f, mchezo_pata_vipimo_laini(g));
    mchezo_hifadhi_soma_kitengo_chini(f, mchezo_pata_kitengo_chini(g));
    mchezo_hifadhi_soma_uandishi(f, mchezo_pata_uandishi(g));
    mchezo_hifadhi_soma_soko_fedha(f, mchezo_pata_soko_fedha(g));
    mchezo_hifadhi_soma_mageuko_lugha(f, mchezo_pata_mageuko_lugha(g));
    mchezo_hifadhi_soma_siasa(f, mchezo_pata_siasa(g));

    faili_funga(f);

    HistoriaDB* jarida = mchezo_pata_historia_db(g);
    kama (jarida != 0 && jarida->njia_ya_db != 0) {
        historia_db_pakia(jarida, jarida->njia_ya_db);
    }

    rudisha r;
}
