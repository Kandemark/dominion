// Historia ya pato ghafi ya taifa moja (au 0).
TakwimuHistoria* mchezo_pata_historia_ya_taifa(Mchezo* g, n64 taifa) {
    n64* safu = g->historia_ya_mataifa_addr;
    kama (safu == 0) { rudisha 0; }
    TaifaMfumo* tm = mchezo_pata_taifa(g);
    kama (taifa < 0 || taifa >= tm->idadi) { rudisha 0; }
    rudisha safu[taifa];
}

LughaMfumo* mchezo_pata_lugha_mfumo(Mchezo* g) { rudisha g->lugha_addr; }
w0 mchezo_weka_lugha_mfumo(Mchezo* g, LughaMfumo* v) { g->lugha_addr = v; }

// hubadilisha lugha hai: mchezo_weka_lugha(g, "en")
w0 mchezo_weka_lugha(Mchezo* g, n8* kodi) {
    kama (g == 0) { rudisha; }
    LughaMfumo* l = mchezo_pata_lugha_mfumo(g);
    kama (l != 0) {
        lugha_weka_lugha_hai(l, kodi);
    }
}

w0 mchezo_usanidi_chaguomsingi(MchezoUsanidi* u) {
    kama (u == 0) { rudisha; }
    u->jina = "Ustaarabu Mpya";
    u->toleo = "0.1.0";
    u->mwaka_wa_kuanza = 0 - 4000;
    u->ugumu = 1;
    u->washa_mantiki_isiyo_wazi = 1;
    u->washa_ufuatiliaji_wa_utegemezi = 1;
    u->muda_wa_hifadhi_otomatiki = 10;
    u->kiwango_cha_juu_cha_kumbukumbu_matukio = 500;
}

Mchezo* mchezo_unda() {
    Mchezo* g = tenga(ukubwa(Mchezo));
    g->hali_ya_mchezo = MCHEZO_HALI_KUANDAA;
    g->zamu_ya_sasa = 0;
    g->inafanya_kazi = 0;
    g->imesimamishwa = 0;
    g->muda_addr = 0;
    g->idadi_ya_watu_addr = 0;
    g->serikali_addr = 0;
    g->ramani_addr = 0;
    g->makazi_addr = 0;
    g->akili_addr = 0;
    g->diplomasia_addr = 0;
    g->taifa_addr = 0;
    g->uchumi_mkuu_addr = 0;
    g->nguvukazi_addr = 0;
    g->sera_addr = 0;
    g->kodi_addr = 0;
    g->bajeti_addr = 0;
    g->bidhaa_addr = 0;
    g->benki_addr = 0;
    g->kilimo_addr = 0;
    g->uchimbaji_addr = 0;
    g->miundombinu_addr = 0;
    g->viwanda_addr = 0;
    g->nishati_addr = 0;
    g->uchumi_makazi_addr = 0;
    g->ardhi_addr = 0;
    g->mtaji_addr = 0;
    g->biashara_ndani_addr = 0;
    g->biashara_nje_addr = 0;
    g->uvumbuzi_addr = 0;
    g->soko_haramu_addr = 0;
    g->vita_addr = 0;
    g->utamaduni_kitambulisho_addr = 0;
    g->utamaduni_kuenea_addr = 0;
    g->utamaduni_itikadi_addr = 0;
    g->utamaduni_uigaji_addr = 0;
    g->utamaduni_dini_addr = 0;
    g->matukio_addr = 0;
    g->wakala_addr = 0;
    g->injini_okestra_addr = 0;
    g->injini_saa_kuu_addr = 0;
    g->injini_uhifadhi_addr = 0;
    g->injini_utendaji_addr = 0;
    g->jeshi_vitengo_addr = 0;
    g->mapigano_addr = 0;
    g->ushindi_addr = 0;
    g->kikundi_addr = 0;
    g->teknolojia_addr = 0;
    g->maarifa_addr = 0;
    g->mipaka_hai_addr = 0;
    g->majanga_addr = 0;
    g->eneo_addr = 0;
    g->uhai_addr = 0;
    g->sarafu_addr = 0;
    g->maajabu_addr = 0;
    g->jamii_addr = 0;
    g->desturi_addr = 0;
    g->mwingiliano_addr = 0;
    g->mhusika_addr = 0;
    g->upinzani_addr = 0;
    g->mashirika_addr = 0;
    g->vipimo_laini_addr = 0;
    g->kitengo_chini_addr = 0;
    g->uandishi_addr = 0;
    g->historia_db_addr = 0;
    g->soko_fedha_addr = 0;
    g->gdp_historia_addr = 0;
    g->atlasi_addr = 0;
    g->miji_addr = 0;
    g->historia_ya_mataifa_addr = 0;
    g->utendaji.idadi_ya_sasisho = 0;
    g->utendaji.muda_wa_wastani_wa_sasisho = 0.0;
    g->utendaji.muda_wa_mwisho_wa_sasisho = 0.0;

    // i18n: iundwe HAPA, kabla ya dunia_taifa_kwanza_*.
    LughaMfumo* lugha = d_lugha_unda();
    mchezo_weka_lugha_mfumo(g, lugha);

    rudisha g;
}

// mchezo_anzisha: uanzishaji ULIOPUNGUZWA (simplified) — huunda
// mifumo saba ya msingi tu (angalia maelezo ya wigo juu ya faili),
// SI mzunguko kamili wa civ_game_initialize (hauna upakiaji wa data
// ya nje, hauna mifumo 18 ya uchumi, hauna NPC engine seeding).
// Uhusiano mmoja kwa kila jozi ya majirani wa nchi kavu. Imani ya mwanzo
// ni 0.35..0.75 kwa jozi (ya kudumu kwa mbegu), ikipunguzwa kidogo na
// mpaka mrefu (mvutano zaidi); kiwango cha uhusiano hufuata imani.
w0 mchezo_anzisha_mahusiano_ya_majirani(DiplomasiaMfumo* ds, TaifaMfumo* tm, Atlasi* a) {
    n32 i = 0;
    wakati (i < tm->idadi) {
        n32 j = i + 1;
        wakati (j < tm->idadi) {
            n32 mpaka = dunia_atlasi_mpaka(i, j);
            kama (mpaka > 0) {
                TaifaNchi* ta = tm->mataifa[i];
                TaifaNchi* tb = tm->mataifa[j];
                diplomasia_anzisha_uhusiano(ds, ta->kitambulisho, tb->kitambulisho);
                DiplomasiaUhusiano* r = diplomasia_pata_uhusiano(ds, ds->idadi_ya_uhusiano - 1);
                d64 h = atlasi_heshi(i, j, a->mbegu + 8181) % 41;
                d64 m = mpaka;
                kama (m > 40.0) { m = 40.0; }
                r->imani = 0.35 + h / 100.0 - m * 0.002;
                kama (r->imani < 0.3) { r->kiwango_cha_uhusiano = DIPLOMASIA_KIWANGO_UADUI; }
                sivyo { kama (r->imani < 0.4) { r->kiwango_cha_uhusiano = DIPLOMASIA_KIWANGO_KATI; }
                sivyo { kama (r->imani < 0.7) { r->kiwango_cha_uhusiano = DIPLOMASIA_KIWANGO_URAFIKI; }
                sivyo { r->kiwango_cha_uhusiano = DIPLOMASIA_KIWANGO_UMOJA; } } }
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

CivMatokeo mchezo_anzisha(Mchezo* g, MchezoUsanidi* usanidi) {
    CivMatokeo r;
    kama (g == 0 || usanidi == 0) {
        r.hitilafu = CIV_HITILAFU_KIELEKEZI_TUPU;
        r.ujumbe = "Mchezo au usanidi ni tupu";
        rudisha r;
    }

    g->usanidi.jina = usanidi->jina;
    g->usanidi.toleo = usanidi->toleo;
    g->usanidi.mwaka_wa_kuanza = usanidi->mwaka_wa_kuanza;
    g->usanidi.ugumu = usanidi->ugumu;
    g->usanidi.washa_mantiki_isiyo_wazi = usanidi->washa_mantiki_isiyo_wazi;
    g->usanidi.washa_ufuatiliaji_wa_utegemezi = usanidi->washa_ufuatiliaji_wa_utegemezi;
    g->usanidi.muda_wa_hifadhi_otomatiki = usanidi->muda_wa_hifadhi_otomatiki;
    g->usanidi.kiwango_cha_juu_cha_kumbukumbu_matukio = usanidi->kiwango_cha_juu_cha_kumbukumbu_matukio;

    mchezo_weka_muda(g, injini_muda_unda());
    mchezo_weka_idadi_ya_watu(g, idadi_ya_watu_unda());
    mchezo_weka_serikali(g, utawala_serikali_unda(usanidi->jina));
    // Dunia: atlasi (dunia_atlasi.swa) ndiyo jiografia.
    // Ramani ya vipande 360x180 (shahada moja kwa kipande) hujazwa
    // kutoka atlasi -- nchi kavu, mwinuko, hali ya hewa, matumizi ya
    // ardhi -- hivyo uigaji na ramani inayochorwa ni dunia moja.
    Atlasi* atlasi = atlasi_unda(MCHEZO_MBEGU_YA_DUNIA, MCHEZO_IDADI_YA_MATAIFA, 64, 36);
    Miji* miji = atlasi_unda_miji(atlasi);
    mchezo_weka_atlasi(g, atlasi);
    mchezo_weka_miji(g, miji);
    DuniaRamani* ramani_mpya = dunia_ramani_unda(360, 180, MCHEZO_MBEGU_YA_DUNIA);
    dunia_atlasi_jaza_ramani(ramani_mpya, atlasi, miji);
    mchezo_weka_ramani(g, ramani_mpya);
    mchezo_weka_makazi(g, dunia_makazi_msimamizi_unda());
    mchezo_weka_akili(g, akili_mfumo_unda());
    mchezo_weka_diplomasia(g, diplomasia_unda());

    // Taifa (nation.c): mataifa ya atlasi, kila moja likimiliki vipande
    // vya nchi kavu ambavyo atlasi inasema ni vyake.
    TaifaMfumo* taifa = dunia_taifa_mfumo_unda();
    dunia_atlasi_unda_mataifa(taifa, ramani_mpya, atlasi, miji);
    dunia_atlasi_hesabu_majirani(taifa, ramani_mpya);
    mchezo_anzisha_mahusiano_ya_majirani(mchezo_pata_diplomasia(g), taifa, atlasi);
    mchezo_weka_taifa(g, taifa);
    DuniaRasilimaliRamani* rm_ya_mwanzo = 0;
    TaifaUchumi* jumla_ya_mwanzo = 0;
    dunia_taifa_hesabu_uchumi_wote(taifa, ramani_mpya, rm_ya_mwanzo, jumla_ya_mwanzo);
    // Taifa la mchezaji: la robo ya juu kwa pato ghafi -- lenye uzito wa
    // kutosha kuwa na maamuzi ya maana, si kubwa kuliko yote.
    taifa->faharisi_ya_taifa_la_mchezaji = dunia_taifa_kwa_nafasi_ya_pato(taifa, taifa->idadi / 4);

    // Nguzo ya uchumi (moduli 20) — hakuna upakiaji wa data ya
    // jiografia halisi bado, hivyo baadhi ya hoja za "jiografia"
    // (eneo la ardhi, utajiri wa madini, n.k.) zinatumia thamani za
    // kawaida (placeholder) zilizoelezwa hapa chini badala ya
    // kusomwa kutoka ramani halisi.
    mchezo_weka_uchumi_mkuu(g, uchumi_mkuu_unda());
    mchezo_weka_nguvukazi(g, nguvukazi_unda());
    mchezo_weka_sera(g, sera_unda());
    mchezo_weka_kodi(g, kodi_unda());
    mchezo_weka_bajeti(g, bajeti_unda());
    mchezo_weka_bidhaa(g, bidhaa_soko_unda());
    mchezo_weka_benki(g, benki_unda());
    mchezo_weka_kilimo(g, kilimo_unda());
    mchezo_weka_uchimbaji(g, uchimbaji_unda());
    mchezo_weka_miundombinu(g, miundombinu_unda());
    mchezo_weka_viwanda(g, viwanda_unda());
    mchezo_weka_nishati(g, nishati_unda());
    mchezo_weka_uchumi_makazi(g, makazi_unda());
    // ardhi_unda inahitaji eneo la jumla la taifa (km2) — thamani ya
    // kawaida ya 500,000 km2 (takriban ukubwa wa taifa la kati)
    // hutumika hadi upakiaji wa data halisi ya jiografia uunganishwe.
    mchezo_weka_ardhi(g, ardhi_unda(500000.0));
    mchezo_weka_mtaji(g, mtaji_unda());
    mchezo_weka_biashara_ndani(g, biashara_ndani_unda());
    mchezo_weka_biashara_nje(g, biashara_nje_unda());
    mchezo_weka_uvumbuzi(g, uvumbuzi_unda());
    mchezo_weka_soko_haramu(g, soko_haramu_unda());
    mchezo_weka_vita(g, vita_unda());

    // Utamaduni (mifumo 5), matukio, wakala, injini_* — nyongeza ya
    // wimbi la tano. Mifumo yote inaundwa TUPU (hakuna vitambulisho/
    // itikadi/dini vya awali vilivyowekwa) — ni miundombinu tayari
    // kupokea data halisi ya kitamaduni pale itakapounganishwa.
    mchezo_weka_utamaduni_kitambulisho(g, utamaduni_kitambulisho_mfumo_unda());
    mchezo_weka_utamaduni_kuenea(g, utamaduni_kuenea_unda());
    mchezo_weka_utamaduni_itikadi(g, utamaduni_itikadi_mfumo_unda());
    mchezo_weka_utamaduni_uigaji(g, utamaduni_uigaji_tracker_unda());
    mchezo_weka_utamaduni_dini(g, utamaduni_dini_mfumo_unda());
    mchezo_weka_matukio(g, matukio_tukio_mfumo_unda());
    mchezo_weka_wakala(g, wakala_injini_unda());
    mchezo_weka_okestra(g, injini_okestra_unda());
    mchezo_weka_saa_kuu(g, injini_saa_unda());
    mchezo_weka_uhifadhi(g, injini_uhifadhi_unda("saves"));
    mchezo_weka_utendaji(g, injini_utendaji_unda());

    // Jeshi (units/combat/conquest), siasa_kikundi (factions),
    // teknolojia, maarifa (research) — nyongeza ya wimbi la tano,
    // sehemu ya pili.
    mchezo_weka_jeshi_vitengo(g, jeshi_vitengo_unda());
    mchezo_weka_mapigano(g, mapigano_mfumo_unda());
    mchezo_weka_ushindi(g, ushindi_mfumo_unda());

    // siasa_kikundi_mfumo_unda() na teknolojia_unda() zinarudisha
    // muundo KWA THAMANI (si kielekezi) — badala ya kujaribu
    // `*kielekezi = thamani;` (njia ambayo haijawahi kujaribiwa
    // kikao hiki kwa miundo hii mikubwa), tunatenga kwenye rundo na
    // kunakili field kwa field, mtindo ulioothibitishwa salama.
    SiasaKikundiMfumo kikundi_v = siasa_kikundi_mfumo_unda();
    SiasaKikundiMfumo* kikundi_p = tenga(ukubwa(SiasaKikundiMfumo));
    kikundi_p->vikundi = kikundi_v.vikundi;
    kikundi_p->idadi = kikundi_v.idadi;
    kikundi_p->uwezo = kikundi_v.uwezo;
    mchezo_weka_kikundi(g, kikundi_p);

    TeknolojiaMfumo tek_v = teknolojia_unda();
    TeknolojiaMfumo* tek_p = tenga(ukubwa(TeknolojiaMfumo));
    tek_p->bajeti_jumla = tek_v.bajeti_jumla;
    tek_p->kiwango = tek_v.kiwango;
    tek_p->cheo_duniani = tek_v.cheo_duniani;
    tek_p->wastani_duniani = tek_v.wastani_duniani;
    tek_p->kiwango_jumla = tek_v.kiwango_jumla;
    tek_p->cheo_jumla = tek_v.cheo_jumla;
    tek_p->mgao_0 = tek_v.mgao_0; tek_p->mgao_1 = tek_v.mgao_1;
    tek_p->mgao_2 = tek_v.mgao_2; tek_p->mgao_3 = tek_v.mgao_3;
    tek_p->mgao_4 = tek_v.mgao_4; tek_p->mgao_5 = tek_v.mgao_5;
    tek_p->mgao_6 = tek_v.mgao_6; tek_p->mgao_7 = tek_v.mgao_7;
    tek_p->mgao_8 = tek_v.mgao_8; tek_p->mgao_9 = tek_v.mgao_9;
    tek_p->mgao_10 = tek_v.mgao_10; tek_p->mgao_11 = tek_v.mgao_11;
    tek_p->kasi_0 = tek_v.kasi_0; tek_p->kasi_1 = tek_v.kasi_1;
    tek_p->kasi_2 = tek_v.kasi_2; tek_p->kasi_3 = tek_v.kasi_3;
    tek_p->kasi_4 = tek_v.kasi_4; tek_p->kasi_5 = tek_v.kasi_5;
    tek_p->kasi_6 = tek_v.kasi_6; tek_p->kasi_7 = tek_v.kasi_7;
    tek_p->kasi_8 = tek_v.kasi_8; tek_p->kasi_9 = tek_v.kasi_9;
    tek_p->kasi_10 = tek_v.kasi_10; tek_p->kasi_11 = tek_v.kasi_11;
    mchezo_weka_teknolojia(g, tek_p);

    mchezo_weka_maarifa(g, maarifa_unda());

    // Nyongeza (wimbi la sita): mipaka_hai, majanga, eneo -- mifumo
    // huru, hazihitaji hoja kutoka kwa mifumo mingine kuundwa.
    mchezo_weka_mipaka_hai(g, dunia_mpaka_hai_unda());
    mchezo_weka_majanga(g, mazingira_majanga_unda());
    mchezo_weka_eneo(g, dunia_eneo_msimamizi_unda());

    // Nyongeza (wimbi la nane): utawala_mwingiliano, mhusika,
    // siasa_upinzani -- angalia maelezo ya wigo juu ya faili.
    // utawala_mwingiliano.swa HAINA kazi ya "meneja_ongeza" (pengo
    // dogo lililopo tayari kwenye moduli hiyo yenyewe, si kosa jipya
    // la mchezo.swa) -- tunaandika kwenye safu ya meneja moja kwa
    // moja (uwezo wake wa awali ni 16, hivyo faharisi 0 ni salama
    // bila realloc), mtindo uleule unaotumika ndani ya
    // utawala_desturi_msimamizi_ongeza.
    UtawalaMwingilianoMeneja* mwingiliano_m = utawala_mwingiliano_meneja_unda();
    UtawalaMwingiliano* mkutano = utawala_mwingiliano_unda(UTAWALA_MWINGILIANO_MKUTANO_BINAFSI);
    utawala_mwingiliano_ongeza_mshiriki(mkutano, "kiongozi", "Mkuu wa Nchi", "sw");
    utawala_mwingiliano_anza(mkutano);
    mwingiliano_m->mwingiliano_zote[0] = mkutano;
    mwingiliano_m->idadi = 1;
    mchezo_weka_mwingiliano(g, mwingiliano_m);

    Mhusika* mhusika_p = mhusika_unda(usanidi->jina);
    mhusika_weka_asili(mhusika_p, MHUSIKA_ASILI_KIUTUMISHI);
    mchezo_weka_mhusika(g, mhusika_p);

    SiasaMpinzani* upinzani_p = tenga(ukubwa(SiasaMpinzani));
    siasa_upinzani_anzisha_mpinzani(upinzani_p, "Kiongozi wa Upinzani");
    mchezo_weka_upinzani(g, upinzani_p);

    // Nyongeza (wimbi la saba): uhai, sarafu, maajabu, jamii,
    // desturi -- angalia maelezo ya wigo juu ya faili.
    UhaiMfumo* uhai = tenga(ukubwa(UhaiMfumo));
    uhai_anzisha(uhai);
    mchezo_weka_uhai(g, uhai);

    Sarafu* sarafu = tenga(ukubwa(Sarafu));
    sarafu_anzisha(sarafu, usanidi->jina);
    mchezo_weka_sarafu(g, sarafu);

    mchezo_weka_maajabu(g, dunia_maajabu_msimamizi_unda());

    // jamii_ibuka inaunda jamii moja ya awali (Binadamu) badala ya
    // kuacha msimamizi tupu -- sawa na taifa (mataifa 8 ya
    // "procedural fallback") na utamaduni (angalia maelezo mengine
    // juu ya faili kuhusu mifumo inayoundwa tupu kimakusudi, hii si
    // mojawapo yao kwa sababu mchezo bila jamii yoyote haufanyi kazi
    // kimantiki).
    JamiiMsimamizi* jamii = jamii_msimamizi_unda();
    n8* eneo_asilia_bado_hakuna = 0;
    jamii_ibuka(jamii, "Binadamu", eneo_asilia_bado_hakuna);
    mchezo_weka_jamii(g, jamii);

    UtawalaDesturiMsimamizi* desturi_m = utawala_desturi_msimamizi_unda();
    UtawalaDesturi* desturi_kuu = utawala_desturi_unda(usanidi->jina, usanidi->jina);
    utawala_desturi_msimamizi_ongeza(desturi_m, desturi_kuu);
    mchezo_weka_desturi(g, desturi_m);

    // Nyongeza (wimbi la tisa): mashirika -- shirika moja la awali
    // (jukwaa la dunia, sawa na "UN") huundwa likiwa na taifa la
    // mchezaji kama mwanachama wa kwanza.
    ShirikaMsimamizi* mashirika_m = shirika_msimamizi_unda();
    Shirika* jukwaa_la_dunia = shirika_unda("org_jukwaa_la_dunia", "Jukwaa la Dunia", SHIRIKA_AINA_JUKWAA_LA_DUNIA);
    shirika_ongeza_mwanachama(jukwaa_la_dunia, usanidi->jina);
    shirika_msimamizi_ongeza(mashirika_m, jukwaa_la_dunia);
    mchezo_weka_mashirika(g, mashirika_m);

    // Nyongeza (wimbi la kumi): vipimo_laini, kitengo_chini, uandishi,
    // historia_db, soko_fedha -- angalia maelezo ya wigo juu ya faili.
    // uandishi inaundwa TUPU (hakuna mfumo wa uandishi wa awali
    // uliowekwa) -- sawa na itikadi/dini/kitambulisho, ni miundombinu
    // tayari kupokea data halisi baadaye.
    mchezo_weka_vipimo_laini(g, vipimo_laini_msimamizi_unda());
    mchezo_weka_kitengo_chini(g, kitengo_chini_msimamizi_unda());
    mchezo_weka_uandishi(g, uandishi_msimamizi_unda());
    mchezo_weka_historia_db(g, historia_db_unda("saves/historia.db"));
    mchezo_weka_soko_fedha(g, soko_fedha_injini_unda());

    // Nyongeza (wimbi la kumi na moja): mageuko_lugha, siasa --
    // angalia maelezo ya wigo juu ya faili na siasa.swa.
    mchezo_weka_mageuko_lugha(g, utamaduni_mageuko_mfumo_unda());
    mchezo_weka_siasa(g, siasa_mfumo_unda());

    // AWAMU D: gdp_historia huanza TUPU (idadi=0, uwezo=64) -- sampuli
    // ya kwanza huongezwa na mchezo_maliza_zamu, si hapa (angalia
    // maelezo kamili karibu na mchezo_hesabu_gdp_jumla chini).
    mchezo_weka_gdp_historia(g, takwimu_historia_unda());
    TaifaMfumo* taifa_ya_historia = mchezo_pata_taifa(g);
    n64* historia_ya_mataifa = tenga(8 * taifa_ya_historia->idadi + 8);
    n32 ih = 0;
    wakati (ih < taifa_ya_historia->idadi) {
        historia_ya_mataifa[ih] = takwimu_historia_unda();
        ih = ih + 1;
    }
    historia_ya_mataifa[ih] = 0;        // mwisho wa safu (mchezo_zima hutembea hadi hapa)
    g->historia_ya_mataifa_addr = historia_ya_mataifa;

    g->hali_ya_mchezo = MCHEZO_HALI_INAENDESHA;
    g->inafanya_kazi = 1;
    g->imesimamishwa = 0;
    g->zamu_ya_sasa = 1;

    andika(d_tafsiri("m1"), g->zamu_ya_sasa, 0,0,0,0,0);

    r.hitilafu = CIV_SAWA;
    r.ujumbe = 0;
    rudisha r;
}

// mchezo_sasisha: mzunguko mmoja wa sasisha ULIOPUNGUZWA — hupitisha
// mifumo saba iliyounganishwa tu, kwa mpangilio wa kimantiki
// (wakati -> idadi ya watu -> utawala -> makazi -> akili -> diplomasia).
// SI civ_game_update kamili (haina uchumi, hauna mizunguko ya
// mfululizo ya awamu 10 za asili).
w0 mchezo_sasisha(Mchezo* g) {
    kama (g == 0 || g->inafanya_kazi == 0 || g->imesimamishwa != 0) { rudisha; }

    d64 dt = 1.0;
    InjiniMudaMfumo* muda = mchezo_pata_muda(g);
    kama (muda != 0) {
        dt = injini_muda_sasisha(muda, 1.0);
        kama (dt <= 0.0) { dt = 1.0; }
    }

    IdadiYaWatuMsimamizi* pm = mchezo_pata_idadi_ya_watu(g);
    n32 idadi_ya_watu_n = 100;
    kama (pm != 0) {
        idadi_ya_watu_sasisha(pm, dt, 0.5);
        n64 idadi_jumla = pm->demografia.idadi_jumla;
        idadi_ya_watu_n = idadi_jumla;
        kama (idadi_ya_watu_n < 100) { idadi_ya_watu_n = 100; }
    }

    // Nguzo ya uchumi (moduli 20) — mpangilio wa awamu unafuata
    // civ_game_update ya asili (Awamu 1a-1s): macro -> nguvukazi ->
    // sera -> kodi -> bajeti -> bidhaa -> benki -> kilimo ->
    // uchimbaji -> miundombinu -> viwanda -> nishati -> makazi ->
    // ardhi -> mtaji -> biashara_ndani -> biashara_nje -> uvumbuzi ->
    // soko_haramu -> vita. Kila kimoja hulishwa na matokeo halisi ya
    // kile kilichotangulia pale inapowezekana (GDP, mfumuko, rushwa,
    // riba, ubora wa miundombinu, n.k.) badala ya thamani za bandia.
    d64 pato = 0.0;
    d64 mfumuko = 0.02;
    d64 ukuaji = 0.0;
    d64 ukosefu_wa_kazi = 0.05;
    d64 rushwa_jumla = 0.0;
    d64 ufanisi_wa_utawala = 0.5;

    UtawalaSerikali* serikali_kwa_uchumi = mchezo_pata_serikali(g);
    kama (serikali_kwa_uchumi != 0) {
        rushwa_jumla = utawala_serikali_pata_rushwa_jumla(serikali_kwa_uchumi);
        ufanisi_wa_utawala = serikali_kwa_uchumi->ufanisi;
    }

    UchumiMkuuMfumo* mkuu = mchezo_pata_uchumi_mkuu(g);
    kama (mkuu != 0) {
        UchumiMkuuRipoti ripoti = uchumi_mkuu_sasisha(mkuu, dt, idadi_ya_watu_n, 5000.0, 0.5);
        pato = ripoti.pato_la_taifa;
        mfumuko = ripoti.kiwango_cha_mfumuko;
        ukuaji = ripoti.kiwango_cha_ukuaji;
        ukosefu_wa_kazi = ripoti.kiwango_cha_ukosefu_wa_kazi;
    }

    NguvukaziMfumo* nguvukazi = mchezo_pata_nguvukazi(g);
    d64 mshahara_wa_wastani = 30000.0;
    kama (nguvukazi != 0) {
        NguvukaziMazingira* nm = tenga(ukubwa(NguvukaziMazingira));
        nm->kiwango_cha_teknolojia = 0.5;
        nm->kiwango_cha_elimu = 0.5;
        nm->imani_ya_biashara = 0.6;
        nguvukazi_sasisha(nguvukazi, dt, idadi_ya_watu_n, pato, nm);
        achilia nm;
        mshahara_wa_wastani = nguvukazi->mshahara_wa_wastani_wa_taifa;
    }

    SeraMfumo* sera = mchezo_pata_sera(g);
    kama (sera != 0) {
        sera_sasisha(sera, dt, mfumuko, ukosefu_wa_kazi, ukuaji, rushwa_jumla);
    }

    KodiMfumo* kodi = mchezo_pata_kodi(g);
    d64 mapato_ya_kodi = 0.0;
    kama (kodi != 0) {
        kodi_sasisha(kodi, dt, pato, idadi_ya_watu_n, ufanisi_wa_utawala, rushwa_jumla);
        mapato_ya_kodi = kodi->mapato_jumla;
    }

    BajetiMfumo* bajeti = mchezo_pata_bajeti(g);
    d64 mgao_wa_miundombinu = 1000.0;
    kama (bajeti != 0) {
        bajeti_sasisha(bajeti, dt, mapato_ya_kodi, pato);
        mgao_wa_miundombinu = bajeti_pata_mgao(bajeti, 0);
    }

    BidhaaSoko* bidhaa = mchezo_pata_bidhaa(g);
    kama (bidhaa != 0) {
        bidhaa_soko_sasisha_zote(bidhaa);
    }

    BenkiMfumo* benki = mchezo_pata_benki(g);
    d64 kiwango_cha_riba = 0.04;
    kama (benki != 0) {
        benki_sasisha(benki, dt, mfumuko, ukuaji, ukosefu_wa_kazi, 0.3);
        kiwango_cha_riba = benki->kiwango_cha_msingi_cha_riba;
    }

    KilimoMfumo* kilimo = mchezo_pata_kilimo(g);
    kama (kilimo != 0) {
        kilimo_sasisha(kilimo, dt, idadi_ya_watu_n, 5000.0, 0.5, 1.0);
    }

    UchimbajiMfumo* uchimbaji = mchezo_pata_uchimbaji(g);
    kama (uchimbaji != 0) {
        uchimbaji_sasisha(uchimbaji, dt, 0.5, mshahara_wa_wastani, 0.5);
    }

    MiundombinuMfumo* miundombinu = mchezo_pata_miundombinu(g);
    d64 ubora_wa_miundombinu = 0.5;
    kama (miundombinu != 0) {
        miundombinu_sasisha(miundombinu, dt, mgao_wa_miundombinu, idadi_ya_watu_n, 1.0);
        ubora_wa_miundombinu = miundombinu->ubora_wa_jumla;
    }

    ViwandaMfumo* viwanda = mchezo_pata_viwanda(g);
    d64 pato_la_viwanda = 0.0;
    kama (viwanda != 0) {
        viwanda_sasisha(viwanda, dt, 0.5, mshahara_wa_wastani, 0.5, ubora_wa_miundombinu);
        pato_la_viwanda = viwanda->pato_jumla_la_viwanda;
    }

    NishatiMfumo* nishati = mchezo_pata_nishati(g);
    kama (nishati != 0) {
        nishati_sasisha(nishati, dt, idadi_ya_watu_n, pato_la_viwanda, 0.5, 0.7);
    }

    MakaziMfumo* uchumi_makazi = mchezo_pata_uchumi_makazi(g);
    kama (uchumi_makazi != 0) {
        makazi_sasisha(uchumi_makazi, dt, idadi_ya_watu_n, mshahara_wa_wastani, kiwango_cha_riba, 1.0);
    }

    ArdhiMfumo* ardhi = mchezo_pata_ardhi(g);
    d64 pato_kwa_mtu = 0.0;
    kama (ardhi != 0) {
        n32 idadi_ya_watu_p1 = idadi_ya_watu_n + 1;
        d64 idadi_ya_watu_p1_d = idadi_ya_watu_p1;
        pato_kwa_mtu = pato / idadi_ya_watu_p1_d;
        ardhi_sasisha(ardhi, dt, idadi_ya_watu_n, pato_kwa_mtu, 0.02);
    }

    MtajiMfumo* mtaji = mchezo_pata_mtaji(g);
    kama (mtaji != 0) {
        mtaji_sasisha(mtaji, dt, pato, 0.2, kiwango_cha_riba, 0.6);
    }

    BiasharaNdaniMfumo* biashara_ndani = mchezo_pata_biashara_ndani(g);
    kama (biashara_ndani != 0) {
        biashara_ndani_sasisha(biashara_ndani, dt, ubora_wa_miundombinu, idadi_ya_watu_n, 1.0);
    }

    BiasharaNjeMfumo* biashara_nje = mchezo_pata_biashara_nje(g);
    kama (biashara_nje != 0) {
        biashara_nje_sasisha(biashara_nje, dt);
    }

    UvumbuziMfumo* uvumbuzi = mchezo_pata_uvumbuzi(g);
    kama (uvumbuzi != 0) {
        UvumbuziMazingira* um = tenga(ukubwa(UvumbuziMazingira));
        um->elimu = 0.5;
        um->imani_ya_biashara = 0.6;
        um->kiwango_cha_kanuni = 0.4;
        um->upatikanaji_wa_mtaji = 0.5;
        uvumbuzi_sasisha(uvumbuzi, dt, pato, um);
        achilia um;
    }

    SokoHaramuMfumo* soko_haramu = mchezo_pata_soko_haramu(g);
    kama (soko_haramu != 0) {
        SokoHaramuMazingira* sm = tenga(ukubwa(SokoHaramuMazingira));
        sm->kiwango_cha_rushwa = rushwa_jumla;
        sm->kiwango_cha_ukosefu_wa_kazi = ukosefu_wa_kazi;
        sm->kiwango_cha_kanuni = 0.4;
        sm->bajeti_ya_udhibiti = mgao_wa_miundombinu;
        soko_haramu_sasisha(soko_haramu, dt, pato, sm);
        achilia sm;
    }

    VitaMfumo* vita = mchezo_pata_vita(g);
    kama (vita != 0) {
        vita_sasisha(vita, dt, pato, pato_la_viwanda, idadi_ya_watu_n, 0);
    }

    TaifaMfumo* taifa = mchezo_pata_taifa(g);
    DuniaRamani* ramani_kwa_uchumi = mchezo_pata_ramani(g);
    kama (taifa != 0 && ramani_kwa_uchumi != 0) {
        DuniaRasilimaliRamani* rm_tupu = 0;
        TaifaUchumi* jumla_tupu = 0;
        dunia_taifa_hesabu_uchumi_wote(taifa, ramani_kwa_uchumi, rm_tupu, jumla_tupu);
    }

    UtawalaSerikali* serikali = mchezo_pata_serikali(g);
    kama (serikali != 0) {
        utawala_serikali_sasisha(serikali, dt, idadi_ya_watu_n, 0.5, pato);
    }

    DuniaRamani* ramani = mchezo_pata_ramani(g);
    DuniaMakaziMsimamizi* makazi = mchezo_pata_makazi(g);
    kama (makazi != 0 && ramani != 0) {
        dunia_makazi_msimamizi_sasisha(makazi, ramani, dt);
    }

    AkiliMfumo* akili = mchezo_pata_akili(g);
    kama (akili != 0) {
        akili_mfumo_sasisha(akili, dt);
    }

    DiplomasiaMfumo* diplomasia = mchezo_pata_diplomasia(g);
    kama (diplomasia != 0) {
        n64 zamu_d = g->zamu_ya_sasa;
        diplomasia_sasisha_mahusiano(diplomasia, zamu_d);
    }

    // Utamaduni: kuenea na uigaji vyote hufanya kazi juu ya mfumo
    // mzima wa vitambulisho (kitambulisho_addr) -- itikadi/dini
    // hazina kazi ya "sasisha zote" ya kiwango cha mfumo (zinaundwa
    // tayari kupokea vitu vya kibinafsi baadaye), kwa hiyo hazipigi
    // simu hapa (kupiga simu kwenye mfumo tupu kusingekuwa na athari
    // yoyote).
    UtamaduniKitambulishoMfumo* kitambulisho_mfumo = mchezo_pata_utamaduni_kitambulisho(g);
    UtamaduniKuenea* kuenea = mchezo_pata_utamaduni_kuenea(g);
    kama (kuenea != 0 && kitambulisho_mfumo != 0) {
        utamaduni_kuenea_chakata(kuenea, kitambulisho_mfumo, dt);
    }
    UtamaduniUigajiTracker* uigaji = mchezo_pata_utamaduni_uigaji(g);
    kama (uigaji != 0 && kitambulisho_mfumo != 0) {
        utamaduni_uigaji_tracker_sasisha(uigaji, kitambulisho_mfumo, dt);
    }

    MatukioTukioMfumo* matukio = mchezo_pata_matukio(g);
    kama (matukio != 0) {
        matukio_tukio_sasisha(matukio, dt);
    }

    // Jeshi (units/combat) hazina "sasisha zote" ya kiwango cha
    // mfumo — mapigano ni ya tukio (event-driven, simulisha vita
    // moja mahususi), vitengo ni ya kitendo (ajiri/imarisha kwa
    // ombi) — zote mbili ni sahihi kubaki bila wito hapa, ni
    // kwa makusudi, si pengo.
    UshindiMfumo* ushindi = mchezo_pata_ushindi(g);
    kama (ushindi != 0) {
        ushindi_sasisha(ushindi, dt);
    }

    SiasaKikundiMfumo* kikundi = mchezo_pata_kikundi(g);
    kama (kikundi != 0) {
        siasa_kikundi_mfumo_sasisha(kikundi, dt);
    }

    TeknolojiaMfumo* teknolojia = mchezo_pata_teknolojia(g);
    kama (teknolojia != 0) {
        teknolojia_sasisha(teknolojia, dt);
    }

    MaarifaUtafiti* maarifa = mchezo_pata_maarifa(g);
    kama (maarifa != 0) {
        maarifa_sasisha(maarifa, idadi_ya_watu_n, 1);
    }

    // Mipaka hai, majanga, eneo -- IMEHAMISHWA kwenye kazi TOFAUTI
    // (mchezo_sasisha_mifumo_huru, chini ya kazi hii) KWA MAKUSUDI, si
    // uzembe: mchezo_sasisha ilikuwa TAYARI karibu sana na kikomo cha
    // mkusanyaji (lugha-swa/swa: uzalishaji.swa, `var_jina_off[64]`,
    // ujumbe wa kosa "vigezo vya ndani vimezidi 64" -- angalia maoni
    // ya kernel_rekebisha_rela kwenye uzalishaji.swa kwa mfano mwingine
    // uliokumbana na tatizo hili hili wakati wa kujijenga kwa mkusanyaji
    // mwenyewe). Kuongeza vigezo vitatu zaidi vya ndani
    // (mipaka_hai/majanga/eneo) HAPA MOJA KWA MOJA kulivunja mkusanyiko
    // (imethibitishwa kwa vitendo: jaribio la kwanza la muunganisho huu
    // lilishindwa na KOSA hiyo mara nne). Kuita kazi ndogo kutoka hapa
    // haiongezi vigezo vya ndani vya mchezo_sasisha yenyewe.
    mchezo_sasisha_mifumo_huru(g, dt);

    g->utendaji.idadi_ya_sasisho = g->utendaji.idadi_ya_sasisho + 1;
}

// mchezo_sasisha_mifumo_huru: sasisha ya mifumo isiyotegemea
// mnyororo wa thamani wa nguzo ya uchumi (mipaka_hai, majanga, eneo)
// -- angalia maoni kwenye mchezo_sasisha juu ya KWA NINI hii iko
// kwenye kazi TOFAUTI (kikomo cha "vigezo vya ndani 64" cha
// mkusanyaji).
w0 mchezo_sasisha_mifumo_huru(Mchezo* g, d64 dt) {
    DuniaMipakaHai* mipaka_hai = mchezo_pata_mipaka_hai(g);
    kama (mipaka_hai != 0) {
        dunia_mpaka_hai_sasisha(mipaka_hai, dt);
    }

    MazingiraMajangaMfumo* majanga = mchezo_pata_majanga(g);
    kama (majanga != 0) {
        mazingira_majanga_sasisha(majanga, dt);
    }

    DuniaEneoMsimamizi* eneo = mchezo_pata_eneo(g);
    kama (eneo != 0) {
        dunia_eneo_msimamizi_sasisha(eneo, dt);
    }

    // Nyongeza (wimbi la saba): uhai, sarafu, desturi -- mifumo
    // mengine miwili ya wimbi hili (maajabu, jamii) hazina kazi ya
    // "sasisha zote" kwenye chanzo asili (sawa na itikadi/dini
    // kwenye mchezo_sasisha), kwa hiyo hazipigi simu hapa kimakusudi.
    UhaiMfumo* uhai = mchezo_pata_uhai(g);
    kama (uhai != 0) {
        uhai_sasisha(uhai, dt);
    }

    // sarafu inalishwa na matokeo HALISI ya uchumi_mkuu (ripoti ya
    // mwisho iliyohesabiwa na mchezo_sasisha kabla ya kazi hii
    // kuitwa) -- ukuaji wa GDP, sehemu ya pato la viwanda kwenye
    // pato la jumla, na ukosefu wa kazi -- badala ya thamani za
    // bandia, sawa na mnyororo wa thamani wa nguzo ya uchumi.
    Sarafu* sarafu = mchezo_pata_sarafu(g);
    UchumiMkuuMfumo* mkuu_kwa_sarafu = mchezo_pata_uchumi_mkuu(g);
    kama (sarafu != 0 && mkuu_kwa_sarafu != 0) {
        SarafuHaliYaTaifa* jumla = tenga(ukubwa(SarafuHaliYaTaifa));
        jumla->uzalishaji_wa_taifa = mkuu_kwa_sarafu->ripoti_ya_mwisho.kiwango_cha_ukuaji;
        jumla->uthabiti_wa_viwanda = 0.0;
        kama (mkuu_kwa_sarafu->ripoti_ya_mwisho.pato_la_taifa > 0.0) {
            jumla->uthabiti_wa_viwanda =
                mkuu_kwa_sarafu->ripoti_ya_mwisho.pato_la_viwanda
                / mkuu_kwa_sarafu->ripoti_ya_mwisho.pato_la_taifa;
        }
        jumla->kiashiria_cha_ukosefu_wa_kazi = mkuu_kwa_sarafu->ripoti_ya_mwisho.kiwango_cha_ukosefu_wa_kazi;
        jumla->mzunguko_wa_sasa = SARAFU_MZUNGUKO_UKUAJI;
        kama (mkuu_kwa_sarafu->hisia == UCHUMI_MKUU_HISIA_YA_KUSHUKA) {
            jumla->mzunguko_wa_sasa = SARAFU_MZUNGUKO_MDOROHO;
        }
        sarafu_sasisha_thamani(sarafu, jumla);
        achilia jumla;
    }

    UtawalaDesturiMsimamizi* desturi_m = mchezo_pata_desturi(g);
    kama (desturi_m != 0 && desturi_m->idadi > 0) {
        UtawalaDesturi* desturi_kuu = utawala_desturi_msimamizi_pata(desturi_m, 0);
        utawala_desturi_sasisha(desturi_kuu, dt);
    }

    // Nyongeza (wimbi la nane): utawala_mwingiliano pekee ina
    // "_sasisha(m, dt)" -- mhusika na siasa_upinzani hazina kazi ya
    // "sasisha zote"/dt kwenye chanzo asili (ni za tukio: mabadiliko
    // ya mhusika hutokea kwa matukio ya maisha, kitendo cha upinzani
    // hutokea kwa uamuzi wa mchezaji/AI -- sawa na jeshi/mapigano
    // ambayo pia hayapigiwi simu hapa kimakusudi).
    UtawalaMwingilianoMeneja* mwingiliano_m2 = mchezo_pata_mwingiliano(g);
    kama (mwingiliano_m2 != 0 && mwingiliano_m2->idadi > 0) {
        UtawalaMwingiliano* mkutano2 = utawala_mwingiliano_meneja_pata(mwingiliano_m2, 0);
        utawala_mwingiliano_sasisha(mkutano2, dt);
    }

    // Nyongeza (wimbi la kumi): kitengo_chini -- mfumo huru wenye
    // "sasisha zote"/dt halisi (kama mipaka_hai/majanga/eneo juu).
    KitengoChiniMsimamizi* kitengo_chini_m = mchezo_pata_kitengo_chini(g);
    kama (kitengo_chini_m != 0) {
        kitengo_chini_msimamizi_sasisha(kitengo_chini_m, dt);
    }

    // vipimo_laini inalishwa na pato_kwa_kila_mtu/ukosefu_wa_kazi
    // HALISI kutoka ripoti_ya_mwisho ya uchumi_mkuu -- mnyororo
    // uleule wa thamani uliotumika kwa sarafu hapo juu.
    VipimoLainiMsimamizi* vipimo = mchezo_pata_vipimo_laini(g);
    kama (vipimo != 0 && mkuu_kwa_sarafu != 0) {
        vipimo_laini_sasisha_kutoka_uchumi(
            vipimo,
            mkuu_kwa_sarafu->ripoti_ya_mwisho.pato_kwa_kila_mtu,
            mkuu_kwa_sarafu->ripoti_ya_mwisho.kiwango_cha_ukosefu_wa_kazi);
    }

    // soko_fedha (masoko ya fedha) inalishwa na pato/chakula/nishati/
    // viwanda HALISI kutoka nguzo ya uchumi -- angalia maelezo ya
    // wigo juu ya faili.
    SokoFedhaInjini* soko = mchezo_pata_soko_fedha(g);
    kama (soko != 0 && mkuu_kwa_sarafu != 0) {
        KilimoMfumo* kilimo_kwa_soko = mchezo_pata_kilimo(g);
        d64 chakula_v = 0.0;
        kama (kilimo_kwa_soko != 0) { chakula_v = kilimo_kwa_soko->uzalishaji_wa_chakula; }
        NishatiMfumo* nishati_kwa_soko = mchezo_pata_nishati(g);
        d64 nishati_v = 0.0;
        kama (nishati_kwa_soko != 0) { nishati_v = nishati_kwa_soko->uwezo_jumla_mw; }
        soko_fedha_sasisha_uzalishaji(
            soko,
            mkuu_kwa_sarafu->ripoti_ya_mwisho.pato_la_taifa,
            chakula_v,
            nishati_v,
            mkuu_kwa_sarafu->ripoti_ya_mwisho.pato_la_viwanda);
    }

    // Nyongeza (wimbi la kumi na moja): mageuko_lugha ni mfumo huru
    // (dt tu, kama mipaka_hai/majanga/eneo juu).
    UtamaduniMageukoMfumo* mageuko = mchezo_pata_mageuko_lugha(g);
    kama (mageuko != 0) {
        utamaduni_mageuko_mfumo_badilika(mageuko, dt);
    }

    // siasa inasoma utulivu wa kikundi BAADA ya kikundi kuwa
    // limeshasasishwa (kikundi_addr inasasishwa kwenye mchezo_sasisha
    // KABLA ya kazi hii kuitwa) -- angalia maelezo ya siasa.swa kwa
    // nini HAIITI siasa_kikundi_mfumo_sasisha tena hapa.
    SiasaMfumo* siasa = mchezo_pata_siasa(g);
    SiasaKikundiMfumo* kikundi_kwa_siasa = mchezo_pata_kikundi(g);
    kama (siasa != 0) {
        siasa_mfumo_sasisha(siasa, kikundi_kwa_siasa, dt);
    }

    // utamaduni.swa: pengo halisi lililopatikana wakati wa kutafsiri
    // culture.c -- kitanzi cha kusasisha KILA kitambulisho (angalia
    // maelezo ya utamaduni.swa) hakikuwa kimeunganishwa popote kabla
    // ya hii. kuenea/uigaji TAYARI zinaitwa moja kwa moja kwenye
    // mchezo_sasisha, kwa hiyo HAZIITWI tena hapa (zingesasishwa mara
    // mbili kwa mzunguko mmoja).
    UtamaduniKitambulishoMfumo* kitambulisho_kwa_utamaduni = mchezo_pata_utamaduni_kitambulisho(g);
    kama (kitambulisho_kwa_utamaduni != 0) {
        utamaduni_mfumo_sasisha_watambulisho_wote(kitambulisho_kwa_utamaduni, dt);
    }
}

// mchezo_zima_mifumo_huru: uharibifu wa mifumo ya wimbi la saba
// (uhai, sarafu, maajabu, jamii, desturi) -- kazi TOFAUTI na
// mchezo_zima kwa sababu ile tayari ina vigezo vingi vya ndani
// (mfumo mmoja kwa kila mfumo uliounganishwa, ~42+) -- angalia maoni
// kwenye mchezo_sasisha_mifumo_huru juu ya kikomo hicho hicho cha
// mkusanyaji.
w0 mchezo_zima_mifumo_huru(Mchezo* g) {
    UhaiMfumo* uhai_zima = mchezo_pata_uhai(g);
    kama (uhai_zima != 0) { achilia uhai_zima; }

    Sarafu* sarafu_zima = mchezo_pata_sarafu(g);
    kama (sarafu_zima != 0) { achilia sarafu_zima; }

    DuniaAjabuMsimamizi* maajabu_zima = mchezo_pata_maajabu(g);
    kama (maajabu_zima != 0) { dunia_maajabu_msimamizi_uharibu(maajabu_zima); }

    JamiiMsimamizi* jamii_zima = mchezo_pata_jamii(g);
    kama (jamii_zima != 0) { jamii_msimamizi_uharibu(jamii_zima); }

    UtawalaDesturiMsimamizi* desturi_zima = mchezo_pata_desturi(g);
    kama (desturi_zima != 0) {
        n32 i = 0;
        wakati (i < desturi_zima->idadi) {
            UtawalaDesturi* d = utawala_desturi_msimamizi_pata(desturi_zima, i);
            utawala_desturi_uharibu(d);
            i = i + 1;
        }
        utawala_desturi_msimamizi_uharibu(desturi_zima);
    }

    // Nyongeza (wimbi la nane): utawala_mwingiliano, mhusika,
    // siasa_upinzani.
    UtawalaMwingilianoMeneja* mwingiliano_zima = mchezo_pata_mwingiliano(g);
    kama (mwingiliano_zima != 0) {
        n32 j = 0;
        wakati (j < mwingiliano_zima->idadi) {
            UtawalaMwingiliano* mw = utawala_mwingiliano_meneja_pata(mwingiliano_zima, j);
            utawala_mwingiliano_uharibu(mw);
            j = j + 1;
        }
        utawala_mwingiliano_meneja_uharibu(mwingiliano_zima);
    }

    Mhusika* mhusika_zima = mchezo_pata_mhusika(g);
    kama (mhusika_zima != 0) { mhusika_uharibu(mhusika_zima); }

    SiasaMpinzani* upinzani_zima = mchezo_pata_upinzani(g);
    kama (upinzani_zima != 0) { achilia upinzani_zima; }

    // Nyongeza (wimbi la tisa): mashirika.
    ShirikaMsimamizi* mashirika_zima = mchezo_pata_mashirika(g);
    kama (mashirika_zima != 0) { shirika_msimamizi_uharibu(mashirika_zima); }

    // Nyongeza (wimbi la kumi): vipimo_laini, kitengo_chini, uandishi,
    // historia_db, soko_fedha.
    VipimoLainiMsimamizi* vipimo_zima = mchezo_pata_vipimo_laini(g);
    kama (vipimo_zima != 0) { vipimo_laini_msimamizi_uharibu(vipimo_zima); }

    KitengoChiniMsimamizi* kitengo_chini_zima = mchezo_pata_kitengo_chini(g);
    kama (kitengo_chini_zima != 0) { kitengo_chini_msimamizi_uharibu(kitengo_chini_zima); }

    UtamaduniAndikoMsimamizi* uandishi_zima = mchezo_pata_uandishi(g);
    kama (uandishi_zima != 0) { uandishi_msimamizi_uharibu(uandishi_zima); }

    HistoriaDB* historia_db_zima = mchezo_pata_historia_db(g);
    kama (historia_db_zima != 0) { historia_db_uharibu(historia_db_zima); }

    SokoFedhaInjini* soko_fedha_zima = mchezo_pata_soko_fedha(g);
    kama (soko_fedha_zima != 0) { soko_fedha_injini_uharibu(soko_fedha_zima); }

    // Nyongeza (wimbi la kumi na moja): mageuko_lugha, siasa.
    UtamaduniMageukoMfumo* mageuko_zima = mchezo_pata_mageuko_lugha(g);
    kama (mageuko_zima != 0) { utamaduni_mageuko_mfumo_uharibu(mageuko_zima); }

    SiasaMfumo* siasa_zima = mchezo_pata_siasa(g);
    kama (siasa_zima != 0) { siasa_mfumo_uharibu(siasa_zima); }

    // AWAMU D: gdp_historia -- achilia KABLA ya Mchezo mwenyewe
    // kuachiliwa (mchezo_uharibu huita mchezo_zima, ambayo huita kazi
    // hii, kisha achilia g).
    TakwimuHistoria* gdp_historia_zima = mchezo_pata_gdp_historia(g);
    kama (gdp_historia_zima != 0) { takwimu_historia_uharibu(gdp_historia_zima); }
    n64* historia_ya_mataifa_zima = g->historia_ya_mataifa_addr;
    kama (historia_ya_mataifa_zima != 0) {
        n64 iz = 0;
        wakati (historia_ya_mataifa_zima[iz] != 0) {
            takwimu_historia_uharibu(historia_ya_mataifa_zima[iz]);
            iz = iz + 1;
        }
        achilia historia_ya_mataifa_zima;
        g->historia_ya_mataifa_addr = 0;
    }

    LughaMfumo* lugha_zima = mchezo_pata_lugha_mfumo(g);
    kama (lugha_zima != 0) { d_lugha_funga(lugha_zima); }
}

// mchezo_hesabu_gdp_jumla: GDP ya JUMLA YA DUNIA (jumla ya
// uchumi.pato_ghafi ya mataifa YOTE kwenye TaifaMfumo, si GDP ya
// taifa moja) -- dunia_taifa_hesabu_uchumi_wote (inayoitwa kwenye
// mchezo_sasisha, angalia juu) TAYARI inakokotoa jumla hii kama
// kigezo cha ndani (jumla_ya_pato, taifa.swa) lakini inaitupa isipokuwa
// jumla_nje != 0 ipitishwe -- mchezo_sasisha huipitisha 0 (jumla_tupu)
// kwa sasa. Badala ya kubadilisha wito huo (kungeongeza kigezo kimoja
// zaidi cha ndani kwenye mchezo_sasisha, ambayo TAYARI iko karibu
// sana na kikomo cha mkusanyaji cha vigezo 64 vya ndani -- angalia
// maoni ya mchezo_sasisha_mifumo_huru juu), tunajumlisha WENYEWE hapa
// kutoka kwa pato_ghafi ya kila taifa (tayari ZIMESASISHWA na wito wa
// mwisho wa mchezo_sasisha kabla ya zamu hii kumalizika).
d64 mchezo_hesabu_gdp_jumla(Mchezo* g) {
    d64 jumla = 0.0;
    kama (g == 0) { rudisha jumla; }
    TaifaMfumo* taifa = mchezo_pata_taifa(g);
    kama (taifa == 0) { rudisha jumla; }
    n32 i = 0;
    wakati (i < taifa->idadi) {
        TaifaNchi* t = dunia_taifa_mfumo_pata_kwa_faharisi(taifa, i);
        kama (t != 0) {
            jumla = jumla + t->uchumi.pato_ghafi;
        }
        i = i + 1;
    }
    rudisha jumla;
}

CivMatokeo mchezo_maliza_zamu(Mchezo* g) {
    CivMatokeo r;
    kama (g == 0) {
        r.hitilafu = CIV_HITILAFU_KIELEKEZI_TUPU;
        r.ujumbe = "Mchezo ni tupu";
        rudisha r;
    }
    g->zamu_ya_sasa = g->zamu_ya_sasa + 1;

    // Saa kuu (mwaka/siku) na wakala (maamuzi ya NPC) ni HALISI YA
    // ZAMU (per-turn), si ya kila mzunguko wa dt kama mchezo_sasisha
    // -- huitwa hapa, si kwenye mchezo_sasisha.
    InjiniSaaKuu* saa = mchezo_pata_saa_kuu(g);
    kama (saa != 0) { injini_saa_songesha_zamu(saa); }

    WakalaInjini* wakala = mchezo_pata_wakala(g);
    kama (wakala != 0 && saa != 0) {
        wakala_injini_sasisha_zamu(wakala, saa->mwaka_wa_ulimwengu, saa->siku_ya_ulimwengu);
    }

    // Mataifa hukua kila zamu; uchumi wao hukokotolewa upya mara moja
    // hapa ili sampuli ya GDP iliyo chini ionyeshe zamu hii.
    TaifaMfumo* taifa_zamu = mchezo_pata_taifa(g);
    Atlasi* atlasi_zamu = mchezo_pata_atlasi(g);
    DuniaRamani* ramani_zamu = mchezo_pata_ramani(g);
    kama (taifa_zamu != 0 && atlasi_zamu != 0 && ramani_zamu != 0) {
        dunia_atlasi_songesha_zamu(taifa_zamu, atlasi_zamu, g->zamu_ya_sasa);
        DuniaRasilimaliRamani* rm_zamu = 0;
        TaifaUchumi* jumla_zamu = 0;
        dunia_taifa_hesabu_uchumi_wote(taifa_zamu, ramani_zamu, rm_zamu, jumla_zamu);
    }

    // AWAMU D: sampuli MOJA ya GDP ya jumla ya dunia kwa kila zamu
    // iliyomalizika -- hapa (mchezo_maliza_zamu), SIYO mchezo_sasisha
    // (ambayo huendesha kwa kila dt, si kila zamu) -- kwa hiyo idadi
    // ya sampuli (gdp_historia->idadi) ni HASA sawa na idadi ya mara
    // mchezo_maliza_zamu imeitwa (= idadi ya zamu zilizomalizika).
    n64* historia_ya_mataifa = g->historia_ya_mataifa_addr;
    TaifaMfumo* taifa_ya_sampuli = mchezo_pata_taifa(g);
    kama (historia_ya_mataifa != 0 && taifa_ya_sampuli != 0) {
        n32 is = 0;
        wakati (is < taifa_ya_sampuli->idadi) {
            TaifaNchi* ts = dunia_taifa_mfumo_pata_kwa_faharisi(taifa_ya_sampuli, is);
            d64 pato_la_taifa = ts->uchumi.pato_ghafi;
            takwimu_historia_ongeza(historia_ya_mataifa[is], pato_la_taifa);
            is = is + 1;
        }
    }
    TakwimuHistoria* gdp_historia = mchezo_pata_gdp_historia(g);
    kama (gdp_historia != 0) {
        d64 gdp_jumla = mchezo_hesabu_gdp_jumla(g);
        takwimu_historia_ongeza(gdp_historia, gdp_jumla);
    }

    andika(d_tafsiri("m2"), g->zamu_ya_sasa, 0,0,0,0,0);
    r.hitilafu = CIV_SAWA;
    r.ujumbe = 0;
    rudisha r;
}

w0 mchezo_pumzisha(Mchezo* g) {
    kama (g != 0) { g->imesimamishwa = 1; }
}

w0 mchezo_endelea(Mchezo* g) {
    kama (g != 0) { g->imesimamishwa = 0; }
}

w0 mchezo_zima(Mchezo* g) {
    kama (g == 0) { rudisha; }
    g->inafanya_kazi = 0;
    g->hali_ya_mchezo = MCHEZO_HALI_INAZIMWA;

    InjiniMudaMfumo* muda = mchezo_pata_muda(g);
    kama (muda != 0) { injini_muda_uharibu(muda); }
    IdadiYaWatuMsimamizi* pm = mchezo_pata_idadi_ya_watu(g);
    kama (pm != 0) { idadi_ya_watu_uharibu(pm); }
    UtawalaSerikali* serikali = mchezo_pata_serikali(g);
    kama (serikali != 0) { utawala_serikali_uharibu(serikali); }
    DuniaMakaziMsimamizi* makazi = mchezo_pata_makazi(g);
    kama (makazi != 0) { dunia_makazi_msimamizi_uharibu(makazi); }
    DuniaRamani* ramani = mchezo_pata_ramani(g);
    kama (ramani != 0) { dunia_ramani_uharibu(ramani); }
    AkiliMfumo* akili = mchezo_pata_akili(g);
    kama (akili != 0) { akili_mfumo_uharibu(akili); }
    DiplomasiaMfumo* diplomasia = mchezo_pata_diplomasia(g);
    kama (diplomasia != 0) { diplomasia_uharibu(diplomasia); }

    TaifaMfumo* taifa = mchezo_pata_taifa(g);
    kama (taifa != 0) { dunia_taifa_mfumo_uharibu(taifa); }
    // baada ya mataifa: majina yao ni ya miji ya atlasi
    Atlasi* atlasi = mchezo_pata_atlasi(g);
    Miji* miji = mchezo_pata_miji(g);
    kama (miji != 0 && atlasi != 0) { atlasi_miji_uharibu(miji, atlasi->idadi); }
    kama (atlasi != 0) { atlasi_uharibu(atlasi); }
    UchumiMkuuMfumo* mkuu = mchezo_pata_uchumi_mkuu(g);
    kama (mkuu != 0) { uchumi_mkuu_uharibu(mkuu); }
    NguvukaziMfumo* nguvukazi = mchezo_pata_nguvukazi(g);
    kama (nguvukazi != 0) { nguvukazi_uharibu(nguvukazi); }
    SeraMfumo* sera = mchezo_pata_sera(g);
    kama (sera != 0) { sera_uharibu(sera); }
    KodiMfumo* kodi = mchezo_pata_kodi(g);
    kama (kodi != 0) { kodi_uharibu(kodi); }
    BajetiMfumo* bajeti = mchezo_pata_bajeti(g);
    kama (bajeti != 0) { bajeti_uharibu(bajeti); }
    BidhaaSoko* bidhaa = mchezo_pata_bidhaa(g);
    kama (bidhaa != 0) { bidhaa_soko_uharibu(bidhaa); }
    BenkiMfumo* benki = mchezo_pata_benki(g);
    kama (benki != 0) { benki_uharibu(benki); }
    KilimoMfumo* kilimo = mchezo_pata_kilimo(g);
    kama (kilimo != 0) { kilimo_uharibu(kilimo); }
    UchimbajiMfumo* uchimbaji = mchezo_pata_uchimbaji(g);
    kama (uchimbaji != 0) { uchimbaji_uharibu(uchimbaji); }
    MiundombinuMfumo* miundombinu = mchezo_pata_miundombinu(g);
    kama (miundombinu != 0) { miundombinu_uharibu(miundombinu); }
    ViwandaMfumo* viwanda = mchezo_pata_viwanda(g);
    kama (viwanda != 0) { viwanda_uharibu(viwanda); }
    NishatiMfumo* nishati = mchezo_pata_nishati(g);
    kama (nishati != 0) { nishati_uharibu(nishati); }
    MakaziMfumo* uchumi_makazi = mchezo_pata_uchumi_makazi(g);
    kama (uchumi_makazi != 0) { makazi_uharibu(uchumi_makazi); }
    ArdhiMfumo* ardhi = mchezo_pata_ardhi(g);
    kama (ardhi != 0) { ardhi_uharibu(ardhi); }
    MtajiMfumo* mtaji = mchezo_pata_mtaji(g);
    kama (mtaji != 0) { mtaji_uharibu(mtaji); }
    BiasharaNdaniMfumo* biashara_ndani = mchezo_pata_biashara_ndani(g);
    kama (biashara_ndani != 0) { biashara_ndani_uharibu(biashara_ndani); }
    BiasharaNjeMfumo* biashara_nje = mchezo_pata_biashara_nje(g);
    kama (biashara_nje != 0) { biashara_nje_uharibu(biashara_nje); }
    UvumbuziMfumo* uvumbuzi = mchezo_pata_uvumbuzi(g);
    kama (uvumbuzi != 0) { uvumbuzi_uharibu(uvumbuzi); }
    SokoHaramuMfumo* soko_haramu = mchezo_pata_soko_haramu(g);
    kama (soko_haramu != 0) { soko_haramu_uharibu(soko_haramu); }
    VitaMfumo* vita = mchezo_pata_vita(g);
    kama (vita != 0) { vita_uharibu(vita); }

    // Mifumo 5 ya utamaduni (kitambulisho, kuenea, itikadi, uigaji,
    // dini) HAIKUUHARIBIWA hapa KWA MAKUSUDI -- hakuna hata mmoja
    // wao anayetoa kazi ya "_uharibu"/"_mfumo_uharibu" (imethibitishwa
    // kwa kusoma faili zao halisi) -- ni pengo lililopo tayari kwenye
    // moduli hizo tano zenyewe, si kosa jipya la mchezo.swa.
    MatukioTukioMfumo* matukio_zima = mchezo_pata_matukio(g);
    kama (matukio_zima != 0) { matukio_tukio_mfumo_uharibu(matukio_zima); }
    WakalaInjini* wakala_zima = mchezo_pata_wakala(g);
    kama (wakala_zima != 0) { wakala_injini_uharibu(wakala_zima); }
    InjiniOkestra* okestra_zima = mchezo_pata_okestra(g);
    kama (okestra_zima != 0) { injini_okestra_uharibu(okestra_zima); }
    InjiniSaaKuu* saa_zima = mchezo_pata_saa_kuu(g);
    kama (saa_zima != 0) { injini_saa_uharibu(saa_zima); }
    InjiniUhifadhi* uhifadhi_zima = mchezo_pata_uhifadhi(g);
    kama (uhifadhi_zima != 0) { injini_uhifadhi_uharibu(uhifadhi_zima); }
    InjiniUtendaji* utendaji_zima = mchezo_pata_utendaji(g);
    kama (utendaji_zima != 0) { injini_utendaji_uharibu(utendaji_zima); }

    JeshiVitengoMfumo* jeshi_vitengo = mchezo_pata_jeshi_vitengo(g);
    kama (jeshi_vitengo != 0) { jeshi_vitengo_uharibu(jeshi_vitengo); }
    MapiganoMfumo* mapigano = mchezo_pata_mapigano(g);
    kama (mapigano != 0) { mapigano_mfumo_uharibu(mapigano); }
    UshindiMfumo* ushindi_zima = mchezo_pata_ushindi(g);
    kama (ushindi_zima != 0) { ushindi_mfumo_uharibu(ushindi_zima); }
    SiasaKikundiMfumo* kikundi_zima = mchezo_pata_kikundi(g);
    kama (kikundi_zima != 0) { siasa_kikundi_mfumo_uharibu(kikundi_zima); }
    TeknolojiaMfumo* teknolojia_zima = mchezo_pata_teknolojia(g);
    kama (teknolojia_zima != 0) { teknolojia_uharibu(teknolojia_zima); }
    MaarifaUtafiti* maarifa_zima = mchezo_pata_maarifa(g);
    kama (maarifa_zima != 0) { maarifa_uharibu(maarifa_zima); }

    DuniaMipakaHai* mipaka_hai_zima = mchezo_pata_mipaka_hai(g);
    kama (mipaka_hai_zima != 0) { dunia_mpaka_hai_uharibu(mipaka_hai_zima); }
    MazingiraMajangaMfumo* majanga_zima = mchezo_pata_majanga(g);
    kama (majanga_zima != 0) { mazingira_majanga_uharibu(majanga_zima); }
    DuniaEneoMsimamizi* eneo_zima = mchezo_pata_eneo(g);
    kama (eneo_zima != 0) { dunia_eneo_msimamizi_uharibu(eneo_zima); }

    mchezo_zima_mifumo_huru(g);
}

w0 mchezo_uharibu(Mchezo* g) {
    kama (g == 0) { rudisha; }
    mchezo_zima(g);
    achilia g;
}

// ---------------------------------------------------------------
// Uhifadhi/upakiaji KAMILI wa hali ya mchezo (state_persistence.c) --
// UANDISHI UPYA KAMILI (2026-10-03) wa toleo la kwanza (lililokuwa
// hapa kabla): lile toleo la kwanza lilitafsiri civ_state_persistence_t
// moja kwa moja (primitives za baiti ghafi tu, angalia uhifadhi.swa)
// na kisha likahifadhi muundo MMOJA BAPA (MchezoHifadhiData) wenye
// shamba 12 TU (4 za juu + 6 za usanidi + 2 za uchumi_mkuu) kama
// baiti ghafi moja kwa moja -- WIGO WAKE HALISI ulikuwa: hali_ya_mchezo/
// zamu_ya_sasa/inafanya_kazi/imesimamishwa, usanidi (bila jina/toleo --
// hizo ni n8* na muundo bapa hauwezi kuzihifadhi kama baiti ghafi),
// na uchumi_mkuu.kiwango_cha_kodi/matumizi_ya_serikali TU (mifumo
// mingine 46 kati ya 47 HAZIKUGUSWA KABISA). Sababu ya wigo huo
// mdogo ilikuwa thibitisho tatu: (1) #186 -- shamba la kielekezi cha
// muundo ndani ya muundo haihifadhi sahihi, (2) hakuna umbizaji wa
// d64 ndani ya mfuatano_umbiza wakati huo, (3) safu za ukubwa
// maalum ndani ya muundo haziwezi kuchanganuliwa -- yote matatu
// yalifanya muundo BAPA mmoja uonekane kama njia pekee salama.
//
// Tangu wakati huo tumepata (na tunatumia hapa chini): primitives za
// I/O za kiwango cha chini zenye kishikio cha FAILI (si muundo bapa)
// kwenye uhifadhi.swa (injini_uhifadhi_andika/soma_n32/n64/d64/n8/
// mfuatano) -- mtindo HUU HUU uliothibitishwa tayari na historia_db.swa
// (angalia faili hilo kwa precedent kamili). Kwa kutumia MKONDO wa
// maandishi ya moja kwa moja kwenye faili (si muundo bapa mmoja),
// tunaepuka vikwazo vyote vitatu vya hapo juu: hakuna haja ya
// kuhifadhi kielekezi cha muundo (tunaandika SHAMBA zake moja kwa
// moja), d64 inahifadhiwa kwa BIT-REINTERPRET (si maandishi), na
// safu za ukubwa maalum (zilizogawanywa kwenye shamba_0..N kwenye
// lugha hii) zinaandikwa kwa KUITA KAZI MOJA YA KUSAIDIA mara N
// (mfano: kifaa_0..kifaa_7 za SeraMfumo) -- hii ndiyo sababu
// UMBIZO LA FAILI LIMEBADILIKA KABISA (halisomani na faili za zamani
// za MchezoHifadhiData) -- SAWA NA USAHIHI, hakuna faili za kweli za
// wachezaji zinazohitaji kuhifadhiwa bado (angalia historia ya
// mradi: historia_db.swa ilifanya uamuzi uleule pale ilipobadilisha
// umbizo lake).
//
// WIGO (2026-10-03): mifumo YOTE 47 ya Mchezo sasa zina angalau
// safu zao za juu (scalar) zikihifadhiwa. Baadhi ya shamba
// yameachwa KWA MAKUSUDI (yametajwa kwenye maoni ya kazi husika
// hapa chini) kwa sababu mojawapo:
//   (a) ni anwani (n64 _addr) zinazorejelea KITU KINGINE (cross-
//       reference kama vile taifa->serikali_addr, au kabila_N/
//       lugha_N/imani_N za makazi) -- kuhifadhi anwani ghafi
//       haina maana baada ya kupakia tena (heap address mpya kabisa
//       kwenye mzunguko mpya wa programu) -- hazijahifadhiwa hadi
//       mfumo wa "ID thabiti" uwepo kwa marejeo haya,
//   (b) ni anwani za KAZI (function pointers -- wasikilizaji wa
//       muda, vishughulikia vya matukio, mifumo ya injini_okestra)
//       -- hazina maana KABISA zikipakiwa tena (anwani hubadilika
//       kila ujenzi wa programu),
//   (c) ni gridi kubwa isiyobadilika kivitendo na mchezo_sasisha wa
//       sasa (DuniaRamani.vipande, upana*urefu kipande -- inaweza
//       kuzalishwa upya kwa uhakika kutoka (upana,urefu,mbegu)),
//   (d) ni safu za ndani NESTED (safu ndani ya kiingilio cha safu
//       nyingine, mfano Shirika.wanachama/maazimio, UtawalaDesturi.
//       majukumu, UtawalaMwingiliano.washiriki, utamaduni
//       kitambulisho/kuenea/itikadi/uigaji/dini zote tano) -- hizi
//       huanza TUPU kwenye mchezo_anzisha ya sasa na HAZIJAZWI na
//       mchezo_sasisha (angalia maelezo ya wigo juu ya faili hili) --
//       tumehifadhi METADATA yao (idadi/uwezo) kama uthibitisho wa
//       muundo, lakini si maudhui ya kila kiingilio -- kazi ijayo
//       dhahiri, imeandikwa wazi kwenye kila kazi husika.
//
// Kila "mchezo_hifadhi_andika_<mfumo>"/"mchezo_hifadhi_soma_<mfumo>"
// ni JOZI inayolingana KABISA kwa mpangilio wa shamba -- mpangilio
// WOWOTE ukibadilika upande mmoja bila mwingine utasababisha data
// kusomwa vibaya kimya (hakuna majina ya "sehemu" kwenye faili,
// ni mkondo mmoja wa moja kwa moja, kama historia_db.swa).

n32 MCHEZO_HIFADHI_ALAMA = 1398227268; // "SWAD" (S=83,W=87,A=65,D=68) kama n32
n32 MCHEZO_HIFADHI_TOLEO = 1;

// ---------- usanidi ----------
w0 mchezo_hifadhi_andika_usanidi(n8* f, MchezoUsanidi* u) {
    injini_uhifadhi_andika_mfuatano(f, u->jina);
    injini_uhifadhi_andika_mfuatano(f, u->toleo);
    injini_uhifadhi_andika_n32(f, u->mwaka_wa_kuanza);
    injini_uhifadhi_andika_n32(f, u->ugumu);
    injini_uhifadhi_andika_n32(f, u->washa_mantiki_isiyo_wazi);
    injini_uhifadhi_andika_n32(f, u->washa_ufuatiliaji_wa_utegemezi);
    injini_uhifadhi_andika_n32(f, u->muda_wa_hifadhi_otomatiki);
    injini_uhifadhi_andika_n32(f, u->kiwango_cha_juu_cha_kumbukumbu_matukio);
}
w0 mchezo_hifadhi_soma_usanidi(n8* f, MchezoUsanidi* u) {
    u->jina = injini_uhifadhi_soma_mfuatano(f);
    u->toleo = injini_uhifadhi_soma_mfuatano(f);
    u->mwaka_wa_kuanza = injini_uhifadhi_soma_n32(f);
    u->ugumu = injini_uhifadhi_soma_n32(f);
    u->washa_mantiki_isiyo_wazi = injini_uhifadhi_soma_n32(f);
    u->washa_ufuatiliaji_wa_utegemezi = injini_uhifadhi_soma_n32(f);
    u->muda_wa_hifadhi_otomatiki = injini_uhifadhi_soma_n32(f);
    u->kiwango_cha_juu_cha_kumbukumbu_matukio = injini_uhifadhi_soma_n32(f);
}

// ---------- muda (InjiniMudaMfumo) ----------
// wasikilizaji (n64, kichwa cha orodha-kiungo ya wasikilizaji wa
// matukio ya muda) HAIHIFADHIWI kimakusudi -- ni anwani za kazi za
// mtumiaji (angalia (b) kwenye maelezo ya wigo juu ya faili).
w0 mchezo_hifadhi_andika_muda(n8* f, InjiniMudaMfumo* m) {
    kama (m == 0) { rudisha; }
    injini_uhifadhi_andika_n32(f, m->kalenda.mwaka);
    injini_uhifadhi_andika_n32(f, m->kalenda.mwezi);
    injini_uhifadhi_andika_n32(f, m->kalenda.siku);
    injini_uhifadhi_andika_n64(f, m->kalenda.jumla_ya_siku);
    injini_uhifadhi_andika_n32(f, m->kalenda.msimu);
    injini_uhifadhi_andika_n32(f, m->kasi_ya_wakati);
    injini_uhifadhi_andika_d64(f, m->kasi_ya_mchezo);
    injini_uhifadhi_andika_d64(f, m->muda_uliopita_hivi_karibuni);
    injini_uhifadhi_andika_d64(f, m->muda_uliokusanywa);
    injini_uhifadhi_andika_d64(f, m->kizidishi_0);
    injini_uhifadhi_andika_d64(f, m->kizidishi_1);
    injini_uhifadhi_andika_d64(f, m->kizidishi_2);
    injini_uhifadhi_andika_d64(f, m->kizidishi_3);
    injini_uhifadhi_andika_d64(f, m->kizidishi_4);
    injini_uhifadhi_andika_d64(f, m->kizidishi_5);
}
w0 mchezo_hifadhi_soma_muda(n8* f, InjiniMudaMfumo* m) {
    kama (m == 0) { rudisha; }
    m->kalenda.mwaka = injini_uhifadhi_soma_n32(f);
    m->kalenda.mwezi = injini_uhifadhi_soma_n32(f);
    m->kalenda.siku = injini_uhifadhi_soma_n32(f);
    m->kalenda.jumla_ya_siku = injini_uhifadhi_soma_n64(f);
    m->kalenda.msimu = injini_uhifadhi_soma_n32(f);
    m->kasi_ya_wakati = injini_uhifadhi_soma_n32(f);
    m->kasi_ya_mchezo = injini_uhifadhi_soma_d64(f);
    m->muda_uliopita_hivi_karibuni = injini_uhifadhi_soma_d64(f);
    m->muda_uliokusanywa = injini_uhifadhi_soma_d64(f);
    m->kizidishi_0 = injini_uhifadhi_soma_d64(f);
    m->kizidishi_1 = injini_uhifadhi_soma_d64(f);
    m->kizidishi_2 = injini_uhifadhi_soma_d64(f);
    m->kizidishi_3 = injini_uhifadhi_soma_d64(f);
    m->kizidishi_4 = injini_uhifadhi_soma_d64(f);
    m->kizidishi_5 = injini_uhifadhi_soma_d64(f);
}

// ---------- saa_kuu (InjiniSaaKuu) ----------
w0 mchezo_hifadhi_andika_saa_kuu(n8* f, InjiniSaaKuu* s) {
    kama (s == 0) { rudisha; }
    injini_uhifadhi_andika_n32(f, s->mwaka_wa_ulimwengu);
    injini_uhifadhi_andika_n32(f, s->siku_ya_ulimwengu);
    injini_uhifadhi_andika_n32(f, s->nambari_ya_zamu);
    injini_uhifadhi_andika_n32(f, s->zamu_kwa_mwaka);
    injini_uhifadhi_andika_d64(f, s->maendeleo_ya_siku);
}
w0 mchezo_hifadhi_soma_saa_kuu(n8* f, InjiniSaaKuu* s) {
    kama (s == 0) { rudisha; }
    s->mwaka_wa_ulimwengu = injini_uhifadhi_soma_n32(f);
    s->siku_ya_ulimwengu = injini_uhifadhi_soma_n32(f);
    s->nambari_ya_zamu = injini_uhifadhi_soma_n32(f);
    s->zamu_kwa_mwaka = injini_uhifadhi_soma_n32(f);
    s->maendeleo_ya_siku = injini_uhifadhi_soma_d64(f);
}

// ---------- idadi_ya_watu (IdadiYaWatuMsimamizi + DemografiaMfumo) ----------
w0 mchezo_hifadhi_andika_kundi_umri(n8* f, DemografiaKundiLaUmri* k) {
    injini_uhifadhi_andika_n32(f, k->umri_wa_chini);
    injini_uhifadhi_andika_n32(f, k->umri_wa_juu);
    injini_uhifadhi_andika_n32(f, k->idadi);
    injini_uhifadhi_andika_d64(f, k->kiwango_cha_uzazi);
    injini_uhifadhi_andika_d64(f, k->kiwango_cha_vifo);
}
w0 mchezo_hifadhi_soma_kundi_umri(n8* f, DemografiaKundiLaUmri* k) {
    k->umri_wa_chini = injini_uhifadhi_soma_n32(f);
    k->umri_wa_juu = injini_uhifadhi_soma_n32(f);
    k->idadi = injini_uhifadhi_soma_n32(f);
    k->kiwango_cha_uzazi = injini_uhifadhi_soma_d64(f);
    k->kiwango_cha_vifo = injini_uhifadhi_soma_d64(f);
}

w0 mchezo_hifadhi_andika_idadi_ya_watu(n8* f, IdadiYaWatuMsimamizi* m) {
    kama (m == 0) { rudisha; }
    injini_uhifadhi_andika_n64(f, m->demografia.idadi_jumla);
    mchezo_hifadhi_andika_kundi_umri(f, &m->demografia.kundi_0);
    mchezo_hifadhi_andika_kundi_umri(f, &m->demografia.kundi_1);
    mchezo_hifadhi_andika_kundi_umri(f, &m->demografia.kundi_2);
    mchezo_hifadhi_andika_kundi_umri(f, &m->demografia.kundi_3);
    mchezo_hifadhi_andika_kundi_umri(f, &m->demografia.kundi_4);
    mchezo_hifadhi_andika_kundi_umri(f, &m->demografia.kundi_5);
    mchezo_hifadhi_andika_kundi_umri(f, &m->demografia.kundi_6);
    injini_uhifadhi_andika_d64(f, m->demografia.uwiano_wa_jinsia);
    injini_uhifadhi_andika_d64(f, m->demografia.uwiano_wa_mjini);
    injini_uhifadhi_andika_d64(f, m->demografia.uwiano_wa_vijijini);
    injini_uhifadhi_andika_d64(f, m->demografia.muundo_wa_kikabila);
    injini_uhifadhi_andika_d64(f, m->kiwango_cha_uzazi);
    injini_uhifadhi_andika_d64(f, m->kiwango_cha_vifo);
    injini_uhifadhi_andika_d64(f, m->kiwango_cha_uhamiaji);
    injini_uhifadhi_andika_d64(f, m->kiwango_cha_ukuaji);
    injini_uhifadhi_andika_d64(f, m->ubora_wa_elimu);
    injini_uhifadhi_andika_d64(f, m->kiashiria_cha_afya);
    injini_uhifadhi_andika_d64(f, m->kuridhika);
    injini_uhifadhi_andika_mfuatano(f, m->eneo_0);
    injini_uhifadhi_andika_mfuatano(f, m->eneo_1);
    injini_uhifadhi_andika_mfuatano(f, m->eneo_2);
    injini_uhifadhi_andika_mfuatano(f, m->eneo_3);
    injini_uhifadhi_andika_mfuatano(f, m->eneo_4);
    injini_uhifadhi_andika_mfuatano(f, m->eneo_5);
    injini_uhifadhi_andika_mfuatano(f, m->eneo_6);
    injini_uhifadhi_andika_mfuatano(f, m->eneo_7);
    injini_uhifadhi_andika_n32(f, m->idadi_ya_maeneo);
}
w0 mchezo_hifadhi_soma_idadi_ya_watu(n8* f, IdadiYaWatuMsimamizi* m) {
    kama (m == 0) { rudisha; }
    m->demografia.idadi_jumla = injini_uhifadhi_soma_n64(f);
    mchezo_hifadhi_soma_kundi_umri(f, &m->demografia.kundi_0);
    mchezo_hifadhi_soma_kundi_umri(f, &m->demografia.kundi_1);
    mchezo_hifadhi_soma_kundi_umri(f, &m->demografia.kundi_2);
    mchezo_hifadhi_soma_kundi_umri(f, &m->demografia.kundi_3);
    mchezo_hifadhi_soma_kundi_umri(f, &m->demografia.kundi_4);
    mchezo_hifadhi_soma_kundi_umri(f, &m->demografia.kundi_5);
    mchezo_hifadhi_soma_kundi_umri(f, &m->demografia.kundi_6);
    m->demografia.uwiano_wa_jinsia = injini_uhifadhi_soma_d64(f);
    m->demografia.uwiano_wa_mjini = injini_uhifadhi_soma_d64(f);
    m->demografia.uwiano_wa_vijijini = injini_uhifadhi_soma_d64(f);
    m->demografia.muundo_wa_kikabila = injini_uhifadhi_soma_d64(f);
    m->kiwango_cha_uzazi = injini_uhifadhi_soma_d64(f);
    m->kiwango_cha_vifo = injini_uhifadhi_soma_d64(f);
    m->kiwango_cha_uhamiaji = injini_uhifadhi_soma_d64(f);
    m->kiwango_cha_ukuaji = injini_uhifadhi_soma_d64(f);
    m->ubora_wa_elimu = injini_uhifadhi_soma_d64(f);
    m->kiashiria_cha_afya = injini_uhifadhi_soma_d64(f);
    m->kuridhika = injini_uhifadhi_soma_d64(f);
    m->eneo_0 = injini_uhifadhi_soma_mfuatano(f);
    m->eneo_1 = injini_uhifadhi_soma_mfuatano(f);
    m->eneo_2 = injini_uhifadhi_soma_mfuatano(f);
    m->eneo_3 = injini_uhifadhi_soma_mfuatano(f);
    m->eneo_4 = injini_uhifadhi_soma_mfuatano(f);
    m->eneo_5 = injini_uhifadhi_soma_mfuatano(f);
    m->eneo_6 = injini_uhifadhi_soma_mfuatano(f);
    m->eneo_7 = injini_uhifadhi_soma_mfuatano(f);
    m->idadi_ya_maeneo = injini_uhifadhi_soma_n32(f);
}

// ---------- serikali (UtawalaSerikali) ----------
// HAIHIFADHIWI kimakusudi: nafasi (n64* safu ya UtawalaNafasi*,
// nafasi za kiserikali) na *_addr zote 15 (katiba/mtendaji/bunge/
// mahakama/baraza/kidini/taasisi_mfumo/mgawanyo_mfumo/rushwa_injini/
// uchaguzi_mfumo/vurugu/wizara_meneja/utumishi/haki_tamko/daftari/
// maendeleo_hali) -- hizi ni mifumo midogo YA ZIADA isiyounganishwa
// kama field zake za Mchezo (pengo lililopo tayari kwenye
// mchezo.swa, si jipya kwenye uhifadhi) -- kuzihifadhi kungehitaji
// kujua miundo yao kamili, ambayo haijatafsiriwa/kuunganishwa bado.
w0 mchezo_hifadhi_andika_serikali(n8* f, UtawalaSerikali* s) {
    kama (s == 0) { rudisha; }
    injini_uhifadhi_andika_mfuatano(f, s->kitambulisho);
    injini_uhifadhi_andika_mfuatano(f, s->jina);
    injini_uhifadhi_andika_d64(f, s->wasifu.umoja_wa_mamlaka);
    injini_uhifadhi_andika_d64(f, s->wasifu.kielezo_cha_uwakilishi);
    injini_uhifadhi_andika_d64(f, s->wasifu.ugumu_wa_kitaasisi);
    injini_uhifadhi_andika_d64(f, s->wasifu.usawa_wa_madaraka);
    injini_uhifadhi_andika_d64(f, s->wasifu.furaha_ya_wananchi);
    injini_uhifadhi_andika_d64(f, s->wasifu.kiwango_cha_utawala);
    injini_uhifadhi_andika_d64(f, s->utulivu);
    injini_uhifadhi_andika_d64(f, s->uhalali);
    injini_uhifadhi_andika_d64(f, s->ufanisi);
    injini_uhifadhi_andika_d64(f, s->afya.kielezo_cha_utulivu);
    injini_uhifadhi_andika_d64(f, s->afya.kielezo_cha_mshikamano);
    injini_uhifadhi_andika_d64(f, s->afya.kielezo_cha_rushwa);
    injini_uhifadhi_andika_d64(f, s->afya.kielezo_cha_ukali);
    injini_uhifadhi_andika_d64(f, s->afya.kasi_ya_mageuzi);
    injini_uhifadhi_andika_d64(f, s->afya.kielezo_cha_kidunia);
    injini_uhifadhi_andika_d64(f, s->afya.kielezo_cha_uhai);
    injini_uhifadhi_andika_d64(f, s->afya.mshikamano_wa_kiuchumi);
    injini_uhifadhi_andika_d64(f, s->afya.heshima_ya_kimataifa);
    injini_uhifadhi_andika_d64(f, s->afya.kielezo_cha_pato);
    injini_uhifadhi_andika_d64(f, s->afya.utulivu_wa_viwanda);
    injini_uhifadhi_andika_d64(f, s->mgao_0);
    injini_uhifadhi_andika_d64(f, s->mgao_1);
    injini_uhifadhi_andika_d64(f, s->mgao_2);
    injini_uhifadhi_andika_d64(f, s->mgao_3);
    injini_uhifadhi_andika_d64(f, s->mgao_4);
    injini_uhifadhi_andika_d64(f, s->mgao_5);
    injini_uhifadhi_andika_d64(f, s->mgao_6);
    injini_uhifadhi_andika_d64(f, s->mgao_7);
    injini_uhifadhi_andika_d64(f, s->mgao_8);
    injini_uhifadhi_andika_d64(f, s->kizingiti_cha_kibunge);
    injini_uhifadhi_andika_n32(f, s->zamu_tangu_kikao_cha_mwisho);
    injini_uhifadhi_andika_d64(f, s->uungwaji_wa_vikundi);
    injini_uhifadhi_andika_n32(f, s->idadi_ya_vikundi);
}
w0 mchezo_hifadhi_soma_serikali(n8* f, UtawalaSerikali* s) {
    kama (s == 0) { rudisha; }
    s->kitambulisho = injini_uhifadhi_soma_mfuatano(f);
    s->jina = injini_uhifadhi_soma_mfuatano(f);
    s->wasifu.umoja_wa_mamlaka = injini_uhifadhi_soma_d64(f);
    s->wasifu.kielezo_cha_uwakilishi = injini_uhifadhi_soma_d64(f);
    s->wasifu.ugumu_wa_kitaasisi = injini_uhifadhi_soma_d64(f);
    s->wasifu.usawa_wa_madaraka = injini_uhifadhi_soma_d64(f);
    s->wasifu.furaha_ya_wananchi = injini_uhifadhi_soma_d64(f);
    s->wasifu.kiwango_cha_utawala = injini_uhifadhi_soma_d64(f);
    s->utulivu = injini_uhifadhi_soma_d64(f);
    s->uhalali = injini_uhifadhi_soma_d64(f);
    s->ufanisi = injini_uhifadhi_soma_d64(f);
    s->afya.kielezo_cha_utulivu = injini_uhifadhi_soma_d64(f);
    s->afya.kielezo_cha_mshikamano = injini_uhifadhi_soma_d64(f);
    s->afya.kielezo_cha_rushwa = injini_uhifadhi_soma_d64(f);
    s->afya.kielezo_cha_ukali = injini_uhifadhi_soma_d64(f);
    s->afya.kasi_ya_mageuzi = injini_uhifadhi_soma_d64(f);
    s->afya.kielezo_cha_kidunia = injini_uhifadhi_soma_d64(f);
    s->afya.kielezo_cha_uhai = injini_uhifadhi_soma_d64(f);
    s->afya.mshikamano_wa_kiuchumi = injini_uhifadhi_soma_d64(f);
    s->afya.heshima_ya_kimataifa = injini_uhifadhi_soma_d64(f);
    s->afya.kielezo_cha_pato = injini_uhifadhi_soma_d64(f);
    s->afya.utulivu_wa_viwanda = injini_uhifadhi_soma_d64(f);
    s->mgao_0 = injini_uhifadhi_soma_d64(f);
    s->mgao_1 = injini_uhifadhi_soma_d64(f);
    s->mgao_2 = injini_uhifadhi_soma_d64(f);
    s->mgao_3 = injini_uhifadhi_soma_d64(f);
    s->mgao_4 = injini_uhifadhi_soma_d64(f);
    s->mgao_5 = injini_uhifadhi_soma_d64(f);
    s->mgao_6 = injini_uhifadhi_soma_d64(f);
    s->mgao_7 = injini_uhifadhi_soma_d64(f);
    s->mgao_8 = injini_uhifadhi_soma_d64(f);
    s->kizingiti_cha_kibunge = injini_uhifadhi_soma_d64(f);
    s->zamu_tangu_kikao_cha_mwisho = injini_uhifadhi_soma_n32(f);
    s->uungwaji_wa_vikundi = injini_uhifadhi_soma_d64(f);
    s->idadi_ya_vikundi = injini_uhifadhi_soma_n32(f);
}

// ---------- ramani (DuniaRamani) ----------
// vipande (n64* gridi ya upana*urefu DuniaRamaniKipande*) HAIHIFADHIWI
// kimakusudi -- angalia (c) kwenye maelezo ya wigo juu ya faili:
// gridi inazalishwa upya kwa uhakika kutoka (upana,urefu,mbegu) kupitia
// dunia_ramani_unda, na mchezo_sasisha iliyopunguzwa ya sasa haiandiki
// kwenye shamba za kila kipande (hakuna makazi yanayoundwa kiotomatiki
// yanayoweza kubadilisha msongamano_wa_watu/ushawishi_wa_kisiasa wa
// kipande -- angalia makazi hapa chini, idadi huanza 0).
w0 mchezo_hifadhi_andika_ramani(n8* f, DuniaRamani* r) {
    kama (r == 0) { rudisha; }
    injini_uhifadhi_andika_n32(f, r->upana);
    injini_uhifadhi_andika_n32(f, r->urefu);
    injini_uhifadhi_andika_d64(f, r->kiwango_cha_bahari);
    injini_uhifadhi_andika_n32(f, r->mbegu);
    injini_uhifadhi_andika_n32(f, r->idadi_ya_vipande_vya_ardhi);
    injini_uhifadhi_andika_n32(f, r->idadi_ya_vipande_vya_mto);
    injini_uhifadhi_andika_n32(f, r->idadi_ya_vipande_vya_mlima);
}
w0 mchezo_hifadhi_soma_ramani(n8* f, DuniaRamani* r) {
    kama (r == 0) { rudisha; }
    r->upana = injini_uhifadhi_soma_n32(f);
    r->urefu = injini_uhifadhi_soma_n32(f);
    r->kiwango_cha_bahari = injini_uhifadhi_soma_d64(f);
    r->mbegu = injini_uhifadhi_soma_n32(f);
    r->idadi_ya_vipande_vya_ardhi = injini_uhifadhi_soma_n32(f);
    r->idadi_ya_vipande_vya_mto = injini_uhifadhi_soma_n32(f);
    r->idadi_ya_vipande_vya_mlima = injini_uhifadhi_soma_n32(f);
}

// ---------- makazi (DuniaMakaziMsimamizi -- settlement manager) ----------
// kabila_0..7/lugha_0..7/imani_0..7 za DuniaMakazi (anwani za vitu
// vya kiutamaduni) HAZIHIFADHIWI kimakusudi -- angalia (a) kwenye
// maelezo ya wigo juu ya faili.
w0 mchezo_hifadhi_andika_kijiji(n8* f, DuniaMakazi* s) {
    injini_uhifadhi_andika_mfuatano(f, s->kitambulisho);
    injini_uhifadhi_andika_mfuatano(f, s->jina);
    injini_uhifadhi_andika_n32(f, s->kiwango);
    injini_uhifadhi_andika_d64(f, s->x);
    injini_uhifadhi_andika_d64(f, s->y);
    injini_uhifadhi_andika_n64(f, s->idadi_ya_watu);
    injini_uhifadhi_andika_d64(f, s->kiwango_cha_ukuaji);
    injini_uhifadhi_andika_d64(f, s->uvutio);
    injini_uhifadhi_andika_d64(f, s->elimu_ya_kusoma);
    injini_uhifadhi_andika_d64(f, s->kiwango_cha_afya);
    injini_uhifadhi_andika_d64(f, s->miundombinu.ubora_wa_barabara);
    injini_uhifadhi_andika_d64(f, s->miundombinu.ngome);
    injini_uhifadhi_andika_d64(f, s->miundombinu.uwezo_wa_bandari);
    injini_uhifadhi_andika_d64(f, s->miundombinu.usafi);
    injini_uhifadhi_andika_mfuatano(f, s->eneo_id);
    injini_uhifadhi_andika_n32(f, s->aina_ya_uzalishaji);
    injini_uhifadhi_andika_d64(f, s->maendeleo_ya_uzalishaji);
    injini_uhifadhi_andika_d64(f, s->lengo_la_uzalishaji);
    injini_uhifadhi_andika_n32(f, s->inazalisha);
    injini_uhifadhi_andika_d64(f, s->mavuno_ya_utamaduni);
    injini_uhifadhi_andika_d64(f, s->utamaduni_uliokusanywa);
    injini_uhifadhi_andika_n32(f, s->eneo_la_kipenyo);
    injini_uhifadhi_andika_d64(f, s->uaminifu);
    injini_uhifadhi_andika_d64(f, s->machafuko);
    injini_uhifadhi_andika_n32(f, s->kabila_kuu);
    injini_uhifadhi_andika_n32(f, s->lugha_kuu);
    injini_uhifadhi_andika_n32(f, s->imani_kuu);
}
w0 mchezo_hifadhi_soma_kijiji(n8* f, DuniaMakazi* s) {
    s->kitambulisho = injini_uhifadhi_soma_mfuatano(f);
    s->jina = injini_uhifadhi_soma_mfuatano(f);
    s->kiwango = injini_uhifadhi_soma_n32(f);
    s->x = injini_uhifadhi_soma_d64(f);
    s->y = injini_uhifadhi_soma_d64(f);
    s->idadi_ya_watu = injini_uhifadhi_soma_n64(f);
    s->kiwango_cha_ukuaji = injini_uhifadhi_soma_d64(f);
    s->uvutio = injini_uhifadhi_soma_d64(f);
    s->elimu_ya_kusoma = injini_uhifadhi_soma_d64(f);
    s->kiwango_cha_afya = injini_uhifadhi_soma_d64(f);
    s->miundombinu.ubora_wa_barabara = injini_uhifadhi_soma_d64(f);
    s->miundombinu.ngome = injini_uhifadhi_soma_d64(f);
    s->miundombinu.uwezo_wa_bandari = injini_uhifadhi_soma_d64(f);
    s->miundombinu.usafi = injini_uhifadhi_soma_d64(f);
    s->eneo_id = injini_uhifadhi_soma_mfuatano(f);
    s->aina_ya_uzalishaji = injini_uhifadhi_soma_n32(f);
    s->maendeleo_ya_uzalishaji = injini_uhifadhi_soma_d64(f);
    s->lengo_la_uzalishaji = injini_uhifadhi_soma_d64(f);
    s->inazalisha = injini_uhifadhi_soma_n32(f);
    s->mavuno_ya_utamaduni = injini_uhifadhi_soma_d64(f);
    s->utamaduni_uliokusanywa = injini_uhifadhi_soma_d64(f);
    s->eneo_la_kipenyo = injini_uhifadhi_soma_n32(f);
    s->uaminifu = injini_uhifadhi_soma_d64(f);
    s->machafuko = injini_uhifadhi_soma_d64(f);
    s->kabila_kuu = injini_uhifadhi_soma_n32(f);
    s->lugha_kuu = injini_uhifadhi_soma_n32(f);
    s->imani_kuu = injini_uhifadhi_soma_n32(f);
}
w0 mchezo_hifadhi_andika_makazi(n8* f, DuniaMakaziMsimamizi* m) {
    kama (m == 0) { rudisha; }
    injini_uhifadhi_andika_d64(f, m->umbali_wa_chini);
    injini_uhifadhi_andika_n32(f, m->idadi);
    n32 i = 0;
    wakati (i < m->idadi) {
        DuniaMakazi* s = m->makazi_yote[i];
        mchezo_hifadhi_andika_kijiji(f, s);
        i = i + 1;
    }
}
w0 mchezo_hifadhi_soma_makazi(n8* f, DuniaMakaziMsimamizi* m) {
    kama (m == 0) { rudisha; }
    m->umbali_wa_chini = injini_uhifadhi_soma_d64(f);
    n32 idadi_iliyohifadhiwa = injini_uhifadhi_soma_n32(f);
    // Rudisha manager kwenye hali tupu kabla ya kupakia upya -- vinginevyo
    // makazi ya chaguo-msingi (kama yapo) yangerudufiwa (angalia maelezo
    // ya jumla ya mbinu hii juu ya faili, karibu na mchezo_pakia).
    m->idadi = 0;
    n32 i = 0;
    wakati (i < idadi_iliyohifadhiwa) {
        DuniaMakazi* s = tenga(ukubwa(DuniaMakazi));
        mchezo_hifadhi_soma_kijiji(f, s);
        dunia_makazi_msimamizi_ongeza(m, s);
        i = i + 1;
    }
}

// ---------- akili (AkiliMfumo) ----------
// mkakati_ais/mbinu_ais (safu za anwani za vitu vya AI) HAZIHIFADHIWI
// kimakusudi -- ni miundo isiyojulikana kwa kikao hiki (haikuchunguzwa),
// na akili_mfumo_sasisha haionekani kubadilisha idadi zao kwa kila
// mzunguko -- metadata (idadi/uwezo) tu ndiyo inayohifadhiwa.
w0 mchezo_hifadhi_andika_akili(n8* f, AkiliMfumo* a) {
    kama (a == 0) { rudisha; }
    injini_uhifadhi_andika_n32(f, a->idadi_ya_mkakati);
    injini_uhifadhi_andika_n32(f, a->idadi_ya_mbinu);
    injini_uhifadhi_andika_n32(f, a->uwezo_wa_mkakati);
    injini_uhifadhi_andika_n32(f, a->uwezo_wa_mbinu);
}
w0 mchezo_hifadhi_soma_akili(n8* f, AkiliMfumo* a) {
    kama (a == 0) { rudisha; }
    a->idadi_ya_mkakati = injini_uhifadhi_soma_n32(f);
    a->idadi_ya_mbinu = injini_uhifadhi_soma_n32(f);
    a->uwezo_wa_mkakati = injini_uhifadhi_soma_n32(f);
    a->uwezo_wa_mbinu = injini_uhifadhi_soma_n32(f);
}

// ---------- diplomasia (DiplomasiaMfumo) ----------
w0 mchezo_hifadhi_andika_uhusiano(n8* f, DiplomasiaUhusiano* u) {
    injini_uhifadhi_andika_mfuatano(f, u->taifa_a);
    injini_uhifadhi_andika_mfuatano(f, u->taifa_b);
    injini_uhifadhi_andika_n32(f, u->kiwango_cha_uhusiano);
    injini_uhifadhi_andika_n32(f, u->msimamo_wa_sasa);
    injini_uhifadhi_andika_d64(f, u->imani);
    injini_uhifadhi_andika_d64(f, u->alama_ya_maoni);
    injini_uhifadhi_andika_n32(f, u->aina_ya_tabia);
    injini_uhifadhi_andika_d64(f, u->malalamiko);
    injini_uhifadhi_andika_mfuatano(f, u->sababu_kuu_ya_vita);
    injini_uhifadhi_andika_n64(f, u->ilisasishwa_mwisho);
}
w0 mchezo_hifadhi_soma_uhusiano(n8* f, DiplomasiaUhusiano* u) {
    u->taifa_a = injini_uhifadhi_soma_mfuatano(f);
    u->taifa_b = injini_uhifadhi_soma_mfuatano(f);
    u->kiwango_cha_uhusiano = injini_uhifadhi_soma_n32(f);
    u->msimamo_wa_sasa = injini_uhifadhi_soma_n32(f);
    u->imani = injini_uhifadhi_soma_d64(f);
    u->alama_ya_maoni = injini_uhifadhi_soma_d64(f);
    u->aina_ya_tabia = injini_uhifadhi_soma_n32(f);
    u->malalamiko = injini_uhifadhi_soma_d64(f);
    u->sababu_kuu_ya_vita = injini_uhifadhi_soma_mfuatano(f);
    u->ilisasishwa_mwisho = injini_uhifadhi_soma_n64(f);
}
w0 mchezo_hifadhi_andika_mkataba(n8* f, DiplomasiaMkataba* k) {
    injini_uhifadhi_andika_mfuatano(f, k->kitambulisho);
    injini_uhifadhi_andika_n32(f, k->aina);
    injini_uhifadhi_andika_mfuatano(f, k->mtia_saini_a);
    injini_uhifadhi_andika_mfuatano(f, k->mtia_saini_b);
    injini_uhifadhi_andika_n64(f, k->tarehe_ya_kuanza);
    injini_uhifadhi_andika_n32(f, k->muda_wa_siku);
    injini_uhifadhi_andika_n32(f, k->unafanya_kazi);
}
w0 mchezo_hifadhi_soma_mkataba(n8* f, DiplomasiaMkataba* k) {
    k->kitambulisho = injini_uhifadhi_soma_mfuatano(f);
    k->aina = injini_uhifadhi_soma_n32(f);
    k->mtia_saini_a = injini_uhifadhi_soma_mfuatano(f);
    k->mtia_saini_b = injini_uhifadhi_soma_mfuatano(f);
    k->tarehe_ya_kuanza = injini_uhifadhi_soma_n64(f);
    k->muda_wa_siku = injini_uhifadhi_soma_n32(f);
    k->unafanya_kazi = injini_uhifadhi_soma_n32(f);
}
w0 mchezo_hifadhi_andika_diplomasia(n8* f, DiplomasiaMfumo* d) {
    kama (d == 0) { rudisha; }
    injini_uhifadhi_andika_n32(f, d->idadi_ya_uhusiano);
    n32 i = 0;
    wakati (i < d->idadi_ya_uhusiano) {
        mchezo_hifadhi_andika_uhusiano(f, diplomasia_pata_uhusiano(d, i));
        i = i + 1;
    }
    injini_uhifadhi_andika_n32(f, d->idadi_ya_mikataba);
    i = 0;
    wakati (i < d->idadi_ya_mikataba) {
        mchezo_hifadhi_andika_mkataba(f, diplomasia_pata_mkataba(d, i));
        i = i + 1;
    }
}
w0 mchezo_hifadhi_soma_diplomasia(n8* f, DiplomasiaMfumo* d) {
    kama (d == 0) { rudisha; }
    // mahusiano yaliyoundwa na mchezo_anzisha hubadilishwa na yaliyohifadhiwa
    n32 i = 0;
    wakati (i < d->idadi_ya_uhusiano) { achilia d->mahusiano[i]; i = i + 1; }
    d->idadi_ya_uhusiano = 0;
    i = 0;
    wakati (i < d->idadi_ya_mikataba) { achilia d->mikataba[i]; i = i + 1; }
    d->idadi_ya_mikataba = 0;
    n32 n = injini_uhifadhi_soma_n32(f);
    i = 0;
    wakati (i < n) {
        mchezo_hifadhi_soma_uhusiano(f, diplomasia_ongeza_uhusiano_tupu(d));
        i = i + 1;
    }
    n = injini_uhifadhi_soma_n32(f);
    i = 0;
    wakati (i < n) {
        mchezo_hifadhi_soma_mkataba(f, diplomasia_ongeza_mkataba_tupu(d));
        i = i + 1;
    }
}

// ---------- taifa (TaifaMfumo -- safu ya TaifaNchi*) ----------
// serikali_addr/katiba_addr za kila TaifaNchi HAZIHIFADHIWI
// kimakusudi -- angalia (a) kwenye maelezo ya wigo juu ya faili
// (serikali/katiba ya kila taifa ni mifumo yake YENYEWE ambayo
// haijaunganishwa kama field za Mchezo).
w0 mchezo_hifadhi_andika_taifa_eneo(n8* f, TaifaEneo* e) {
    injini_uhifadhi_andika_d64(f, e->lon_chini);
    injini_uhifadhi_andika_d64(f, e->lon_juu);
    injini_uhifadhi_andika_d64(f, e->lat_chini);
    injini_uhifadhi_andika_d64(f, e->lat_juu);
}
w0 mchezo_hifadhi_soma_taifa_eneo(n8* f, TaifaEneo* e) {
    e->lon_chini = injini_uhifadhi_soma_d64(f);
    e->lon_juu = injini_uhifadhi_soma_d64(f);
    e->lat_chini = injini_uhifadhi_soma_d64(f);
    e->lat_juu = injini_uhifadhi_soma_d64(f);
}
w0 mchezo_hifadhi_andika_taifa_mgawanyo(n8* f, TaifaMgawanyo* g2) {
    injini_uhifadhi_andika_mfuatano(f, g2->jina);
    injini_uhifadhi_andika_mfuatano(f, g2->kitambulisho);
    injini_uhifadhi_andika_n32(f, g2->rangi);
    mchezo_hifadhi_andika_taifa_eneo(f, &g2->eneo);
}
w0 mchezo_hifadhi_soma_taifa_mgawanyo(n8* f, TaifaMgawanyo* g2) {
    g2->jina = injini_uhifadhi_soma_mfuatano(f);
    g2->kitambulisho = injini_uhifadhi_soma_mfuatano(f);
    g2->rangi = injini_uhifadhi_soma_n32(f);
    mchezo_hifadhi_soma_taifa_eneo(f, &g2->eneo);
}
w0 mchezo_hifadhi_andika_taifa_uchumi(n8* f, TaifaUchumi* u) {
    injini_uhifadhi_andika_d64(f, u->pato_ghafi);
    injini_uhifadhi_andika_d64(f, u->pato_kwa_kila_mtu);
    injini_uhifadhi_andika_d64(f, u->ukuaji_wa_pato);
    injini_uhifadhi_andika_d64(f, u->mfumuko);
    injini_uhifadhi_andika_d64(f, u->ukosefu_wa_kazi);
    injini_uhifadhi_andika_d64(f, u->mapato_ya_kodi);
    injini_uhifadhi_andika_d64(f, u->uzalishaji_wa_chakula);
    injini_uhifadhi_andika_d64(f, u->matumizi_ya_chakula);
    injini_uhifadhi_andika_d64(f, u->uzalishaji_wa_nishati);
    injini_uhifadhi_andika_d64(f, u->uzalishaji_wa_viwanda);
    injini_uhifadhi_andika_d64(f, u->malighafi);
    injini_uhifadhi_andika_d64(f, u->nguvukazi);
    injini_uhifadhi_andika_d64(f, u->mshahara_wa_wastani);
    injini_uhifadhi_andika_n32(f, u->vipande_vya_ardhi);
    injini_uhifadhi_andika_n32(f, u->vipande_vya_maji);
}
w0 mchezo_hifadhi_soma_taifa_uchumi(n8* f, TaifaUchumi* u) {
    u->pato_ghafi = injini_uhifadhi_soma_d64(f);
    u->pato_kwa_kila_mtu = injini_uhifadhi_soma_d64(f);
    u->ukuaji_wa_pato = injini_uhifadhi_soma_d64(f);
    u->mfumuko = injini_uhifadhi_soma_d64(f);
    u->ukosefu_wa_kazi = injini_uhifadhi_soma_d64(f);
    u->mapato_ya_kodi = injini_uhifadhi_soma_d64(f);
    u->uzalishaji_wa_chakula = injini_uhifadhi_soma_d64(f);
    u->matumizi_ya_chakula = injini_uhifadhi_soma_d64(f);
    u->uzalishaji_wa_nishati = injini_uhifadhi_soma_d64(f);
    u->uzalishaji_wa_viwanda = injini_uhifadhi_soma_d64(f);
    u->malighafi = injini_uhifadhi_soma_d64(f);
    u->nguvukazi = injini_uhifadhi_soma_d64(f);
    u->mshahara_wa_wastani = injini_uhifadhi_soma_d64(f);
    u->vipande_vya_ardhi = injini_uhifadhi_soma_n32(f);
    u->vipande_vya_maji = injini_uhifadhi_soma_n32(f);
}
w0 mchezo_hifadhi_andika_nchi(n8* f, TaifaNchi* t) {
    injini_uhifadhi_andika_mfuatano(f, t->kitambulisho);
    injini_uhifadhi_andika_mfuatano(f, t->jina);
    injini_uhifadhi_andika_n32(f, t->rangi);
    injini_uhifadhi_andika_n32(f, t->rangi_pambizo);
    injini_uhifadhi_andika_n32(f, t->data_id);
    injini_uhifadhi_andika_mfuatano(f, t->iso_a3);
    injini_uhifadhi_andika_mfuatano(f, t->iso_a2);
    mchezo_hifadhi_andika_taifa_eneo(f, &t->eneo_0);
    mchezo_hifadhi_andika_taifa_eneo(f, &t->eneo_1);
    mchezo_hifadhi_andika_taifa_eneo(f, &t->eneo_2);
    mchezo_hifadhi_andika_taifa_eneo(f, &t->eneo_3);
    mchezo_hifadhi_andika_taifa_eneo(f, &t->eneo_4);
    mchezo_hifadhi_andika_taifa_eneo(f, &t->eneo_5);
    mchezo_hifadhi_andika_taifa_eneo(f, &t->eneo_6);
    mchezo_hifadhi_andika_taifa_eneo(f, &t->eneo_7);
    injini_uhifadhi_andika_n32(f, t->idadi_ya_maeneo);
    injini_uhifadhi_andika_d64(f, t->mji_mkuu_lon);
    injini_uhifadhi_andika_d64(f, t->mji_mkuu_lat);
    mchezo_hifadhi_andika_taifa_mgawanyo(f, &t->mgawanyo_0);
    mchezo_hifadhi_andika_taifa_mgawanyo(f, &t->mgawanyo_1);
    mchezo_hifadhi_andika_taifa_mgawanyo(f, &t->mgawanyo_2);
    mchezo_hifadhi_andika_taifa_mgawanyo(f, &t->mgawanyo_3);
    mchezo_hifadhi_andika_taifa_mgawanyo(f, &t->mgawanyo_4);
    mchezo_hifadhi_andika_taifa_mgawanyo(f, &t->mgawanyo_5);
    mchezo_hifadhi_andika_taifa_mgawanyo(f, &t->mgawanyo_6);
    mchezo_hifadhi_andika_taifa_mgawanyo(f, &t->mgawanyo_7);
    mchezo_hifadhi_andika_taifa_mgawanyo(f, &t->mgawanyo_8);
    mchezo_hifadhi_andika_taifa_mgawanyo(f, &t->mgawanyo_9);
    mchezo_hifadhi_andika_taifa_mgawanyo(f, &t->mgawanyo_10);
    mchezo_hifadhi_andika_taifa_mgawanyo(f, &t->mgawanyo_11);
    mchezo_hifadhi_andika_taifa_mgawanyo(f, &t->mgawanyo_12);
    mchezo_hifadhi_andika_taifa_mgawanyo(f, &t->mgawanyo_13);
    mchezo_hifadhi_andika_taifa_mgawanyo(f, &t->mgawanyo_14);
    mchezo_hifadhi_andika_taifa_mgawanyo(f, &t->mgawanyo_15);
    injini_uhifadhi_andika_n32(f, t->idadi_ya_mgawanyo);
    mchezo_hifadhi_andika_taifa_uchumi(f, &t->uchumi);
    injini_uhifadhi_andika_n32(f, t->kielezo_cha_teknolojia);
    injini_uhifadhi_andika_n32(f, t->kielezo_cha_uchumi);
    injini_uhifadhi_andika_n32(f, t->kielezo_cha_kijeshi);
    injini_uhifadhi_andika_n32(f, t->kielezo_cha_utamaduni);
    injini_uhifadhi_andika_n64(f, t->idadi_ya_watu);
    injini_uhifadhi_andika_d64(f, t->gharama_ya_maisha);
    injini_uhifadhi_andika_d64(f, t->pato_kwa_kila_mtu);
}
w0 mchezo_hifadhi_soma_nchi(n8* f, TaifaNchi* t) {
    t->kitambulisho = injini_uhifadhi_soma_mfuatano(f);
    t->jina = injini_uhifadhi_soma_mfuatano(f);
    t->rangi = injini_uhifadhi_soma_n32(f);
    t->rangi_pambizo = injini_uhifadhi_soma_n32(f);
    t->data_id = injini_uhifadhi_soma_n32(f);
    t->iso_a3 = injini_uhifadhi_soma_mfuatano(f);
    t->iso_a2 = injini_uhifadhi_soma_mfuatano(f);
    mchezo_hifadhi_soma_taifa_eneo(f, &t->eneo_0);
    mchezo_hifadhi_soma_taifa_eneo(f, &t->eneo_1);
    mchezo_hifadhi_soma_taifa_eneo(f, &t->eneo_2);
    mchezo_hifadhi_soma_taifa_eneo(f, &t->eneo_3);
    mchezo_hifadhi_soma_taifa_eneo(f, &t->eneo_4);
    mchezo_hifadhi_soma_taifa_eneo(f, &t->eneo_5);
    mchezo_hifadhi_soma_taifa_eneo(f, &t->eneo_6);
    mchezo_hifadhi_soma_taifa_eneo(f, &t->eneo_7);
    t->idadi_ya_maeneo = injini_uhifadhi_soma_n32(f);
    t->mji_mkuu_lon = injini_uhifadhi_soma_d64(f);
    t->mji_mkuu_lat = injini_uhifadhi_soma_d64(f);
    mchezo_hifadhi_soma_taifa_mgawanyo(f, &t->mgawanyo_0);
    mchezo_hifadhi_soma_taifa_mgawanyo(f, &t->mgawanyo_1);
    mchezo_hifadhi_soma_taifa_mgawanyo(f, &t->mgawanyo_2);
    mchezo_hifadhi_soma_taifa_mgawanyo(f, &t->mgawanyo_3);
    mchezo_hifadhi_soma_taifa_mgawanyo(f, &t->mgawanyo_4);
    mchezo_hifadhi_soma_taifa_mgawanyo(f, &t->mgawanyo_5);
    mchezo_hifadhi_soma_taifa_mgawanyo(f, &t->mgawanyo_6);
    mchezo_hifadhi_soma_taifa_mgawanyo(f, &t->mgawanyo_7);
    mchezo_hifadhi_soma_taifa_mgawanyo(f, &t->mgawanyo_8);
    mchezo_hifadhi_soma_taifa_mgawanyo(f, &t->mgawanyo_9);
    mchezo_hifadhi_soma_taifa_mgawanyo(f, &t->mgawanyo_10);
    mchezo_hifadhi_soma_taifa_mgawanyo(f, &t->mgawanyo_11);
    mchezo_hifadhi_soma_taifa_mgawanyo(f, &t->mgawanyo_12);
    mchezo_hifadhi_soma_taifa_mgawanyo(f, &t->mgawanyo_13);
    mchezo_hifadhi_soma_taifa_mgawanyo(f, &t->mgawanyo_14);
    mchezo_hifadhi_soma_taifa_mgawanyo(f, &t->mgawanyo_15);
    t->idadi_ya_mgawanyo = injini_uhifadhi_soma_n32(f);
    mchezo_hifadhi_soma_taifa_uchumi(f, &t->uchumi);
    t->kielezo_cha_teknolojia = injini_uhifadhi_soma_n32(f);
    t->kielezo_cha_uchumi = injini_uhifadhi_soma_n32(f);
    t->kielezo_cha_kijeshi = injini_uhifadhi_soma_n32(f);
    t->kielezo_cha_utamaduni = injini_uhifadhi_soma_n32(f);
    t->idadi_ya_watu = injini_uhifadhi_soma_n64(f);
    t->gharama_ya_maisha = injini_uhifadhi_soma_d64(f);
    t->pato_kwa_kila_mtu = injini_uhifadhi_soma_d64(f);
    t->serikali_addr = 0;
    t->katiba_addr = 0;
}
w0 mchezo_hifadhi_andika_taifa(n8* f, TaifaMfumo* m) {
    kama (m == 0) { rudisha; }
    injini_uhifadhi_andika_n32(f, m->idadi);
    injini_uhifadhi_andika_n32(f, m->faharisi_ya_taifa_la_mchezaji);
    n32 i = 0;
    wakati (i < m->idadi) {
        TaifaNchi* t = m->mataifa[i];
        mchezo_hifadhi_andika_nchi(f, t);
        i = i + 1;
    }
}
w0 mchezo_hifadhi_soma_taifa(n8* f, TaifaMfumo* m) {
    kama (m == 0) { rudisha; }
    n32 idadi_iliyohifadhiwa = injini_uhifadhi_soma_n32(f);
    m->faharisi_ya_taifa_la_mchezaji = injini_uhifadhi_soma_n32(f);
    // Rudisha kwenye tupu kabla ya kujaza upya (mataifa 8 ya chaguo-
    // msingi yaliyoundwa na mchezo_anzisha yangerudufiwa vinginevyo --
    // angalia maelezo ya jumla karibu na mchezo_pakia). Nafasi
    // (m->uwezo) tayari ni ya kutosha kwa sababu haibadiliki baada ya
    // dunia_taifa_mfumo_unda (DUNIA_TAIFA_UWEZO_JUU).
    m->idadi = 0;
    n32 i = 0;
    wakati (i < idadi_iliyohifadhiwa) {
        TaifaNchi* t = tenga(ukubwa(TaifaNchi));
        mchezo_hifadhi_soma_nchi(f, t);
        m->mataifa[m->idadi] = t;
        m->idadi = m->idadi + 1;
        i = i + 1;
    }
}

// ---------- uchumi_mkuu (UchumiMkuuMfumo) ----------
w0 mchezo_hifadhi_andika_mkuu_sekta(n8* f, UchumiMkuuSekta* s) {
    injini_uhifadhi_andika_d64(f, s->pato);
    injini_uhifadhi_andika_d64(f, s->uzalishaji);
    injini_uhifadhi_andika_d64(f, s->kiwango_cha_ukuaji);
}
w0 mchezo_hifadhi_soma_mkuu_sekta(n8* f, UchumiMkuuSekta* s) {
