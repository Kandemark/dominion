    s->uzalishaji = injini_uhifadhi_soma_d64(f);
    s->kiwango_cha_ukuaji = injini_uhifadhi_soma_d64(f);
}
w0 mchezo_hifadhi_andika_mkuu_ripoti(n8* f, UchumiMkuuRipoti* r) {
    injini_uhifadhi_andika_d64(f, r->pato_la_taifa);
    injini_uhifadhi_andika_d64(f, r->pato_kwa_kila_mtu);
    injini_uhifadhi_andika_d64(f, r->kiwango_cha_ukosefu_wa_kazi);
    injini_uhifadhi_andika_d64(f, r->kiwango_cha_mfumuko);
    injini_uhifadhi_andika_d64(f, r->kiwango_cha_ukuaji);
    injini_uhifadhi_andika_d64(f, r->pato_la_kilimo);
    injini_uhifadhi_andika_d64(f, r->pato_la_viwanda);
    injini_uhifadhi_andika_d64(f, r->pato_la_huduma);
    injini_uhifadhi_andika_n32(f, r->hisia);
}
w0 mchezo_hifadhi_soma_mkuu_ripoti(n8* f, UchumiMkuuRipoti* r) {
    r->pato_la_taifa = injini_uhifadhi_soma_d64(f);
    r->pato_kwa_kila_mtu = injini_uhifadhi_soma_d64(f);
    r->kiwango_cha_ukosefu_wa_kazi = injini_uhifadhi_soma_d64(f);
    r->kiwango_cha_mfumuko = injini_uhifadhi_soma_d64(f);
    r->kiwango_cha_ukuaji = injini_uhifadhi_soma_d64(f);
    r->pato_la_kilimo = injini_uhifadhi_soma_d64(f);
    r->pato_la_viwanda = injini_uhifadhi_soma_d64(f);
    r->pato_la_huduma = injini_uhifadhi_soma_d64(f);
    r->hisia = injini_uhifadhi_soma_n32(f);
}
w0 mchezo_hifadhi_andika_uchumi_mkuu(n8* f, UchumiMkuuMfumo* m) {
    kama (m == 0) { rudisha; }
    injini_uhifadhi_andika_d64(f, m->kiwango_cha_kodi);
    injini_uhifadhi_andika_d64(f, m->matumizi_ya_serikali);
    injini_uhifadhi_andika_d64(f, m->pato_la_msingi);
    injini_uhifadhi_andika_d64(f, m->ukosefu_wa_kazi_wa_msingi);
    injini_uhifadhi_andika_d64(f, m->mfumuko_wa_msingi);
    mchezo_hifadhi_andika_mkuu_sekta(f, &m->kilimo);
    mchezo_hifadhi_andika_mkuu_sekta(f, &m->viwanda);
    mchezo_hifadhi_andika_mkuu_sekta(f, &m->huduma);
    injini_uhifadhi_andika_n32(f, m->hisia);
    injini_uhifadhi_andika_d64(f, m->mtikisiko_wa_soko);
    mchezo_hifadhi_andika_mkuu_ripoti(f, &m->ripoti_ya_mwisho);
}
w0 mchezo_hifadhi_soma_uchumi_mkuu(n8* f, UchumiMkuuMfumo* m) {
    kama (m == 0) { rudisha; }
    m->kiwango_cha_kodi = injini_uhifadhi_soma_d64(f);
    m->matumizi_ya_serikali = injini_uhifadhi_soma_d64(f);
    m->pato_la_msingi = injini_uhifadhi_soma_d64(f);
    m->ukosefu_wa_kazi_wa_msingi = injini_uhifadhi_soma_d64(f);
    m->mfumuko_wa_msingi = injini_uhifadhi_soma_d64(f);
    mchezo_hifadhi_soma_mkuu_sekta(f, &m->kilimo);
    mchezo_hifadhi_soma_mkuu_sekta(f, &m->viwanda);
    mchezo_hifadhi_soma_mkuu_sekta(f, &m->huduma);
    m->hisia = injini_uhifadhi_soma_n32(f);
    m->mtikisiko_wa_soko = injini_uhifadhi_soma_d64(f);
    mchezo_hifadhi_soma_mkuu_ripoti(f, &m->ripoti_ya_mwisho);
}

