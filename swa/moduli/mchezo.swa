// ---------- utamaduni x5 (kitambulisho/kuenea/itikadi/uigaji/dini) ----------
// Mifumo hii MITANO huanza TUPU (idadi=0) kwenye mchezo_anzisha ya
// sasa na HAIJAZWI na mchezo_sasisha (angalia maelezo ya wigo juu ya
// faili (d)) -- kila kiingilio chake kina safu zake za NDANI (mfano
// UtamaduniKitambulisho.sifa/thamani, UtamaduniItikadi.thamani_zote)
// ambazo zingehitaji tabaka la pili la uhifadhi lililowekwa (nested).
// Kwa kuwa hazijazwi na mzunguko wa sasa wa mchezo (hakuna thamani
// halisi ya kuthibitisha round-trip nayo), tumehifadhi METADATA
// (idadi/uwezo) TU kama uthibitisho wa muundo -- maudhui kamili ya
// kila kiingilio ni kazi ijayo wazi, itakapokuwa na data halisi ya
// kuhifadhi.
w0 mchezo_hifadhi_andika_utamaduni_metadata(n8* f, Mchezo* g) {
    UtamaduniKitambulishoMfumo* kit = mchezo_pata_utamaduni_kitambulisho(g);
    kama (kit != 0) {
        injini_uhifadhi_andika_n32(f, kit->idadi);
        injini_uhifadhi_andika_n32(f, kit->uwezo);
    } sivyo {
        injini_uhifadhi_andika_n32(f, 0);
        injini_uhifadhi_andika_n32(f, 0);
    }
    UtamaduniKuenea* kue = mchezo_pata_utamaduni_kuenea(g);
    kama (kue != 0) {
        injini_uhifadhi_andika_n32(f, kue->idadi_ya_matukio);
        injini_uhifadhi_andika_n32(f, kue->uwezo_wa_matukio);
    } sivyo {
        injini_uhifadhi_andika_n32(f, 0);
        injini_uhifadhi_andika_n32(f, 0);
    }
    UtamaduniItikadiMfumo* iti = mchezo_pata_utamaduni_itikadi(g);
    kama (iti != 0) {
        injini_uhifadhi_andika_n32(f, iti->idadi);
        injini_uhifadhi_andika_n32(f, iti->uwezo);
    } sivyo {
        injini_uhifadhi_andika_n32(f, 0);
        injini_uhifadhi_andika_n32(f, 0);
    }
    UtamaduniUigajiTracker* uig = mchezo_pata_utamaduni_uigaji(g);
    kama (uig != 0) {
        injini_uhifadhi_andika_n32(f, uig->idadi_ya_matukio);
        injini_uhifadhi_andika_n32(f, uig->uwezo_wa_matukio);
    } sivyo {
        injini_uhifadhi_andika_n32(f, 0);
        injini_uhifadhi_andika_n32(f, 0);
    }
    UtamaduniDiniMfumo* din = mchezo_pata_utamaduni_dini(g);
    kama (din != 0) {
        injini_uhifadhi_andika_n32(f, din->idadi);
        injini_uhifadhi_andika_n32(f, din->uwezo);
    } sivyo {
        injini_uhifadhi_andika_n32(f, 0);
        injini_uhifadhi_andika_n32(f, 0);
    }
}
w0 mchezo_hifadhi_soma_utamaduni_metadata(n8* f, Mchezo* g) {
    n32 a0 = injini_uhifadhi_soma_n32(f); n32 a1 = injini_uhifadhi_soma_n32(f);
    n32 b0 = injini_uhifadhi_soma_n32(f); n32 b1 = injini_uhifadhi_soma_n32(f);
    n32 c0 = injini_uhifadhi_soma_n32(f); n32 c1 = injini_uhifadhi_soma_n32(f);
    n32 d0 = injini_uhifadhi_soma_n32(f); n32 d1 = injini_uhifadhi_soma_n32(f);
    n32 e0 = injini_uhifadhi_soma_n32(f); n32 e1 = injini_uhifadhi_soma_n32(f);
    // Thamani hizi ni kwa ajili ya UKAGUZI/kulinganisha tu (metadata
    // haibadilishi hali hai ya g kwa sasa, kwa sababu idadi halisi za
    // mifumo hii TAYARI ni 0 baada ya mchezo_anzisha mpya -- angalia
    // maelezo juu). Zisipotumika moja kwa moja, bado zimesomwa kwa
    // mpangilio sahihi ili mkondo wa faili usichafuke kwa mifumo
    // inayofuata.
    n32 jumla_isiyotumika = a0 + a1 + b0 + b1 + c0 + c1 + d0 + d1 + e0 + e1;
    kama (jumla_isiyotumika < 0) { rudisha; }
}

// ---------- matukio (MatukioTukioMfumo) ----------
// vishughulikia (n64* -- anwani za KAZI za mtumiaji + data) HAZIHIFADHIWI
// kimakusudi -- angalia (b) kwenye maelezo ya wigo juu ya faili.
w0 mchezo_hifadhi_andika_tukio(n8* f, MatukioTukio* t) {
    injini_uhifadhi_andika_n32(f, t->nambari_ya_tukio);
    injini_uhifadhi_andika_n32(f, t->aina);
    injini_uhifadhi_andika_mfuatano(f, t->kichwa);
    injini_uhifadhi_andika_mfuatano(f, t->maelezo);
    injini_uhifadhi_andika_d64(f, t->umuhimu);
    injini_uhifadhi_andika_d64(f, t->wakati_uliotokea);
    injini_uhifadhi_andika_n32(f, t->linafanya_kazi);
}
w0 mchezo_hifadhi_soma_tukio(n8* f, MatukioTukio* t) {
    t->nambari_ya_tukio = injini_uhifadhi_soma_n32(f);
    t->aina = injini_uhifadhi_soma_n32(f);
    t->kichwa = injini_uhifadhi_soma_mfuatano(f);
    t->maelezo = injini_uhifadhi_soma_mfuatano(f);
    t->umuhimu = injini_uhifadhi_soma_d64(f);
    t->wakati_uliotokea = injini_uhifadhi_soma_d64(f);
    t->linafanya_kazi = injini_uhifadhi_soma_n32(f);
}
w0 mchezo_hifadhi_andika_matukio(n8* f, MatukioTukioMfumo* em) {
    kama (em == 0) { rudisha; }
    injini_uhifadhi_andika_n32(f, em->idadi_ya_matukio);
    injini_uhifadhi_andika_d64(f, em->muda_wa_mwisho);
    n32 i = 0;
    wakati (i < em->idadi_ya_matukio) {
        MatukioTukio* t = em->matukio[i];
        mchezo_hifadhi_andika_tukio(f, t);
        i = i + 1;
    }
}
w0 mchezo_hifadhi_soma_matukio(n8* f, MatukioTukioMfumo* em) {
    kama (em == 0) { rudisha; }
    n32 idadi_iliyohifadhiwa = injini_uhifadhi_soma_n32(f);
    em->muda_wa_mwisho = injini_uhifadhi_soma_d64(f);
    n32 i = 0;
    wakati (i < idadi_iliyohifadhiwa) {
        MatukioTukio* t = tenga(ukubwa(MatukioTukio));
        mchezo_hifadhi_soma_tukio(f, t);
        matukio_tukio_toa(em, t);
        i = i + 1;
    }
}

// ---------- wakala (WakalaInjini) ----------
w0 mchezo_hifadhi_andika_mwakala(n8* f, Wakala* w) {
    injini_uhifadhi_andika_mfuatano(f, w->jina);
    injini_uhifadhi_andika_mfuatano(f, w->jukumu);
    injini_uhifadhi_andika_d64(f, w->itikadi.mila_dhidi_ya_maendeleo);
    injini_uhifadhi_andika_d64(f, w->itikadi.kimabavu_dhidi_ya_huria);
    injini_uhifadhi_andika_d64(f, w->itikadi.utaifa_dhidi_ya_udunia);
    injini_uhifadhi_andika_d64(f, w->itikadi.kijeshi_dhidi_ya_amani);
    injini_uhifadhi_andika_d64(f, w->itikadi.kibiashara_dhidi_ya_kilimo);
    injini_uhifadhi_andika_d64(f, w->itikadi.kidini_dhidi_ya_kilimwengu);
    injini_uhifadhi_andika_d64(f, w->ushawishi);
    injini_uhifadhi_andika_d64(f, w->rushwa);
    injini_uhifadhi_andika_d64(f, w->umahiri);
    injini_uhifadhi_andika_n32(f, w->umri);
    injini_uhifadhi_andika_mfuatano(f, w->taifa_id);
}
w0 mchezo_hifadhi_soma_mwakala(n8* f, Wakala* w) {
    w->jina = injini_uhifadhi_soma_mfuatano(f);
    w->jukumu = injini_uhifadhi_soma_mfuatano(f);
    w->itikadi.mila_dhidi_ya_maendeleo = injini_uhifadhi_soma_d64(f);
    w->itikadi.kimabavu_dhidi_ya_huria = injini_uhifadhi_soma_d64(f);
    w->itikadi.utaifa_dhidi_ya_udunia = injini_uhifadhi_soma_d64(f);
    w->itikadi.kijeshi_dhidi_ya_amani = injini_uhifadhi_soma_d64(f);
    w->itikadi.kibiashara_dhidi_ya_kilimo = injini_uhifadhi_soma_d64(f);
    w->itikadi.kidini_dhidi_ya_kilimwengu = injini_uhifadhi_soma_d64(f);
    w->ushawishi = injini_uhifadhi_soma_d64(f);
    w->rushwa = injini_uhifadhi_soma_d64(f);
    w->umahiri = injini_uhifadhi_soma_d64(f);
    w->umri = injini_uhifadhi_soma_n32(f);
    w->taifa_id = injini_uhifadhi_soma_mfuatano(f);
}
w0 mchezo_hifadhi_andika_uamuzi(n8* f, WakalaUamuzi* u) {
    injini_uhifadhi_andika_mfuatano(f, u->muigizaji);
    injini_uhifadhi_andika_mfuatano(f, u->taifa);
    injini_uhifadhi_andika_n32(f, u->mwaka);
    injini_uhifadhi_andika_n32(f, u->siku);
    injini_uhifadhi_andika_n32(f, u->kundi);
    injini_uhifadhi_andika_n32(f, u->ni_rushwa);
    injini_uhifadhi_andika_d64(f, u->athari_ya_uthabiti);
    injini_uhifadhi_andika_d64(f, u->athari_ya_uchumi);
    injini_uhifadhi_andika_d64(f, u->athari_ya_kidiplomasia);
}
w0 mchezo_hifadhi_soma_uamuzi(n8* f, WakalaUamuzi* u) {
    u->muigizaji = injini_uhifadhi_soma_mfuatano(f);
    u->taifa = injini_uhifadhi_soma_mfuatano(f);
    u->mwaka = injini_uhifadhi_soma_n32(f);
    u->siku = injini_uhifadhi_soma_n32(f);
    u->kundi = injini_uhifadhi_soma_n32(f);
    u->ni_rushwa = injini_uhifadhi_soma_n32(f);
    u->athari_ya_uthabiti = injini_uhifadhi_soma_d64(f);
    u->athari_ya_uchumi = injini_uhifadhi_soma_d64(f);
    u->athari_ya_kidiplomasia = injini_uhifadhi_soma_d64(f);
}
w0 mchezo_hifadhi_andika_wakala(n8* f, WakalaInjini* eng) {
    kama (eng == 0) { rudisha; }
    injini_uhifadhi_andika_n32(f, eng->idadi_ya_wakala);
    n32 i = 0;
    wakati (i < eng->idadi_ya_wakala) {
        Wakala* w = eng->wakala_wote[i];
        mchezo_hifadhi_andika_mwakala(f, w);
        i = i + 1;
    }
    mchezo_hifadhi_andika_uamuzi(f, &eng->uamuzi_0);
    mchezo_hifadhi_andika_uamuzi(f, &eng->uamuzi_1);
    mchezo_hifadhi_andika_uamuzi(f, &eng->uamuzi_2);
    mchezo_hifadhi_andika_uamuzi(f, &eng->uamuzi_3);
    mchezo_hifadhi_andika_uamuzi(f, &eng->uamuzi_4);
    mchezo_hifadhi_andika_uamuzi(f, &eng->uamuzi_5);
    mchezo_hifadhi_andika_uamuzi(f, &eng->uamuzi_6);
    mchezo_hifadhi_andika_uamuzi(f, &eng->uamuzi_7);
    injini_uhifadhi_andika_n32(f, eng->idadi_ya_maamuzi);
    injini_uhifadhi_andika_n32(f, eng->kichwa_cha_pete);
}
w0 mchezo_hifadhi_soma_wakala(n8* f, WakalaInjini* eng) {
    kama (eng == 0) { rudisha; }
    n32 idadi_iliyohifadhiwa = injini_uhifadhi_soma_n32(f);
    // Rudisha kwenye tupu kabla ya kujaza upya (angalia maelezo ya
    // jumla karibu na mchezo_pakia).
    eng->idadi_ya_wakala = 0;
    n32 i = 0;
    wakati (i < idadi_iliyohifadhiwa) {
        n8* jina_tupu = "";
        n8* jukumu_tupu = "";
        n8* taifa_tupu = "";
        Wakala* w = wakala_injini_ongeza(eng, jina_tupu, jukumu_tupu, taifa_tupu);
        mchezo_hifadhi_soma_mwakala(f, w);
        i = i + 1;
    }
    mchezo_hifadhi_soma_uamuzi(f, &eng->uamuzi_0);
    mchezo_hifadhi_soma_uamuzi(f, &eng->uamuzi_1);
    mchezo_hifadhi_soma_uamuzi(f, &eng->uamuzi_2);
    mchezo_hifadhi_soma_uamuzi(f, &eng->uamuzi_3);
    mchezo_hifadhi_soma_uamuzi(f, &eng->uamuzi_4);
    mchezo_hifadhi_soma_uamuzi(f, &eng->uamuzi_5);
    mchezo_hifadhi_soma_uamuzi(f, &eng->uamuzi_6);
    mchezo_hifadhi_soma_uamuzi(f, &eng->uamuzi_7);
    eng->idadi_ya_maamuzi = injini_uhifadhi_soma_n32(f);
    eng->kichwa_cha_pete = injini_uhifadhi_soma_n32(f);
}

// ---------- injini_okestra + injini_utendaji ----------
// Zote mbili zina safu zenye vipengele vya ANWANI ZA KAZI (function
// pointers -- InjiniMfumo.update_fn/n.k. kwa okestra) au hazijaza
// kabisa na mchezo_sasisha ya sasa (utendaji -- angalia maelezo ya
// wigo juu ya faili). Metadata TU inahifadhiwa.
w0 mchezo_hifadhi_andika_okestra_utendaji(n8* f, InjiniOkestra* ok, InjiniUtendaji* ut) {
    kama (ok != 0) {
        injini_uhifadhi_andika_n32(f, ok->idadi);
        injini_uhifadhi_andika_n32(f, ok->idadi_ya_mpangilio);
    } sivyo {
        injini_uhifadhi_andika_n32(f, 0);
        injini_uhifadhi_andika_n32(f, 0);
    }
    kama (ut != 0) {
        injini_uhifadhi_andika_n32(f, ut->idadi_ya_vipimo);
        injini_uhifadhi_andika_n32(f, ut->ufuatiliaji_umewashwa);
        injini_uhifadhi_andika_d64(f, ut->kizingiti_cha_uboreshaji);
        injini_uhifadhi_andika_n64(f, ut->jumla_ya_wito);
        injini_uhifadhi_andika_d64(f, ut->jumla_ya_muda_wa_utekelezaji);
    } sivyo {
        injini_uhifadhi_andika_n32(f, 0);
        injini_uhifadhi_andika_n32(f, 0);
        injini_uhifadhi_andika_d64(f, 0.0);
        injini_uhifadhi_andika_n64(f, 0);
        injini_uhifadhi_andika_d64(f, 0.0);
    }
}
w0 mchezo_hifadhi_soma_okestra_utendaji(n8* f, InjiniUtendaji* ut) {
    n32 ok_idadi = injini_uhifadhi_soma_n32(f);
    n32 ok_mpangilio = injini_uhifadhi_soma_n32(f);
    n32 dummy_jumla = ok_idadi + ok_mpangilio;
    kama (ut == 0) {
        n32 a0 = injini_uhifadhi_soma_n32(f);
        n32 a1 = injini_uhifadhi_soma_n32(f);
        d64 a2 = injini_uhifadhi_soma_d64(f);
        n64 a3 = injini_uhifadhi_soma_n64(f);
        d64 a4 = injini_uhifadhi_soma_d64(f);
        rudisha;
    }
    n32 idadi_v = injini_uhifadhi_soma_n32(f);
    ut->ufuatiliaji_umewashwa = injini_uhifadhi_soma_n32(f);
    ut->kizingiti_cha_uboreshaji = injini_uhifadhi_soma_d64(f);
    ut->jumla_ya_wito = injini_uhifadhi_soma_n64(f);
    ut->jumla_ya_muda_wa_utekelezaji = injini_uhifadhi_soma_d64(f);
    kama (dummy_jumla < 0 || idadi_v < 0) { rudisha; }
}

// ---------- jeshi (vitengo/mapigano/ushindi) ----------
// Metadata tu -- mifumo hii ni ya TUKIO/KITENDO (si "sasisha zote"
// ya kila mzunguko -- angalia maelezo ndani ya mchezo_sasisha_mifumo_huru
// na mchezo_sasisha), kwa hiyo mazingira ya kawaida ya jaribio hili
// (mizunguko ya dt bila vitendo vya mchezaji) hayaongezi vitengo/
// mapigano/matukio ya ushindi -- kuandika maudhui kamili (ambayo
// pia hayana anwani za marejeo kuwa shida) ni kazi ya thamani ndogo
// kwa toleo hili, imeachwa kwa makusudi.
w0 mchezo_hifadhi_andika_jeshi_metadata(n8* f, Mchezo* g) {
    JeshiVitengoMfumo* v = mchezo_pata_jeshi_vitengo(g);
    kama (v != 0) { injini_uhifadhi_andika_n32(f, v->idadi); } sivyo { injini_uhifadhi_andika_n32(f, 0); }
    MapiganoMfumo* mp = mchezo_pata_mapigano(g);
    kama (mp != 0) { injini_uhifadhi_andika_n32(f, mp->idadi_ya_historia); } sivyo { injini_uhifadhi_andika_n32(f, 0); }
    UshindiMfumo* us = mchezo_pata_ushindi(g);
    kama (us != 0) {
        injini_uhifadhi_andika_n32(f, us->idadi_ya_matukio);
        injini_uhifadhi_andika_d64(f, us->kiwango_cha_msingi_cha_ushindi);
        injini_uhifadhi_andika_d64(f, us->kizidishi_cha_nyara);
    } sivyo {
        injini_uhifadhi_andika_n32(f, 0);
        injini_uhifadhi_andika_d64(f, 0.0);
        injini_uhifadhi_andika_d64(f, 0.0);
    }
}
w0 mchezo_hifadhi_soma_jeshi_metadata(n8* f, Mchezo* g) {
    n32 v_idadi = injini_uhifadhi_soma_n32(f);
    n32 mp_idadi = injini_uhifadhi_soma_n32(f);
    UshindiMfumo* us = mchezo_pata_ushindi(g);
    n32 us_idadi = injini_uhifadhi_soma_n32(f);
    d64 us_msingi = injini_uhifadhi_soma_d64(f);
    d64 us_kizidishi = injini_uhifadhi_soma_d64(f);
    kama (us != 0) {
        us->kiwango_cha_msingi_cha_ushindi = us_msingi;
        us->kizidishi_cha_nyara = us_kizidishi;
    }
    n32 dummy = v_idadi + mp_idadi + us_idadi;
    kama (dummy < 0) { rudisha; }
}

// ---------- kikundi / siasa_kikundi (SiasaKikundiMfumo -- vyama) ----------
w0 mchezo_hifadhi_andika_kikundi_kimoja(n8* f, SiasaKikundi* k) {
    injini_uhifadhi_andika_mfuatano(f, k->kitambulisho);
    injini_uhifadhi_andika_mfuatano(f, k->jina);
    injini_uhifadhi_andika_n32(f, k->itikadi);
    injini_uhifadhi_andika_d64(f, k->uungwaji_mkono);
    injini_uhifadhi_andika_d64(f, k->ushawishi);
    injini_uhifadhi_andika_d64(f, k->nguvu);
    injini_uhifadhi_andika_d64(f, k->uaminifu);
    injini_uhifadhi_andika_d64(f, k->tamaa);
}
w0 mchezo_hifadhi_soma_kikundi_kimoja(n8* f, SiasaKikundi* k) {
    k->kitambulisho = injini_uhifadhi_soma_mfuatano(f);
    k->jina = injini_uhifadhi_soma_mfuatano(f);
    k->itikadi = injini_uhifadhi_soma_n32(f);
    k->uungwaji_mkono = injini_uhifadhi_soma_d64(f);
    k->ushawishi = injini_uhifadhi_soma_d64(f);
    k->nguvu = injini_uhifadhi_soma_d64(f);
    k->uaminifu = injini_uhifadhi_soma_d64(f);
    k->tamaa = injini_uhifadhi_soma_d64(f);
}
w0 mchezo_hifadhi_andika_kikundi(n8* f, SiasaKikundiMfumo* m) {
    kama (m == 0) { rudisha; }
    injini_uhifadhi_andika_n32(f, m->idadi);
    n32 i = 0;
    wakati (i < m->idadi) {
        SiasaKikundi* k = &m->vikundi[i];
        mchezo_hifadhi_andika_kikundi_kimoja(f, k);
        i = i + 1;
    }
}
w0 mchezo_hifadhi_soma_kikundi(n8* f, SiasaKikundiMfumo* m) {
    kama (m == 0) { rudisha; }
    n32 idadi_iliyohifadhiwa = injini_uhifadhi_soma_n32(f);
    m->idadi = 0;
    n32 i = 0;
    wakati (i < idadi_iliyohifadhiwa) {
        SiasaKikundi kv;
        mchezo_hifadhi_soma_kikundi_kimoja(f, &kv);
        siasa_kikundi_mfumo_ongeza(m, &kv);
        i = i + 1;
    }
}

// ---------- teknolojia (TeknolojiaMfumo) ----------
w0 mchezo_hifadhi_andika_teknolojia(n8* f, TeknolojiaMfumo* m) {
    kama (m == 0) { rudisha; }
    injini_uhifadhi_andika_d64(f, m->bajeti_jumla);
    n32 i = 0;
    wakati (i < TEKNOLOJIA_IDADI_YA_NYANJA) {
        injini_uhifadhi_andika_n32(f, m->kiwango[i]);
        injini_uhifadhi_andika_n32(f, m->cheo_duniani[i]);
        injini_uhifadhi_andika_n32(f, m->wastani_duniani[i]);
        i = i + 1;
    }
    injini_uhifadhi_andika_n32(f, m->kiwango_jumla);
    injini_uhifadhi_andika_n32(f, m->cheo_jumla);
    injini_uhifadhi_andika_d64(f, m->mgao_0); injini_uhifadhi_andika_d64(f, m->mgao_1);
    injini_uhifadhi_andika_d64(f, m->mgao_2); injini_uhifadhi_andika_d64(f, m->mgao_3);
    injini_uhifadhi_andika_d64(f, m->mgao_4); injini_uhifadhi_andika_d64(f, m->mgao_5);
    injini_uhifadhi_andika_d64(f, m->mgao_6); injini_uhifadhi_andika_d64(f, m->mgao_7);
    injini_uhifadhi_andika_d64(f, m->mgao_8); injini_uhifadhi_andika_d64(f, m->mgao_9);
    injini_uhifadhi_andika_d64(f, m->mgao_10); injini_uhifadhi_andika_d64(f, m->mgao_11);
    injini_uhifadhi_andika_d64(f, m->kasi_0); injini_uhifadhi_andika_d64(f, m->kasi_1);
    injini_uhifadhi_andika_d64(f, m->kasi_2); injini_uhifadhi_andika_d64(f, m->kasi_3);
    injini_uhifadhi_andika_d64(f, m->kasi_4); injini_uhifadhi_andika_d64(f, m->kasi_5);
    injini_uhifadhi_andika_d64(f, m->kasi_6); injini_uhifadhi_andika_d64(f, m->kasi_7);
    injini_uhifadhi_andika_d64(f, m->kasi_8); injini_uhifadhi_andika_d64(f, m->kasi_9);
    injini_uhifadhi_andika_d64(f, m->kasi_10); injini_uhifadhi_andika_d64(f, m->kasi_11);
}
w0 mchezo_hifadhi_soma_teknolojia(n8* f, TeknolojiaMfumo* m) {
    kama (m == 0) { rudisha; }
    m->bajeti_jumla = injini_uhifadhi_soma_d64(f);
    n32 i = 0;
    wakati (i < TEKNOLOJIA_IDADI_YA_NYANJA) {
        m->kiwango[i] = injini_uhifadhi_soma_n32(f);
        m->cheo_duniani[i] = injini_uhifadhi_soma_n32(f);
        m->wastani_duniani[i] = injini_uhifadhi_soma_n32(f);
        i = i + 1;
    }
    m->kiwango_jumla = injini_uhifadhi_soma_n32(f);
    m->cheo_jumla = injini_uhifadhi_soma_n32(f);
    m->mgao_0 = injini_uhifadhi_soma_d64(f); m->mgao_1 = injini_uhifadhi_soma_d64(f);
    m->mgao_2 = injini_uhifadhi_soma_d64(f); m->mgao_3 = injini_uhifadhi_soma_d64(f);
    m->mgao_4 = injini_uhifadhi_soma_d64(f); m->mgao_5 = injini_uhifadhi_soma_d64(f);
    m->mgao_6 = injini_uhifadhi_soma_d64(f); m->mgao_7 = injini_uhifadhi_soma_d64(f);
    m->mgao_8 = injini_uhifadhi_soma_d64(f); m->mgao_9 = injini_uhifadhi_soma_d64(f);
    m->mgao_10 = injini_uhifadhi_soma_d64(f); m->mgao_11 = injini_uhifadhi_soma_d64(f);
    m->kasi_0 = injini_uhifadhi_soma_d64(f); m->kasi_1 = injini_uhifadhi_soma_d64(f);
    m->kasi_2 = injini_uhifadhi_soma_d64(f); m->kasi_3 = injini_uhifadhi_soma_d64(f);
