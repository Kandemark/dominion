    injini_uhifadhi_andika_n64(f, k->idadi_ya_watu);
    injini_uhifadhi_andika_d64(f, k->pato);
    injini_uhifadhi_andika_n64(f, k->muda_wa_kuundwa);
}
w0 mchezo_hifadhi_soma_kitengo(n8* f, KitengoChini* k) {
    k->kitambulisho = injini_uhifadhi_soma_mfuatano(f);
    k->jina = injini_uhifadhi_soma_mfuatano(f);
    k->aina = injini_uhifadhi_soma_n32(f);
    k->mzazi_id = injini_uhifadhi_soma_mfuatano(f);
    k->uhuru = injini_uhifadhi_soma_d64(f);
    k->uaminifu = injini_uhifadhi_soma_d64(f);
    k->maendeleo = injini_uhifadhi_soma_d64(f);
    k->idadi_ya_watu = injini_uhifadhi_soma_n64(f);
    k->pato = injini_uhifadhi_soma_d64(f);
    k->muda_wa_kuundwa = injini_uhifadhi_soma_n64(f);
}
w0 mchezo_hifadhi_andika_kitengo_chini(n8* f, KitengoChiniMsimamizi* m) {
    kama (m == 0) { rudisha; }
    injini_uhifadhi_andika_n32(f, m->idadi);
    n32 i = 0;
    wakati (i < m->idadi) {
        KitengoChini* k = kitengo_chini_msimamizi_pata(m, i);
        mchezo_hifadhi_andika_kitengo(f, k);
        i = i + 1;
    }
}
w0 mchezo_hifadhi_soma_kitengo_chini(n8* f, KitengoChiniMsimamizi* m) {
    kama (m == 0) { rudisha; }
    n32 idadi_iliyohifadhiwa = injini_uhifadhi_soma_n32(f);
    m->idadi = 0;
    n32 i = 0;
    wakati (i < idadi_iliyohifadhiwa) {
        n8* id_tupu = "";
        n8* jina_tupu = "";
        KitengoChini* k = kitengo_chini_unda(id_tupu, jina_tupu, 0);
        mchezo_hifadhi_soma_kitengo(f, k);
        kitengo_chini_msimamizi_ongeza(m, k);
        i = i + 1;
    }
}

// ---------- uandishi (UtamaduniAndikoMsimamizi) ----------
w0 mchezo_hifadhi_andika_andiko(n8* f, UtamaduniAndiko* a) {
    injini_uhifadhi_andika_mfuatano(f, a->kitambulisho);
