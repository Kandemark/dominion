// kianzio.swa — tafsiri ya src/core/faction.c (na .h) kwenda Swa.
// Aina 8 za awali za taifa (starting archetypes) -- nafasi za
// kuanzia kwenye vipimo endelevu, si nyongeza za kudumu za mchezo.
//
// Kiambishi: taifa_kianzio_ — angalia ../../KANUNI-MAJINA.md. MUHIMU:
// hii ni TOFAUTI KABISA na siasa_kikundi_ (politics/faction_system.c,
// imezuiwa na #182(b)) -- ile ni kuhusu miungano ya kisiasa NDANI ya
// taifa moja (mfano vyama), hii ni kuhusu VIGEZO VYA KUANZIA vya
// taifa lenyewe (aina 8 za ustaarabu za kuchagua mwanzoni mwa
// mchezo, kama katika michezo ya mkakati mkuu). civ_icon_id_t
// imekuwa N32 tupu (nambari ya ikoni, safu ya UI bado haijaandikwa).
// sector_weights[8] (safu ya ndani ya float, field ya muundo)
// imegawanywa kuwa vigezo 8 vyenye majina (uzito_0..uzito_7).
// s_factions[8] (safu ya kudumu ya C) imekuwa kazi 8 tofauti
// zinazounda na kurudisha muundo mpya kila zikiitwa, mtindo
// ulioothibitishwa kwenye jukumu.swa.

husisha { msingi/msingi_civ.swa }
husisha { msingi/maktaba/mfuatano.swa }

N32 TAIFA_KIANZIO_IKONI_TAJI = 0;
N32 TAIFA_KIANZIO_IKONI_SARAFU = 1;
N32 TAIFA_KIANZIO_IKONI_HEKALU = 2;
N32 TAIFA_KIANZIO_IKONI_BENDERA = 3;
N32 TAIFA_KIANZIO_IKONI_CHUPA = 4;
N32 TAIFA_KIANZIO_IKONI_UPANGA = 5;
N32 TAIFA_KIANZIO_IKONI_NGANO = 6;
N32 TAIFA_KIANZIO_IKONI_PETE_YA_MTI = 7;

muundo TaifaKianzioHali {
    N32 kiwango_cha_teknolojia;
    N32 kiwango_cha_kijeshi;
    N32 kiwango_cha_uchumi;
    N32 kiwango_cha_utamaduni;
    N32 kiwango_cha_uthabiti;
    N32 kiwango_cha_idadi_ya_watu;

    D64 uzito_0; D64 uzito_1; D64 uzito_2; D64 uzito_3;
    D64 uzito_4; D64 uzito_5; D64 uzito_6; D64 uzito_7;

    D64 nguvu_ya_utendaji;
    D64 nguvu_ya_kutunga_sheria;
    D64 nguvu_ya_mahakama;

    N8* mazingira_yanayopendelewa;
    N32 latitudo_inayopendelewa;

    N32 makazi_ya_kuanzia;
    D64 eneo_la_kuanzia_km2;
};

muundo TaifaKianzio {
    N8* id;
    N8* jina;
    N8* maelezo;
    N32 rangi;
    N32 rangi_ya_pili;
    N32 ikoni;
    TaifaKianzioHali kuanzia;
};

TaifaKianzio* taifa_kianzio_himaya() {
    TaifaKianzio* f = tenga(ukubwa(TaifaKianzio));
    f->id = "himaya"; f->jina = "Himaya ya Kifalme";
    f->maelezo = "Nchi kuu iliyojengwa kwa kuunganisha ardhi jirani. Mamlaka kubwa ya utendaji, mila ya kijeshi, lakini muungano wa ndani bado unaendelea.";
    f->rangi = 13382656; f->rangi_ya_pili = 16733252; f->ikoni = TAIFA_KIANZIO_IKONI_TAJI;
    f->kuanzia.kiwango_cha_teknolojia = 180; f->kuanzia.kiwango_cha_kijeshi = 340;
    f->kuanzia.kiwango_cha_uchumi = 220; f->kuanzia.kiwango_cha_utamaduni = 140;
    f->kuanzia.kiwango_cha_uthabiti = -50; f->kuanzia.kiwango_cha_idadi_ya_watu = 280;
    f->kuanzia.uzito_0 = 0.18; f->kuanzia.uzito_1 = 0.15; f->kuanzia.uzito_2 = 0.22;
    f->kuanzia.uzito_3 = 0.14; f->kuanzia.uzito_4 = 0.08; f->kuanzia.uzito_5 = 0.10;
    f->kuanzia.uzito_6 = 0.05; f->kuanzia.uzito_7 = 0.08;
    f->kuanzia.nguvu_ya_utendaji = 0.80; f->kuanzia.nguvu_ya_kutunga_sheria = 0.15;
    f->kuanzia.nguvu_ya_mahakama = 0.05;
    f->kuanzia.mazingira_yanayopendelewa = "Nyanda"; f->kuanzia.latitudo_inayopendelewa = 35;
    f->kuanzia.makazi_ya_kuanzia = 3; f->kuanzia.eneo_la_kuanzia_km2 = 3.0;
    rudisha f;
}

