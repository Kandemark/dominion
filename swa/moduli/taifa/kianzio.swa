TaifaKianzio* taifa_kianzio_pata_kwa_faharisi(N32 idx) {
    kama (idx == 0) { rudisha taifa_kianzio_himaya(); }
    kama (idx == 1) { rudisha taifa_kianzio_muungano_wa_biashara(); }
    kama (idx == 2) { rudisha taifa_kianzio_utawala_wa_kidini(); }
    kama (idx == 3) { rudisha taifa_kianzio_shirikisho_la_kidemokrasia(); }
    kama (idx == 4) { rudisha taifa_kianzio_muungano_wa_kiteknolojia(); }
    kama (idx == 5) { rudisha taifa_kianzio_jeshi_la_kuhamahama(); }
    kama (idx == 6) { rudisha taifa_kianzio_umoja_wa_kilimo(); }
    kama (idx == 7) { rudisha taifa_kianzio_walinzi_wa_pori(); }
    rudisha 0;
}

N32 taifa_kianzio_idadi() {
    rudisha 8;
}

TaifaKianzio* taifa_kianzio_pata_kwa_id(N8* id) {
    N32 i = 0;
    wakati (i < 8) {
        TaifaKianzio* f = taifa_kianzio_pata_kwa_faharisi(i);
        kama (linganisha_mfuatano(f->id, id) == 0) { rudisha f; }
        achilia f;
        i = i + 1;
    }
    rudisha 0;
}
