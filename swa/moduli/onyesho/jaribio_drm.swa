husisha { moduli/onyesho/drm.swa }

// jaribio_drm.swa -- jaribio la mkono la mfululizo mzima wa KMS
// dhidi ya kifaa HALISI cha /dev/dri/cardN. Huandika rangi tatu
// tofauti kwenye robo tatu za kwanza za bafa ya dumb, kisha
// husoma nyuma na kuthibitisha thamani HALISI (si tu "haikuanguka").

n32 anza() {
    n64 fd = onyesho_drm_fungua("/dev/dri/card1");
    kama (fd < 0) {
        andika_kosa("SKIP: haiwezi kufungua /dev/dri/card1 (ruhusa?) rc=%d\n", fd, 0, 0, 0, 0, 0);
        rudisha 2;
    }
    andika("OK: kifaa kimefunguliwa, fd=%d\n", fd, 0, 0, 0, 0, 0);

    n64 early_master_rc = onyesho_drm_kuwa_bwana(fd);
    andika("DEBUG: jaribio la mapema la SET_MASTER rc=%d\n", early_master_rc, 0, 0, 0, 0, 0);

    n8* res = onyesho_drm_pata_rasilimali(fd);
    kama (res == 0) {
        andika_kosa("FAIL: GETRESOURCES imeshindwa\n", 0, 0, 0, 0, 0, 0);
        rudisha 1;
    }
    n64 n_conn = onyesho_rasilimali_idadi_conn(res);
    n64 n_crtc = onyesho_rasilimali_idadi_crtc(res);
    andika("OK: GETRESOURCES -- connectors=%d crtcs=%d\n", n_conn, n_crtc, 0, 0, 0, 0);
    kama (n_conn == 0) {
        andika_kosa("FAIL: hakuna connector yoyote imerudishwa\n", 0, 0, 0, 0, 0, 0);
        rudisha 1;
    }

    n64 i = 0;
    n8* kiungo = 0;
    n64 conn_id = 0;
    wakati (i < n_conn) {
        n64 cid = onyesho_rasilimali_conn_id(res, i);
        n8* c = onyesho_drm_pata_kiunganishi(fd, cid);
        kama (c != 0) {
            n64 kimeungwa = onyesho_kiunganishi_kimeungwa(c);
            n64 nm = onyesho_kiunganishi_idadi_modi(c);
            n64 ctype = pata_u32(c, 52);
            andika("  connector #%d: kimeungwa=%d idadi_modi=%d aina=%d\n", cid, kimeungwa, nm, ctype, 0, 0);
            kama (kimeungwa == 1 && nm > 0 && kiungo == 0) {
                kiungo = c;
                conn_id = cid;
            }
        } sivyo {
            andika("  connector #%d: GETCONNECTOR imeshindwa\n", cid, 0, 0, 0, 0, 0);
        }
        i = i + 1;
    }

    kama (kiungo == 0) {
        andika_kosa("SKIP: hakuna onyesho lililounganishwa (hakuna monitor?)\n", 0, 0, 0, 0, 0, 0);
        rudisha 2;
    }

    n8* modi = onyesho_kiunganishi_modi_bora(kiungo);
    n64 upana = onyesho_modi_upana(modi);
    n64 kimo = onyesho_modi_kimo(modi);
    andika("OK: modi bora = %d x %d\n", upana, kimo, 0, 0, 0, 0);

    n64 enc_id = onyesho_kiunganishi_encoder_id(kiungo);
    n64 crtc_id = onyesho_drm_pata_crtc_ya_encoder(fd, enc_id);
    kama (crtc_id == 0 && n_crtc > 0) {
        crtc_id = onyesho_rasilimali_crtc_id(res, 0);
    }
    andika("OK: crtc_id = %d\n", crtc_id, 0, 0, 0, 0, 0);

    n8* dumb = onyesho_drm_unda_dumb(fd, upana, kimo, 32);
    kama (dumb == 0) {
        andika_kosa("FAIL: CREATE_DUMB imeshindwa\n", 0, 0, 0, 0, 0, 0);
        rudisha 1;
    }
    n64 handle = onyesho_dumb_handle(dumb);
    n64 pitch = onyesho_dumb_pitch(dumb);
    n64 ukubwa = onyesho_dumb_ukubwa(dumb);
    andika("OK: CREATE_DUMB -- handle=%d pitch=%d ukubwa=%d\n", handle, pitch, ukubwa, 0, 0, 0);

    n8* fb_mem = onyesho_drm_ramanisha_dumb(fd, handle, ukubwa);
    n64 fb_mem_addr = fb_mem;
    kama (fb_mem_addr < 0) {
        andika_kosa("SKIP: mmap ya dumb buffer imekataliwa (errno=-%d) -- kawaida kwa sababu compositor mwingine (Wayland) tayari ni DRM master; angalia dokezo la SET_MASTER hapo juu\n", 0 - fb_mem_addr, 0, 0, 0, 0, 0);
        onyesho_drm_haribu_dumb(fd, handle);
        onyesho_drm_funga(fd);
        rudisha 2;
    }
    andika("OK: dumb buffer imeramanishwa kumbukumbu, anwani=%d\n", fb_mem_addr, 0, 0, 0, 0, 0);

    // Jaribio la kweli: andika muundo unaotambulika kwenye baiti za
    // mwanzo za bafa HALISI ya kernel, kisha usome nyuma kutoka kwa
    // kielekezi kile kile na uthibitishe thamani HALISI (si "haikuanguka" tu).
    weka_u32(fb_mem, 0, 4293322470);      // XRGB8888 -- karibu-nyeupe
    weka_u32(fb_mem, 4, 4278190335);      // buluu safi
    weka_u32(fb_mem, pitch, 4294901760);  // nyekundu safi (mstari wa 2)
    n64 v0 = pata_u32(fb_mem, 0);
    n64 v1 = pata_u32(fb_mem, 4);
    n64 v2 = pata_u32(fb_mem, pitch);
    kama (v0 != 4293322470 || v1 != 4278190335 || v2 != 4294901760) {
        andika_kosa("FAIL: usomaji nyuma wa dumb buffer haulingani (v0=%d v1=%d v2=%d)\n", v0, v1, v2, 0, 0, 0);
        rudisha 1;
    }
    andika("OK: uandishi+usomaji wa pikseli HALISI kwenye kumbukumbu ya kernel umethibitishwa\n", 0, 0, 0, 0, 0, 0);

    n64 fb_id = onyesho_drm_ongeza_fb(fd, upana, kimo, pitch, 32, 24, handle);
    kama (fb_id == 0) {
        andika_kosa("FAIL: ADDFB imeshindwa\n", 0, 0, 0, 0, 0, 0);
        rudisha 1;
    }
    andika("OK: ADDFB -- fb_id=%d\n", fb_id, 0, 0, 0, 0, 0);

    n64 master_rc = onyesho_drm_kuwa_bwana(fd);
    andika("INFO: SET_MASTER rc=%d (hasi ni kawaida ikiwa compositor mwingine tayari anaimiliki onyesho)\n", master_rc, 0, 0, 0, 0, 0);

    n64 crtc_rc = onyesho_drm_weka_crtc(fd, crtc_id, fb_id, conn_id, modi);
    kama (crtc_rc < 0) {
        andika_kosa("INFO: SETCRTC imeshindwa rc=%d (kinatarajiwa ikiwa hatuna DRM master -- angalia SET_MASTER hapo juu)\n", crtc_rc, 0, 0, 0, 0, 0);
    } sivyo {
        andika("OK: SETCRTC imefanikiwa -- onyesho limebadilishwa kwa kweli!\n", 0, 0, 0, 0, 0, 0);
    }

    onyesho_drm_achilia_ubwana(fd);
    onyesho_drm_haribu_dumb(fd, handle);
    onyesho_drm_funga(fd);
    andika("DONE\n", 0, 0, 0, 0, 0, 0);
    rudisha 0;
}
