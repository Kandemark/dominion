    maneno_sajili("%d matters need your answer before the week can advance.", "Mambo %d yanahitaji jibu lako kabla wiki haijasonga.", "%d affaires attendent votre réponse avant que la semaine avance.");
    maneno_sajili("Every matter is answered. The week can advance.", "Kila jambo limejibiwa. Wiki inaweza kusonga.", "Toutes les affaires ont une réponse. La semaine peut avancer.");
    maneno_sajili("REQUEST", "OMBI", "DEMANDE");
    maneno_sajili("Meet", "Kutana", "Recevoir");
