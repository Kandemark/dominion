    maneno_sajili("Speaker of the Assembly", "Spika wa Bunge", "Président de l'Assemblée");
    maneno_sajili("speaks for the guild in the councils of state and governs its members", "huwakilisha chama cha mafundi katika mabaraza ya dola na kuongoza wanachama wake", "représente la guilde dans les conseils de l'État et gouverne ses membres");
    maneno_sajili("speaks for the head of state to the press", "huzungumza kwa niaba ya mkuu wa dola na waandishi wa habari", "s'exprime au nom du chef de l'État devant la presse");
    maneno_sajili("Speaks only to you.", "Huzungumza nawe pekee.", "Ne parle qu'à vous.");
    maneno_sajili("Special Courts", "Mahakama Maalum", "Juridictions spéciales");
    maneno_sajili("Special forces", "Vikosi maalum", "Forces spéciales");
    maneno_sajili("Special Forces Group", "Kundi la Vikosi Maalum", "Groupe de forces spéciales");
    maneno_sajili("Squadron", "Kikosi cha Manowari", "Escadre");
    maneno_sajili("Stability", "Utulivu", "Stabilité");
    maneno_sajili("STABILITY", "UTULIVU", "STABILITÉ");
    maneno_sajili("Stability has fallen to %d. Strikes are spreading in the provinces and the police ask for instructions.", "Utulivu umeshuka hadi %d. Migomo inaenea mikoani na polisi wanaomba maelekezo.", "La stabilité est tombée à %d. Les grèves s'étendent en province et la police demande des instructions.");
    maneno_sajili("Standing Committees", "Kamati za Kudumu", "Commissions permanentes");
    maneno_sajili("START IN THE OFFICE OF", "ANZA KATIKA OFISI YA", "COMMENCER DANS LA CHARGE DE");
    maneno_sajili("State", "Dola", "État");
    maneno_sajili("State Governor", "Gavana wa Jimbo", "Gouverneur d'État");
    maneno_sajili("State of Emergency", "Hali ya Hatari", "État d'urgence");
    maneno_sajili("STATE OF THE NATION", "HALI YA TAIFA", "ÉTAT DE LA NATION");
    maneno_sajili("State-owned", "Mali ya dola", "Propriété de l'État");
    maneno_sajili("Stateless commune", "Jumuiya isiyo na dola", "Commune sans État");
    maneno_sajili("States of Emergency", "Hali za Hatari", "États d'urgence");
    maneno_sajili("Steel", "Chuma", "Acier");
    maneno_sajili("street lighting", "taa za barabarani", "l'éclairage public");
    maneno_sajili("STRENGTH", "NGUVU", "EFFECTIF");
    maneno_sajili("Strength among the nations, commanders, neighbours and forces.", "Nguvu kati ya mataifa, makamanda, majirani na majeshi.", "Puissance parmi les nations, commandants, voisins et forces.");
    maneno_sajili("strike", "kugoma", "la grève");
    maneno_sajili("Subject to this Constitution, ", "Kwa kuzingatia Katiba hii, ", "Sous réserve de la présente Constitution, ");
    maneno_sajili("succeeds by hereditary right", "hurithi kwa haki ya urithi", "succède par droit héréditaire");
    maneno_sajili("Succession", "Urithi", "Succession");
    maneno_sajili("Sultan", "Sultani", "Sultan");
    maneno_sajili("Summon to a meeting", "Ita kwenye mkutano", "Convoquer en réunion");
    maneno_sajili("SUN", "JPI", "DIM");
    maneno_sajili("Supreme Commander", "Kamanda Mkuu", "Commandant suprême");
    maneno_sajili("Supreme Guide", "Kiongozi Mkuu", "Guide suprême");
    maneno_sajili("Supreme People's Assembly", "Bunge Kuu la Wananchi", "Assemblée populaire suprême");
    maneno_sajili("Surveying the provinces", "Kupima kata", "Arpentage des provinces");
    maneno_sajili("Suspended", "Imesimamishwa", "Suspendu");
    maneno_sajili("Syndicalism", "Usindikalisti", "Syndicalisme");
    maneno_sajili("Syndicalist Congress", "Kongresi ya Kisindikalisti", "Congrès syndicaliste");
    maneno_sajili("Table a motion (%d)", "Wasilisha hoja (%d)", "Déposer une motion (%d)");
    maneno_sajili("Take this office", "Chukua ofisi hii", "Prendre cette charge");
    maneno_sajili("Talk", "Ongea", "Parler");
    maneno_sajili("Tank Brigade", "Brigedi ya Vifaru", "Brigade de chars");
    maneno_sajili("tanks", "vifaru", "chars");
    maneno_sajili("Target strength", "Nguvu inayolengwa", "Effectif visé");
    maneno_sajili("Tax revenue", "Mapato ya kodi", "Recettes fiscales");
    maneno_sajili("Taxation", "Kodi", "Fiscalité");
    maneno_sajili("Technical Directorate", "Kurugenzi ya Kiufundi", "Direction technique");
    maneno_sajili("Technocracy", "Utawala wa wataalamu", "Technocratie");
    maneno_sajili("technocratic", "mtaalamu", "technocrate");
    maneno_sajili("TECHNOLOGY BY FORM OF GOVERNMENT", "TEKNOLOJIA KWA AINA YA UTAWALA", "TECHNOLOGIE PAR FORME DE GOUVERNEMENT");
    maneno_sajili("Telegraph", "Simu ya maandishi", "Télégraphe");
    maneno_sajili("Tenure of Judges", "Muda wa Majaji Kazini", "Inamovibilité des juges");
    maneno_sajili("Term (years)", "Muhula (miaka)", "Mandat (ans)");
    maneno_sajili("Term (years, 0 life)", "Muhula (miaka, 0 maisha)", "Mandat (ans, 0 à vie)");
    maneno_sajili("Term limit (0 none)", "Kikomo cha mihula (0 hakuna)", "Limite de mandats (0 aucune)");
    maneno_sajili("Term of its head (years)", "Muhula wa mkuu wake (miaka)", "Mandat de son dirigeant (ans)");
    maneno_sajili("Term of office", "Muhula wa ofisi", "Durée du mandat");
    maneno_sajili("Territory", "Eneo", "Territoire");
    maneno_sajili("Tetracameral", "Mabaraza manne", "Tétracaméral");
    maneno_sajili("Textiles", "Nguo", "Textile");
    maneno_sajili("That slot could not be loaded.", "Nafasi hiyo haikuweza kupakiwa.", "Impossible de charger cet emplacement.");
    maneno_sajili("The %s %s and holds office %s. A candidate %s be at least %d years of age.%s", "%s %s na hushika wadhifa %s. Mgombea %s kuwa na umri wa angalau miaka %d.%s", "Le %s %s et exerce ses fonctions %s. Un candidat %s avoir au moins %d ans.%s");
    maneno_sajili("The %s %s assent to every bill passed by the legislature.", "%s %s kuidhinisha kila mswada unaopitishwa na bunge.", "Le %s %s promulguer toute loi adoptée par la législature.");
    maneno_sajili("The %s %s attend the legislature to answer questions on %d days in every month while it sits.", "%s %s kuhudhuria bungeni kujibu maswali siku %d kila mwezi bunge likiwa kikaoni.", "Le %s %s se présenter devant la législature pour répondre aux questions %d jours par mois pendant les sessions.");
    maneno_sajili("The %s %s attend the legislature to answer questions on one day in every month while it sits.", "%s %s kuhudhuria bungeni kujibu maswali siku moja kila mwezi bunge likiwa kikaoni.", "Le %s %s se présenter devant la législature pour répondre aux questions un jour par mois pendant les sessions.");
    maneno_sajili("The %s %s meet in at least %d sessions in every year.", "%s %s kukutana katika angalau vikao %d kila mwaka.", "La %s %s se réunir au moins %d fois par an.");
    maneno_sajili("The %s %s, and answers to the %s.", "%s %s, na huwajibika kwa %s.", "Le %s %s, et répond devant le %s.");
    maneno_sajili("The %s %s, and answers to the chamber.", "%s %s, na huwajibika kwa baraza.", "Le %s %s, et répond devant la chambre.");
    maneno_sajili("The %s %s, and is subject to no direction or control in the exercise of judicial power.", "%s %s, na haelekezwi wala kudhibitiwa na yeyote katika kutekeleza mamlaka ya kimahakama.", "Le %s %s, et n'est soumis à aucune direction ni contrôle dans l'exercice du pouvoir judiciaire.");
    maneno_sajili("The %s commands under the authority of the %s, who is Commander-in-Chief.", "%s huongoza chini ya mamlaka ya %s, ambaye ni Amiri Jeshi Mkuu.", "Le %s commande sous l'autorité du %s, commandant en chef.");
    maneno_sajili("The %s consists of %d members, %s.", "%s lina wajumbe %d, %s.", "La %s compte %d membres, %s.");
    maneno_sajili("The %s declares war and makes peace.", "%s hutangaza vita na kufanya amani.", "Le %s déclare la guerre et fait la paix.");
    maneno_sajili("The %s elects a Speaker from among its members, who may be removed by a resolution of %d per cent of the members.", "%s humchagua Spika miongoni mwa wajumbe wake, anayeweza kuondolewa kwa azimio la asilimia %d ya wajumbe.", "La %s élit en son sein un président, révocable par une résolution de %d pour cent des membres.");
    maneno_sajili("The %s is responsible for %s.", "%s anawajibika kwa %s.", "Le %s est chargé de %s.");
    maneno_sajili("The %s may be dissolved by the %s, and a general election %s then be held within %d days.", "%s linaweza kuvunjwa na %s, na uchaguzi mkuu %s kufanyika ndani ya siku %d.", "La %s peut être dissoute par le %s, et des élections générales %s alors avoir lieu dans les %d jours.");
    maneno_sajili("The %s may be removed from office for grave violation of this Constitution by a resolution supported by %d per cent of the members of the legislature.", "%s anaweza kuondolewa madarakani kwa ukiukaji mkubwa wa Katiba hii kwa azimio linaloungwa mkono na asilimia %d ya wabunge.", "Le %s peut être destitué pour violation grave de la présente Constitution par une résolution soutenue par %d pour cent des membres de la législature.");
    maneno_sajili("The %s may dismiss the holder.", "%s anaweza kumfukuza mshika wadhifa.", "Le %s peut révoquer le titulaire.");
    maneno_sajili("The %s may grant pardons, commute sentences and remit penalties, save in cases of impeachment.", "%s anaweza kutoa msamaha, kubadilisha hukumu na kufuta adhabu, isipokuwa katika kesi za kuondolewa madarakani.", "Le %s peut accorder la grâce, commuer les peines et remettre les sanctions, sauf en cas de destitution.");
    maneno_sajili("The %s may not be dissolved before the end of its term.", "%s haliwezi kuvunjwa kabla ya mwisho wa muhula wake.", "La %s ne peut être dissoute avant la fin de son mandat.");
    maneno_sajili("The %s may not transact business unless %d per cent of its members are present.", "%s haliwezi kuendesha shughuli isipokuwa asilimia %d ya wajumbe wake wapo.", "La %s ne peut délibérer que si %d pour cent de ses membres sont présents.");
    maneno_sajili("The %s, %s, sent word that the diary is full.", "%s, %s, ametuma ujumbe kuwa ratiba imejaa.", "Le %s, %s, fait savoir que son agenda est complet.");
    maneno_sajili("The %s, %s, will attend. The meeting is in your diary.", "%s, %s, atahudhuria. Mkutano uko kwenye shajara yako.", "Le %s, %s, sera présent. La réunion figure dans votre agenda.");
    maneno_sajili("The Adviser", "Mshauri", "Le Conseiller");
    maneno_sajili("THE ADVISER", "MSHAURI", "LE CONSEILLER");
    maneno_sajili("The Adviser and your assistant", "Mshauri na msaidizi wako", "Le Conseiller et votre assistant");
    maneno_sajili("The Adviser is always at your side.", "Mshauri yuko kando yako daima.", "Le Conseiller est toujours à vos côtés.");
    maneno_sajili("The adviser is switched off. Choose a provider in Settings.", "Mshauri amezimwa. Chagua mtoa huduma kwenye Mipangilio.", "Le conseiller est désactivé. Choisissez un fournisseur dans les Paramètres.");
    maneno_sajili("The age of absolutism", "Zama za ufalme kamili", "L'âge de l'absolutisme");
    maneno_sajili("The age of nations", "Zama za mataifa", "L'âge des nations");
    maneno_sajili("The age of revolutions", "Zama za mapinduzi", "L'âge des révolutions");
    maneno_sajili("the Air Force", "Jeshi la Anga", "l'Armée de l'air");
    maneno_sajili("The amendment is in force.", "Marekebisho yanatumika.", "La révision est en vigueur.");
    maneno_sajili("The amendment is tabled in the legislature.", "Marekebisho yamewasilishwa bungeni.", "La révision est déposée devant la législature.");
    maneno_sajili("The amendment to %s is ratified and enters the constitution.", "Marekebisho ya %s yameridhiwa na kuingia katika katiba.", "La révision de %s est ratifiée et entre dans la constitution.");
    maneno_sajili("The amendment was rejected.", "Marekebisho yamekataliwa.", "La révision a été rejetée.");
    maneno_sajili("The Armed Forces", "Majeshi", "Les forces armées");
    maneno_sajili("the Armoured Corps", "Jeshi la Deraya", "l'Arme blindée");
    maneno_sajili("the Army", "Jeshi la Nchi Kavu", "l'Armée de terre");
    maneno_sajili("the Artillery", "Jeshi la Mizinga", "l'Artillerie");
    maneno_sajili("the authority and impartiality of the courts", "mamlaka na kutopendelea kwa mahakama", "l'autorité et l'impartialité des tribunaux");
    maneno_sajili("THE BENCH", "JOPO LA MAJAJI", "LA MAGISTRATURE");
    maneno_sajili("The capital of %s is %s.", "Mji mkuu wa %s ni %s.", "La capitale de %s est %s.");
    maneno_sajili("the Cavalry", "Jeshi la Wapanda Farasi", "la Cavalerie");
    maneno_sajili("The central bank acts on the instructions of the government.", "Benki kuu hufuata maelekezo ya serikali.", "La banque centrale agit sur instruction du gouvernement.");
    maneno_sajili("The central bank is independent and takes no instructions from the government on the value of the currency.", "Benki kuu ni huru na haipokei maelekezo kutoka serikali kuhusu thamani ya sarafu.", "La banque centrale est indépendante et ne reçoit aucune instruction du gouvernement sur la valeur de la monnaie.");
    maneno_sajili("The chamber overrode your veto by two thirds.", "Baraza limepindua kura yako ya turufu kwa theluthi mbili.", "La chambre a passé outre à votre veto à la majorité des deux tiers.");
    maneno_sajili("The chamber rejected your nominee, %s to %s. %s remains in office.", "Baraza limemkataa uliyemteua, %s kwa %s. %s anabaki ofisini.", "La chambre a rejeté votre candidat, %s contre %s. %s reste en fonction.");
    maneno_sajili("The constitution gives your office no power over this post.", "Katiba haiipi ofisi yako mamlaka juu ya nafasi hii.", "La constitution ne donne à votre charge aucun pouvoir sur ce poste.");
    maneno_sajili("The Constitution of %s", "Katiba ya %s", "La Constitution de %s");
    maneno_sajili("The council of %s District is responsible within the district for %s, and may levy rates for these purposes as the law allows.", "Baraza la Wilaya ya %s linawajibika ndani ya wilaya kwa %s, na linaweza kutoza ada kwa madhumuni haya kama sheria inavyoruhusu.", "Le conseil du district de %s est responsable dans le district de %s, et peut lever des taxes à ces fins dans les limites de la loi.");
    maneno_sajili("The courts of this rank hear %s, within the limits set by law.", "Mahakama za ngazi hii husikiliza %s, ndani ya mipaka iliyowekwa na sheria.", "Les juridictions de ce rang connaissent de %s, dans les limites fixées par la loi.");
    maneno_sajili("the Crown, which exercises it according to this Constitution", "Taji, linalolitekeleza kwa mujibu wa Katiba hii", "la Couronne, qui l'exerce conformément à la présente Constitution");
    maneno_sajili("The currency of the state is the %s. Its issue is reserved to the state.", "Sarafu ya dola ni %s. Kuitoa ni haki ya dola pekee.", "La monnaie de l'État est le %s. Son émission est réservée à l'État.");
    maneno_sajili("the district", "wilaya", "le district");
    maneno_sajili("The economy rests on private property and free enterprise, regulated by law in the common interest.", "Uchumi umejengwa juu ya mali binafsi na biashara huru, zinazodhibitiwa na sheria kwa maslahi ya wote.", "L'économie repose sur la propriété privée et la libre entreprise, encadrées par la loi dans l'intérêt commun.");
    maneno_sajili("the enforcement of the rights in Part II", "utekelezaji wa haki za Sehemu ya II", "la garantie des droits du titre II");
    maneno_sajili("The Executive", "Utendaji", "L'Exécutif");
    maneno_sajili("The executive power of the Region of %s is exercised by the governor with an executive committee of %d members.", "Mamlaka ya utendaji ya Mkoa wa %s hutekelezwa na gavana pamoja na kamati ya utendaji ya wajumbe %d.", "Le pouvoir exécutif de la région de %s est exercé par le gouverneur avec un comité exécutif de %d membres.");
    maneno_sajili("The game could not be saved.", "Mchezo haukuweza kuhifadhiwa.", "Impossible de sauvegarder la partie.");
    maneno_sajili("The government %s lay the estimates of revenue and expenditure before the legislature in month %d of every year; no money may be spent except as appropriated by law.", "Serikali %s kuwasilisha makadirio ya mapato na matumizi bungeni katika mwezi wa %d wa kila mwaka; hakuna fedha zinazoweza kutumika isipokuwa zilizoidhinishwa na sheria.", "Le gouvernement %s présenter les prévisions de recettes et de dépenses à la législature au mois %d de chaque année ; aucune dépense n'est permise sans crédit voté par la loi.");
    maneno_sajili("The government %s resign if %d per cent of the members of the legislature pass a motion of no confidence in it, and a new government %s be formed %s the vote.", "Serikali %s kujiuzulu ikiwa asilimia %d ya wabunge watapitisha hoja ya kutokuwa na imani nayo, na serikali mpya %s kuundwa %s kura hiyo.", "Le gouvernement %s démissionner si %d pour cent des membres de la législature adoptent une motion de défiance, et un nouveau gouvernement %s être formé %s le vote.");
    maneno_sajili("The great wars", "Vita vikuu", "Les grandes guerres");
    maneno_sajili("The Greens", "Wanamazingira", "Les Verts");
    maneno_sajili("The Head of State", "Mkuu wa Dola", "Le chef de l'État");
    maneno_sajili("The High Court", "Mahakama Kuu", "La Haute Cour");
    maneno_sajili("The High Court has jurisdiction in %s.", "Mahakama Kuu ina mamlaka juu ya %s.", "La Haute Cour est compétente pour %s.");
    maneno_sajili("The High Court may declare void any law or act inconsistent with this Constitution.", "Mahakama Kuu inaweza kubatilisha sheria au kitendo chochote kinachopingana na Katiba hii.", "La Haute Cour peut annuler toute loi ou tout acte contraire à la présente Constitution.");
    maneno_sajili("The intelligence service acts only within the law and reports in confidence to a committee of the legislature.", "Idara ya ujasusi hufanya kazi ndani ya sheria tu na huripoti kwa siri kwa kamati ya bunge.", "Le service de renseignement n'agit que dans le cadre de la loi et rend compte confidentiellement à une commission de la législature.");
    maneno_sajili("The intelligence service answers to the %s alone.", "Idara ya ujasusi huwajibika kwa %s pekee.", "Le service de renseignement ne répond qu'au %s.");
    maneno_sajili("The judicial power of %s is vested in a High Court of %d justices and in such lower courts as the law establishes.", "Mamlaka ya kimahakama ya %s yamekabidhiwa Mahakama Kuu ya majaji %d na mahakama za chini zitakazoanzishwa na sheria.", "Le pouvoir judiciaire de %s est confié à une Haute Cour de %d juges et aux juridictions inférieures établies par la loi.");
    maneno_sajili("The Judiciary", "Mahakama", "Le pouvoir judiciaire");
    maneno_sajili("The land, the mines, the banks and the great industries are the common property of the people, administered by the state.", "Ardhi, migodi, benki na viwanda vikubwa ni mali ya pamoja ya watu, inayosimamiwa na dola.", "La terre, les mines, les banques et les grandes industries sont la propriété commune du peuple, administrée par l'État.");
    maneno_sajili("The Legislature", "Bunge", "La Législature");
    maneno_sajili("the licensing of trades", "leseni za biashara", "les licences commerciales");
    maneno_sajili("The long standoff", "Mvutano mrefu", "La longue confrontation");
    maneno_sajili("The motion carries", "Hoja imepita", "La motion est adoptée");
    maneno_sajili("The motion fails", "Hoja imeshindwa", "La motion est rejetée");
    maneno_sajili("the nation, held in trust by the Armed Forces", "taifa, linaloshikiliwa kwa dhamana na Majeshi", "la nation, détenue en dépôt par les forces armées");
    maneno_sajili("The national anthem is the anthem prescribed by law, and it may be altered only by law.", "Wimbo wa taifa ni ule uliowekwa na sheria, na unaweza kubadilishwa kwa sheria tu.", "L'hymne national est celui que prescrit la loi, et seule la loi peut le modifier.");
    maneno_sajili("The national flag is the flag described by law, and it %s be flown on every public building.", "Bendera ya taifa ni ile iliyoelezwa na sheria, na %s kupeperushwa juu ya kila jengo la umma.", "Le drapeau national est celui que décrit la loi, et il %s flotter sur chaque bâtiment public.");
    maneno_sajili("the Navy", "Jeshi la Majini", "la Marine");
    maneno_sajili("The new order", "Mpangilio mpya", "Le nouvel ordre");
    maneno_sajili("The opposition moves against you", "Upinzani unakushambulia", "L'opposition se dresse contre vous");
    maneno_sajili("The people rejected the amendment to %s in the referendum.", "Wananchi wamekataa marekebisho ya %s katika kura ya maoni.", "Le peuple a rejeté la révision de %s par référendum.");
    maneno_sajili("the people, who exercise it through their representatives and by referendum", "wananchi, wanaoyatekeleza kupitia wawakilishi wao na kwa kura ya maoni", "le peuple, qui l'exerce par ses représentants et par référendum");
    maneno_sajili("The power to make laws on %s %s.", "Mamlaka ya kutunga sheria kuhusu %s %s.", "Le pouvoir de légiférer sur %s %s.");
    maneno_sajili("The Press", "Vyombo vya Habari", "La presse");
    maneno_sajili("The press has exposed payments to %s. Legitimacy falls; the opposition smells blood.", "Vyombo vya habari vimefichua malipo kwa %s. Uhalali unashuka; upinzani unanusa damu.", "La presse a révélé des versements à %s. La légitimité chute ; l'opposition flaire le sang.");
    maneno_sajili("The press has exposed secret payments from your office.", "Vyombo vya habari vimefichua malipo ya siri kutoka ofisi yako.", "La presse a révélé des versements secrets de votre cabinet.");
    maneno_sajili("the presumption of innocence", "dhana ya kutokuwa na hatia", "la présomption d'innocence");
    maneno_sajili("the prevention of crime", "kuzuia uhalifu", "la prévention du crime");
    maneno_sajili("the protection of minorities", "ulinzi wa makundi madogo", "la protection des minorités");
    maneno_sajili("The public seal of the state is kept by the head of government and affixed to every instrument of state.", "Muhuri wa dola hutunzwa na mkuu wa serikali na hugongwa kwenye kila hati ya dola.", "Le sceau de l'État est gardé par le chef du gouvernement et apposé sur tout acte de l'État.");
    maneno_sajili("the region", "mkoa", "la région");
    maneno_sajili("The Region of %s has a council of %d members, elected for the term of the national legislature, which makes laws for the region within its powers.", "Mkoa wa %s una baraza la wajumbe %d, wanaochaguliwa kwa muhula wa bunge la taifa, linalotunga sheria za mkoa ndani ya mamlaka yake.", "La région de %s dispose d'un conseil de %d membres, élus pour la durée de la législature nationale, qui légifère pour la région dans les limites de ses compétences.");
    maneno_sajili("The Region of %s receives %d.%d per cent of the regional share.", "Mkoa wa %s hupokea asilimia %d.%d ya fungu la mikoa.", "La région de %s reçoit %d,%d pour cent de la part régionale.");
    maneno_sajili("the rights and freedoms of others", "haki na uhuru wa wengine", "les droits et libertés d'autrui");
    maneno_sajili("The rights declared in Part II may be extended by amendment but never abolished or further limited.", "Haki zilizotangazwa katika Sehemu ya II zinaweza kupanuliwa kwa marekebisho lakini kamwe hazifutwi wala kupunguzwa zaidi.", "Les droits proclamés au titre II peuvent être étendus par révision mais jamais abolis ni davantage restreints.");
    maneno_sajili("The ruling party is the leading force of state and society; no other party may be formed.", "Chama tawala ni nguvu inayoongoza dola na jamii; hakuna chama kingine kinachoweza kuundwa.", "Le parti au pouvoir est la force dirigeante de l'État et de la société ; aucun autre parti ne peut être formé.");
    maneno_sajili("The server refused the request. Check the model name and key in saves/akili.", "Seva imekataa ombi. Kagua jina la modeli na ufunguo katika saves/akili.", "Le serveur a refusé la requête. Vérifiez le nom du modèle et la clé dans saves/akili.");
    maneno_sajili("the Special Forces", "Vikosi Maalum", "les Forces spéciales");
    maneno_sajili("The State", "Dola", "L'État");
    maneno_sajili("The state shall build and keep the roads, railways, ports and posts the nation needs.", "Dola itajenga na kutunza barabara, reli, bandari na posta ambazo taifa linahitaji.", "L'État construit et entretient les routes, voies ferrées, ports et postes dont la nation a besoin.");
    maneno_sajili("The state shall defend the territory of the nation and keep public order within it.", "Dola italinda eneo la taifa na kudumisha utulivu wa umma ndani yake.", "L'État défend le territoire de la nation et y maintient l'ordre public.");
    maneno_sajili("The state shall encourage agriculture and secure fair access to land.", "Dola itahimiza kilimo na kuhakikisha upatikanaji wa ardhi kwa haki.", "L'État encourage l'agriculture et garantit un accès équitable à la terre.");
    maneno_sajili("The state shall guard the public health against epidemic disease and provide hospitals.", "Dola italinda afya ya umma dhidi ya magonjwa ya mlipuko na kutoa hospitali.", "L'État protège la santé publique contre les épidémies et fournit des hôpitaux.");
    maneno_sajili("The state shall promote the employment of the people and just and humane conditions of work.", "Dola itakuza ajira kwa watu na mazingira ya kazi ya haki na ya kibinadamu.", "L'État favorise l'emploi et des conditions de travail justes et humaines.");
    maneno_sajili("The state shall protect the land, water, air and wildlife of the nation for future generations.", "Dola italinda ardhi, maji, hewa na wanyamapori wa taifa kwa ajili ya vizazi vijavyo.", "L'État protège la terre, l'eau, l'air et la faune de la nation pour les générations futures.");
    maneno_sajili("The state shall protect the language, history and monuments of the nation.", "Dola italinda lugha, historia na makumbusho ya taifa.", "L'État protège la langue, l'histoire et les monuments de la nation.");
    maneno_sajili("The state shall provide for those who cannot work by reason of age, sickness or disability.", "Dola itawahudumia wasioweza kufanya kazi kwa sababu ya umri, ugonjwa au ulemavu.", "L'État pourvoit aux besoins de ceux qui ne peuvent travailler en raison de l'âge, de la maladie ou du handicap.");
    maneno_sajili("The state shall provide schooling for every child, without fees at the primary level.", "Dola itatoa elimu kwa kila mtoto, bila ada katika ngazi ya msingi.", "L'État assure la scolarité de chaque enfant, gratuite au niveau primaire.");
    maneno_sajili("The state shall secure justice for all, and the courts shall be open to every person.", "Dola itahakikisha haki kwa wote, na mahakama zitakuwa wazi kwa kila mtu.", "L'État garantit la justice pour tous, et les tribunaux sont ouverts à chacun.");
    maneno_sajili("The state shall seek peace among nations and respect the treaties it has made.", "Dola itatafuta amani kati ya mataifa na kuheshimu mikataba iliyofanya.", "L'État recherche la paix entre les nations et respecte les traités qu'il a conclus.");
    maneno_sajili("The state shall uphold the Faith, and no law shall be made contrary to its teaching.", "Dola itailinda Imani, na hakuna sheria itakayotungwa kinyume na mafundisho yake.", "L'État défend la Foi, et aucune loi contraire à son enseignement ne peut être adoptée.");
    maneno_sajili("the supervision of every lower court and tribunal", "usimamizi wa kila mahakama ya chini na baraza la kimahakama", "le contrôle de toute juridiction et de tout tribunal inférieurs");
    maneno_sajili("The supreme law of %s, generated from its institutions and amended %s.", "Sheria kuu ya %s, iliyozalishwa kutoka taasisi zake na kurekebishwa %s.", "La loi suprême de %s, issue de ses institutions et révisée %s.");
    maneno_sajili("The territory of %s comprises %d regions, whose boundaries may be altered only in the manner of an amendment to this Constitution.", "Eneo la %s lina mikoa %d, ambayo mipaka yake inaweza kubadilishwa kwa utaratibu wa marekebisho ya Katiba hii tu.", "Le territoire de %s comprend %d régions, dont les limites ne peuvent être modifiées que selon la procédure de révision de la présente Constitution.");
    maneno_sajili("The territory of %s is that held by it on the day this Constitution came into force.", "Eneo la %s ni lile lililokuwa nalo siku Katiba hii ilipoanza kutumika.", "Le territoire de %s est celui qu'il détenait le jour de l'entrée en vigueur de la présente Constitution.");
    maneno_sajili("The treasury cannot spare it.", "Hazina haiwezi kumudu.", "Le trésor ne peut pas se le permettre.");
    maneno_sajili("The treasury is running low", "Hazina inakaribia kuisha", "Le trésor s'épuise");
    maneno_sajili("the unity and territorial integrity of the state", "umoja na ukamilifu wa eneo la dola", "l'unité et l'intégrité territoriale de l'État");
    maneno_sajili("the use of one's own language", "kutumia lugha yake mwenyewe", "l'usage de sa propre langue");
    maneno_sajili("The whips have tightened party discipline in the %s.", "Wanadhimu wameimarisha nidhamu ya chama katika %s.", "Les whips ont resserré la discipline de parti à la %s.");
    maneno_sajili("the working people, under the leadership of the Party", "watu wa kazi, chini ya uongozi wa Chama", "le peuple travailleur, sous la direction du Parti");
    maneno_sajili("the writ of habeas corpus", "amri ya kumfikisha mfungwa mahakamani", "l'habeas corpus");
    maneno_sajili("Theocracy", "Utawala wa kidini", "Théocratie");
    maneno_sajili("There are %d public holidays in every year, fixed by law, on which public offices are closed.", "Kuna sikukuu %d za umma kila mwaka, zilizowekwa na sheria, ambapo ofisi za umma hufungwa.", "Il y a %d jours fériés chaque année, fixés par la loi, durant lesquels les administrations sont fermées.");
    maneno_sajili("There are established %s, each sitting with %d judges, from which an appeal lies to the High Court.", "Zimeanzishwa %s, kila moja ikiketi na majaji %d, ambazo rufaa yake huenda Mahakama Kuu.", "Sont instituées %s, siégeant chacune avec %d juges, dont il peut être fait appel devant la Haute Cour.");
    maneno_sajili("There are established the %s, each sitting with %d judges, whose decisions may be appealed to the court above it.", "Zimeanzishwa %s, kila moja ikiketi na majaji %d, ambazo maamuzi yake yanaweza kukatiwa rufaa kwa mahakama iliyo juu yake.", "Sont instituées les %s, siégeant chacune avec %d juges, dont les décisions peuvent être portées devant la juridiction supérieure.");
    maneno_sajili("There is established %s, whose strength in time of peace may not exceed %s men except with the approval of the legislature.", "Limeanzishwa %s, ambalo idadi yake wakati wa amani haiwezi kuzidi askari %s bila idhini ya bunge.", "Il est institué %s, dont l'effectif en temps de paix ne peut dépasser %s hommes sans l'accord de la législature.");
    maneno_sajili("There is established a %s, independent in the exercise of its functions, whose head is appointed for %d years and may be removed only as a justice of the High Court.", "Imeanzishwa %s, huru katika kutekeleza majukumu yake, ambayo mkuu wake huteuliwa kwa miaka %d na anaweza kuondolewa kama jaji wa Mahakama Kuu tu.", "Il est institué un(e) %s, indépendant(e) dans l'exercice de ses fonctions, dont le dirigeant est nommé pour %d ans et ne peut être révoqué que comme un juge de la Haute Cour.");
    maneno_sajili("There is established a standing committee whose chair, the %s, may summon any minister or official to give evidence on oath.", "Imeanzishwa kamati ya kudumu ambayo mwenyekiti wake, %s, anaweza kumwita waziri au afisa yeyote kutoa ushahidi kwa kiapo.", "Il est institué une commission permanente dont le président, le %s, peut convoquer tout ministre ou fonctionnaire pour témoigner sous serment.");
    maneno_sajili("There is established the office of %s, responsible for the affairs assigned to it by law and answerable to the head of government.", "Imeanzishwa ofisi ya %s, inayowajibika kwa mambo iliyopewa na sheria na inayowajibika kwa mkuu wa serikali.", "Il est institué la charge de %s, chargée des affaires que lui confie la loi et responsable devant le chef du gouvernement.");
    maneno_sajili("There is established the Region of %s, administered by a governor %s, with a council for its local affairs.", "Umeanzishwa Mkoa wa %s, unaosimamiwa na gavana %s, pamoja na baraza kwa mambo yake ya ndani.", "Il est institué la région de %s, administrée par un gouverneur %s, avec un conseil pour ses affaires locales.");
    maneno_sajili("There is no general franchise; offices are filled as this Constitution provides.", "Hakuna haki ya kura kwa wote; ofisi hujazwa kama Katiba hii inavyoeleza.", "Il n'y a pas de suffrage général ; les charges sont pourvues selon la présente Constitution.");
    maneno_sajili("There is no state religion; the state treats all faiths equally.", "Hakuna dini ya dola; dola huzichukulia imani zote kwa usawa.", "Il n'y a pas de religion d'État ; l'État traite toutes les croyances à égalité.");
    maneno_sajili("There is one national police service, under a commissioner appointed by the head of government.", "Kuna jeshi moja la polisi la taifa, chini ya kamishna anayeteuliwa na mkuu wa serikali.", "Il existe un seul service national de police, sous l'autorité d'un commissaire nommé par le chef du gouvernement.");
    maneno_sajili("Third Schedule: Oaths of Office", "Jedwali la Tatu: Viapo vya Ofisi", "Troisième annexe : serments");
    maneno_sajili("This Constitution came into force %d years ago. Laws then in force continue until repealed, so far as they are consistent with it.", "Katiba hii ilianza kutumika miaka %d iliyopita. Sheria zilizokuwepo wakati huo zinaendelea hadi zifutwe, kwa kadiri zinavyoendana nayo.", "La présente Constitution est entrée en vigueur il y a %d ans. Les lois alors en vigueur demeurent jusqu'à leur abrogation, dans la mesure où elles lui sont conformes.");
    maneno_sajili("This Constitution may be amended %s, by a measure supported by %d per cent%s, no sooner than %d days after the amendment is published.", "Katiba hii inaweza kurekebishwa %s, kwa hatua inayoungwa mkono na asilimia %d%s, si mapema kuliko siku %d baada ya marekebisho kutangazwa.", "La présente Constitution peut être révisée %s, par une mesure soutenue par %d pour cent%s, au plus tôt %d jours après la publication de la révision.");
    maneno_sajili("this nation", "taifa hili", "cette nation");
    maneno_sajili("This nation keeps no army.", "Taifa hili halina jeshi.", "Cette nation n'entretient pas d'armée.");
    maneno_sajili("This official is above you. Ask your assistant to request a meeting first.", "Afisa huyu yuko juu yako. Mwombe msaidizi wako aombe mkutano kwanza.", "Ce responsable est au-dessus de vous. Demandez d'abord à votre assistant de solliciter une réunion.");
    maneno_sajili("This right is absolute and admits no limitation.", "Haki hii ni kamili na haiwekewi mipaka yoyote.", "Ce droit est absolu et ne souffre aucune restriction.");
    maneno_sajili("This right may not be suspended even during a state of emergency.", "Haki hii haiwezi kusimamishwa hata wakati wa hali ya hatari.", "Ce droit ne peut être suspendu, même pendant l'état d'urgence.");
    maneno_sajili("THU", "ALH", "JEU");
    maneno_sajili("town planning and building control", "mipango miji na udhibiti wa ujenzi", "l'urbanisme et le contrôle des constructions");
    maneno_sajili("Trading", "Biashara", "Négoce");
    maneno_sajili("Traditionalism", "Mila", "Traditionalisme");
    maneno_sajili("Transitional and Final Provisions", "Masharti ya Mpito na ya Mwisho", "Dispositions transitoires et finales");
    maneno_sajili("Treasury", "Hazina", "Trésor");
    maneno_sajili("TREASURY", "HAZINA", "TRÉSOR");
    maneno_sajili("Treasury health", "Hali ya hazina", "Santé du trésor");
    maneno_sajili("Treasury health stands at %d. Salaries for the civil service are due and the reserves will not cover them for long.", "Hali ya hazina iko %d. Mishahara ya watumishi wa umma imefika na akiba haitaitosha kwa muda mrefu.", "La santé du trésor est de %d. Les traitements de la fonction publique sont dus et les réserves ne suffiront pas longtemps.");
    maneno_sajili("trial by jury", "kesi mbele ya baraza la wazee wa mahakama", "le jugement par jury");
    maneno_sajili("Trials are held in public, save where the court excludes the public to protect a minor or the security of the state.", "Kesi husikilizwa hadharani, isipokuwa mahakama inapozuia umma ili kumlinda mtoto au usalama wa dola.", "Les procès sont publics, sauf si le tribunal exclut le public pour protéger un mineur ou la sûreté de l'État.");
    maneno_sajili("Tribal confederation", "Muungano wa makabila", "Confédération tribale");
    maneno_sajili("Tricameral", "Mabaraza matatu", "Tricaméral");
    maneno_sajili("TUE", "JNE", "MAR");
    maneno_sajili("Turn %s  ·  one week", "Zamu %s  ·  wiki moja", "Tour %s  ·  une semaine");
    maneno_sajili("Type below and press Enter.", "Andika hapa chini na bonyeza Enter.", "Tapez ci-dessous et appuyez sur Entrée.");
    maneno_sajili("Type here...", "Andika hapa...", "Tapez ici...");
    maneno_sajili("Unemployment %s", "Ukosefu wa ajira %s", "Chômage %s");
    maneno_sajili("Unicameral", "Baraza moja", "Monocaméral");
    maneno_sajili("Union of the Faithful", "Muungano wa Waumini", "Union des fidèles");
    maneno_sajili("Universal suffrage", "Haki ya kura kwa wote", "Suffrage universel");
    maneno_sajili("Universal, by examination for office", "Kwa wote, kwa mtihani wa kushika ofisi", "Universel, par examen pour les charges");
    maneno_sajili("Universal, single list", "Kwa wote, orodha moja", "Universel, liste unique");
    maneno_sajili("Universal, uncontested", "Kwa wote, bila ushindani", "Universel, sans concurrence");
    maneno_sajili("Unknown", "Haijulikani", "Inconnu");
    maneno_sajili("Unrest in the provinces", "Machafuko mikoani", "Troubles en province");
    maneno_sajili("Unsettled  ·  %s km2", "Haina makazi  ·  km2 %s", "Inhabité  ·  %s km2");
    maneno_sajili("VENALITY", "UFISADI", "VÉNALITÉ");
    maneno_sajili("Veterans' League", "Ligi ya Wastaafu wa Jeshi", "Ligue des anciens combattants");
    maneno_sajili("Veto (%d)", "Turufu (%d)", "Veto (%d)");
    maneno_sajili("Veto (1 yes)", "Turufu (1 ndiyo)", "Veto (1 oui)");
    maneno_sajili("veto overridden", "turufu imepinduliwa", "veto levé");
    maneno_sajili("vetoed", "imekataliwa kwa turufu", "frappé de veto");
    maneno_sajili("Vice President", "Makamu wa Rais", "Vice-président");
    maneno_sajili("Village Chief", "Chifu wa Kijiji", "Chef de village");
    maneno_sajili("Village Speaker", "Msemaji wa Kijiji", "Porte-parole du village");
    maneno_sajili("vote and to stand for office", "kupiga kura na kugombea wadhifa", "voter et se présenter aux élections");
    maneno_sajili("vote pending", "kura inasubiri", "vote en attente");
    maneno_sajili("Votes in joint sitting (%)", "Kura katika kikao cha pamoja (%)", "Voix en séance commune (%)");
    maneno_sajili("Votes required (%)", "Kura zinazohitajika (%)", "Voix requises (%)");
    maneno_sajili("Votes to extend (%)", "Kura za kuongeza muda (%)", "Voix pour prolonger (%)");
    maneno_sajili("Voting age", "Umri wa kupiga kura", "Âge du droit de vote");
    maneno_sajili("vs %s ten turns ago", "dhidi ya %s zamu kumi zilizopita", "contre %s il y a dix tours");
    maneno_sajili("Waiting", "Inasubiri", "En attente");
    maneno_sajili("Waiting in your diary", "Inasubiri kwenye shajara yako", "En attente dans votre agenda");
    maneno_sajili("WALLET", "POCHI", "PORTEFEUILLE");
    maneno_sajili("wants your support for a bill", "anataka uungaji mkono wako kwa mswada", "souhaite votre soutien pour un projet de loi");
    maneno_sajili("War and Peace", "Vita na Amani", "Guerre et paix");
    maneno_sajili("War losses to date %s", "Hasara za vita hadi sasa %s", "Pertes de guerre à ce jour %s");
    maneno_sajili("War may be declared, and forces sent abroad, only with the approval of %d per cent of the members of the legislature.", "Vita vinaweza kutangazwa, na majeshi kupelekwa nje, kwa idhini ya asilimia %d ya wabunge tu.", "La guerre ne peut être déclarée, ni des forces envoyées à l'étranger, qu'avec l'accord de %d pour cent des membres de la législature.");
    maneno_sajili("Warning", "Onyo", "Avertissement");
    maneno_sajili("warns of a case against the government", "anaonya juu ya kesi dhidi ya serikali", "met en garde contre une action contre le gouvernement");
    maneno_sajili("wary", "mwenye tahadhari", "méfiant");
    maneno_sajili("water supply", "usambazaji wa maji", "l'approvisionnement en eau");
    maneno_sajili("WED", "JTN", "MER");
    maneno_sajili("week", "wiki", "semaine");
    maneno_sajili("Weighs the consequences of what you intend before you act.", "Hupima matokeo ya unachokusudia kabla hujatenda.", "Pèse les conséquences de vos intentions avant que vous agissiez.");
    maneno_sajili("When does your story begin?", "Hadithi yako inaanza lini?", "Quand votre histoire commence-t-elle ?");
    maneno_sajili("Where an accused person cannot afford an advocate and substantial injustice would otherwise result, one shall be assigned at the expense of the state.", "Mshtakiwa asiyeweza kumudu wakili, na pale ambapo vinginevyo dhuluma kubwa ingetokea, atapewa wakili kwa gharama ya dola.", "Lorsqu'un accusé ne peut payer un avocat et qu'une injustice grave en résulterait, un avocat lui est commis aux frais de l'État.");
    maneno_sajili("Whip the party", "Imarisha nidhamu ya chama", "Discipliner le parti");
    maneno_sajili("Whip the party (%d)", "Imarisha nidhamu ya chama (%d)", "Discipliner le parti (%d)");
    maneno_sajili("Who are you?", "Wewe ni nani?", "Qui êtes-vous ?");
    maneno_sajili("within %d days", "ndani ya siku %d", "dans les %d jours");
    maneno_sajili("wk", "wk", "sem");
    maneno_sajili("Women and men have equal rights in political, economic and family life.", "Wanawake na wanaume wana haki sawa katika maisha ya kisiasa, kiuchumi na ya familia.", "Les femmes et les hommes ont des droits égaux dans la vie politique, économique et familiale.");
    maneno_sajili("work", "kufanya kazi", "le travail");
    maneno_sajili("Workers' Vanguard", "Kikosi cha Mbele cha Wafanyakazi", "Avant-garde ouvrière");
    maneno_sajili("WORLD", "DUNIA", "MONDE");
    maneno_sajili("World average %s", "Wastani wa dunia %s", "Moyenne mondiale %s");
    maneno_sajili("World technology research.", "Utafiti wa teknolojia duniani.", "Recherche technologique mondiale.");
    maneno_sajili("Years of citizenship", "Miaka ya uraia", "Années de citoyenneté");
    maneno_sajili("Years of residence", "Miaka ya ukaazi", "Années de résidence");
    maneno_sajili("Years required", "Miaka inayohitajika", "Années requises");
    maneno_sajili("You", "Wewe", "Vous");
    maneno_sajili("YOU", "WEWE", "VOUS");
    maneno_sajili("You can amend only your own nation's constitution.", "Unaweza kurekebisha katiba ya taifa lako pekee.", "Vous ne pouvez réviser que la constitution de votre propre nation.");
    maneno_sajili("You have %d meetings in your diary this week. The Calendar shows the day and hour of each.", "Una mikutano %d kwenye shajara yako wiki hii. Kalenda inaonyesha siku na saa ya kila mmoja.", "Vous avez %d réunions dans votre agenda cette semaine. Le calendrier indique le jour et l'heure de chacune.");
    maneno_sajili("You hold the office of %s  ·  %s", "Unashika ofisi ya %s  ·  %s", "Vous occupez la charge de %s  ·  %s");
    maneno_sajili("You now hold the office of %s.", "Sasa unashika ofisi ya %s.", "Vous occupez désormais la charge de %s.");
    maneno_sajili("You own no shares. Buy them from the market terminal.", "Huna hisa yoyote. Zinunue kutoka kituo cha masoko.", "Vous ne détenez aucune action. Achetez-en depuis le terminal des marchés.");
    maneno_sajili("Your assistant", "Msaidizi wako", "Votre assistant");
    maneno_sajili("YOUR ASSISTANT", "MSAIDIZI WAKO", "VOTRE ASSISTANT");
    maneno_sajili("Your assistant reports", "Msaidizi wako anaripoti", "Votre assistant rapporte");
    maneno_sajili("Your assistant will ask them to table: %s.", "Msaidizi wako atawaomba kuwasilisha: %s.", "Votre assistant leur demandera de déposer : %s.");
    maneno_sajili("Your assistant will brief the whips this week.", "Msaidizi wako atawapa wanadhimu maelekezo wiki hii.", "Votre assistant briefera les whips cette semaine.");
    maneno_sajili("Your assistant will call on %s this week.", "Msaidizi wako atamtembelea %s wiki hii.", "Votre assistant rendra visite à %s cette semaine.");
    maneno_sajili("Your assistant's desk is not an office of state.", "Meza ya msaidizi wako si ofisi ya dola.", "Le bureau de votre assistant n'est pas une charge d'État.");
    maneno_sajili("Your diary this week", "Shajara yako wiki hii", "Votre agenda cette semaine");
    maneno_sajili("Your motions carried", "Hoja zako zilizopita", "Vos motions adoptées");
    maneno_sajili("YOUR NETWORK", "MTANDAO WAKO", "VOTRE RÉSEAU");
    maneno_sajili("Your office", "Ofisi yako", "Votre cabinet");
    maneno_sajili("YOUR OFFICE", "OFISI YAKO", "VOTRE CABINET");
    maneno_sajili("Your office has no power of veto.", "Ofisi yako haina mamlaka ya turufu.", "Votre charge n'a pas de droit de veto.");
    maneno_sajili("Your person, your money and the people around you.", "Nafsi yako, fedha zako na watu wanaokuzunguka.", "Votre personne, votre argent et votre entourage.");
    maneno_sajili("your value vs the top", "thamani yako dhidi ya wa kwanza", "votre valeur face au premier");
    maneno_sajili("Your veto stands. The chamber could not muster two thirds.", "Turufu yako inabaki. Baraza halikupata theluthi mbili.", "Votre veto tient. La chambre n'a pu réunir les deux tiers.");
    maneno_jaza_ziada_4();
    maneno_jaza_ziada_3();
    maneno_jaza_ziada_2();
}

