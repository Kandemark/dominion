// maneno_ziada.swa -- tafsiri za Kiswahili na Kifaransa za maandishi ya kurasa
// zilizoongezwa baada ya maneno.swa (dola, katiba, majeshi, kata, historia,
// mchezo mpya). Kila ingizo: Kiingereza (ufunguo, sawasawa na ui() kwenye
// msimbo), Kiswahili, Kifaransa. Alama %s na %d hubaki kwa mpangilio uleule.

w0 maneno_jaza_ziada() {
    maneno_sajili("the people, under the leadership of the Party", "wananchi, chini ya uongozi wa Chama", "le peuple, sous la direction du Parti");
    maneno_sajili("the nation, under the leadership of the Party", "taifa, chini ya uongozi wa Chama", "la nation, sous la direction du Parti");
    maneno_sajili("serve the people of %s and the Party", "kuwatumikia wananchi wa %s na Chama", "servir le peuple de %s et le Parti");
    maneno_sajili("serve the nation of %s and the Party", "kulitumikia taifa la %s na Chama", "servir la nation de %s et le Parti");
    maneno_sajili("ord|%s no. %d, %s", "%s Na. %d, %s", "%s n° %d, %s");
    maneno_sajili("ord|%s no. %d", "%s Na. %d", "%s n° %d");
    maneno_sajili(" A member who leaves the party for which he or she was elected also loses the seat.", " Mjumbe anayehama chama kilichomchagua pia hupoteza kiti.", " Un membre qui quitte le parti sous lequel il a été élu perd aussi son siège.");
    maneno_sajili(" A state of emergency is now in force, and the head of state may govern and amend this Constitution by decree.", " Hali ya hatari sasa inatumika, na mkuu wa dola anaweza kutawala na kurekebisha Katiba hii kwa amri.", " L'état d'urgence est en vigueur, et le chef de l'État peut gouverner et réviser la présente Constitution par décret.");
    maneno_sajili(" and %s", " na %s", " et %s");
    maneno_sajili(" and approved by the citizens in a referendum", " na kuidhinishwa na wananchi katika kura ya maoni", " et approuvée par les citoyens par référendum");
    maneno_sajili(" Any person whose right is infringed may seek a remedy in the courts.", " Mtu yeyote ambaye haki yake imevunjwa anaweza kutafuta suluhu mahakamani.", " Toute personne dont le droit est violé peut demander réparation devant les tribunaux.");
    maneno_sajili(" No person may hold the office for more than %d terms.", " Hakuna mtu anayeweza kushika wadhifa huo kwa zaidi ya mihula %d.", " Nul ne peut exercer cette charge plus de %d mandats.");
    maneno_sajili(" or %s", " au %s", " ou %s");
    maneno_sajili("%d articles  ·  %d clauses in force  ·  %d pages  ·  version %d", "Ibara %d  ·  vifungu %d vinavyotumika  ·  kurasa %d  ·  toleo %d", "%d articles  ·  %d clauses en vigueur  ·  %d pages  ·  version %d");
    maneno_sajili("%d chamber(s)", "Mabaraza %d", "%d chambre(s)");
    maneno_sajili("%d commands", "Amri %d", "%d commandements");
    maneno_sajili("%d formations", "Vikosi %d", "%d formations");
    maneno_sajili("%d formations  ·  page %d of %d", "Vikosi %d  ·  ukurasa %d kati ya %d", "%d formations  ·  page %d sur %d");
    maneno_sajili("%d justices  ·  %d offices", "Majaji %d  ·  ofisi %d", "%d juges  ·  %d charges");
    maneno_sajili("%d members  ·  showing %d to %d", "Wajumbe %d  ·  inaonyesha %d hadi %d", "%d membres  ·  affichage de %d à %d");
    maneno_sajili("%d messages, %d unread", "Ujumbe %d, %d haujasomwa", "%d messages, %d non lus");
    maneno_sajili("%d nations  ·  you are highlighted", "Mataifa %d  ·  wewe umeangaziwa", "%d nations  ·  vous êtes en surbrillance");
    maneno_sajili("%d nations in %d", "Mataifa %d mwaka %d", "%d nations en %d");
    maneno_sajili("%d nations in scope", "Mataifa %d katika wigo", "%d nations dans le périmètre");
    maneno_sajili("%d offices", "Ofisi %d", "%d charges");
    maneno_sajili("%d parties", "Vyama %d", "%d partis");
    maneno_sajili("%d seats  ·  government %d", "Viti %d  ·  serikali %d", "%d sièges  ·  gouvernement %d");
    maneno_sajili("%d yes / %d needed", "Ndiyo %d / zinahitajika %d", "%d oui / %d requis");
    maneno_sajili("%s  ·  %d aircraft", "%s  ·  ndege %d", "%s  ·  %d avions");
    maneno_sajili("%s  ·  %d ships", "%s  ·  meli %d", "%s  ·  %d navires");
    maneno_sajili("%s  ·  %d tanks", "%s  ·  vifaru %d", "%s  ·  %d chars");
    maneno_sajili("%s  ·  today is %s", "%s  ·  leo ni %s", "%s  ·  nous sommes le %s");
    maneno_sajili("%s accepted %dM. Attitude to you is now %d.", "%s amekubali %dM. Msimamo wake kwako sasa ni %d.", "%s a accepté %d M. Son attitude envers vous est désormais de %d.");
    maneno_sajili("%s ask to see you", "%s wanaomba kukuona", "%s demandent à vous voir");
    maneno_sajili("%s District is divided into %d constituencies, each returning one member to the %s.", "Wilaya ya %s imegawanywa katika majimbo %d, kila moja likichagua mjumbe mmoja wa %s.", "Le district de %s est divisé en %d circonscriptions, chacune élisant un membre à la %s.");
    maneno_sajili("%s District returns one member to the %s.", "Wilaya ya %s huchagua mjumbe mmoja wa %s.", "Le district de %s élit un membre à la %s.");
    maneno_sajili("%s District votes as part of the constituency of %s.", "Wilaya ya %s hupiga kura kama sehemu ya jimbo la %s.", "Le district de %s vote au sein de la circonscription de %s.");
    maneno_sajili("%s District: about %s inhabitants, governed by a district council of %d members.", "Wilaya ya %s: takriban wakazi %s, inaongozwa na baraza la wilaya la wajumbe %d.", "District de %s : environ %s habitants, administré par un conseil de district de %d membres.");
    maneno_sajili("%s has come to see you.", "%s amekuja kukuona.", "%s est venu vous voir.");
    maneno_sajili("%s has tabled the motion: %s. The vote is in two weeks.", "%s amewasilisha hoja: %s. Kura ni baada ya wiki mbili.", "%s a déposé la motion : %s. Le vote a lieu dans deux semaines.");
    maneno_sajili("%s in the labour force", "%s katika nguvu kazi", "%s dans la population active");
    maneno_sajili("%s is a %s, one and indivisible.", "%s ni %s, moja na isiyogawanyika.", "%s est un(e) %s, un(e) et indivisible.");
    maneno_sajili("%s is dismissed. %s takes the post.", "%s amefukuzwa. %s anachukua nafasi hiyo.", "%s est révoqué. %s prend le poste.");
    maneno_sajili("%s is dismissed. The chamber confirmed %s, %s to %s.", "%s amefukuzwa. Baraza limemthibitisha %s, %s kwa %s.", "%s est révoqué. La chambre a confirmé %s, %s contre %s.");
    maneno_sajili("%s is shown in.", "%s anaingizwa.", "%s est introduit.");
    maneno_sajili("%s listened. Attitude to you is now %d.", "%s amesikiliza. Msimamo wake kwako sasa ni %d.", "%s a écouté. Son attitude envers vous est désormais de %d.");
    maneno_sajili("%s men  ·  exp %d", "%s  ·  uzo. %d", "%s h.  ·  exp %d");
    maneno_sajili("%s more are wary of you", "%s zaidi wana shaka nawe", "%s autres se méfient de vous");
    maneno_sajili("%s of %s by GDP  ·  %s people", "%s kati ya %s kwa pato  ·  watu %s", "%s sur %s par PIB  ·  %s habitants");
    maneno_sajili("%s of 4", "%s kati ya 4", "%s sur 4");
    maneno_sajili("%s people  ·  %s km2", "watu %s  ·  km2 %s", "%s habitants  ·  %s km2");
    maneno_sajili("%s per head", "%s kwa mtu", "%s par habitant");
    maneno_sajili("%s refused the money and will remember the offer.", "%s amekataa fedha na atakumbuka ofa hiyo.", "%s a refusé l'argent et s'en souviendra.");
    maneno_sajili("%s refused to table the motion: %s.", "%s amekataa kuwasilisha hoja: %s.", "%s a refusé de déposer la motion : %s.");
    maneno_sajili("%s repealed", "%s kimefutwa", "%s abrogé");
    maneno_sajili("%s seats", "viti %s", "%s sièges");
    maneno_sajili("%s set to %d", "%s kimewekwa %d", "%s fixé à %d");
    maneno_sajili("%s shows %s in.", "%s anamwingiza %s.", "%s fait entrer %s.");
    maneno_sajili("%s who has reached the age of %d has the right to vote, by secret ballot.", "%s aliyefikia umri wa miaka %d ana haki ya kupiga kura, kwa kura ya siri.", "%s ayant atteint l'âge de %d ans a le droit de vote, au scrutin secret.");
    maneno_sajili("%s will summon the %s to a meeting.", "%s atamwita %s kwenye mkutano.", "%s convoquera le %s en réunion.");
    maneno_sajili("%s years", "miaka %s", "%s ans");
    maneno_sajili("%s, %s, %s and asks for a meeting at your earliest convenience.", "%s, %s, %s na anaomba mkutano utakapopata nafasi.", "%s, %s, %s et sollicite une audience à votre convenance.");
    maneno_sajili("%s, Leader of the Opposition, has tabled: %s. The vote is in two weeks.", "%s, Kiongozi wa Upinzani, amewasilisha: %s. Kura ni baada ya wiki mbili.", "%s, chef de l'opposition, a déposé : %s. Le vote a lieu dans deux semaines.");
    maneno_sajili("%s: %d in favour, %d against (%d needed).", "%s: %d wanaunga mkono, %d wanapinga (%d zinahitajika).", "%s : %d pour, %d contre (%d requis).");
    maneno_sajili("%s: %s is on the way to see you.", "%s: %s yuko njiani kukuona.", "%s : %s est en route pour vous voir.");
    maneno_sajili("%s: %s will receive you on %s. The meeting is in your diary.", "%s: %s atakupokea tarehe %s. Mkutano uko kwenye shajara yako.", "%s : %s vous recevra le %s. La réunion figure dans votre agenda.");
    maneno_sajili("%s: the office of %s has declined to receive you.", "%s: ofisi ya %s imekataa kukupokea.", "%s : le cabinet de %s a refusé de vous recevoir.");
    maneno_sajili("%sthe %s is appointed by the %s and holds office at the pleasure of the %s.", "%s%s huteuliwa na %s na hushika wadhifa kwa ridhaa ya %s.", "%sle %s est nommé par le %s et exerce ses fonctions au gré du %s.");
    maneno_sajili("%sthe %s is appointed by the %s with the consent of the %s, which %s decide %s the nomination. ", "%s%s huteuliwa na %s kwa ridhaa ya %s, ambalo %s kuamua %s uteuzi. ", "%sle %s est nommé par le %s avec l'accord de la %s, qui %s statuer %s la nomination. ");
    maneno_sajili("+1 political capital every week", "+1 mtaji wa kisiasa kila wiki", "+1 capital politique par semaine");
    maneno_sajili(", confirmed by the ", ", huthibitishwa na ", ", confirmé par la ");
    maneno_sajili("1 formation", "Kikosi 1", "1 formation");
    maneno_sajili("[Repealed.]", "[Kimefutwa.]", "[Abrogé.]");
    maneno_sajili("\"I swear that I will %s as %s, uphold this Constitution, and do right to all manner of people without fear or favour.\"", "\"Naapa %s kama %s, kuilinda Katiba hii, na kutenda haki kwa watu wa kila aina bila hofu wala upendeleo.\"", "\"Je jure de %s en qualité de %s, de défendre la présente Constitution et de rendre justice à tous sans crainte ni faveur.\"");
    maneno_sajili("A %s producing %s this turn. Stability %s, legitimacy %s.", "%s inayozalisha %s zamu hii. Utulivu %s, uhalali %s.", "Un(e) %s produisant %s ce tour. Stabilité %s, légitimité %s.");
    maneno_sajili("A bill becomes law when passed by %d per cent of the members voting, no sooner than %d days after it is tabled.", "Mswada huwa sheria ukipitishwa na asilimia %d ya wajumbe wanaopiga kura, si mapema kuliko siku %d baada ya kuwasilishwa.", "Un projet de loi devient loi s'il est adopté par %d pour cent des membres votants, au plus tôt %d jours après son dépôt.");
    maneno_sajili("A bill to impose taxes or appropriate public money may be introduced only in the %s. The %s may delay such a bill for no more than %d days.", "Mswada wa kutoza kodi au kutenga fedha za umma unaweza kuwasilishwa katika %s pekee. %s kinaweza kuuchelewesha kwa siku zisizozidi %d.", "Un projet de loi fiscal ou budgétaire ne peut être déposé que devant la %s. La %s ne peut le retarder de plus de %d jours.");
    maneno_sajili("A child found in %s whose parents are not known is presumed to be a citizen by birth.", "Mtoto aliyeokotwa %s ambaye wazazi wake hawajulikani anachukuliwa kuwa raia kwa kuzaliwa.", "Un enfant trouvé en %s dont les parents sont inconnus est présumé citoyen de naissance.");
    maneno_sajili("A citizen does not lose citizenship by acquiring the citizenship of another state.", "Raia hapotezi uraia wake kwa kupata uraia wa nchi nyingine.", "Un citoyen ne perd pas sa nationalité en acquérant celle d'un autre État.");
    maneno_sajili("A citizen of full age may renounce citizenship by a declaration, which takes effect when registered.", "Raia mwenye umri kamili anaweza kukana uraia kwa tamko, ambalo hutekelezwa linaposajiliwa.", "Un citoyen majeur peut renoncer à sa nationalité par une déclaration, effective dès son enregistrement.");
    maneno_sajili("A citizen who voluntarily acquires the citizenship of another state ceases to be a citizen.", "Raia anayejipatia kwa hiari uraia wa nchi nyingine hukoma kuwa raia.", "Un citoyen qui acquiert volontairement la nationalité d'un autre État perd la sienne.");
    maneno_sajili("a commercial court for disputes in trade, shipping and insolvency", "mahakama ya biashara kwa migogoro ya biashara, usafirishaji wa majini na ufilisi", "un tribunal de commerce pour les litiges commerciaux, maritimes et de faillite");
    maneno_sajili("A Defence Council of %d members, chaired by the %s and including the commanders of the forces, advises on all matters of defence.", "Baraza la Ulinzi la wajumbe %d, linaloongozwa na %s na kuwajumuisha makamanda wa majeshi, hushauri juu ya mambo yote ya ulinzi.", "Un Conseil de défense de %d membres, présidé par le %s et comprenant les commandants des forces, conseille sur toutes les questions de défense.");
    maneno_sajili("a fair and public trial", "kesi ya haki na ya hadhara", "un procès équitable et public");
    maneno_sajili("A justice holds office until the age of %d, and his or her salary may not be reduced while in office.", "Jaji hushika wadhifa hadi umri wa miaka %d, na mshahara wake hauwezi kupunguzwa akiwa kazini.", "Un juge exerce jusqu'à l'âge de %d ans, et son traitement ne peut être réduit pendant son mandat.");
    maneno_sajili("A justice may be removed only for proved misconduct or incapacity, by resolution of %d per cent of the members of the legislature.", "Jaji anaweza kuondolewa kwa utovu wa nidhamu uliothibitishwa au kutoweza tu, kwa azimio la asilimia %d ya wabunge.", "Un juge ne peut être révoqué que pour faute prouvée ou incapacité, par une résolution de %d pour cent des membres de la législature.");
    maneno_sajili("a land court for disputes over the title, use and boundaries of land", "mahakama ya ardhi kwa migogoro ya umiliki, matumizi na mipaka ya ardhi", "un tribunal foncier pour les litiges de propriété, d'usage et de bornage");
    maneno_sajili("A law limiting this right is valid only so far as it is necessary in a free society in the interests of %s, and it %s not touch the essence of the right.", "Sheria inayoweka mipaka kwa haki hii ni halali kwa kadiri inavyohitajika katika jamii huru kwa maslahi ya %s tu, na %s kugusa kiini cha haki hiyo.", "Une loi limitant ce droit n'est valable que dans la mesure nécessaire dans une société libre dans l'intérêt de %s, et elle %s pas porter atteinte à l'essence du droit.");
    maneno_sajili("A member of the %s who is absent without leave from %d consecutive sittings vacates the seat.%s", "Mjumbe wa %s asiyehudhuria bila ruhusa vikao %d mfululizo hupoteza kiti.%s", "Un membre de la %s absent sans autorisation pendant %d séances consécutives perd son siège.%s");
    maneno_sajili("a neighbouring district", "wilaya jirani", "un district voisin");
    maneno_sajili("A person awaiting trial is entitled to be released on reasonable conditions unless there are compelling reasons for detention.", "Mtu anayesubiri kesi ana haki ya kuachiliwa kwa masharti ya busara isipokuwa kuna sababu nzito za kumshikilia.", "Toute personne en attente de jugement a droit à la liberté sous conditions raisonnables, sauf raisons impérieuses de la détenir.");
    maneno_sajili("A person born in %s is a citizen by birth if either parent is a citizen at the time of the birth.", "Mtu aliyezaliwa %s ni raia kwa kuzaliwa ikiwa mmoja wa wazazi wake ni raia wakati wa kuzaliwa.", "Toute personne née en %s est citoyenne de naissance si l'un de ses parents est citoyen au moment de la naissance.");
    maneno_sajili("A person born outside %s is a citizen by descent if either parent is a citizen by birth.", "Mtu aliyezaliwa nje ya %s ni raia kwa nasaba ikiwa mmoja wa wazazi wake ni raia kwa kuzaliwa.", "Toute personne née hors de %s est citoyenne par filiation si l'un de ses parents est citoyen de naissance.");
    maneno_sajili("A person lawfully resident in %s for %d years may be registered as a citizen, on proof of good character.", "Mtu aliyeishi kihalali %s kwa miaka %d anaweza kusajiliwa kuwa raia, akithibitisha tabia njema.", "Toute personne résidant légalement en %s depuis %d ans peut être enregistrée comme citoyenne, sur preuve de bonne conduite.");
    maneno_sajili("A person married to a citizen for at least %d years may be registered as a citizen on application.", "Mtu aliyeoana na raia kwa angalau miaka %d anaweza kusajiliwa kuwa raia kwa maombi.", "Toute personne mariée à un citoyen depuis au moins %d ans peut être enregistrée comme citoyenne sur demande.");
    maneno_sajili("A person whose conviction is quashed on new evidence is entitled to compensation from the state.", "Mtu ambaye hukumu yake inabatilishwa kwa ushahidi mpya ana haki ya fidia kutoka kwa dola.", "Toute personne dont la condamnation est annulée sur preuve nouvelle a droit à une indemnisation de l'État.");
    maneno_sajili("A petition disputing an election is heard by the High Court, which %s decide it within %d days of its filing.", "Ombi la kupinga uchaguzi husikilizwa na Mahakama Kuu, ambayo %s kuliamua ndani ya siku %d tangu kuwasilishwa.", "Une requête contestant une élection est jugée par la Haute Cour, qui %s statuer dans les %d jours suivant son dépôt.");
    maneno_sajili("A seat in the %s that falls vacant %s be filled %s the vacancy.", "Kiti katika %s kinachobaki wazi %s kujazwa %s nafasi hiyo.", "Un siège vacant à la %s %s être pourvu %s la vacance.");
    maneno_sajili("A state since before 1700", "Dola tangu kabla ya 1700", "État depuis avant 1700");
    maneno_sajili("Absolute monarchy", "Ufalme kamili", "Monarchie absolue");
    maneno_sajili("Accepted", "Imekubaliwa", "Accepté");
    maneno_sajili("access to public office on merit", "kupata nafasi za umma kwa sifa", "l'accès aux emplois publics selon le mérite");
    maneno_sajili("Acquisition and Loss of Citizenship", "Kupata na Kupoteza Uraia", "Acquisition et perte de la nationalité");
    maneno_sajili("administrative courts for complaints against public bodies", "mahakama za utawala kwa malalamiko dhidi ya taasisi za umma", "des tribunaux administratifs pour les plaintes contre les organismes publics");
    maneno_sajili("Adviser fee, weekly", "Ada ya mshauri, kwa wiki", "Honoraires du conseiller, par semaine");
    maneno_sajili("Age of call-up", "Umri wa kuitwa jeshini", "Âge d'appel");
    maneno_sajili("Age of the state", "Umri wa dola", "Âge de l'État");
    maneno_sajili("Agrarian League", "Ligi ya Wakulima", "Ligue agraire");
    maneno_sajili("Agrarianism", "Siasa za wakulima", "Agrarisme");
    maneno_sajili("Agriculture", "Kilimo", "Agriculture");
    maneno_sajili("agriculture and forests", "kilimo na misitu", "l'agriculture et les forêts");
    maneno_sajili("Air", "Anga", "Air");
    maneno_sajili("Air Squadron", "Kikosi cha Anga", "Escadrille");
    maneno_sajili("Air Wing", "Kikosi Kikuu cha Anga", "Escadre aérienne");
    maneno_sajili("aircraft", "ndege", "avions");
    maneno_sajili("Alert", "Tahadhari", "Alerte");
    maneno_sajili("ally in business", "mshirika wa biashara", "allié en affaires");
    maneno_sajili("ambitious", "mwenye tamaa", "ambitieux");
    maneno_sajili("Amended %d times", "Imerekebishwa mara %d", "Modifié %d fois");
    maneno_sajili("Amendment", "Marekebisho", "Révision");
    maneno_sajili("Amendment of this Constitution", "Marekebisho ya Katiba hii", "Révision de la présente Constitution");
    maneno_sajili("AMENDMENTS", "MAREKEBISHO", "RÉVISIONS");
    maneno_sajili("Amnesty bill", "Mswada wa msamaha", "Projet d'amnistie");
    maneno_sajili("An accused person is entitled to adequate time and facilities to prepare a defence.", "Mshtakiwa ana haki ya muda na nyenzo za kutosha kuandaa utetezi.", "Toute personne accusée a droit au temps et aux moyens nécessaires pour préparer sa défense.");
    maneno_sajili("An accused person may be defended by an advocate of his or her own choosing.", "Mshtakiwa anaweza kutetewa na wakili wa chaguo lake.", "Toute personne accusée peut être défendue par l'avocat de son choix.");
    maneno_sajili("An accused person who does not understand the language of the court is entitled to an interpreter without charge.", "Mshtakiwa asiyeelewa lugha ya mahakama ana haki ya mkalimani bila malipo.", "Toute personne accusée qui ne comprend pas la langue du tribunal a droit à un interprète gratuit.");
    maneno_sajili("An Auditor-General, appointed for %d years, %s examine the accounts of every public body and report to the legislature.", "Mkaguzi Mkuu, anayeteuliwa kwa miaka %d, %s kukagua hesabu za kila taasisi ya umma na kuripoti kwa bunge.", "Un vérificateur général, nommé pour %d ans, %s examiner les comptes de chaque organisme public et faire rapport à la législature.");
    maneno_sajili("An Electoral Commission of %d members, independent of the government, %s conduct all elections and referendums.", "Tume ya Uchaguzi ya wajumbe %d, huru kutoka serikali, %s kuendesha chaguzi zote na kura za maoni.", "Une commission électorale de %d membres, indépendante du gouvernement, %s organiser toutes les élections et tous les référendums.");
    maneno_sajili("an industrial court for disputes between employers and workers", "mahakama ya kazi kwa migogoro kati ya waajiri na wafanyakazi", "un tribunal du travail pour les litiges entre employeurs et salariés");
    maneno_sajili("Anarchism", "Uanaki", "Anarchisme");
    maneno_sajili("Another name", "Jina jingine", "Un autre nom");
    maneno_sajili("Anti-Corruption Commission", "Tume ya Kupambana na Rushwa", "Commission anticorruption");
    maneno_sajili("any matter conferred by law", "jambo lolote linalotolewa na sheria", "toute matière attribuée par la loi");
    maneno_sajili("appeals from the courts below", "rufaa kutoka mahakama za chini", "les appels des juridictions inférieures");
    maneno_sajili("Appointed", "Ameteuliwa", "Nommé");
    maneno_sajili("Appointed by the %s%s%s", "Huteuliwa na %s%s%s", "Nommé par le %s%s%s");
    maneno_sajili("appointed by the head of state", "anayeteuliwa na mkuu wa dola", "nommé par le chef de l'État");
    maneno_sajili("April", "Aprili", "Avril");
    maneno_sajili("Armed forces", "Majeshi", "Forces armées");
    maneno_sajili("ARMED FORCES", "MAJESHI", "FORCES ARMÉES");
    maneno_sajili("Armour", "Deraya", "Blindés");
