husisha { msingi/maktaba/mfuatano.swa }
husisha { moduli/onyesho/dunia_halisi.swa }

// jaribio_kata.swa -- kata za ramani: zaidi ya 40,000, kila pikseli ya ardhi
// yenye mwenyewe iko kwenye kata, hakuna kata inayovuka mpaka wa taifa au wa
// mkoa, hakuna kata tupu, kila taifa lenye ardhi lina kata, na kila kata ina jina.

n64 makosa = 0;

w0 thibitisha(n8* jina, n32 sawa) {
    kama (sawa == 0) { andika("SHINDWA: %s\n", jina, 0, 0, 0, 0, 0); makosa = makosa + 1; }
}

n32 anza(n32 idadi_ya_hoja, n8** hoja_za_mstari) {
    DuniaHalisi* d = dunia_halisi_pakia("rasilimali/dunia.bin");
    thibitisha("dunia", d != 0);
    kama (d == 0) { rudisha 1; }
    kata_hakikisha(d);
    andika("kata %d (za makazi %d, za mwituni %d)\n", kata_idadi, kata_za_makazi, kata_idadi - kata_za_makazi, 0, 0, 0);
    thibitisha("zaidi ya 40,000", kata_idadi > 40000);
    n64 px = d->upana * d->kimo;
    n64 bila_kata = 0;
    n64 inavuka = 0;
    n64 ardhi_ya_mwituni = 0;
    n64 ardhi = 0;
    n64 g = 0;
    wakati (g < px) {
        n64 a = d->ardhi[g] & 255;
        n64 m = dh_u16(d->wamiliki, 2 * g);
        kama ((a == 1 || a == 3) && m != 65535) {
            ardhi = ardhi + 1;
            n64 k = kata_gridi[g];
            kama (k < 0) { bila_kata = bila_kata + 1; }
            sivyo {
                kama (kata_taifa[k] != m || kata_mkoa[k] != dh_mkoa(d, g)) { inavuka = inavuka + 1; }
                kama (k >= kata_za_makazi) { ardhi_ya_mwituni = ardhi_ya_mwituni + 1; }
            }
        }
        g = g + 1;
    }
    thibitisha("kila pikseli ya ardhi ina kata", bila_kata == 0);
    thibitisha("hakuna kata inayovuka mpaka", inavuka == 0);
    // mafuriko hufika karibu kila mahali: ardhi ya mwituni ni chini ya 1%
    thibitisha("ardhi ya mwituni ni kidogo", ardhi_ya_mwituni * 100 < ardhi);
    n64 tupu = 0;
    n64 bila_jina = 0;
    n8 jina[96];
    n64 i = 0;
    wakati (i < kata_idadi) {
        kama (kata_eneo[i] == 0) { tupu = tupu + 1; }
        kata_jina(d, i, jina, 96);
        kama (jina[0] == 0) { bila_jina = bila_jina + 1; }
        i = i + 1;
    }
    thibitisha("hakuna kata tupu", tupu == 0);
    thibitisha("kila kata ina jina", bila_jina == 0);
    // kila taifa lenye ardhi kwenye ramani lina kata
    n64* ardhi_ya = tenga(8 * d->mataifa);
    weka_sifuri(ardhi_ya, 8 * d->mataifa);
    g = 0;
    wakati (g < px) {
        n64 a = d->ardhi[g] & 255;
        n64 m = dh_u16(d->wamiliki, 2 * g);
        kama ((a == 1 || a == 3) && m < d->mataifa) { ardhi_ya[m] = ardhi_ya[m] + 1; }
        g = g + 1;
    }
    n64 bila = 0;
    n64 t = 0;
    wakati (t < d->mataifa) {
        kama (ardhi_ya[t] > 0 && kata_za_taifa(d, t) == 0) { bila = bila + 1; }
        kama (ardhi_ya[t] == 0) { andika("taifa %d (%s) halina ardhi kwenye ramani\n", t, dh_jina(d->data, d->jina[t]), 0, 0, 0, 0); }
        t = t + 1;
    }
    thibitisha("kila taifa lenye ardhi lina kata", bila == 0);
    // kata ya mji mkuu wa taifa la kwanza ni ya taifa hilo
    n64 k0 = kata_ya(d, d->mji_x[0], d->mji_y[0]);
    thibitisha("kata ya mji mkuu", k0 >= 0 && kata_taifa[k0] == 0);
    kata_jina(d, k0, jina, 96);
    andika("mji mkuu wa taifa 0 uko kwenye kata ya %s (%d km2)\n", jina, kata_eneo[k0] * 95, 0, 0, 0, 0);
    kama (makosa > 0) {
        andika("kata: makosa %d\n", makosa, 0, 0, 0, 0, 0);
        rudisha 1;
    }
    andika("kata: sawa\n", 0, 0, 0, 0, 0, 0);
    rudisha 0;
}
