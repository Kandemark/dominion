husisha { moduli/onyesho/baiti_ghafi.swa }

// mchoro.swa -- vitendo vya msingi vya uchoraji 2D juu ya framebuffer
// YOYOTE ya XRGB8888 (bafa ya n8*, pitch ya baiti kwa kila mstari wa
// pikseli -- inaweza kuwa dumb buffer halisi ya DRM (angalia drm.swa)
// AU bafa ya kawaida ya tenga() kwa madhumuni ya jaribio/nje ya
// skrini). Haihitaji GPU/shader kabisa -- mchezo halisi wa C
// ulitumia SDL_Renderer 2D pekee (fill-rect/line/texture-blit),
// kamwe si API ya GPU ya moja kwa moja, kwa hiyo hakuna kinachopotea
// kwa kutumia CPU pekee hapa.

w0 mchoro_weka_pikseli(n8* fb, n64 pitch, n64 x, n64 y, n64 rangi) {
    n64 off = (y * pitch) + (x * 4);
    weka_u32(fb, off, rangi);
}

n64 mchoro_pata_pikseli(n8* fb, n64 pitch, n64 x, n64 y) {
    n64 off = (y * pitch) + (x * 4);
    rudisha pata_u32(fb, off);
}

// Jaza mstatili (x,y,w,h) na rangi moja, ukikata (clip) kwenye mipaka
// ya canvas_w x canvas_h.
w0 mchoro_piga_mstatili(n8* fb, n64 pitch, n64 canvas_w, n64 canvas_h, n64 x, n64 y, n64 w, n64 h, n64 rangi) {
    n64 x0 = x;
    kama (x0 < 0) { x0 = 0; }
    n64 y0 = y;
    kama (y0 < 0) { y0 = 0; }
    n64 x1 = x + w;
    kama (x1 > canvas_w) { x1 = canvas_w; }
    n64 y1 = y + h;
    kama (y1 > canvas_h) { y1 = canvas_h; }

    n64 j = y0;
    wakati (j < y1) {
        n64 i = x0;
        wakati (i < x1) {
            mchoro_weka_pikseli(fb, pitch, i, j, rangi);
            i = i + 1;
        }
        j = j + 1;
    }
}

// Mstari kwa alogorithimu ya Bresenham (integer pekee, hakuna d64) --
// imekatwa (clip) pikseli moja moja dhidi ya mipaka ya canvas.
w0 mchoro_chora_mstari(n8* fb, n64 pitch, n64 canvas_w, n64 canvas_h, n64 x0, n64 y0, n64 x1, n64 y1, n64 rangi) {
    n64 dx = x1 - x0;
    kama (dx < 0) { dx = 0 - dx; }
    n64 dy = y1 - y0;
    kama (dy < 0) { dy = 0 - dy; }
    n64 sx = 0 - 1;
    kama (x0 < x1) { sx = 1; }
    n64 sy = 0 - 1;
    kama (y0 < y1) { sy = 1; }
    n64 err = dx - dy;
    n64 x = x0;
    n64 y = y0;

    wakati (1) {
        kama (x >= 0 && x < canvas_w && y >= 0 && y < canvas_h) {
            mchoro_weka_pikseli(fb, pitch, x, y, rangi);
        }
        kama (x == x1 && y == y1) { acha; }
        n64 e2 = 2 * err;
        kama (e2 > (0 - dy)) {
            err = err - dy;
            x = x + sx;
        }
        kama (e2 < dx) {
            err = err + dx;
            y = y + sy;
        }
    }
}

// Nakili mstatili wa pikseli kutoka bafa ya chanzo (mfano: sprite/
// bitmap font ndogo iliyowekwa kwenye kumbukumbu) hadi kwenye
// framebuffer lengwa, kwenye nafasi (x,y), ukikata dhidi ya mipaka
// ya lengwa. Hii ndiyo msingi wa uchoraji wa sprite/maandishi ya
// baadaye.
w0 mchoro_bandika(n8* fb, n64 pitch, n64 canvas_w, n64 canvas_h, n64 x, n64 y, n8* chanzo, n64 chanzo_pitch, n64 cw, n64 ch) {
    n64 j = 0;
    wakati (j < ch) {
        n64 dy = y + j;
        kama (dy >= 0 && dy < canvas_h) {
            n64 i = 0;
            wakati (i < cw) {
                n64 dx = x + i;
                kama (dx >= 0 && dx < canvas_w) {
                    n64 px = mchoro_pata_pikseli(chanzo, chanzo_pitch, i, j);
                    mchoro_weka_pikseli(fb, pitch, dx, dy, px);
                }
                i = i + 1;
            }
        }
        j = j + 1;
    }
}

// Mpaka (outline) WA mstatili -- SI uliojazwa. Badala ya kujenga upya
// mantiki ya mstari, kila "ukingo" wa unene uliotolewa huchorwa kama
// mstatili mwembamba wake wenyewe ukitumia mchoro_piga_mstatili
// iliyopo tayari (hivyo ukataji dhidi ya mipaka ya canvas unarithiwa
// moja kwa moja, bila kurudia mantiki hiyo hapa).
w0 mchoro_piga_mstatili_mpaka(n8* fb, n64 pitch, n64 canvas_w, n64 canvas_h, n64 x, n64 y, n64 w, n64 h, n64 rangi, n64 unene) {
    // ukingo wa juu
    mchoro_piga_mstatili(fb, pitch, canvas_w, canvas_h, x, y, w, unene, rangi);
    // ukingo wa chini
    mchoro_piga_mstatili(fb, pitch, canvas_w, canvas_h, x, (y + h) - unene, w, unene, rangi);
    // ukingo wa kushoto
    mchoro_piga_mstatili(fb, pitch, canvas_w, canvas_h, x, y, unene, h, rangi);
    // ukingo wa kulia
    mchoro_piga_mstatili(fb, pitch, canvas_w, canvas_h, (x + w) - unene, y, unene, h, rangi);
}

// Duara LILILOJAZWA -- "midpoint circle algorithm" (integer pekee,
// hauhitaji trig wala civ_mzizi). Kwa kila hatua ya decision variable
// (x,y) tunachora MSTARI MLALO (si pikseli moja moja) kwa ulinganifu
// wa octants nane, hivyo eneo lote la ndani linajazwa; mchoro_piga_
// mstatili (h=1) inatoa ukataji dhidi ya mipaka ya canvas bila ya
// kurudia mantiki hiyo hapa.
w0 mchoro_duara(n8* fb, n64 pitch, n64 canvas_w, n64 canvas_h, n64 cx, n64 cy, n64 radius, n64 rangi) {
    n64 x = radius;
    n64 y = 0;
    n64 err = 1 - radius;

    wakati (x >= y) {
        n64 upana_x = (x + x) + 1;
        mchoro_piga_mstatili(fb, pitch, canvas_w, canvas_h, cx - x, cy + y, upana_x, 1, rangi);
        mchoro_piga_mstatili(fb, pitch, canvas_w, canvas_h, cx - x, cy - y, upana_x, 1, rangi);
        n64 upana_y = (y + y) + 1;
        mchoro_piga_mstatili(fb, pitch, canvas_w, canvas_h, cx - y, cy + x, upana_y, 1, rangi);
        mchoro_piga_mstatili(fb, pitch, canvas_w, canvas_h, cx - y, cy - x, upana_y, 1, rangi);

        y = y + 1;
        kama (err < 0) {
            err = err + (2 * y) + 1;
        } sivyo {
            x = x - 1;
            err = err + (2 * (y - x)) + 1;
        }
    }
}

// Mpaka WA duara pekee (SI uliojazwa) -- "midpoint circle algorithm"
// ya kawaida, ikichapa pikseli NANE za ulinganifu kwa kila hatua
// (TOFAUTI na mchoro_duara: hapa hatujazi safu mlalo -- pikseli za
// ukingo pekee, kioo cha ukaguzi wa mipaka wa mchoro_chora_mstari).
w0 mchoro_duara_mpaka(n8* fb, n64 pitch, n64 canvas_w, n64 canvas_h, n64 cx, n64 cy, n64 radius, n64 rangi) {
    n64 x = radius;
    n64 y = 0;
    n64 err = 1 - radius;

    wakati (x >= y) {
        n64 p1x = cx + x;
        n64 p1y = cy + y;
        kama (p1x >= 0 && p1x < canvas_w && p1y >= 0 && p1y < canvas_h) { mchoro_weka_pikseli(fb, pitch, p1x, p1y, rangi); }

        n64 p2x = cx - x;
        n64 p2y = cy + y;
        kama (p2x >= 0 && p2x < canvas_w && p2y >= 0 && p2y < canvas_h) { mchoro_weka_pikseli(fb, pitch, p2x, p2y, rangi); }

        n64 p3x = cx + x;
        n64 p3y = cy - y;
        kama (p3x >= 0 && p3x < canvas_w && p3y >= 0 && p3y < canvas_h) { mchoro_weka_pikseli(fb, pitch, p3x, p3y, rangi); }

        n64 p4x = cx - x;
        n64 p4y = cy - y;
        kama (p4x >= 0 && p4x < canvas_w && p4y >= 0 && p4y < canvas_h) { mchoro_weka_pikseli(fb, pitch, p4x, p4y, rangi); }

        n64 p5x = cx + y;
        n64 p5y = cy + x;
        kama (p5x >= 0 && p5x < canvas_w && p5y >= 0 && p5y < canvas_h) { mchoro_weka_pikseli(fb, pitch, p5x, p5y, rangi); }

        n64 p6x = cx - y;
        n64 p6y = cy + x;
        kama (p6x >= 0 && p6x < canvas_w && p6y >= 0 && p6y < canvas_h) { mchoro_weka_pikseli(fb, pitch, p6x, p6y, rangi); }

        n64 p7x = cx + y;
        n64 p7y = cy - x;
        kama (p7x >= 0 && p7x < canvas_w && p7y >= 0 && p7y < canvas_h) { mchoro_weka_pikseli(fb, pitch, p7x, p7y, rangi); }

        n64 p8x = cx - y;
        n64 p8y = cy - x;
        kama (p8x >= 0 && p8x < canvas_w && p8y >= 0 && p8y < canvas_h) { mchoro_weka_pikseli(fb, pitch, p8x, p8y, rangi); }

        y = y + 1;
        kama (err < 0) {
            err = err + (2 * y) + 1;
        } sivyo {
            x = x - 1;
            err = err + (2 * (y - x)) + 1;
        }
    }
}

// Mviringo (ellipse) ULIOJAZWA -- panuzi la mchoro_duara kwa radii
// MBILI tofauti (rx/ry). Kwa kila safu ya dy: x_max = rx * sqrt(ry^2
// - dy^2) / ry, ikikokotolewa kwa mzizi wa integer (Newton/Babylonian,
// haihitaji d64/civ_mzizi -- epuka ubadilishaji wa aina n64<->d64
// usiothibitishwa kwenye mnyororo huu).
w0 mchoro_mviringo(n8* fb, n64 pitch, n64 canvas_w, n64 canvas_h, n64 cx, n64 cy, n64 rx, n64 ry, n64 rangi) {
    kama (ry == 0) {
        n64 upana0 = (rx + rx) + 1;
        mchoro_piga_mstatili(fb, pitch, canvas_w, canvas_h, cx - rx, cy, upana0, 1, rangi);
        rudisha;
    }

    n64 dy = 0 - ry;
    wakati (dy <= ry) {
        n64 ry2_dy2 = (ry * ry) - (dy * dy);
        n64 num = (rx * rx) * ry2_dy2;

        n64 mzizi = num;
        kama (num >= 2) {
            n64 kg = num;
            n64 kj = (kg + 1) / 2;
            wakati (kj < kg) {
                kg = kj;
                kj = (kg + (num / kg)) / 2;
            }
            mzizi = kg;
        }

        n64 x_max = mzizi / ry;
        n64 upana = (x_max + x_max) + 1;
        mchoro_piga_mstatili(fb, pitch, canvas_w, canvas_h, cx - x_max, cy + dy, upana, 1, rangi);
        dy = dy + 1;
    }
}

// Pembetatu ILIYOJAZWA -- scanline fill. Wima (x0,y0)/(x1,y1)/(x2,y2)
// vinapangwa kwanza kwa y inayopanda (mtandao wa swaps tatu wa
// kawaida kwa vitu vitatu), kisha kwa kila safu ya y kati ya y0 na y2
// x_kushoto/x_kulia vinakokotolewa kwa interpolation ya mstari mrefu
// (y0->y2) dhidi ya mstari mfupi unaofaa (y0->y1 au y1->y2).
w0 mchoro_pembetatu(n8* fb, n64 pitch, n64 canvas_w, n64 canvas_h, n64 x0, n64 y0, n64 x1, n64 y1, n64 x2, n64 y2, n64 rangi) {
    kama (y0 > y1) {
        n64 tx = x0;
        n64 ty = y0;
        x0 = x1;
        y0 = y1;
        x1 = tx;
        y1 = ty;
    }
    kama (y1 > y2) {
        n64 tx = x1;
        n64 ty = y1;
        x1 = x2;
        y1 = y2;
        x2 = tx;
        y2 = ty;
    }
    kama (y0 > y1) {
        n64 tx = x0;
        n64 ty = y0;
        x0 = x1;
        y0 = y1;
        x1 = tx;
        y1 = ty;
    }

    kama (y2 == y0) {
        // pembetatu tambarare (eneo = 0) -- mstari mmoja wa mlalo pekee
        n64 xmin = x0;
        kama (x1 < xmin) { xmin = x1; }
        kama (x2 < xmin) { xmin = x2; }
        n64 xmax = x0;
        kama (x1 > xmax) { xmax = x1; }
        kama (x2 > xmax) { xmax = x2; }
        mchoro_piga_mstatili(fb, pitch, canvas_w, canvas_h, xmin, y0, (xmax - xmin) + 1, 1, rangi);
        rudisha;
    }

    n64 y = y0;
    wakati (y <= y2) {
        n64 xa = x0 + (((x2 - x0) * (y - y0)) / (y2 - y0));
        n64 xb = 0;
        kama (y < y1) {
            kama (y1 == y0) {
                xb = x0;
            } sivyo {
                xb = x0 + (((x1 - x0) * (y - y0)) / (y1 - y0));
            }
        } sivyo {
            kama (y2 == y1) {
                xb = x1;
            } sivyo {
                xb = x1 + (((x2 - x1) * (y - y1)) / (y2 - y1));
            }
        }
        n64 kushoto = xa;
        kama (xb < kushoto) { kushoto = xb; }
        n64 kulia = xa;
        kama (xb > kulia) { kulia = xb; }
        mchoro_piga_mstatili(fb, pitch, canvas_w, canvas_h, kushoto, y, (kulia - kushoto) + 1, 1, rangi);
        y = y + 1;
    }
}

// Changanya rangi mbili za XRGB8888 (rangi_a, rangi_b) kulingana na
// kipimo 0-255 (0=rangi_a safi KABISA, 255=rangi_b safi KABISA,
// katikati=mchanganyiko wa uwiano). Kila kijenzi (R, G, B)
// kinatenganishwa kwa `>> na & 255`, HASA kama mchoro_pata_pikseli/
// pata_u32 (baiti_ghafi.swa) zinavyounda rangi -- rangi hapa ni
// matokeo ya pata_u32 (kila baiti imekwishapitia `& 255`), hivyo ni
// n64 ISIYO HASI daima, kwa hiyo `>>`/`&` ni salama (hitilafu
// inayojulikana ya mnyororo wa `&`/`>>` kwenye namba hasi [mbegu.s]
// haihusiani na matumizi haya -- angalia komenti ya pata_u16/pata_u32
// hapo juu).
n64 mchoro_changanya_rangi(n64 rangi_a, n64 rangi_b, n64 kipimo) {
    n64 ra = (rangi_a >> 16) & 255;
    n64 ga = (rangi_a >> 8) & 255;
    n64 ba = rangi_a & 255;

    n64 rb = (rangi_b >> 16) & 255;
    n64 gb = (rangi_b >> 8) & 255;
    n64 bb = rangi_b & 255;

    n64 r = ra + (((rb - ra) * kipimo) / 255);
    n64 g = ga + (((gb - ga) * kipimo) / 255);
    n64 b = ba + (((bb - ba) * kipimo) / 255);

    rudisha (r << 16) | (g << 8) | b;
}

// Weka pikseli moja ikichanganywa (alpha blend) na iliyopo tayari
// kwenye framebuffer -- HAINA ukaguzi wa mipaka ya canvas, kwa sababu
// mchoro_weka_pikseli/mchoro_pata_pikseli zilizopo (zilizosomwa hapo
// juu) HAZINA ukaguzi wa mipaka wenyewe ama (zinaandika/kusoma moja
// kwa moja kwa offset iliyokokotolewa bila kukagua x/y dhidi ya
// canvas_w/canvas_h -- jukumu hilo ni la mwito, kama ilivyo tayari
// kwa mchoro_weka_pikseli). Kazi hii inafuata mkataba HUOHUO HASA --
// haina hata vigezo vya canvas_w/canvas_h kwenye saini yake -- hivyo
// mwito ndiye anayehakikisha x/y ziko ndani ya mipaka KABLA ya kuita
// hii, sawa kabisa na jinsi mchoro_piga_mstatili inavyofanya kabla ya
// kuita mchoro_weka_pikseli ndani ya kitanzi chake.
w0 mchoro_weka_pikseli_alpha(n8* fb, n64 pitch, n64 x, n64 y, n64 rangi, n64 alpha) {
    n64 iliyopo = mchoro_pata_pikseli(fb, pitch, x, y);
    n64 mpya = mchoro_changanya_rangi(iliyopo, rangi, alpha);
    mchoro_weka_pikseli(fb, pitch, x, y, mpya);
}

// Mstatili wenye gradient ya MSTARI (linear) WIMA -- kutoka rangi_juu
// (safu ya kwanza, dy=0) hadi rangi_chini (safu ya mwisho, dy=h-1).
// Kila safu ya dy inapewa kipimo chake (0-255) kulingana na nafasi
// yake kati ya juu na chini, kisha rangi ya safu hiyo inakokotolewa
// kwa mchoro_changanya_rangi, na safu nzima inachorwa kwa
// mchoro_piga_mstatili (h_safu=1) -- ukataji dhidi ya mipaka ya
// canvas unarithiwa moja kwa moja na mchoro_piga_mstatili, bila
// kurudia mantiki hiyo hapa.
w0 mchoro_piga_mstatili_gradient(n8* fb, n64 pitch, n64 canvas_w, n64 canvas_h, n64 x, n64 y, n64 w, n64 h, n64 rangi_juu, n64 rangi_chini) {
    kama (h <= 0) { rudisha; }

    n64 dy = 0;
    wakati (dy < h) {
        n64 kipimo = (dy * 255) / h;
        n64 rangi_safu = mchoro_changanya_rangi(rangi_juu, rangi_chini, kipimo);
        mchoro_piga_mstatili(fb, pitch, canvas_w, canvas_h, x, y + dy, w, 1, rangi_safu);
        dy = dy + 1;
    }
}

// Palette ya KUDUMU yenye rangi 8 tofauti, zinazoonekana vizuri kando
// kando ya macho (nyekundu/kijani/bluu/njano/zambarau/cyan/machungwa/
// nyeupe). Faharisi inazungushwa kwa `% 8` ili kuepuka kwenda nje ya
// 0-7 (hivyo faharisi=8 inarudisha sawa na faharisi=0, n.k.).
n64 mchoro_rangi_ya_faharisi(n32 faharisi) {
    n32 f = faharisi % 8;

    kama (f == 0) { rudisha 16711680; }  // nyekundu -- 0xFF0000
    sivyo { kama (f == 1) { rudisha 65280; }  // kijani -- 0x00FF00
    sivyo { kama (f == 2) { rudisha 255; }  // bluu -- 0x0000FF
    sivyo { kama (f == 3) { rudisha 16776960; }  // njano -- 0xFFFF00
    sivyo { kama (f == 4) { rudisha 16711935; }  // zambarau/magenta -- 0xFF00FF
    sivyo { kama (f == 5) { rudisha 65535; }  // cyan -- 0x00FFFF
    sivyo { kama (f == 6) { rudisha 16744448; }  // machungwa -- 0xFF8000
    sivyo { rudisha 16777215; } } } } } } }  // nyeupe -- 0xFFFFFF (f == 7)
}
