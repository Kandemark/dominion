// fonti.swa -- fonti ya bitmap yenye upana usiobadilika (8x16,
// baiti 1 kwa kila mstari wa pikseli: biti 7 = safu wima ya kushoto,
// biti 0 = safu wima ya kulia) kwa ajili ya kuchora maandishi juu ya
// framebuffer YOYOTE ya XRGB8888 (angalia mchoro.swa). Hakuna
// maktaba ya fonti ya nje inayotumika (kanuni ya mradi: sifuri za
// utegemezi) -- data ya herufi imepachikwa moja kwa moja hapa,
// ikitokana na uchoraji halisi wa fonti ya mfumo (monospace) kisha
// kubadilishwa kuwa ramani ya biti 1bpp (hakuna anti-aliasing,
// hakuna kerning, hakuna upanuzi -- si lazima kwa toleo la kwanza).
//
// MUHIMU -- SINTAKSIA: mkusanyaji wa Swa HAUKUBALI kianzilishi cha
// safu ({1, 2, 3}) -- angalia lugha-swa/swa
// majaribio/programu/jaribio_mende_kianzilishi_safu.swa: jaribio
// HILO lenyewe linathibitisha kuwa muundo huo LAZIMA ukataliwe kwa
// sauti, si kukubaliwa kimya. Kwa hiyo data ya fonti HAIWEZI kuandikwa
// kama `n8 ONYESHO_FONTI_DATA[1936] = {...};` -- badala yake
// safu ya ulimwengu (global) isiyo na kianzilishi inatengwa (hii
// inaenda .bss, ikianzishwa kwa SIFURI kiotomatiki na kiunzi cha
// uzalishaji -- angalia data_ulimwengu_bss kwenye
// msingi/mkusanyaji/uzalishaji.swa), kisha kazi ndogo moja kwa kila
// glyph huweka BAITI ZISIZO SIFURI pekee (zile zilizo 0 tayari
// ni sahihi bila kuziandika upya) -- hii inapunguza idadi ya
// taarifa za uwekaji kutoka 1936 hadi idadi halisi ya biti
// zilizowashwa pekee.
//
// WIGO WA HERUFI: ASCII inayochapishwa 32-126 (herufi 95) +
// sehemu ya Kiambatisho cha Latin-1 (U+00C0-U+00FF) inayohitajika na
// Kifaransa: Aa Cc Ee Ii Oo Uu zenye alama (circumflex/aigu/grave/
// trema/cedille) -- herufi 26 (kubwa na ndogo). KWA
// MAKUSUDI HAZIJAJUMUISHWA: mnyambuliko oe/ae (U+0152/U+00E6 n.k.) --
// hizi ziko NJE ya eneo la Latin-1 Supplement (zinaanza na baiti
// nyingine ya UTF-8 kiongozi, si 0xC3), ni nadra sana kwenye
// maandishi ya mchezo huu, na kuzijumuisha kungehitaji njia ya
// uchanganuzi wa UTF-8 ya jumla zaidi -- uamuzi huu wa wigo
// umeandikwa humu kwa uwazi badala ya kudai "Kifaransa kamili".
//
// UCHANGANUZI WA UTF-8: herufi zote za Kiambatisho cha Latin-1
// (U+00C0-U+00FF) HUSIMBWA kwa baiti MBILI za UTF-8 zenye baiti
// kiongozi 0xC3 (195) daima -- hii ndiyo sababu kuangalia 0xC3 pekee
// kunatosha kabisa kugundua herufi zote 26 bila
// kuhitaji msimbuaji wa UTF-8 wa jumla (ambao ungehitajika kwa
// alama za vigezo vingine vya Kiunikodi).

husisha { moduli/onyesho/mchoro.swa }

n32 ONYESHO_FONTI_UPANA = 8;
n32 ONYESHO_FONTI_KIMO = 16;
n32 ONYESHO_FONTI_IDADI = 121;

n8 ONYESHO_FONTI_DATA[1936];

