// onyesho_fonti_faharisi_ascii -- faharisi ya glyph kwa ASCII
// inayochapishwa (32-126). Nje ya wigo huu -> -1 (haijaungwa mkono,
// inarukwa salama na mchoro_andika_mstari badala ya kuchora takataka).
n32 onyesho_fonti_faharisi_ascii(n32 kanuni) {
    kama (kanuni < 32 || kanuni > 126) { rudisha 0 - 1; }
    rudisha kanuni - 32;
}

// onyesho_fonti_faharisi_latin1 -- faharisi ya glyph kwa nukta ya
// Kiunikodi ndani ya U+00C0-U+00FF (tayari imebadilishwa kutoka
// baiti mbili za UTF-8 na mwito). Nje ya seti ya 
// herufi 26 zinazoungwa mkono -> -1.
n32 onyesho_fonti_faharisi_latin1(n32 nukta) {
    kama (nukta == 192) { rudisha 95; }  // 'À'
    kama (nukta == 194) { rudisha 96; }  // 'Â'
    kama (nukta == 199) { rudisha 97; }  // 'Ç'
    kama (nukta == 200) { rudisha 98; }  // 'È'
    kama (nukta == 201) { rudisha 99; }  // 'É'
    kama (nukta == 202) { rudisha 100; }  // 'Ê'
    kama (nukta == 203) { rudisha 101; }  // 'Ë'
    kama (nukta == 206) { rudisha 102; }  // 'Î'
    kama (nukta == 207) { rudisha 103; }  // 'Ï'
    kama (nukta == 212) { rudisha 104; }  // 'Ô'
    kama (nukta == 217) { rudisha 105; }  // 'Ù'
    kama (nukta == 219) { rudisha 106; }  // 'Û'
    kama (nukta == 220) { rudisha 107; }  // 'Ü'
    kama (nukta == 224) { rudisha 108; }  // 'à'
    kama (nukta == 226) { rudisha 109; }  // 'â'
    kama (nukta == 231) { rudisha 110; }  // 'ç'
    kama (nukta == 232) { rudisha 111; }  // 'è'
    kama (nukta == 233) { rudisha 112; }  // 'é'
    kama (nukta == 234) { rudisha 113; }  // 'ê'
    kama (nukta == 235) { rudisha 114; }  // 'ë'
    kama (nukta == 238) { rudisha 115; }  // 'î'
    kama (nukta == 239) { rudisha 116; }  // 'ï'
    kama (nukta == 244) { rudisha 117; }  // 'ô'
    kama (nukta == 249) { rudisha 118; }  // 'ù'
    kama (nukta == 251) { rudisha 119; }  // 'û'
    kama (nukta == 252) { rudisha 120; }  // 'ü'
    rudisha 0 - 1;
}


// MchoroMaandishiHoja -- hoja zimefungwa kwenye muundo (zaidi ya
// vigezo 6, baadhi ya 64-bit -- angalia kanuni za usanifu za mradi).
muundo MchoroMaandishiHoja {
    n8* fb;
    n64 pitch;
    n64 canvas_w;
    n64 canvas_h;
    n64 x;
    n64 y;
    n8* maandishi;
    n64 rangi;
};

// mchoro_andika_mstari -- huchora mfuatano (n8*, null-terminated)
// kwenye framebuffer, glyph moja baada ya nyingine, kwa kutumia
// mchoro_weka_pikseli iliyopo TAYARI (mchoro.swa) kwa kila pikseli
// iliyowashwa. Hukata (clip) dhidi ya canvas_w/canvas_h, kama vile
// mchoro_piga_mstatili/mchoro_chora_mstari zinavyofanya.
//
// Husoma UTF-8: baiti < 128 ni ASCII ya moja kwa moja; baiti kiongozi
// 0xC3 (195) huanzisha mfuatano wa baiti 2 wa Kiambatisho cha Latin-1
// (angalia maelezo juu ya faili). Herufi nyingine zozote (baiti
// kiongozi tofauti za UTF-8, au baiti za kuendelea zilizopotea) hazina
// glyph inayolingana -- hurukwa salama (nafasi moja ya herufi
// inarukwa, hakuna kuchora takataka, hakuna kitanzi kisichokwisha).
w0 mchoro_andika_mstari(MchoroMaandishiHoja* hoja) {
    n8* fb = hoja->fb;
    n64 pitch = hoja->pitch;
    n64 canvas_w = hoja->canvas_w;
    n64 canvas_h = hoja->canvas_h;
    n64 cx = hoja->x;
    n64 y = hoja->y;
    n8* maandishi = hoja->maandishi;
    n64 rangi = hoja->rangi;

    n64 i = 0;
    wakati (maandishi[i] != 0) {
        n32 b0 = maandishi[i] & 255;
        n32 faharisi = 0 - 1;
        n64 baiti_zilizotumika = 1;

        kama (b0 < 128) {
            faharisi = onyesho_fonti_faharisi_ascii(b0);
        } sivyo {
            kama (b0 == 195) {
                n32 b1 = maandishi[i + 1] & 255;
                kama (b1 != 0) {
                    n32 nukta = 192 + (b1 & 63);
                    faharisi = onyesho_fonti_faharisi_latin1(nukta);
                    baiti_zilizotumika = 2;
                }
            }
        }

        kama (faharisi >= 0) {
            n64 msingi = faharisi * ONYESHO_FONTI_KIMO;
            n32 row = 0;
            wakati (row < ONYESHO_FONTI_KIMO) {
                n64 dy = y + row;
                kama (dy >= 0 && dy < canvas_h) {
                    n32 byte = ONYESHO_FONTI_DATA[msingi + row] & 255;
                    n32 col = 0;
                    wakati (col < ONYESHO_FONTI_UPANA) {
                        n64 dx = cx + col;
                        kama (dx >= 0 && dx < canvas_w) {
                            n32 biti = (byte >> (7 - col)) & 1;
                            kama (biti == 1) {
                                mchoro_weka_pikseli(fb, pitch, dx, dy, rangi);
                            }
                        }
                        col = col + 1;
                    }
                }
                row = row + 1;
            }
        }

        cx = cx + ONYESHO_FONTI_UPANA;
        i = i + baiti_zilizotumika;
    }
}
