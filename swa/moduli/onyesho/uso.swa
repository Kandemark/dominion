husisha { moduli/onyesho/turubai.swa }
husisha { msingi/maktaba/hesabu.swa }

// uso.swa -- picha za wahusika zinazochorwa kwa msimbo, pikseli kwa pikseli.
//
// Uso ni vigezo 15 (umbo, ngozi, nywele na rangi yake, macho na rangi yake,
// nyusi, pua, mdomo, ndevu, miwani, mavazi, jinsia, unene, umri). Picha ni ya
// kichwa na mabega kama ya studio: kila pikseli hupata rangi kutoka maumbo
// yaliyopangwa nyuma kwenda mbele, na mwanga kutoka juu-kushoto juu ya kichwa
// kinachochukuliwa kuwa duaradufu ya pande tatu. Kingo ni laini kwa umbali
// kutoka kila umbo; nywele na ndevu zina umbile la kelele. Hakuna picha za nje.
//
// Picha zilizochorwa huwekwa kwenye akiba (vigezo na ukubwa), kwa hiyo orodha
// ndefu za maafisa huchora kila uso mara moja tu.
//
// Vipimo vyote viko kwenye kisanduku cha 100x100: kichwa kiko (50, 44).

muundo Uso {
    n64 umbo;           // 0..3   mviringo, mrefu, mpana, wa mraba
    n64 ngozi;          // 0..11  nyeupe kabisa .. nyeusi kabisa
    n64 nywele;         // 0..9   upara, fupi, upande, ndefu, kipilipili fupi, fundo,
                        //        zinazopungua, kilemba, misuko, zilizolazwa
    n64 rangi_ya_nywele;// 0..6   nyeusi, kahawia nzito, kahawia, nyekundu, njano, kijivu, nyeupe
    n64 macho;          // 0..3   lozi, yaliyofunikwa, mviringo, kope moja
    n64 nyusi;          // 0..3   nyembamba .. nene
    n64 pua;            // 0..3   nyembamba .. pana
    n64 mdomo;          // 0..3   nyembamba .. kamili
    n64 ndevu;          // 0..6   hakuna, changa, masharubu, kamili, kidevu, za pembeni, ndefu
    n64 miwani;         // 0..2   hakuna, ya mviringo, ya mstatili
    n64 mavazi;         // 0..6   koti la zamani, suti, sare ya jeshi, joho, shati, ya kifalme, ya jadi
    n64 jinsia;         // 0..1   mwanamume, mwanamke
    n64 rangi_ya_macho; // 0..4   kahawia nzito, kahawia, hazel, kijani, buluu
    n64 unene;          // 0..3   mwembamba .. mnene
    n64 umri;           // 0..5   miaka 20, 30, 40, 50, 60, 70+
}

n64 USO_SIFA = 15;

n64 uso_kikomo(n64 sifa) {
    kama (sifa == 0) { rudisha 4; }
    kama (sifa == 1) { rudisha 12; }
    kama (sifa == 2) { rudisha 10; }
    kama (sifa == 3) { rudisha 7; }
    kama (sifa == 8) { rudisha 7; }
    kama (sifa == 9) { rudisha 3; }
    kama (sifa == 10) { rudisha 7; }
    kama (sifa == 11) { rudisha 2; }
    kama (sifa == 12) { rudisha 5; }
    kama (sifa == 14) { rudisha 6; }
    rudisha 4;
}

n64* uso_sifa_ya(Uso* u, n64 sifa) {
    kama (sifa == 0) { rudisha &u->umbo; }
    kama (sifa == 1) { rudisha &u->ngozi; }
    kama (sifa == 2) { rudisha &u->nywele; }
    kama (sifa == 3) { rudisha &u->rangi_ya_nywele; }
    kama (sifa == 4) { rudisha &u->macho; }
    kama (sifa == 5) { rudisha &u->nyusi; }
    kama (sifa == 6) { rudisha &u->pua; }
    kama (sifa == 7) { rudisha &u->mdomo; }
    kama (sifa == 8) { rudisha &u->ndevu; }
    kama (sifa == 9) { rudisha &u->miwani; }
    kama (sifa == 10) { rudisha &u->mavazi; }
    kama (sifa == 11) { rudisha &u->jinsia; }
    kama (sifa == 12) { rudisha &u->rangi_ya_macho; }
    kama (sifa == 13) { rudisha &u->unene; }
    rudisha &u->umri;
}

// Badilisha sifa kwa hatua +1 / -1 (huzunguka).
w0 uso_badilisha(Uso* u, n64 sifa, n64 hatua) {
    n64* v = uso_sifa_ya(u, sifa);
    n64 k = uso_kikomo(sifa);
    v[0] = ((v[0] + hatua) % k + k) % k;
}

n64 uso_nasibu(n64 a, n64 b) {
    n64 n = (a * 2654435761 + b * 40503 + 4057) & 4294967295;
    n = ((n ^ (n >> 15)) * 2246822519) & 4294967295;
    rudisha (n ^ (n >> 13)) & 4294967295;
}

// Uso wa nasibu kutoka mbegu, bila kuzingatia jamii (skrini/nyuso.swa
// huzalisha nyuso kwa jamii za taifa). Mavazi hufuata zama.
w0 uso_zalisha(Uso* u, n64 mbegu, n64 mwaka) {
    n64 s = 0;
    wakati (s < USO_SIFA) {
        n64* v = uso_sifa_ya(u, s);
        v[0] = uso_nasibu(mbegu, s + 1) % uso_kikomo(s);
        s = s + 1;
    }
    u->jinsia = 0;
    kama (uso_nasibu(mbegu, 40) % 3 != 0) { u->miwani = 0; }
    kama (mwaka < 1850) { u->mavazi = 0; } sivyo { u->mavazi = 1; }
}

// Kuhifadhi: vigezo 11 vya kwanza huandikwa (umbizo la faili halibadiliki);
// vinne vya mwisho hukaa juu ya vinne vya kwanza (v + 256 * ziada).
n64 USO_SIFA_ZA_FAILI = 11;

n64 uso_thamani_ya_faili(Uso* u, n64 s) {
    n64 v = uso_sifa_ya(u, s)[0];
    kama (s < USO_SIFA - USO_SIFA_ZA_FAILI) { v = v + 256 * uso_sifa_ya(u, USO_SIFA_ZA_FAILI + s)[0]; }
    rudisha v;
}

w0 uso_weka_kutoka_faili(Uso* u, n64 s, n64 v) {
    uso_sifa_ya(u, s)[0] = (v % 256) % uso_kikomo(s);
    kama (s < USO_SIFA - USO_SIFA_ZA_FAILI) { uso_sifa_ya(u, USO_SIFA_ZA_FAILI + s)[0] = (v / 256) % uso_kikomo(USO_SIFA_ZA_FAILI + s); }
}

// ---------- rangi ----------

n64 uso_rangi_ya_ngozi(n64 i) {
    kama (i == 0) { rudisha 16179667; }
    kama (i == 1) { rudisha 15716280; }
    kama (i == 2) { rudisha 15122080; }
    kama (i == 3) { rudisha 14264452; }
    kama (i == 4) { rudisha 13209704; }
    kama (i == 5) { rudisha 11893330; }
    kama (i == 6) { rudisha 10380864; }
    kama (i == 7) { rudisha 8934452; }
    kama (i == 8) { rudisha 7488810; }
    kama (i == 9) { rudisha 6174754; }
    kama (i == 10) { rudisha 4860955; }
    rudisha 3809814;
}

n64 uso_rangi_ya_nywele(n64 i) {
    kama (i == 0) { rudisha 1841689; }
    kama (i == 1) { rudisha 3877410; }
    kama (i == 2) { rudisha 7031347; }
    kama (i == 3) { rudisha 9059106; }
    kama (i == 4) { rudisha 13215339; }
    kama (i == 5) { rudisha 9341832; }
    rudisha 14473426;
}

n64 uso_rangi_ya_macho_ya(n64 i) {
    kama (i == 0) { rudisha 3022100; }
    kama (i == 1) { rudisha 5913122; }
    kama (i == 2) { rudisha 8020530; }
    kama (i == 3) { rudisha 5143114; }
    rudisha 6063272;
}

n64 uso_rangi_ya_mavazi(n64 i) {
    kama (i == 0) { rudisha 3091018; }    // koti la zamani
    kama (i == 1) { rudisha 2764341; }    // suti
    kama (i == 2) { rudisha 4082227; }    // sare ya jeshi
    kama (i == 3) { rudisha 1513243; }    // joho la mahakama au dini
    kama (i == 4) { rudisha 13883616; }    // shati
    kama (i == 5) { rudisha 7214118; }    // ya kifalme
    rudisha 9069608;                      // ya jadi
}

// Kitambaa cha kilemba (kwa rangi_ya_nywele) na cha tai (kwa umbo).
n64 uso_rangi_ya_kitambaa(n64 i) {
    kama (i == 0) { rudisha 1981038; }
    kama (i == 1) { rudisha 15262420; }
    kama (i == 2) { rudisha 9182244; }
    kama (i == 3) { rudisha 3042117; }
    kama (i == 4) { rudisha 13145646; }
    kama (i == 5) { rudisha 5910126; }
    rudisha 14275266;
}

// ---------- hesabu ndogo ----------

// Badili namba nzima kuwa d64 (Swa haibadilishi n64 ndani ya hesabu ya d64).
d64 uso_d(n64 v) {
    d64 r = v;
    rudisha r;
}

d64 uso_bana(d64 v) {
    kama (v < 0.0) { rudisha 0.0; }
    kama (v > 1.0) { rudisha 1.0; }
    rudisha v;
}

d64 uso_kamili(d64 v) {
    kama (v < 0.0) { rudisha 0.0 - v; }
    rudisha v;
}

// Funiko (0..1) kutoka umbali wenye ishara d (chanya ndani) na upana wa pikseli w.
d64 uso_funiko(d64 d, d64 w) { rudisha uso_bana(d / w + 0.5); }

// Umbali wa takriban ndani ya duaradufu (chanya ndani), kwa vizio vya kisanduku.
d64 uso_duara(d64 x, d64 y, d64 cx, d64 cy, d64 rx, d64 ry) {
    d64 dx = (x - cx) / rx;
    d64 dy = (y - cy) / ry;
    d64 e = mzizi_hesabu(dx * dx + dy * dy);
    d64 r = rx;
    kama (ry < r) { r = ry; }
    rudisha (1.0 - e) * r;
}

// Umbali kutoka nukta hadi kipande cha mstari.
d64 uso_kipande(d64 x, d64 y, d64 ax, d64 ay, d64 bx, d64 by) {
    d64 vx = bx - ax;
    d64 vy = by - ay;
    d64 wx = x - ax;
    d64 wy = y - ay;
    d64 l = vx * vx + vy * vy;
    d64 t = 0.0;
    kama (l > 0.0) { t = uso_bana((wx * vx + wy * vy) / l); }
    d64 px = ax + vx * t - x;
    d64 py = ay + vy * t - y;
    rudisha mzizi_hesabu(px * px + py * py);
}

// Kelele laini 0..1 (thamani kwenye gridi, kisha mchanganyiko wa mstari).
d64 uso_kelele_ya(n64 ix, n64 iy, n64 mbegu) {
    n64 h = uso_nasibu(ix * 73856093 + iy * 19349663, mbegu) % 1000;
    d64 v = h;
    rudisha v / 1000.0;
}

d64 uso_kelele(d64 x, d64 y, n64 mbegu) {
    n64 ix = x;
    n64 iy = y;
    kama (x < 0.0) { ix = ix - 1; }
    kama (y < 0.0) { iy = iy - 1; }
    d64 fx = x - uso_d(ix);
    d64 fy = y - uso_d(iy);
    fx = fx * fx * (3.0 - 2.0 * fx);
    fy = fy * fy * (3.0 - 2.0 * fy);
    d64 a = uso_kelele_ya(ix, iy, mbegu);
    d64 b = uso_kelele_ya(ix + 1, iy, mbegu);
    d64 c = uso_kelele_ya(ix, iy + 1, mbegu);
    d64 d = uso_kelele_ya(ix + 1, iy + 1, mbegu);
    d64 juu = a + (b - a) * fx;
    d64 chini = c + (d - c) * fx;
    rudisha juu + (chini - juu) * fy;
}

// ---------- uchoraji ----------

// Hali ya pikseli moja na vipimo vya uso vinavyotumika na kila tabaka.
muundo UsoKazi {
    d64 r;              // rangi inayojengwa, 0..255
    d64 g;
    d64 b;
    d64 w;              // upana wa pikseli moja kwa vizio vya kisanduku
    d64 hx;             // kitovu cha kichwa
    d64 hy;
    d64 rx;             // nusu-upana na nusu-kimo cha kichwa
    d64 ry;
    d64 taper;          // kupungua kwa taya
    d64 ex;             // umbali wa jicho kutoka katikati
    d64 ey;             // kimo cha macho
    d64 my;             // kimo cha mdomo
    d64 mw;             // nusu-upana wa mdomo
    d64 sw;             // nusu-upana wa mabega
    n64 ngozi;
    n64 nywele;
    n64 vazi;
    n64 mbegu;
}

w0 uso_paka(UsoKazi* k, n64 rangi, d64 a) {
    kama (a <= 0.0) { rudisha; }
    kama (a > 1.0) { a = 1.0; }
    d64 rr = (rangi >> 16) & 255;
    d64 gg = (rangi >> 8) & 255;
    d64 bb = rangi & 255;
    k->r = k->r + (rr - k->r) * a;
    k->g = k->g + (gg - k->g) * a;
    k->b = k->b + (bb - k->b) * a;
}

// Zidisha rangi iliyopo (kivuli < 1, mwanga > 1) kwa kiasi a.
w0 uso_zidisha(UsoKazi* k, d64 f, d64 a) {
    kama (a <= 0.0) { rudisha; }
    d64 m = 1.0 + (f - 1.0) * uso_bana(a);
    k->r = k->r * m;
    k->g = k->g * m;
    k->b = k->b * m;
}

// Rangi yenye mwanga: rangi * kivuli (kivuli 0..1.3).
n64 uso_kivuli(n64 rangi, d64 kivuli) {
    d64 rr = uso_d((rangi >> 16) & 255) * kivuli;
    d64 gg = uso_d((rangi >> 8) & 255) * kivuli;
    d64 bb = uso_d(rangi & 255) * kivuli;
    kama (rr > 255.0) { rr = 255.0; }
    kama (gg > 255.0) { gg = 255.0; }
    kama (bb > 255.0) { bb = 255.0; }
    n64 r = rr;
    n64 g = gg;
    n64 b = bb;
    rudisha (r << 16) | (g << 8) | b;
}

n64 uso_changanya(n64 a, n64 b, n64 f) {
    n64 r = (((a >> 16) & 255) * (255 - f) + ((b >> 16) & 255) * f) / 255;
    n64 g = (((a >> 8) & 255) * (255 - f) + ((b >> 8) & 255) * f) / 255;
    n64 c = ((a & 255) * (255 - f) + (b & 255) * f) / 255;
    rudisha (r << 16) | (g << 8) | c;
}

// Mwanga wa juu-kushoto juu ya duaradufu ya pande tatu (dx, dy kwa kipimo 0..1).
d64 uso_mwanga(d64 dx, d64 dy) {
    d64 q = 1.0 - dx * dx - dy * dy;
    kama (q < 0.0) { q = 0.0; }
    d64 nz = mzizi_hesabu(q);
    d64 l = 0.0 - 0.45 * dx - 0.55 * dy + 0.70 * nz;
    kama (l < 0.0) { l = 0.0; }
    rudisha 0.58 + 0.52 * l;
}

// Kichwa: umbali wenye ishara (chanya ndani), na dx/dy zilizosawazishwa.
d64 uso_kichwa_umbali(UsoKazi* k, d64 x, d64 y) {
    d64 dx = (x - k->hx) / k->rx;
    d64 dy = (y - k->hy) / k->ry;
    kama (dy > 0.0) {
        d64 taya = 1.0 - k->taper * dy * dy;
        kama (taya < 0.25) { taya = 0.25; }
        dx = dx / taya;
    }
    rudisha (1.0 - mzizi_hesabu(dx * dx + dy * dy)) * k->rx;
}

// Usuli wa studio: mwanga laini nyuma ya kichwa.
w0 uso_usuli(UsoKazi* k, d64 x, d64 y) {
    d64 dx = (x - 46.0) / 70.0;
    d64 dy = (y - 30.0) / 80.0;
    d64 f = 1.0 - (dx * dx + dy * dy);
    kama (f < 0.0) { f = 0.0; }
    k->r = 20.0 + 34.0 * f;
    k->g = 25.0 + 38.0 * f;
    k->b = 32.0 + 46.0 * f;
}

// Mabega na mavazi.
w0 uso_mavazi(UsoKazi* k, Uso* u, d64 x, d64 y) {
    d64 d = uso_duara(x, y, 50.0, 109.0, k->sw + 4.0, 31.0);
    kama (d <= 0.0 - k->w) { rudisha; }
    d64 a = uso_funiko(d, k->w);
    d64 dx = (x - 50.0) / (k->sw + 4.0);
    d64 dy = (y - 109.0) / 31.0;
    n64 msingi = uso_kivuli(k->vazi, uso_mwanga(dx * 0.9, dy * 0.9 - 0.25));
    uso_paka(k, msingi, a);
    d64 ax = uso_kamili(x - 50.0);
    d64 shingo_y = 79.0;
    // shati jeupe na kola (koti, suti, ya kifalme)
    kama (u->mavazi == 0 || u->mavazi == 1 || u->mavazi == 5) {
        d64 v = 0.55;
        kama (u->mavazi == 1) { v = 0.36; }
        kama (y > shingo_y && ax < (y - shingo_y) * v + 0.4) {
            uso_paka(k, uso_kivuli(15526628, uso_mwanga(dx, 0.0 - 0.3)), a * uso_funiko((y - shingo_y) * v + 0.4 - ax, k->w));
        }
        // ukingo wa koti (lapel) huwa na kivuli
        d64 ukingo = uso_kamili(ax - (y - shingo_y) * v - 0.4);
        kama (y > shingo_y && ukingo < 1.4) { uso_zidisha(k, 0.7, a * (1.0 - ukingo / 1.4)); }
    }
    kama (u->mavazi == 0) {
        // kitambaa cha shingo (cravat)
        d64 c = uso_duara(x, y, 50.0, 83.0, 4.2, 3.4);
        kama (c > 0.0 - k->w) { uso_paka(k, uso_kivuli(15921386, uso_mwanga((x - 50.0) / 6.0, (y - 82.0) / 6.0)), uso_funiko(c, k->w)); }
    }
    kama (u->mavazi == 1 && u->jinsia == 0) {
        // tai na fundo lake
        n64 tai = uso_rangi_ya_kitambaa((u->umbo + u->ngozi) % 6);
        kama (tai == 15262420) { tai = 1981038; }
        d64 upana = 1.5 + (y - 83.0) * 0.07;
        kama (y > 83.0 && y < 104.0 && ax < upana) { uso_paka(k, uso_kivuli(tai, uso_mwanga(dx * 3.0, 0.0)), uso_funiko(upana - ax, k->w)); }
        d64 f = uso_duara(x, y, 50.0, 82.6, 1.9, 1.5);
        kama (f > 0.0 - k->w) { uso_paka(k, uso_kivuli(tai, 0.85), uso_funiko(f, k->w)); }
    }
    kama (u->mavazi == 2) {
        // kola ndefu, kamba ya dhahabu, vifungo na vipande vya mabega
        kama (y > 77.0 && y < 83.5 && ax < 10.0) { uso_zidisha(k, 0.8, 1.0); }
        kama (uso_kamili(y - 82.8) < 0.45 && ax < 10.0) { uso_paka(k, 13214282, 0.9); }
        n64 i = 0;
        wakati (i < 3) {
            d64 by = 89.0 + 7.0 * uso_d(i);
            d64 kf = uso_duara(x, y, 50.0, by, 0.95, 0.95);
            kama (kf > 0.0 - k->w) { uso_paka(k, uso_kivuli(14201942, uso_mwanga((x - 49.6) / 1.2, (y - by + 0.4) / 1.2)), uso_funiko(kf, k->w)); }
            i = i + 1;
        }
        d64 ep = uso_duara(ax, y, k->sw - 7.0, 91.0, 6.5, 2.4);
        kama (ep > 0.0 - k->w) { uso_paka(k, uso_kivuli(13214282, uso_mwanga((ax - k->sw + 9.0) / 7.0, (y - 90.0) / 3.0)), uso_funiko(ep, k->w)); }
    }
    kama (u->mavazi == 3) {
        // vipande viwili vyeupe vya mahakama au dini
        kama (y > 80.0 && y < 93.0 && uso_kamili(ax - 1.4) < 1.1) { uso_paka(k, 15724006, uso_funiko(1.1 - uso_kamili(ax - 1.4), k->w)); }
    }
    kama (u->mavazi == 4) {
        // shati: kola wazi
        kama (y > shingo_y && ax < (y - shingo_y) * 0.3 + 0.2 && y < 89.0) { uso_paka(k, uso_kivuli(k->ngozi, 0.8), 1.0); }
        d64 kola = uso_kamili(ax - (y - shingo_y) * 0.3 - 0.2);
        kama (y > shingo_y && y < 89.0 && kola < 1.0) { uso_zidisha(k, 0.8, 1.0 - kola); }
    }
    kama (u->mavazi == 5) {
        // ngozi ya ermine na mnyororo wa dhahabu
        d64 ermine = uso_duara(x, y, 50.0, 104.0, k->sw + 1.0, 22.0);
        kama (y > 82.0 && y < 97.0 && ermine > 0.0) {
            uso_paka(k, uso_kivuli(15855334, uso_mwanga(dx, 0.0 - 0.2)), a);
            n64 gx = x / 4.0;
            n64 gy = y / 4.0;
            d64 nx = x - uso_d(gx) * 4.0 - 2.0 - (uso_d(gy % 2) * 2.0 - 1.0);
            d64 nyy = y - uso_d(gy) * 4.0 - 2.0;
            kama (nx * nx + nyy * nyy < 0.5) { uso_paka(k, 1381653, 0.9); }
        }
        d64 mn = uso_kamili(y - (84.0 + 0.014 * (x - 50.0) * (x - 50.0)));
        kama (mn < 0.55 && ax < k->sw - 4.0) { uso_paka(k, 14266956, uso_funiko(0.55 - mn, k->w)); }
    }
    kama (u->mavazi == 6) {
        // kitambaa cha jadi chenye mistari ya mshazari
        d64 m = sin_hesabu((x + y * 0.8) * 0.9);
        kama (m > 0.6) { uso_paka(k, uso_kivuli(uso_rangi_ya_kitambaa((u->umbo + u->rangi_ya_nywele) % 7), 0.9), a * 0.55); }
        d64 sh = uso_kamili(y - 80.0 - (x - 50.0) * 0.35);
        kama (sh < 1.2 && x > 40.0) { uso_zidisha(k, 0.75, a * (1.0 - sh / 1.2)); }
    }
}

// Shingo yenye kivuli chini ya taya.
w0 uso_shingo(UsoKazi* k, Uso* u, d64 x, d64 y) {
    // pande zilizonyooka zinazopanuka kidogo kuelekea mabega
    d64 juu = k->hy + k->ry - 10.0;
    kama (y < juu || y > 96.0) { rudisha; }
    d64 rw = 8.2 + uso_d(u->unene) * 1.0 - uso_d(u->jinsia) * 1.5 + uso_bana((y - 78.0) / 14.0) * 4.0;
    d64 d = rw - uso_kamili(x - 50.0);
    kama (d <= 0.0 - k->w) { rudisha; }
    d64 dx = (x - 50.0) / rw;
    d64 f = (0.62 + 0.36 * uso_bana(1.0 - (dx + 0.35) * (dx + 0.35))) * 0.92;
    uso_paka(k, uso_kivuli(k->ngozi, f), uso_funiko(d, k->w));
    // kivuli cha taya juu ya shingo
    d64 chini_ya_taya = k->hy + k->ry - 2.0;
    kama (y < chini_ya_taya + 6.0) { uso_zidisha(k, 0.68, (chini_ya_taya + 6.0 - y) / 7.0); }
}

w0 uso_masikio(UsoKazi* k, d64 x, d64 y) {
    d64 upande = 1.0;
    kama (x < 50.0) { upande = 0.0 - 1.0; }
    d64 cx = 50.0 + upande * (k->rx - 0.6);
    d64 d = uso_duara(x, y, cx, k->hy + 1.0, 3.6, 6.0);
    kama (d <= 0.0 - k->w) { rudisha; }
    d64 f = 0.78;
    kama (upande < 0.0) { f = 0.95; }
    uso_paka(k, uso_kivuli(k->ngozi, f), uso_funiko(d, k->w));
    d64 ndani = uso_duara(x, y, cx + upande * 0.4, k->hy + 1.2, 1.8, 3.8);
    kama (ndani > 0.0) { uso_zidisha(k, 0.78, uso_funiko(ndani, k->w)); }
}

// Ngozi ya uso: mwanga, mashavu, mashimo ya macho, na mistari ya umri.
w0 uso_ngozi(UsoKazi* k, Uso* u, d64 x, d64 y) {
    d64 d = uso_kichwa_umbali(k, x, y);
    kama (d <= 0.0 - k->w) { rudisha; }
    d64 dx = (x - k->hx) / k->rx;
    d64 dy = (y - k->hy) / k->ry;
    kama (dy > 0.0) {
        d64 taya = 1.0 - k->taper * dy * dy;
        kama (taya < 0.25) { taya = 0.25; }
        dx = dx / taya;
    }
    d64 mwanga = uso_mwanga(dx * 0.92, dy * 0.92);
    uso_paka(k, uso_kivuli(k->ngozi, mwanga), uso_funiko(d, k->w));
    // joto la ngozi kwenye kivuli
    uso_paka(k, 11554879, (1.15 - mwanga) * 0.18);
    // mashavu
    d64 shavu = uso_duara(uso_kamili(x - 50.0), y, 11.5, k->hy + 9.5, 6.5, 4.5);
    kama (shavu > 0.0) { uso_paka(k, 12607578, uso_bana(shavu / 4.0) * (0.10 + uso_d(u->jinsia) * 0.06)); }
    // mashimo ya macho
    d64 shimo = uso_duara(uso_kamili(x - 50.0), y, k->ex, k->ey - 0.5, 5.8, 3.9);
    kama (shimo > 0.0) { uso_zidisha(k, 0.86, uso_bana(shimo / 3.0)); }
    // kivuli chini ya mdomo na kidevu
    d64 kidevu = uso_duara(x, y, 50.0, k->my + 3.4, 4.0, 1.4);
    kama (kidevu > 0.0) { uso_zidisha(k, 0.88, uso_bana(kidevu / 1.4)); }
    // mistari ya umri
    d64 ax = uso_kamili(x - 50.0);
    kama (u->umri >= 3 && ax < 9.0) {
        d64 m1 = uso_kamili(y - (k->hy - 15.0 + 0.02 * ax * ax));
        d64 m2 = uso_kamili(y - (k->hy - 12.2 + 0.02 * ax * ax));
        d64 nguvu = 0.10 + 0.04 * (u->umri - 3);
        kama (m1 < 0.35) { uso_zidisha(k, 0.82, nguvu * (1.0 - ax / 9.0)); }
        kama (m2 < 0.35 && u->umri >= 4) { uso_zidisha(k, 0.82, nguvu * (1.0 - ax / 9.0)); }
    }
    kama (u->umri >= 2) {
        d64 mk = uso_kipande(ax, y, 3.6, k->hy + 12.5, k->mw + 1.6, k->my + 1.0);
        kama (mk < 0.45) { uso_zidisha(k, 0.78, (0.12 + 0.05 * uso_d(u->umri)) * (1.0 - mk / 0.45)); }
    }
    kama (u->umri >= 4) {
        n64 i = 0;
        wakati (i < 3) {
            d64 sy = k->ey - 0.6 + uso_d(i) * 0.9;
            d64 cf = uso_kipande(ax, y, k->ex + 4.6, sy, k->ex + 6.6, sy + uso_d(i - 1) * 0.8);
            kama (cf < 0.25) { uso_zidisha(k, 0.85, 0.5); }
            i = i + 1;
        }
    }
    // mifuko chini ya macho
    kama (u->umri >= 3) {
        d64 mfuko = uso_kamili(y - (k->ey + 2.6 + 0.04 * (ax - k->ex) * (ax - k->ex)));
        kama (mfuko < 0.4 && uso_kamili(ax - k->ex) < 3.2) { uso_zidisha(k, 0.84, (0.10 + 0.06 * uso_d(u->umri - 3)) * (1.0 - mfuko / 0.4)); }
    }
    // taya inayolegea na madoa ya uzee
    kama (u->umri >= 4 && dy > 0.6) { uso_zidisha(k, 0.9, uso_bana((dy - 0.6) * 2.5) * uso_bana(uso_kamili(dx) - 0.5) * 1.4); }
    kama (u->umri >= 5) {
        d64 doa = uso_kelele(x * 1.7, y * 1.7, k->mbegu + 23);
        kama (doa > 0.82 && dy < 0.2) { uso_zidisha(k, 0.9, (doa - 0.82) * 4.0); }
    }
    kama (u->umri >= 3 && u->unene >= 2 && dy > 0.55) { uso_zidisha(k, 0.9, uso_bana((dy - 0.55) * 2.0) * uso_bana(uso_kamili(dx) - 0.55)); }
}

// Macho: weupe, mboni, kibonyo, kope na mstari wa juu.
w0 uso_jicho(UsoKazi* k, Uso* u, d64 x, d64 y, d64 cx) {
    d64 ew = 4.1 - uso_d(u->jinsia) * 0.1;
    d64 eh = 1.9;
    kama (u->macho == 1) { eh = 1.45; }
    kama (u->macho == 2) { eh = 2.3; }
    kama (u->macho == 3) { eh = 1.45; ew = 4.3; }
    d64 dx = (x - cx) / ew;
    kama (uso_kamili(dx) > 1.15) { rudisha; }
    d64 umbo = 1.0 - dx * dx;
    kama (umbo < 0.0) { umbo = 0.0; }
    // kona ya ndani iko chini kidogo kuliko ya nje (kope moja: juu zaidi nje)
    d64 mwinuko = 0.0;
    kama (u->macho == 3) { mwinuko = 0.35 * dx; kama (cx < 50.0) { mwinuko = 0.0 - mwinuko; } }
    d64 juu = k->ey - eh * umbo - mwinuko;
    d64 chini = k->ey + eh * 0.72 * umbo - mwinuko * 0.5;
    // mstari wa kope ya juu (nje ya jicho pia)
    d64 kope = uso_kamili(y - juu + 0.15);
    d64 unene_wa_kope = 0.42 + uso_d(u->jinsia) * 0.18;
    // weupe wa jicho
    kama (y > juu && y < chini && uso_kamili(dx) < 1.0) {
        d64 a = uso_funiko(uso_bana(y - juu) * 4.0, 1.0) * uso_funiko((chini - y) * 4.0, 1.0);
        uso_paka(k, uso_kivuli(15393754, 0.92 - 0.18 * dx * dx), a);
        // mboni
        d64 ix = cx;
        d64 iy = k->ey + 0.1;
        d64 ir = eh * 0.95;
        kama (ir > 1.85) { ir = 1.85; }
        d64 di = ir - mzizi_hesabu((x - ix) * (x - ix) + (y - iy) * (y - iy));
        kama (di > 0.0 - k->w) {
            n64 rangi = uso_rangi_ya_macho_ya(u->rangi_ya_macho);
            d64 pete = uso_bana(1.0 - di / ir);
            uso_paka(k, uso_kivuli(rangi, 1.15 - 0.55 * pete), a * uso_funiko(di, k->w));
            d64 dp = ir * 0.42 - mzizi_hesabu((x - ix) * (x - ix) + (y - iy) * (y - iy));
            kama (dp > 0.0 - k->w) { uso_paka(k, 789001, a * uso_funiko(dp, k->w)); }
            d64 mn = 0.38 - mzizi_hesabu((x - ix + 0.6) * (x - ix + 0.6) + (y - iy + 0.6) * (y - iy + 0.6));
            kama (mn > 0.0 - k->w) { uso_paka(k, 16777215, 0.85 * uso_funiko(mn, k->w)); }
        }
        // kivuli cha kope juu ya jicho
        uso_zidisha(k, 0.75, uso_bana(1.0 - (y - juu) / 1.1) * 0.6);
    }
    kama (kope < unene_wa_kope && uso_kamili(dx) < 1.08) { uso_paka(k, 1708560, 0.85 * uso_funiko(unene_wa_kope - kope, k->w)); }
    // kibonyo juu ya kope (si kwa kope moja)
    kama (u->macho != 3) {
        d64 kb = uso_kamili(y - (juu - 1.25 - uso_d(u->macho == 1) * 0.2));
        kama (kb < 0.3 && uso_kamili(dx) < 0.85) { uso_zidisha(k, 0.8, 0.35); }
    }
    // kope ya chini
    d64 kc = uso_kamili(y - chini - 0.1);
    kama (kc < 0.22 && uso_kamili(dx) < 0.9) { uso_zidisha(k, 0.85, 0.4); }
}

w0 uso_nyusi(UsoKazi* k, Uso* u, d64 x, d64 y, d64 cx) {
    d64 bw = 4.9;
    d64 dx = (x - cx) / bw;
    kama (uso_kamili(dx) > 1.1) { rudisha; }
    // upinde: juu zaidi kuelekea nje
    d64 nje = dx;
    kama (cx < 50.0) { nje = 0.0 - dx; }
    d64 by = k->ey - 4.0 - 0.9 * (1.0 - dx * dx) - 0.35 * nje - uso_d(u->nyusi) * 0.08;
    d64 nene = (0.55 + 0.3 * uso_d(u->nyusi)) * (1.0 - uso_d(u->jinsia) * 0.35) * (1.0 - 0.45 * uso_bana(nje));
    d64 d = nene - uso_kamili(y - by);
    kama (d <= 0.0 - k->w) { rudisha; }
    n64 rangi = uso_changanya(k->nywele, 1445900, 60);
    kama (u->rangi_ya_nywele >= 4) { rangi = uso_changanya(k->nywele, 4865072, 90); }
    d64 a = uso_funiko(d, k->w) * uso_bana((1.1 - uso_kamili(dx)) * 4.0) * (0.75 + 0.25 * uso_kelele(x * 3.0, y * 6.0, k->mbegu));
    uso_paka(k, rangi, a);
}

w0 uso_pua(UsoKazi* k, Uso* u, d64 x, d64 y) {
    d64 nw = 1.9 + uso_d(u->pua) * 0.45 - uso_d(u->jinsia) * 0.2;
    d64 ny = k->hy + 13.6;
    // kivuli cha upande wa kulia wa daraja la pua
    kama (y > k->ey + 1.0 && y < ny) {
        d64 upana_wa_daraja = 1.6 + uso_d(u->pua) * 0.25;
        d64 kv = uso_kamili(x - 50.0 - upana_wa_daraja);
        d64 kuongezeka = uso_bana((y - k->ey - 1.0) / 8.0);
        kama (kv < 1.8 && x > 50.0) { uso_zidisha(k, 0.84, (1.0 - kv / 1.8) * kuongezeka); }
        d64 km = uso_kamili(x - 50.0 + upana_wa_daraja * 0.5);
        kama (km < 1.0 && x < 50.0) { uso_zidisha(k, 1.06, (1.0 - km) * kuongezeka); }
    }
    // ncha ya pua: mwanga kushoto, kivuli kulia
    d64 nc = uso_duara(x, y, 50.0, ny, nw + 0.5, 2.1);
    kama (nc > 0.0) { uso_zidisha(k, 1.06, uso_bana(nc) * uso_bana((50.0 - x) / 2.0 + 0.5) * 0.6); }
    // mabawa ya pua
    d64 ax = uso_kamili(x - 50.0);
    d64 bawa = uso_duara(ax, y, nw + 0.6, ny + 0.5, 1.2, 1.5);
    kama (bawa > 0.0 - k->w) { uso_zidisha(k, 0.84, uso_funiko(bawa, k->w) * 0.6); }
    // matundu ya pua
    d64 tundu = uso_duara(ax, y, nw * 0.62, ny + 1.5, 0.95, 0.5);
    kama (tundu > 0.0 - k->w) { uso_paka(k, uso_kivuli(k->ngozi, 0.35), uso_funiko(tundu, k->w) * 0.75); }
    // kivuli chini ya pua
    d64 chini = uso_duara(x, y, 50.0, ny + 2.6, nw, 0.9);
    kama (chini > 0.0) { uso_zidisha(k, 0.85, uso_bana(chini)); }
}

w0 uso_mdomo(UsoKazi* k, Uso* u, d64 x, d64 y) {
    d64 dx = (x - 50.0) / k->mw;
    kama (uso_kamili(dx) > 1.05) { rudisha; }
    d64 umbo = 1.0 - dx * dx;
    kama (umbo < 0.0) { umbo = 0.0; }
    n64 mdomo = uso_changanya(k->ngozi, 10111556, 70 + uso_d(u->jinsia) * 50);
    kama (u->ngozi >= 8) { mdomo = uso_changanya(k->ngozi, 5910060, 80); }
    d64 juu_kimo = (1.0 + uso_d(u->mdomo) * 0.28 - uso_d(u->umri) * 0.08) * umbo;
    // upinde wa Cupid
    d64 upinde = 0.25 * uso_bana(1.0 - uso_kamili(dx) * 3.0);
    d64 juu = k->my - juu_kimo + upinde;
    d64 chini = k->my + (1.3 + uso_d(u->mdomo) * 0.4 - uso_d(u->umri) * 0.1) * umbo;
    kama (y > juu && y < k->my) {
        d64 a = uso_funiko(uso_bana(y - juu) * 3.0, 1.0);
        uso_paka(k, uso_kivuli(mdomo, 0.78), a * 0.9);
    }
    kama (y >= k->my && y < chini) {
        d64 a = uso_funiko((chini - y) * 3.0, 1.0);
        d64 mw = 0.95 + 0.25 * uso_bana(1.0 - uso_kamili(y - (k->my + chini) / 2.0 + 0.3) / 0.6) * uso_bana(1.0 - uso_kamili(dx) * 1.5);
        uso_paka(k, uso_kivuli(mdomo, mw), a * 0.9);
    }
    // mstari kati ya midomo
    d64 mst = uso_kamili(y - k->my - 0.05 * dx * dx);
    kama (mst < 0.3) { uso_paka(k, uso_kivuli(mdomo, 0.38), (1.0 - mst / 0.3) * uso_bana(umbo * 3.0)); }
}

// Ndevu na masharubu kwa umbile la kelele.
w0 uso_ndevu(UsoKazi* k, Uso* u, d64 x, d64 y) {
    kama (u->ndevu == 0 || u->jinsia == 1) { rudisha; }
    n64 rangi = k->nywele;
    d64 kel = uso_kelele(x * 2.6, y * 1.4, k->mbegu + 7);
    d64 kel2 = uso_kelele(x * 5.0, y * 5.0, k->mbegu + 11);
    d64 ax = uso_kamili(x - 50.0);
    d64 a = 0.0;
    // eneo la ndevu kamili: chini ya mashavu, ndani ya kichwa kilichopanuliwa
    kama (u->ndevu == 3 || u->ndevu == 6 || u->ndevu == 1) {
        d64 ndani = uso_kichwa_umbali(k, x, y - 2.0) + 1.0;
        kama (u->ndevu == 6 && y > k->hy + k->ry - 2.0) { ndani = uso_duara(x, y, 50.0, k->hy + k->ry + 2.0, k->mw + 4.0 - (y - k->hy - k->ry) * 0.2, 14.0); }
        d64 mpaka = k->hy + 8.5 + 3.0 * uso_bana(1.0 - ax / k->rx) - 3.5 * uso_bana(ax / k->rx - 0.6);
        d64 mdomo = uso_duara(x, y, 50.0, k->my + 0.4, k->mw + 0.4, 1.9);
        kama (ndani > 0.0 && y > mpaka) {
            a = uso_bana((y - mpaka) / 2.5) * uso_bana(ndani / 1.5);
            kama (mdomo > 0.0) { a = a * uso_bana(1.0 - mdomo * 1.2); }
        }
        kama (u->ndevu == 1) { a = a * 0.3 * uso_d(kel2 > 0.45); }
    }
    kama (u->ndevu == 4) {
        d64 kd = uso_duara(x, y, 50.0, k->my + 3.4, 3.4, 3.6);
        kama (kd > 0.0) { a = uso_bana(kd / 1.2); }
    }
    kama (u->ndevu == 5) {
        d64 sp = uso_kamili(ax - (k->rx - 1.6));
        kama (sp < 1.8 && y > k->hy - 3.0 && y < k->hy + 12.0) { a = uso_bana((1.8 - sp) / 1.0) * uso_bana((k->hy + 12.0 - y) / 2.0); }
    }
    // masharubu
    kama (u->ndevu == 2 || u->ndevu == 3 || u->ndevu == 4 || u->ndevu == 6) {
        d64 dxm = ax / (k->mw + 1.0);
        kama (dxm < 1.0) {
            d64 juu = k->my - 3.0 + 0.6 * dxm * dxm;
            d64 chini = k->my - 0.3 + 1.2 * dxm * dxm;
            kama (y > juu && y < chini) { a = uso_bana((y - juu) * 2.0) * uso_bana((chini - y) * 2.0) * uso_bana((1.0 - dxm) * 4.0); }
        }
    }
    kama (a <= 0.0) { rudisha; }
    d64 f = 0.75 + 0.45 * kel;
    uso_paka(k, uso_kivuli(rangi, f), a * (0.75 + 0.25 * kel2));
}

// Nywele za juu (mbele ya kichwa) kwa mtindo.
w0 uso_nywele(UsoKazi* k, Uso* u, d64 x, d64 y) {
    n64 m = u->nywele;
    kama (m == 0) { rudisha; }
    d64 ax = uso_kamili(x - 50.0);
    d64 nje_rx = k->rx + 1.6;
    d64 nje_ry = k->ry + 2.2;
    kama (m == 4) { nje_rx = k->rx + 3.4; nje_ry = k->ry + 3.8; }
    kama (m == 2) { nje_rx = k->rx + 2.2; nje_ry = k->ry + 2.8; }
    kama (m == 7) { nje_rx = k->rx + 4.0; nje_ry = k->ry + 4.2; }
    d64 d = uso_duara(x, y, 50.0, k->hy - 1.5, nje_rx, nje_ry);
    // dirisha la uso: duaradufu laini ambayo nywele haziifuniki, ili mstari
    // wa nywele uwe wa mviringo na upungue kuelekea mahekalu
    d64 dirisha = uso_duara(x, y, 50.0, k->hy + 5.5, k->rx * 0.86, k->ry * 0.93);
    kama (m == 6) { dirisha = uso_duara(x, y, 50.0, k->hy + 1.0, k->rx * 0.92, k->ry * 1.06); }
    kama (m == 9 || m == 5) { dirisha = uso_duara(x, y, 50.0, k->hy + 4.0, k->rx * 0.88, k->ry * 0.97); }
    d64 a = 0.0;
    kama (d > 0.0 - k->w && dirisha < k->w) {
        a = uso_funiko(d, k->w) * uso_funiko(0.0 - dirisha, k->w * 1.6);
        // pembeni nywele huishia juu ya masikio
        a = a * uso_bana((k->hy + 3.5 - y) / 3.0);
        // zinazopungua: juu katikati ni nyembamba
        kama (m == 6 && ax < k->rx * 0.6 && y < k->hy - k->ry * 0.45) { a = a * 0.15; }
        // kilemba hufunika juu ya paji tu
        kama (m == 7) { a = uso_funiko(d, k->w) * uso_bana((k->hy - k->ry * 0.36 + 0.03 * ax * ax - y) / 0.8); }
    }
    // ndefu na misuko: hushuka pembeni hadi mabegani
    kama (m == 3 || m == 8) {
        d64 upana = 4.6;
        kama (m == 8) { upana = 5.4; }
        d64 kando = uso_kamili(ax - (k->rx + 0.6));
        kama (kando < upana / 2.0 + 1.0 && y > k->hy - 6.0 && y < k->hy + 26.0) {
            d64 b = uso_funiko(upana / 2.0 - kando, k->w) * uso_bana((k->hy + 26.0 - y) / 3.0);
            kama (b > a) { a = b; }
        }
    }
    // fundo juu
    kama (m == 5) {
        d64 fd = uso_duara(x, y, 50.0, k->hy - k->ry - 3.0, 6.2, 5.6);
        kama (fd > 0.0 - k->w) { d64 b = uso_funiko(fd, k->w); kama (b > a) { a = b; } }
    }
    kama (a <= 0.0) { rudisha; }
    // rangi na umbile
    n64 rangi = k->nywele;
    kama (m == 7) { rangi = uso_rangi_ya_kitambaa(u->rangi_ya_nywele); }
    d64 dx = (x - 50.0) / nje_rx;
    d64 dy = (y - k->hy + 1.5) / nje_ry;
    d64 f = uso_mwanga(dx * 0.9, dy * 0.9);
    d64 kel = uso_kelele(x * 0.8, y * 3.5, k->mbegu + 3);
    kama (m == 4 || m == 8) { kel = uso_kelele(x * 2.8, y * 2.8, k->mbegu + 5); }
    kama (m == 7) { kel = 0.5 + 0.5 * sin_hesabu((y + x * 0.3) * 1.3); }
    f = f * (0.78 + 0.4 * kel);
    // mng'ao wa nywele zilizolazwa
    kama (m == 9 || m == 2) { f = f + 0.25 * uso_bana(1.0 - uso_kamili(dy + 0.55) * 4.0) * kel; }
    // mstari wa kugawanya nywele
    kama (m == 2 && uso_kamili(x - 44.0) < 0.35 && y < k->hy - k->ry * 0.4) { f = f * 0.55; }
    // misuko: kamba zinazojirudia
    kama (m == 8 && y > k->hy - 6.0) { f = f * (0.7 + 0.3 * uso_kamili(sin_hesabu(y * 1.6 + ax))); }
    uso_paka(k, uso_kivuli(rangi, f), a);
}

// Nywele nyuma ya kichwa (ndefu, misuko).
w0 uso_nywele_nyuma(UsoKazi* k, Uso* u, d64 x, d64 y) {
    kama (u->nywele != 3 && u->nywele != 8) { rudisha; }
    d64 d = uso_duara(x, y, 50.0, k->hy + 8.0, k->rx + 5.5, k->ry + 12.0);
    kama (d <= 0.0 - k->w) { rudisha; }
    d64 kel = uso_kelele(x * 0.8, y * 3.0, k->mbegu + 13);
    uso_paka(k, uso_kivuli(k->nywele, 0.55 + 0.3 * kel), uso_funiko(d, k->w));
}

w0 uso_miwani(UsoKazi* k, Uso* u, d64 x, d64 y) {
    kama (u->miwani == 0) { rudisha; }
    n64 fremu = 2433310;
    kama (u->miwani == 1) { fremu = 11045966; }
    d64 t = 0.42;
    kama (u->miwani == 2) { t = 0.55; }
    d64 a = 0.0;
    n64 i = 0;
    wakati (i < 2) {
        d64 cx = 50.0 - k->ex;
        kama (i == 1) { cx = 50.0 + k->ex; }
        d64 dx = x - cx;
        d64 dy = y - k->ey - 0.3;
        d64 pete = 0.0;
        kama (u->miwani == 1) { pete = uso_kamili(mzizi_hesabu(dx * dx + dy * dy) - 4.8); }
        sivyo {
            d64 bx = uso_kamili(dx) - 5.0;
            d64 by = uso_kamili(dy) - 3.4;
            d64 nje = bx;
            kama (by > nje) { nje = by; }
            pete = uso_kamili(nje);
        }
        kama (pete < t + k->w) { d64 b = uso_funiko(t - pete, k->w); kama (b > a) { a = b; } }
        // mng'ao wa lenzi
        kama (dx * dx + dy * dy < 20.0) {
            d64 ml = uso_kamili(dx + dy * 0.8 + 1.2);
            kama (ml < 0.6) { uso_paka(k, 16777215, 0.10 * (1.0 - ml / 0.6)); }
        }
        i = i + 1;
    }
    // daraja na mikono kuelekea masikio
    d64 daraja = uso_kipande(x, y, 50.0 - k->ex + 4.6, k->ey - 0.8, 50.0 + k->ex - 4.6, k->ey - 0.8);
    kama (daraja < t + k->w) { d64 b = uso_funiko(t - daraja, k->w); kama (b > a) { a = b; } }
    d64 ax = uso_kamili(x - 50.0);
    kama (ax > k->ex + 4.6 && ax < k->rx && uso_kamili(y - k->ey + 0.6) < t) { a = 1.0; }
    kama (a > 0.0) { uso_paka(k, fremu, a); }
}

// Rangi ya pikseli moja (x, y kwa vizio vya kisanduku).
n64 uso_pikseli(UsoKazi* k, Uso* u, d64 x, d64 y) {
    uso_usuli(k, x, y);
    uso_nywele_nyuma(k, u, x, y);
    uso_shingo(k, u, x, y);
    uso_mavazi(k, u, x, y);
    uso_masikio(k, x, y);
    uso_ngozi(k, u, x, y);
    uso_jicho(k, u, x, y, 50.0 - k->ex);
    uso_jicho(k, u, x, y, 50.0 + k->ex);
    uso_nyusi(k, u, x, y, 50.0 - k->ex);
    uso_nyusi(k, u, x, y, 50.0 + k->ex);
    uso_pua(k, u, x, y);
    uso_mdomo(k, u, x, y);
    uso_ndevu(k, u, x, y);
    uso_miwani(k, u, x, y);
    uso_nywele(k, u, x, y);
    // kingo za picha hufifia kidogo
    d64 vx = (x - 50.0) / 72.0;
    d64 vy = (y - 46.0) / 72.0;
    d64 v = 1.0 - 0.35 * (vx * vx + vy * vy);
    d64 r = k->r * v;
    d64 g = k->g * v;
    d64 b = k->b * v;
    kama (r < 0.0) { r = 0.0; }
    kama (g < 0.0) { g = 0.0; }
    kama (b < 0.0) { b = 0.0; }
    kama (r > 255.0) { r = 255.0; }
    kama (g > 255.0) { g = 255.0; }
    kama (b > 255.0) { b = 255.0; }
    n64 ri = r;
    n64 gi = g;
    n64 bi = b;
    rudisha (ri << 16) | (gi << 8) | bi;
}

w0 uso_andaa(UsoKazi* k, Uso* u, n64 ukubwa) {
    d64 s = ukubwa;
    k->w = 100.0 / s;
    k->hx = 50.0;
    k->hy = 44.0;
    k->rx = 21.0;
    k->ry = 27.0;
    k->taper = 0.36;
    kama (u->umbo == 1) { k->rx = 19.6; k->ry = 28.6; k->taper = 0.42; }
    kama (u->umbo == 2) { k->rx = 23.2; k->ry = 26.2; k->taper = 0.30; }
    kama (u->umbo == 3) { k->rx = 22.2; k->ry = 27.0; k->taper = 0.16; }
    k->rx = k->rx + uso_d(u->unene) * 0.9 - uso_d(u->jinsia) * 1.0;
    k->ry = k->ry - uso_d(u->jinsia) * 0.8;
    k->taper = k->taper + uso_d(u->jinsia) * 0.08 - uso_d(u->unene) * 0.03;
    k->ex = 8.5 + uso_d(u->umbo == 2) * 0.4;
    k->ey = k->hy + 1.5;
    k->my = k->hy + 20.0;
    k->mw = 5.2 + uso_d(u->mdomo) * 0.45 - uso_d(u->jinsia) * 0.3;
    k->sw = 34.0 + uso_d(u->unene) * 4.0 - uso_d(u->jinsia) * 3.0;
    k->ngozi = uso_rangi_ya_ngozi(u->ngozi);
    k->nywele = uso_rangi_ya_nywele(u->rangi_ya_nywele);
    k->vazi = uso_rangi_ya_mavazi(u->mavazi);
    k->mbegu = u->umbo * 7 + u->nywele * 131 + u->ngozi * 17 + u->ndevu * 29 + uso_d(u->mdomo) * 3;
}

// ---------- akiba ya picha ----------

n64 USO_AKIBA_JUU = 96;
n64* uso_akiba_ufunguo = 0;
n64* uso_akiba_ukubwa = 0;
n64* uso_akiba_picha = 0;       // Turubai*
n64 uso_akiba_ijayo = 0;

n64 uso_ufunguo(Uso* u) {
    n64 h = 1469598103;
    n64 s = 0;
    wakati (s < USO_SIFA) { h = ((h ^ (uso_sifa_ya(u, s)[0] + 1)) * 16777619) & 4294967295; s = s + 1; }
    rudisha h;
}

// Picha ya uso kwa ukubwa huu, kutoka akiba au mpya.
Turubai* uso_picha(Uso* u, n64 ukubwa) {
    kama (uso_akiba_ufunguo == 0) {
        uso_akiba_ufunguo = tenga(8 * USO_AKIBA_JUU);
        uso_akiba_ukubwa = tenga(8 * USO_AKIBA_JUU);
        uso_akiba_picha = tenga(8 * USO_AKIBA_JUU);
        weka_sifuri(uso_akiba_picha, 8 * USO_AKIBA_JUU);
        weka_sifuri(uso_akiba_ukubwa, 8 * USO_AKIBA_JUU);
    }
    n64 f = uso_ufunguo(u);
    n64 i = 0;
    wakati (i < USO_AKIBA_JUU) {
        kama (uso_akiba_picha[i] != 0 && uso_akiba_ufunguo[i] == f && uso_akiba_ukubwa[i] == ukubwa) { rudisha uso_akiba_picha[i]; }
        i = i + 1;
    }
    n64 nafasi = uso_akiba_ijayo;
    uso_akiba_ijayo = (uso_akiba_ijayo + 1) % USO_AKIBA_JUU;
    kama (uso_akiba_picha[nafasi] != 0) {
        Turubai* zamani = uso_akiba_picha[nafasi];
        achilia zamani->pikseli;
        achilia zamani;
    }
    Turubai* p = turubai_unda(ukubwa, ukubwa);
    UsoKazi* k = tenga(ukubwa(UsoKazi));
    // picha ndogo huchorwa kwa sampuli nyingi kwa kila pikseli, ili sura ionekane wazi
    n64 ss = 1;
    kama (ukubwa < 96) { ss = 2; }
    kama (ukubwa < 48) { ss = 3; }
    uso_andaa(k, u, ukubwa * ss);
    d64 hatua = 100.0 / uso_d(ukubwa * ss);
    n64 j = 0;
    wakati (j < ukubwa) {
        n64 ii = 0;
        wakati (ii < ukubwa) {
            n64 jr = 0;
            n64 jg = 0;
            n64 jb = 0;
            n64 sy = 0;
            wakati (sy < ss) {
                n64 sx = 0;
                wakati (sx < ss) {
                    d64 x = (uso_d(ii * ss + sx) + 0.5) * hatua;
                    d64 y = (uso_d(j * ss + sy) + 0.5) * hatua;
                    n64 c = uso_pikseli(k, u, x, y);
                    jr = jr + ((c >> 16) & 255);
                    jg = jg + ((c >> 8) & 255);
                    jb = jb + (c & 255);
                    sx = sx + 1;
                }
                sy = sy + 1;
            }
            n64 n = ss * ss;
            weka_u32(p->pikseli, j * p->hatua + ii * 4, ((jr / n) << 16) | ((jg / n) << 8) | (jb / n));
            ii = ii + 1;
        }
        j = j + 1;
    }
    achilia k;
    uso_akiba_ufunguo[nafasi] = f;
    uso_akiba_ukubwa[nafasi] = ukubwa;
    uso_akiba_picha[nafasi] = p;
    rudisha p;
}

// Chora uso kwenye mraba (x, y, ukubwa x ukubwa).
w0 uso_chora(Turubai* t, Uso* u, n64 x, n64 y, n64 ukubwa) {
    kama (ukubwa <= 0) { rudisha; }
    Turubai* p = uso_picha(u, ukubwa);
    n64 j = 0;
    wakati (j < ukubwa) {
        n64 ty = y + j;
        kama (ty >= t->ky0 && ty < t->ky1) {
            n64 i = 0;
            wakati (i < ukubwa) {
                n64 tx = x + i;
                kama (tx >= t->kx0 && tx < t->kx1) { weka_u32(t->pikseli, ty * t->hatua + tx * 4, pata_u32(p->pikseli, j * p->hatua + i * 4)); }
                i = i + 1;
            }
        }
        j = j + 1;
    }
}

n64 uso_kipeuo(n64 n) {
    kama (n <= 0) { rudisha 0; }
    n64 x = n;
    n64 y = (x + 1) / 2;
    wakati (y < x) { x = y; y = (x + n / x) / 2; }
    rudisha x;
}

// Avatar ya mduara yenye kingo laini, kutoka akiba ya picha.
w0 uso_chora_duara(Turubai* t, Uso* u, n64 cx, n64 cy, n64 r) {
    n64 s = r * 2;
    kama (s <= 0) { rudisha; }
    Turubai* p = uso_picha(u, s);
    n64 r16 = r * 16;
    n64 kushoto = cx - r;
    n64 juu_ya = cy - r;
    n64 j = 0;
    wakati (j < s) {
        n64 dy = j * 16 + 8 - r16;
        n64 dy2 = dy * dy;
        n64 ty = juu_ya + j;
        n64 i = 0;
        wakati (i < s) {
            n64 dx = i * 16 + 8 - r16;
            n64 funiko = r16 - uso_kipeuo(dx * dx + dy2);
            kama (funiko > 0) {
                n64 tx = kushoto + i;
                kama (tx >= t->kx0 && tx < t->kx1 && ty >= t->ky0 && ty < t->ky1 && tx >= 0 && ty >= 0 && tx < t->upana && ty < t->kimo) {
                    n64 a = funiko * 16;
                    kama (a > 255) { a = 255; }
                    n64 juu = pata_u32(p->pikseli, j * p->hatua + i * 4);
                    n64 chini = pata_u32(t->pikseli, ty * t->hatua + tx * 4);
                    n64 baki = 255 - a;
                    n64 rr = (((juu >> 16) & 255) * a + ((chini >> 16) & 255) * baki) / 255;
                    n64 gg = (((juu >> 8) & 255) * a + ((chini >> 8) & 255) * baki) / 255;
                    n64 bb = ((juu & 255) * a + (chini & 255) * baki) / 255;
                    weka_u32(t->pikseli, ty * t->hatua + tx * 4, (rr << 16) | (gg << 8) | bb);
                }
            }
            i = i + 1;
        }
        j = j + 1;
    }
}

n8* uso_jina_la_sifa(n64 sifa) {
    kama (sifa == 0) { rudisha "Face"; }
    kama (sifa == 1) { rudisha "Skin"; }
    kama (sifa == 2) { rudisha "Hair"; }
    kama (sifa == 3) { rudisha "Hair colour"; }
    kama (sifa == 4) { rudisha "Eyes"; }
    kama (sifa == 5) { rudisha "Brows"; }
    kama (sifa == 6) { rudisha "Nose"; }
    kama (sifa == 7) { rudisha "Mouth"; }
    kama (sifa == 8) { rudisha "Beard"; }
    kama (sifa == 9) { rudisha "Glasses"; }
    kama (sifa == 10) { rudisha "Dress"; }
    kama (sifa == 11) { rudisha "Sex"; }
    kama (sifa == 12) { rudisha "Eye colour"; }
    kama (sifa == 13) { rudisha "Build"; }
    rudisha "Age";
}
