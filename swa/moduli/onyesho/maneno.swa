husisha { msingi/maktaba/mfuatano.swa }

// maneno.swa -- maneno ya kiolesura cha Dominion kwa lugha ya mchezaji.
//
// Mchezo ni wa dunia nzima: lugha ya chaguo-msingi ya kiolesura ni
// Kiingereza, na mchezaji huchagua nyingine kwenye skrini ya Mipangilio.
// Msimbo huandika neno la Kiingereza mahali linapotumika -- ui("Economy")
// -- nalo ndilo ufunguo wa tafsiri. Lugha isiyo na tafsiri ya neno fulani
// hurudi kwenye Kiingereza, hivyo skrini haibaki tupu kamwe.
//
// Neno lenye maana mbili hupewa muktadha kwa herufi ndogo kabla ya '|':
// ui("tab|GDP") na ui("row|GDP") ni funguo tofauti, zote huonyesha "GDP"
// kwa Kiingereza.
//
// Majina ya ndani ya dunia (mataifa, miji, mito) hayapiti hapa: hubaki
// katika lugha zake.
//
// Kuongeza lugha: ongeza safu kwenye maneno_sajili na jina lake kwenye
// maneno_lugha_jina, kisha ongeza MANENO_LUGHA_IDADI.

n64 MANENO_KIINGEREZA = 0;
n64 MANENO_KISWAHILI = 1;
n64 MANENO_KIFARANSA = 2;
n64 MANENO_LUGHA_IDADI = 3;

n64 MANENO_UWEZO = 1024;         // nafasi za jedwali (kipeo cha 2)

n64 maneno_lugha = 0;
n64* maneno_funguo = 0;          // viashiria vya funguo (Kiingereza)
n64* maneno_thamani = 0;         // [nafasi * 2 + (lugha - 1)]

n64 maneno_heshi(n8* s) {
    n64 h = 2166136261;
    n64 i = 0;
    wakati (s[i] != 0) {
        h = ((h ^ (s[i] & 255)) * 16777619) & 4294967295;
        i = i + 1;
    }
    rudisha h & (MANENO_UWEZO - 1);
}

w0 maneno_sajili(n8* en, n8* sw, n8* fr) {
    n64 p = maneno_heshi(en);
    wakati (maneno_funguo[p] != 0) {
        n8* k = maneno_funguo[p];
        kama (linganisha_mfuatano(k, en) == 0) { rudisha; }
        p = (p + 1) & (MANENO_UWEZO - 1);
    }
    maneno_funguo[p] = en;
    maneno_thamani[p * 2] = sw;
    maneno_thamani[p * 2 + 1] = fr;
}

w0 maneno_jaza() {
    maneno_funguo = tenga(8 * MANENO_UWEZO);
    maneno_thamani = tenga(16 * MANENO_UWEZO);
    weka_sifuri(maneno_funguo, 8 * MANENO_UWEZO);
    weka_sifuri(maneno_thamani, 16 * MANENO_UWEZO);
    maneno_sajili("War", "Vita", "Guerre");
    maneno_sajili("Hostile", "Uadui", "Hostile");
    maneno_sajili("Friendly", "Urafiki", "Amical");
    maneno_sajili("Allied", "Umoja", "Allié");
    maneno_sajili("Neutral", "Kati", "Neutre");
