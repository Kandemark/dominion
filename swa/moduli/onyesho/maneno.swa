// Jina la lugha kwa lugha yenyewe (halitafsiriwi).
n8* maneno_lugha_jina(n64 l) {
    kama (l == MANENO_KISWAHILI) { rudisha "Kiswahili"; }
    kama (l == MANENO_KIFARANSA) { rudisha "Français"; }
    rudisha "English";
}

// Msimbo wa lugha kwa mfumo wa ujumbe wa uigaji (lugha_dominion).
n8* maneno_lugha_msimbo(n64 l) {
    kama (l == MANENO_KISWAHILI) { rudisha "sw"; }
    kama (l == MANENO_KIFARANSA) { rudisha "fr"; }
    rudisha "en";
}

w0 maneno_weka_lugha(n64 l) {
    kama (l < 0 || l >= MANENO_LUGHA_IDADI) { l = 0; }
    maneno_lugha = l;
}

// Neno la kiolesura kwa lugha hai.
n8* ui(n8* en) {
    kama (maneno_lugha != 0) {
        kama (maneno_funguo == 0) { maneno_jaza(); }
        n64 p = maneno_heshi(en);
        n64 imeisha = 0;
        wakati (imeisha == 0 && maneno_funguo[p] != 0) {
            n8* k = maneno_funguo[p];
            kama (linganisha_mfuatano(k, en) == 0) {
                n8* v = maneno_thamani[p * 2 + maneno_lugha - 1];
                kama (v != 0) { rudisha v; }
                imeisha = 1;
            }
            p = (p + 1) & (MANENO_UWEZO - 1);
        }
    }
    // Kiingereza: ondoa muktadha "abc|" wa mwanzo
    n64 i = 0;
    wakati (en[i] >= 97 && en[i] <= 122 && i < 16) { i = i + 1; }
    kama (i > 0 && en[i] == 124) { rudisha &en[i + 1]; }
    rudisha en;
}
