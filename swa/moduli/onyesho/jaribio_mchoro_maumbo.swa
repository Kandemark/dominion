husisha { moduli/onyesho/mchoro.swa }

// jaribio_mchoro_maumbo.swa -- huthibitisha maumbo matano mapya
// yaliyoongezwa kwenye mchoro.swa (mstatili_mpaka, duara, duara_mpaka,
// mviringo, pembetatu) dhidi ya bafa za tenga() za 100x100 XRGB8888,
// kila umbo kwenye bafa yake YENYEWE ili kuepuka mchanganyiko wa
// matokeo kati ya jaribio moja na jingine. Kila ukaguzi unathibitisha
// THAMANI HASA ya pikseli maalum, si tu "haikuanguka".

n32 anza() {
    n64 canvas_w = 100;
    n64 canvas_h = 100;
    n64 pitch = canvas_w * 4;
    n64 rangi = 4294901760;  // nyekundu (0xFFFF0000)

    // ===== 1. mchoro_duara (lililojazwa), cx=50 cy=50 radius=20 =====
    n8* fb1 = tenga(pitch * canvas_h);
    weka_sifuri(fb1, pitch * canvas_h);
    mchoro_duara(fb1, pitch, canvas_w, canvas_h, 50, 50, 20, rangi);

    n64 d_kituo = mchoro_pata_pikseli(fb1, pitch, 50, 50);
    kama (d_kituo != rangi) { andika_kosa("FAIL: duara kituo (50,50) =%d\n", d_kituo, 0, 0, 0, 0, 0); rudisha 1; }

    n64 d_ukingo = mchoro_pata_pikseli(fb1, pitch, 70, 50);  // 50+20
    kama (d_ukingo != rangi) { andika_kosa("FAIL: duara ukingo (70,50) =%d\n", d_ukingo, 0, 0, 0, 0, 0); rudisha 1; }

    n64 d_nje = mchoro_pata_pikseli(fb1, pitch, 75, 50);  // 50+25, nje
    kama (d_nje != 0) { andika_kosa("FAIL: duara nje (75,50) haikuwa 0, ni %d\n", d_nje, 0, 0, 0, 0, 0); rudisha 1; }

    // ===== 2. mchoro_duara_mpaka, cx=50 cy=50 radius=20 =====
    n8* fb2 = tenga(pitch * canvas_h);
    weka_sifuri(fb2, pitch * canvas_h);
    mchoro_duara_mpaka(fb2, pitch, canvas_w, canvas_h, 50, 50, 20, rangi);

    n64 dm_kituo = mchoro_pata_pikseli(fb2, pitch, 50, 50);
    kama (dm_kituo != 0) { andika_kosa("FAIL: duara_mpaka kituo (50,50) haikuwa 0 (ndani halipaswi kuguswa), ni %d\n", dm_kituo, 0, 0, 0, 0, 0); rudisha 1; }

    n64 dm_ukingo = mchoro_pata_pikseli(fb2, pitch, 70, 50);  // 50+20
    kama (dm_ukingo != rangi) { andika_kosa("FAIL: duara_mpaka ukingo (70,50) =%d\n", dm_ukingo, 0, 0, 0, 0, 0); rudisha 1; }

    // ===== 3. mchoro_mviringo (lililojazwa), cx=50 cy=50 rx=30 ry=15 =====
    n8* fb3 = tenga(pitch * canvas_h);
    weka_sifuri(fb3, pitch * canvas_h);
    mchoro_mviringo(fb3, pitch, canvas_w, canvas_h, 50, 50, 30, 15, rangi);

    n64 m_ndani = mchoro_pata_pikseli(fb3, pitch, 80, 50);  // cx+rx, cy -- juu ya ukingo wa mlalo
    kama (m_ndani != rangi) { andika_kosa("FAIL: mviringo ndani (80,50) =%d\n", m_ndani, 0, 0, 0, 0, 0); rudisha 1; }

    n64 m_kona_nje = mchoro_pata_pikseli(fb3, pitch, 80, 65);  // cx+rx, cy+ry -- kona ya mstatili unaozunguka, NJE ya mviringo
    kama (m_kona_nje != 0) { andika_kosa("FAIL: mviringo kona nje (80,65) haikuwa 0, ni %d\n", m_kona_nje, 0, 0, 0, 0, 0); rudisha 1; }

    // ===== 4. mchoro_pembetatu (lililojazwa) (10,10)-(90,30)-(50,80) =====
    n8* fb4 = tenga(pitch * canvas_h);
    weka_sifuri(fb4, pitch * canvas_h);
    mchoro_pembetatu(fb4, pitch, canvas_w, canvas_h, 10, 10, 90, 30, 50, 80, rangi);

    n64 p_centroid = mchoro_pata_pikseli(fb4, pitch, 50, 40);  // ((10+90+50)/3, (10+30+80)/3)
    kama (p_centroid != rangi) { andika_kosa("FAIL: pembetatu centroid (50,40) =%d\n", p_centroid, 0, 0, 0, 0, 0); rudisha 1; }

    n64 p_nje = mchoro_pata_pikseli(fb4, pitch, 2, 2);  // kona ya bafa, mbali na pembetatu
    kama (p_nje != 0) { andika_kosa("FAIL: pembetatu nje (2,2) haikuwa 0, ni %d\n", p_nje, 0, 0, 0, 0, 0); rudisha 1; }

    // ===== 5. mchoro_piga_mstatili_mpaka, x=10 y=10 w=40 h=30 unene=3 =====
    n8* fb5 = tenga(pitch * canvas_h);
    weka_sifuri(fb5, pitch * canvas_h);
    mchoro_piga_mstatili_mpaka(fb5, pitch, canvas_w, canvas_h, 10, 10, 40, 30, rangi, 3);

    n64 r_katikati = mchoro_pata_pikseli(fb5, pitch, 30, 25);  // ndani ya shimo (si ukingoni)
    kama (r_katikati != 0) { andika_kosa("FAIL: mstatili_mpaka katikati (30,25) haikuwa 0 (haijajazwa), ni %d\n", r_katikati, 0, 0, 0, 0, 0); rudisha 1; }

    n64 r_ukingo = mchoro_pata_pikseli(fb5, pitch, 10, 25);  // ukingo wa kushoto
    kama (r_ukingo != rangi) { andika_kosa("FAIL: mstatili_mpaka ukingo (10,25) =%d\n", r_ukingo, 0, 0, 0, 0, 0); rudisha 1; }

    andika("PASS mchoro_maumbo.swa (duara/duara_mpaka/mviringo/pembetatu/mstatili_mpaka -- pikseli maalum zote sahihi)\n", 0, 0, 0, 0, 0, 0);
    rudisha 0;
}
