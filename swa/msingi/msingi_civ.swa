// msingi_civ.swa — tafsiri ya include/common.h (C) kwenda Swa.
//
// Kiambishi: civ_ (jina la asili la mradi). Faili hili linahusishwa
// na kila moduli ya Dominion — angalia ../KANUNI-MAJINA.md.
//
// Tofauti za kimakusudi kutoka kwa chanzo cha C:
//   - Hakuna enum wala macro kwenye Swa — misimbo ya hitilafu ni
//     viambatanisho vya n32 vya ulimwengu, na macros za
//     CIV_SUCCESS/CIV_FAILED/MIN/MAX/CLAMP zimekuwa kazi za kawaida.
//   - achilia ni neno muhimu la lugha (si jina la kazi linaloweza
//     kuandikwa) — hakuna kazi ya "civ_free" hapa; wito wa moja kwa
//     moja wa achilia unafanyika mahali kielekezi kinapoachwa.
//   - civ_log haitumii hoja zisizo na kikomo (Swa haina hilo) —
//     inafuata muundo uleule wa andika()/andika_kosa(): kigezo
//     kimoja cha muundo + nafasi sita za hoja za n64.

husisha { maktaba/kumbukumbu.swa }

// ---------- Toleo ----------
n32 CIV_TOLEO_KUU = 0;
n32 CIV_TOLEO_KATI = 1;
n32 CIV_TOLEO_NDOGO = 0;

// ---------- Viwango vya urefu wa mfuatano ----------
n32 CIV_MFUATANO_UREFU_MKUBWA = 256;
n32 CIV_MFUATANO_UREFU_KATI = 128;
n32 CIV_MFUATANO_UREFU_MDOGO = 64;

// ---------- Misimbo ya hitilafu (badala ya civ_error_t enum) ----------
n32 CIV_SAWA = 0;
n32 CIV_HITILAFU_KIELEKEZI_TUPU = -1;
n32 CIV_HITILAFU_KUMBUKUMBU_IMEISHA = -2;
n32 CIV_HITILAFU_HOJA_MBAYA = -3;
n32 CIV_HITILAFU_HAIJAPATIKANA = -4;
n32 CIV_HITILAFU_HALI_MBAYA = -5;
n32 CIV_HITILAFU_IO = -6;
n32 CIV_HITILAFU_DATA_MBAYA = -7;
n32 CIV_HITILAFU_UANZISHAJI_UMESHINDWA = -8;

// ---------- Viwango vya kumbukumbu (logging) ----------
n32 CIV_LOG_UTATUZI = 0;
n32 CIV_LOG_TAARIFA = 1;
n32 CIV_LOG_ONYO = 2;
n32 CIV_LOG_HITILAFU = 3;
n32 CIV_LOG_MBAYA_KABISA = 4;

// ---------- Matokeo ya operesheni (badala ya civ_result_t) ----------
muundo CivMatokeo {
    n32 hitilafu;
    n8* ujumbe;
};

n32 kiwango_cha_chini(n32 a, n32 b) {
    kama (a < b) { rudisha a; }
    rudisha b;
}

n32 kiwango_cha_juu(n32 a, n32 b) {
    kama (a > b) { rudisha a; }
    rudisha b;
}

n32 finya(n32 thamani, n32 chini, n32 juu) {
    rudisha kiwango_cha_juu(chini, kiwango_cha_chini(juu, thamani));
}

d64 kiwango_cha_chini_d64(d64 a, d64 b) {
    kama (a < b) { rudisha a; }
    rudisha b;
}

d64 kiwango_cha_juu_d64(d64 a, d64 b) {
    kama (a > b) { rudisha a; }
    rudisha b;
}

d64 finya_d64(d64 thamani, d64 chini, d64 juu) {
    rudisha kiwango_cha_juu_d64(chini, kiwango_cha_chini_d64(juu, thamani));
}

n32 civ_mafanikio(CivMatokeo m) {
    kama (m.hitilafu == CIV_SAWA) { rudisha 1; }
    rudisha 0;
}

n32 civ_imeshindwa(CivMatokeo m) {
    kama (m.hitilafu == CIV_SAWA) { rudisha 0; }
    rudisha 1;
}

// civ_log: nafasi sita za n64 kama andika() — zisizotumika ni 0.
// MUHIMU: tofauti na andika()/andika_kosa() (externi, hoja
// huru), civ_log ni kazi ya kawaida ya Swa yenye vigezo vya n64
// vilivyokaguliwa kikamilifu — kupitisha kielekezi (n8*, kama
// jina la mtu) kwenye nafasi hizi ni kosa la aina wakati wa
// kukusanya. Ukihitaji kuandika kielekezi kwenye ujumbe wa log,
// tumia andika()/andika_kosa() moja kwa moja badala ya civ_log.
w0 civ_log(n32 kiwango, n8* umbizo, n64 a1, n64 a2, n64 a3, n64 a4, n64 a5, n64 a6) {
    kama (kiwango >= CIV_LOG_HITILAFU) {
        andika_kosa(umbizo, a1, a2, a3, a4, a5, a6);
    } sivyo {
        andika(umbizo, a1, a2, a3, a4, a5, a6);
    }
}

// civ_thibitisha: badala ya CIV_ASSERT — daima inafanya kazi (hakuna
// tofauti ya DEBUG/release kwenye Swa kwa sasa). Sharti likishindwa,
// inaandika ujumbe na kutoka kwa msimbo 1 (syscall 60 = exit).
w0 civ_thibitisha(n32 sharti, n8* ujumbe) {
    kama (sharti == 0) {
        andika_kosa(ujumbe, 0, 0, 0, 0, 0, 0);
        wito_wa_mfumo(60, 1, 0, 0, 0, 0, 0);
    }
}

// ---------- Nasibu (badala ya rand()/srand() ya libc) ----------
// LCG rahisi (viwango vya Numerical Recipes) — si ya kificho, ni
// kwa ajili ya uigaji tu. Hali ya ulimwengu moja, kama rand() ya C
// (hakuna hali ya kila-nyuzi bado — Swa haina nyuzi kwa sasa).
n32 civ_nasibu_hali = 88172645;

w0 civ_nasibu_panda(n32 mbegu) {
    kama (mbegu == 0) { mbegu = 1; }
    civ_nasibu_hali = mbegu;
}

n32 civ_nasibu() {
    civ_nasibu_hali = civ_nasibu_hali * 1103515245 + 12345;
    n32 v = civ_nasibu_hali % 32768;
    kama (v < 0) { v = 0 - v; }
    rudisha v;
}

// [0, kikomo) — sawa na rand() % kikomo ya C.
n32 civ_nasibu_chini_ya(n32 kikomo) {
    kama (kikomo <= 0) { rudisha 0; }
    rudisha civ_nasibu() % kikomo;
}

// ---------- Hesabu za kielelezi (badala ya expf/exp ya libc) ----------
// hesabu.swa ya lugha ya Swa haina kazi za d64 transcendental bado
// (lugha-swa/swa#183, ombi la kipengele). civ_kielelezi ni ukadiriaji
// wa mfululizo wa Taylor (maneno 30) — sahihi vya kutosha kwa
// mahitaji ya uigaji (mfano: kiwango cha kuenea kwa utamaduni,
// ambapo x ni kawaida kati ya -10 na 0). Si sahihi kabisa kwa x kubwa
// sana chanya (mfululizo hausambamki haraka), lakini hakuna matumizi
// kama hayo kwenye Dominion.
d64 civ_kielelezi(d64 x) {
    d64 jumla = 1.0;
    d64 neno = 1.0;
    n32 n = 1;
    wakati (n <= 30) {
        d64 n_d = n;
        neno = neno * x / n_d;
        jumla = jumla + neno;
        n = n + 1;
    }
    rudisha jumla;
}

// civ_mzizi: mzizi wa mraba (badala ya sqrt ya libc, lugha-swa/swa#183)
// kwa mbinu ya Newton (marudio 25 — inasambamka haraka sana kwa
// thamani zisizo hasi). x hasi hurudisha 0.0 (hakuna mzizi halisi).
d64 civ_mzizi(d64 x) {
    kama (x <= 0.0) { rudisha 0.0; }
    d64 kisio = x;
    kama (kisio < 1.0) { kisio = 1.0; }
    n32 n = 0;
    wakati (n < 25) {
        kisio = 0.5 * (kisio + x / kisio);
        n = n + 1;
    }
    rudisha kisio;
}

// civ_logasili: logarithm ya asili (ln, badala ya log() ya libc,
// lugha-swa/swa#183). MUHIMU: civ_kielelezi (exp) kupitia mfululizo
// wa Taylor haisambamki vizuri kwa x kubwa, kwa hiyo Newton juu ya
// exp() haingekuwa sahihi kwa maadili makubwa (mfano maarifa
// yanayokua bila kikomo). Badala yake: upunguzaji wa masafa (range
// reduction) -- x inagawanywa/kuzidishwa mara kwa mara kwa 2 hadi
// iwe kati ya 0.5 na 2.0 (idadi ya hatua = k, chanya au hasi),
// kisha mfululizo wa atanh (unaosambamka haraka kwa hoja ndogo)
// unatumika: ln(x_iliyopunguzwa) = 2*atanh((x-1)/(x+1)). Hatimaye
// ln(x_asili) = ln(x_iliyopunguzwa) + k * ln(2). x<=0.0 hurudisha
// 0.0 (hakuna logarithm halisi, sawa na muundo wa civ_mzizi).
d64 civ_logasili(d64 x) {
    kama (x <= 0.0) { rudisha 0.0; }

    // MUHIMU: maneno ya d64 yenye tarakimu nyingi (>~10 baada ya nukta)
    // huchanganuliwa vibaya KIMYA KIMYA (lugha-swa/swa#188) --
    // 0.6931471805 (tarakimu 10) ni ndani ya kikomo salama.
    d64 LN2 = 0.6931471805;
    n32 k = 0;
    d64 xr = x;
    wakati (xr > 2.0) {
        xr = xr / 2.0;
        k = k + 1;
    }
    wakati (xr < 0.5) {
        xr = xr * 2.0;
        k = k - 1;
    }

    d64 z = (xr - 1.0) / (xr + 1.0);
    d64 z2 = z * z;
    d64 jumla = 0.0;
    d64 neno = z;
    n32 i = 1;
    wakati (i <= 40) {
        d64 i_d = i;
        jumla = jumla + neno / i_d;
        neno = neno * z2;
        i = i + 2;
    }

    d64 k_d = k;
    rudisha 2.0 * jumla + k_d * LN2;
}

// civ_kuinua: x kwa nguvu ya y (badala ya pow() ya libc,
// lugha-swa/swa#183), kwa x > 0 pekee (kesi pekee inayohitajika
// kwenye Dominion hadi sasa -- mfano (1.0 + kiwango)^kipeo ambapo
// msingi daima ni >= 1.0). x^y = exp(y * ln(x)). x <= 0.0 hurudisha
// 0.0.
d64 civ_kuinua(d64 x, d64 y) {
    kama (x <= 0.0) { rudisha 0.0; }
    rudisha civ_kielelezi(y * civ_logasili(x));
}

// ---------- Trigonometry (sin/cos/atan2, lugha-swa/swa#183) ----------
// civ_pi: kazi (si kigezo cha ulimwengu cha d64 -- hakijawahi
// kujaribiwa kwenye kikao hiki, kwa hiyo tunaepuka hatari
// isiyojulikana). 3.1415926536 ni herufi 12 jumla, sawa na muundo wa
// LN2 kwenye civ_logasili -- ndani ya kikomo salama cha #188.
d64 civ_pi() {
    rudisha 3.1415926536;
}

// civ_sin/civ_cos: hupunguza masafa (range reduction) kwenda (-pi,pi]
// kwa kutoa/kuongeza 2*pi mara kwa mara, kisha mfululizo wa Taylor wa
// moja kwa moja (maneno 20) -- HAKUNA upunguzaji zaidi kwenda
// robo-mzunguko (hauhitajiki: mfululizo unasambamka vizuri ndani ya
// (-pi,pi] kwa maneno 20, imethibitishwa kwa majaribio ya moja kwa
// moja dhidi ya thamani zinazojulikana, angalia jaribio la kikao hiki).
d64 civ_sin(d64 x) {
    d64 pi = civ_pi();
    d64 pi2 = pi + pi;
    wakati (x > pi) { x = x - pi2; }
    wakati (x <= (0.0 - pi)) { x = x + pi2; }

    d64 x2 = x * x;
    d64 jumla = x;
    d64 neno = x;
    n32 n = 1;
    wakati (n <= 20) {
        d64 n_d = n;
        d64 chini1 = 2.0 * n_d;
        d64 chini2 = chini1 + 1.0;
        neno = neno * (0.0 - x2) / (chini1 * chini2);
        jumla = jumla + neno;
        n = n + 1;
    }
    rudisha jumla;
}

d64 civ_cos(d64 x) {
    d64 pi = civ_pi();
    d64 pi2 = pi + pi;
    wakati (x > pi) { x = x - pi2; }
    wakati (x <= (0.0 - pi)) { x = x + pi2; }

    d64 x2 = x * x;
    d64 jumla = 1.0;
    d64 neno = 1.0;
    n32 n = 1;
    wakati (n <= 20) {
        d64 n_d = n;
        d64 chini1 = 2.0 * n_d - 1.0;
        d64 chini2 = 2.0 * n_d;
        neno = neno * (0.0 - x2) / (chini1 * chini2);
        jumla = jumla + neno;
        n = n + 1;
    }
    rudisha jumla;
}

// civ_atan_ndogo: atan(t) kwa t ndani ya [0.0, 1.0] pekee. Mfululizo
// wa Gregory (t - t^3/3 + t^5/5 - ...) unasambamka POLEPOLE SANA
// karibu na t=1.0 (kosa la O(1/N)) -- kwa hiyo tunapunguza t mara
// tatu kwa kigezo cha "nusu-pembe" (half-angle: atan(t) =
// 2*atan(t/(1+sqrt(1+t^2)))) KABLA ya mfululizo, sawa na mbinu ya
// range-reduction ya civ_logasili. Kwa t=1.0, punguzo tatu
// hufikisha hoja ya mfululizo chini ya ~0.1 -- muunganiko wa haraka.
d64 civ_atan_ndogo(d64 t) {
    d64 u1 = t / (1.0 + civ_mzizi(1.0 + t * t));
    d64 u2 = u1 / (1.0 + civ_mzizi(1.0 + u1 * u1));
    d64 u3 = u2 / (1.0 + civ_mzizi(1.0 + u2 * u2));

    d64 u2sq = u3 * u3;
    d64 jumla = u3;
    d64 neno = u3;
    n32 n = 1;
    wakati (n <= 20) {
        d64 n_d = n;
        d64 juu = 2.0 * n_d - 1.0;
        d64 chini = 2.0 * n_d + 1.0;
        neno = neno * (0.0 - u2sq) * juu / chini;
        jumla = jumla + neno;
        n = n + 1;
    }
    rudisha jumla * 8.0;
}

// civ_atan: atan(t) kwa t YOYOTE halisi. t hasi hushughulikiwa kwa
// ulinganifu (atan ni kazi isiyo ya kawaida/odd function); |t| > 1.0
// hushughulikiwa kwa kitambulisho atan(t) = pi/2 - atan(1/t).
d64 civ_atan(d64 t) {
    n32 hasi = 0;
    d64 tt = t;
    kama (tt < 0.0) { hasi = 1; tt = 0.0 - tt; }

    d64 matokeo = civ_atan_ndogo(tt);
    kama (tt > 1.0) {
        matokeo = (civ_pi() / 2.0) - civ_atan_ndogo(1.0 / tt);
    }

    kama (hasi == 1) { matokeo = 0.0 - matokeo; }
    rudisha matokeo;
}

// civ_atan2: pembe kamili (mzunguko mzima, -pi hadi pi) ya (y, x),
// kwa mantiki ya robo (quadrant) ya kawaida ya atan2. x==0.0 na
// y==0.0 (isiyofafanuliwa kihisabati) hurudisha 0.0.
d64 civ_atan2(d64 y, d64 x) {
    kama (x > 0.0) { rudisha civ_atan(y / x); }
    kama (x < 0.0) {
        kama (y >= 0.0) { rudisha civ_atan(y / x) + civ_pi(); }
        rudisha civ_atan(y / x) - civ_pi();
    }
    kama (y > 0.0) { rudisha civ_pi() / 2.0; }
    kama (y < 0.0) { rudisha 0.0 - (civ_pi() / 2.0); }
    rudisha 0.0;
}

// civ_muda_sasa: sekunde tangu 1970-01-01 (Unix epoch), kwa
// clock_gettime(CLOCK_REALTIME=0, ...) moja kwa moja (syscall 228 kwenye
// x86-64 Linux) badala ya time() ya libc -- inaendana na msururu wa
// sifuri-libc wa mradi (angalia faili.swa, ambayo tayari inatumia
// wito_wa_mfumo moja kwa moja kwa open/read/write/close/unlink).
// struct timespec { long tv_sec; long tv_nsec; } -- n64 mbili,
// tv_sec ndiyo ya kwanza.
n64 civ_muda_sasa() {
    n64* muda_buf = tenga(ukubwa(n64) * 2);
    wito_wa_mfumo(228, 0, muda_buf, 0, 0, 0, 0);
    n64 sekunde = muda_buf[0];
    achilia muda_buf;
    rudisha sekunde;
}
